---
import '../styles/global.css';
import '../styles/admin.css';

interface Props {
  title?: string;
  activePage?: string;
}

const { title = 'Admin Dashboard', activePage = 'dashboard' } = Astro.props;

const navItems = [
  { id: 'dashboard', label: 'Dashboard', href: '/admin', icon: 'grid' },
  { id: 'networks', label: 'Networks', href: '/admin/networks', icon: 'globe' },
  { id: 'news', label: 'News', href: '/admin/news', icon: 'file-text' },
  { id: 'compare', label: 'Compare', href: '/admin/compare', icon: 'columns' },
  { id: 'settings', label: 'Site Settings', href: '/admin/settings', icon: 'settings' },
  { id: 'preview', label: 'Preview Site', href: '/admin/preview', icon: 'eye' },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — ExpertHub Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body class="bg-bg-secondary">
  <!-- Sidebar -->
  <aside class="admin-sidebar">
    <div class="admin-sidebar-brand">
      Expert<span>Hub</span>
      <span class="text-xs text-white/40 ml-2">Admin</span>
    </div>
    <nav class="admin-sidebar-nav">
      {navItems.map(item => (
        <a href={item.href} class={`admin-sidebar-link ${activePage === item.id ? 'active' : ''}`}>
          <span class="w-5 h-5 flex items-center justify-center text-xs">
            {item.icon === 'grid' && '▦'}
            {item.icon === 'globe' && '◉'}
            {item.icon === 'file-text' && '▤'}
            {item.icon === 'columns' && '▥'}
            {item.icon === 'settings' && '⚙'}
            {item.icon === 'eye' && '◎'}
          </span>
          {item.label}
        </a>
      ))}
    </nav>
    <div class="px-3 py-4 border-t border-white/10">
      <a href="/" class="admin-sidebar-link">
        <span class="w-5 h-5 flex items-center justify-center text-xs">←</span>
        View Public Site
      </a>
      <form method="POST" action="/api/auth?action=logout" class="mt-1">
        <button type="submit" class="admin-sidebar-link w-full text-left cursor-pointer border-none bg-transparent">
          <span class="w-5 h-5 flex items-center justify-center text-xs">⏻</span>
          Logout
        </button>
      </form>
    </div>
  </aside>

  <!-- Main content -->
  <div class="admin-main">
    <header class="admin-topbar">
      <h1 class="text-lg font-bold text-primary">{title}</h1>
      <div class="text-sm text-tertiary">ExpertHub Admin</div>
    </header>
    <main class="admin-content">
      <slot />
    </main>
  </div>
</body>
</html>

---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
// Self-hosted Inter (variable). Preloaded so the first paint uses the real font.
import interLatinUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  canonicalPath?: string;
  jsonLd?: Record<string, any>;
  /** Show the reading-progress bar under the header (long editorial pages). */
  progress?: boolean;
  /** Browser UI colour. Pages that open on a dark hero should pass '#0d0d0f'. */
  themeColor?: string;
}

const {
  title = 'Expert Network Companies: Compare Providers, Pricing & Reviews (2026) | ExpertNetworks.net',
  description = 'Independent expert network directory. Compare 33+ providers including GLG, AlphaSights, Third Bridge, Guidepoint, and Dialectica across pricing, compliance, AI capabilities, and expert coverage. Free, no sign-up required.',
  ogImage = '/og-default.png',
  ogType = 'website',
  canonicalPath,
  jsonLd,
  progress = false,
  themeColor = '#FBFBFD',
} = Astro.props;

const siteUrl = 'https://expertnetworks.net';
const canonicalUrl = canonicalPath ? `${siteUrl}${canonicalPath}` : new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  <meta name="theme-color" content={themeColor} />
  <meta name="color-scheme" content="light" />
  <title>{title}</title>

  <!-- Canonical URL -->
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title} />
  <meta property="og:site_name" content="ExpertNetworks.net" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />

  <!-- Font: self-hosted Inter variable (no third-party font origin) -->
  <link rel="preload" href={interLatinUrl} as="font" type="font/woff2" crossorigin />

  <!-- Favicons -->
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
  <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

  <!-- JSON-LD Structured Data -->
  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  )}

  <!-- Organization Schema (every page) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "ExpertNetworks.net",
    "url": "https://expertnetworks.net",
    "logo": "https://expertnetworks.net/favicon-512.png",
    "description": "Independent expert network directory and industry intelligence resource.",
    "sameAs": ["https://www.linkedin.com/company/expertnetworks-net/"]
  })} is:inline />

  <!-- Speculation Rules: prefetch same-origin links on hover/pointer-down intent,
       prerender on moderate eagerness. Browsers without support ignore this. -->
  <script type="speculationrules" is:inline set:html={JSON.stringify({
    prefetch: [{
      where: { and: [{ href_matches: '/*' }, { not: { selector_matches: '[rel~=nofollow], [download], [target=_blank], [data-no-speculate]' } }] },
      eagerness: 'moderate',
    }],
    prerender: [{
      where: { and: [{ href_matches: '/*' }, { not: { selector_matches: '[rel~=nofollow], [download], [target=_blank], [data-no-speculate]' } }] },
      eagerness: 'moderate',
    }],
  })} />
</head>
<body>
  <Header pathname={Astro.url.pathname} />
  {progress && <div class="scroll-progress" id="scrollProgress" aria-hidden="true"></div>}
  <main id="main-content">
    <slot />
  </main>
  <Footer />
  <script>
    // Scroll reveals. Where CSS scroll-driven animations are supported the
    // `.fade-in` class is animated by `animation-timeline: view()` (see
    // global.css) and this observer is only a harmless no-op fallback.
    const reveals = document.querySelectorAll('.fade-in');
    if (reveals.length) {
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
        reveals.forEach(el => observer.observe(el));
      } else {
        reveals.forEach(el => el.classList.add('visible'));
      }
    }

    // Reading progress fallback for browsers without scroll() timelines.
    const progressBar = document.getElementById('scrollProgress');
    if (progressBar && !(window.CSS && CSS.supports('animation-timeline: scroll()'))) {
      let ticking = false;
      const update = () => {
        ticking = false;
        const max = document.documentElement.scrollHeight - window.innerHeight;
        progressBar.style.setProperty('--scroll-progress', max > 0 ? String(Math.min(1, window.scrollY / max)) : '0');
      };
      window.addEventListener('scroll', () => {
        if (!ticking) { ticking = true; requestAnimationFrame(update); }
      }, { passive: true });
      update();
    }

    // Pointer-follow spotlight for `.card-spot` (mouse/pen only, delegated).
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      document.addEventListener('pointermove', (e) => {
        const card = e.target instanceof Element ? e.target.closest('.card-spot') : null;
        if (!(card instanceof HTMLElement)) return;
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${e.clientX - rect.left}px`);
        card.style.setProperty('--my', `${e.clientY - rect.top}px`);
      }, { passive: true });
    }

    // FIX: Reset body state on page load to prevent "stuck" scroll lock after
    // navigating away while an overlay (search, menu, sidebar) was open.
    document.body.classList.remove('overlay-open');
    document.body.style.top = '';
    document.body.style.overflow = '';
  </script>
</body>
</html>

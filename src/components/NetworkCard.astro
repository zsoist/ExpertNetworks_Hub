---
interface Props {
  name: string;
  shortName: string;
  slug: string;
  gradientFrom: string;
  gradientTo: string;
  type: string;
  founded?: number;
  headquarters?: string;
  description: string;
  services: string[];
  expertCount?: string;
  employeeCount?: string;
  pricingModel?: string;
  logo?: string;
  variant?: 'logo' | 'profile';
  stagger?: number;
}

const { name, shortName, slug, gradientFrom, gradientTo, type, founded, headquarters, description, services, expertCount, employeeCount, pricingModel, logo, variant = 'profile', stagger = 0 } = Astro.props;
---

{variant === 'logo' ? (
  <a href={`/networks/${slug}`} class={`block bg-white rounded-card p-5 text-center no-underline shadow-card hover:shadow-card-hover hover:-translate-y-1 transition-all fade-in stagger-${stagger}`}>
    {logo ? (
      <img src={logo} alt={name} width="48" height="48" class="w-12 h-12 rounded-xl mx-auto mb-3 object-contain" loading="lazy" />
    ) : (
      <div class="w-12 h-12 rounded-xl mx-auto mb-3 flex items-center justify-center text-white font-bold text-lg" style={`background: linear-gradient(135deg, ${gradientFrom}, ${gradientTo})`}>
        {shortName}
      </div>
    )}
    <div class="font-semibold text-sm text-primary">{name}</div>
    <div class="text-xs text-tertiary mt-0.5">{type}</div>
  </a>
) : (
  <a href={`/networks/${slug}`} class="block bg-white rounded-card p-6 no-underline shadow-card hover:shadow-card-hover hover:-translate-y-1 transition-all fade-in">
    <div class="flex items-center gap-3 mb-4">
      {logo ? (
        <img src={logo} alt={name} width="44" height="44" class="w-11 h-11 rounded-xl object-contain flex-shrink-0" loading="lazy" />
      ) : (
        <div class="w-11 h-11 rounded-xl flex items-center justify-center text-white font-bold text-base flex-shrink-0" style={`background: linear-gradient(135deg, ${gradientFrom}, ${gradientTo})`}>
          {shortName}
        </div>
      )}
      <div>
        <h3 class="font-bold text-base text-primary leading-tight">{name}</h3>
        <div class="text-xs text-tertiary">{founded && `Founded ${founded}`}{founded && headquarters && ' \u00B7 '}{headquarters}</div>
      </div>
    </div>
    <p class="text-sm text-secondary leading-relaxed mb-4 line-clamp-2">{description}</p>
    <div class="flex flex-wrap gap-1.5 mb-4">
      {services.slice(0, 4).map(service => (
        <span class="inline-block px-2 py-0.5 text-xs rounded-full font-medium bg-accent/10 text-accent">{service}</span>
      ))}
    </div>
    <div class="flex gap-6 pt-3 border-t border-bg-secondary">
      {expertCount && (
        <div>
          <span class="block text-sm font-bold text-primary">{expertCount}</span>
          <span class="text-xs text-tertiary">Experts</span>
        </div>
      )}
      {employeeCount && (
        <div>
          <span class="block text-sm font-bold text-primary">{employeeCount}</span>
          <span class="text-xs text-tertiary">Employees</span>
        </div>
      )}
      {pricingModel && (
        <div>
          <span class="block text-sm font-bold text-primary">{pricingModel}</span>
          <span class="text-xs text-tertiary">Pricing</span>
        </div>
      )}
    </div>
  </a>
)}

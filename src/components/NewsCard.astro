---
interface Props {
  title: string;
  slug: string;
  date: string;
  source: string;
  summary: string;
  category: string;
  categoryColor?: string;
  gradientFrom?: string;
  gradientTo?: string;
}

const { title, slug, date, source, summary, category, categoryColor = '#0071E3', gradientFrom = '#1a365d', gradientTo = '#2563eb' } = Astro.props;
const formattedDate = new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<div class="bg-white rounded-card overflow-hidden shadow-card hover:shadow-card-hover transition-all fade-in">
  <div class="h-40" style={`background: linear-gradient(135deg, ${gradientFrom} 0%, ${gradientTo} 100%)`}></div>
  <div class="p-5">
    <div class="flex items-center gap-3 mb-2">
      <span class="text-xs font-bold uppercase tracking-wide" style={`color: ${categoryColor}`}>{category}</span>
      <span class="text-xs text-tertiary">{formattedDate}</span>
    </div>
    <h3 class="text-base font-bold text-primary leading-snug mb-2">{title}</h3>
    <p class="text-sm text-secondary leading-relaxed mb-3 line-clamp-3">{summary}</p>
    <div class="flex items-center gap-1.5 text-xs text-tertiary">
      <svg width="12" height="12" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
      Source: {source}
    </div>
  </div>
</div>

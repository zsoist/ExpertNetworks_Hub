---
interface NetworkData {
  name: string;
  shortName: string;
  slug: string;
  logo?: string;
  gradientFrom: string;
  gradientTo: string;
  founded?: number;
  headquarters?: string;
  expertCount?: string;
  expertCountLabel?: string;
  employeeCount?: string;
  pricingModel?: string;
  pricingDetail?: string;
  deliveryModel?: string;
  categoryBadge?: string;
  regionStrength?: string;
  aiBadge?: string;
  complianceBadge?: string;
  services?: string[];
  aiCapabilities?: string[];
  keyDifferentiators?: string[];
  bestFor?: string[];
  description?: string;
}

interface Props {
  a: { data: NetworkData };
  b: { data: NetworkData };
  verdict: string[];
  backLink?: { href: string; label: string };
}

const { a, b, verdict } = Astro.props;

const comparisons = [
  { label: 'Founded', va: String(a.data.founded || 'N/A'), vb: String(b.data.founded || 'N/A') },
  { label: 'Headquarters', va: a.data.headquarters || 'N/A', vb: b.data.headquarters || 'N/A' },
  { label: 'Expert Network Size', va: a.data.expertCount || 'N/A', vb: b.data.expertCount || 'N/A' },
  { label: 'Employees', va: a.data.employeeCount || 'N/A', vb: b.data.employeeCount || 'N/A' },
  { label: 'Pricing Model', va: a.data.pricingModel || 'N/A', vb: b.data.pricingModel || 'N/A' },
  { label: 'Pricing Detail', va: a.data.pricingDetail || 'N/A', vb: b.data.pricingDetail || 'N/A' },
  { label: 'Delivery Model', va: a.data.deliveryModel || 'N/A', vb: b.data.deliveryModel || 'N/A' },
  { label: 'Category', va: a.data.categoryBadge || 'N/A', vb: b.data.categoryBadge || 'N/A' },
  { label: 'Region Strength', va: a.data.regionStrength || 'N/A', vb: b.data.regionStrength || 'N/A' },
  { label: 'AI Badge', va: a.data.aiBadge || 'N/A', vb: b.data.aiBadge || 'N/A' },
  { label: 'Compliance', va: a.data.complianceBadge || 'N/A', vb: b.data.complianceBadge || 'N/A' },
];

const nameA = a.data.name.split(' (')[0];
const nameB = b.data.name.split(' (')[0];
const shortA = a.data.shortName || nameA.charAt(0);
const shortB = b.data.shortName || nameB.charAt(0);

// Related pages lookup
const relatedPages: Record<string, { comparisons: { href: string; label: string }[]; alternatives?: string }> = {
  'glg': {
    comparisons: [
      { href: '/glg-vs-alphasights/', label: 'GLG vs AlphaSights' },
      { href: '/glg-vs-third-bridge/', label: 'GLG vs Third Bridge' },
      { href: '/glg-vs-guidepoint/', label: 'GLG vs Guidepoint' },
    ],
    alternatives: '/glg-alternatives/',
  },
  'alphasights': {
    comparisons: [
      { href: '/glg-vs-alphasights/', label: 'GLG vs AlphaSights' },
      { href: '/alphasights-vs-third-bridge/', label: 'AlphaSights vs Third Bridge' },
      { href: '/alphasights-vs-dialectica/', label: 'AlphaSights vs Dialectica' },
    ],
    alternatives: '/alphasights-alternatives/',
  },
  'third-bridge': {
    comparisons: [
      { href: '/glg-vs-third-bridge/', label: 'GLG vs Third Bridge' },
      { href: '/alphasights-vs-third-bridge/', label: 'AlphaSights vs Third Bridge' },
      { href: '/third-bridge-vs-guidepoint/', label: 'Third Bridge vs Guidepoint' },
    ],
    alternatives: '/third-bridge-alternatives/',
  },
  'guidepoint': {
    comparisons: [
      { href: '/glg-vs-guidepoint/', label: 'GLG vs Guidepoint' },
      { href: '/third-bridge-vs-guidepoint/', label: 'Third Bridge vs Guidepoint' },
    ],
  },
  'dialectica': {
    comparisons: [
      { href: '/alphasights-vs-dialectica/', label: 'AlphaSights vs Dialectica' },
    ],
  },
};

// Get related for both networks, exclude current page
const currentPath = `/${a.data.slug}-vs-${b.data.slug}`;
const altPath = `/${b.data.slug}-vs-${a.data.slug}`;
const relA = relatedPages[a.data.slug];
const relB = relatedPages[b.data.slug];
const linksA = relA?.comparisons.filter(c => c.href !== currentPath && c.href !== altPath) || [];
const linksB = relB?.comparisons.filter(c => c.href !== currentPath && c.href !== altPath) || [];
const hasRelated = linksA.length > 0 || linksB.length > 0 || relA?.alternatives || relB?.alternatives;
const sides = [
  { n: a.data, name: nameA, short: shortA },
  { n: b.data, name: nameB, short: shortB },
];
const diffCount = comparisons.filter(row => row.va !== row.vb).length;
---

<!-- Visual Face-off -->
<section class="py-10 md:py-12 px-4 md:px-6">
  <div class="max-w-4xl mx-auto">
    <div class="vs-faceoff">
      {sides.map(({ n, name, short }, i) => (
        <Fragment>
          {i === 1 && <div class="vs-medallion" aria-hidden="true">VS</div>}
          <a href={`/networks/${n.slug}/`} class="vs-side group" style={`--vs-a: ${n.gradientFrom}; --vs-b: ${n.gradientTo}`}>
            {n.logo ? (
              <img src={n.logo} alt={`${name} logo`} width="72" height="72" class="vs-logo" loading="eager" decoding="async" />
            ) : (
              <div class="vs-logo vs-logo-fallback" style={`background: linear-gradient(135deg, ${n.gradientFrom}, ${n.gradientTo})`} aria-hidden="true">{short}</div>
            )}
            <h2 class="text-[22px] font-bold tracking-tight text-primary mt-4 group-hover:text-[#0066cc] transition-colors">{name}</h2>
            {n.categoryBadge && <p class="text-[13px] text-secondary mt-0.5">{n.categoryBadge}</p>}
            <div class="mt-4 text-[26px] leading-tight font-extrabold tracking-tight text-primary">{n.expertCount || '—'}</div>
            <div class="text-[13px] text-secondary mt-0.5">experts · est. {n.founded || 'N/A'}</div>
            <span class="vs-profile-link">View profile <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></span>
          </a>
        </Fragment>
      ))}
    </div>
  </div>
</section>

<!-- Comparison Table -->
<section class="py-12 px-4 md:px-6 bg-bg-secondary">
  <div class="max-w-4xl mx-auto">
    <div class="flex flex-wrap items-end justify-between gap-2 mb-5">
      <h2 class="text-2xl md:text-[28px] font-bold tracking-tight text-primary">Side-by-Side Comparison</h2>
      <p class="text-[13px] text-secondary"><strong class="text-primary">{diffCount}</strong> of {comparisons.length} rows differ <span class="vs-diff-key" aria-hidden="true"></span></p>
    </div>
    <div class="vs-table-card">
      <div class="overflow-x-auto">
        <table class="vs-table">
          <thead>
            <tr>
              <th scope="col">Metric</th>
              {sides.map(({ n, name, short }) => (
                <th scope="col">
                  <span class="inline-flex items-center gap-2">
                    {n.logo ? (
                      <img src={n.logo} alt="" width="22" height="22" class="w-[22px] h-[22px] rounded-md object-contain bg-white" loading="lazy" />
                    ) : (
                      <span class="w-[22px] h-[22px] rounded-md inline-flex items-center justify-center text-white font-bold text-[8px]" style={`background: linear-gradient(135deg, ${n.gradientFrom}, ${n.gradientTo})`} aria-hidden="true">{short}</span>
                    )}
                    {name}
                  </span>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {comparisons.map((row) => {
              const differs = row.va !== row.vb;
              return (
                <tr class={differs ? 'is-diff' : 'is-same'}>
                  <th scope="row">
                    {row.label}
                    {!differs && <span class="vs-same">Same</span>}
                  </th>
                  <td>{row.va}</td>
                  <td>{row.vb}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<!-- Services Comparison -->
<section class="py-14 px-4 md:px-6">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-2xl md:text-[28px] font-bold tracking-tight text-primary mb-6">Products & Services</h2>
    <div class="grid md:grid-cols-2 gap-5">
      {sides.map(({ n, name, short }) => (
        <div class="vs-card">
          <h3 class="vs-card-title">
            <span class="w-6 h-6 rounded-md inline-flex items-center justify-center text-white font-bold text-[9px] flex-shrink-0" style={`background: linear-gradient(135deg, ${n.gradientFrom}, ${n.gradientTo})`} aria-hidden="true">{short}</span>
            {name} Services
          </h3>
          <ul class="vs-list">
            {(n.services || []).map((s: string) => (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" class="vs-tick" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                {s}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- AI Comparison -->
{(a.data.aiCapabilities?.length || b.data.aiCapabilities?.length) && (
  <section class="py-14 px-4 md:px-6 bg-bg-secondary">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl md:text-[28px] font-bold tracking-tight text-primary mb-6">AI & Technology</h2>
      <div class="grid md:grid-cols-2 gap-5">
        {sides.map(({ n, name }) => (
          <div class="vs-card">
            <h3 class="vs-card-title">{name} AI Stack</h3>
            <ul class="vs-list vs-list-dots">
              {(n.aiCapabilities || []).map((c: string) => <li>{c}</li>)}
              {!(n.aiCapabilities?.length) && <li class="vs-list-empty">Limited public information</li>}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<!-- Key Differentiators -->
{(a.data.keyDifferentiators?.length || b.data.keyDifferentiators?.length) && (
  <section class="py-14 px-4 md:px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl md:text-[28px] font-bold tracking-tight text-primary mb-6">Key Differentiators</h2>
      <div class="grid md:grid-cols-2 gap-5">
        {sides.map(({ n, name }) => (
          <div class="vs-card">
            <h3 class="vs-card-title">Why Choose {name}</h3>
            <ul class="vs-list">
              {(n.keyDifferentiators || []).map((d: string) => (
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" class="vs-tick vs-tick-blue" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                  {d}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<!-- Best For -->
{(a.data.bestFor?.length || b.data.bestFor?.length) && (
  <section class="py-14 px-4 md:px-6 bg-bg-secondary">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl md:text-[28px] font-bold tracking-tight text-primary mb-6">Best For</h2>
      <div class="grid md:grid-cols-2 gap-5">
        {sides.map(({ n, name }) => (
          <div class="vs-card">
            <h3 class="vs-card-title">{name} Is Best For</h3>
            <ul class="vs-list vs-list-arrows">
              {(n.bestFor || []).map((bf: string) => <li>{bf}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<!-- Verdict -->
<section class="py-14 px-4 md:px-6">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-2xl md:text-[28px] font-bold tracking-tight text-primary mb-5">The Bottom Line</h2>
    <div class="vs-prose">
      {verdict.map((p) => <p set:html={p} />)}
    </div>
  </div>
</section>

<!-- Related Comparisons -->
{hasRelated && (
  <section class="pb-14 px-4 md:px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-xl font-bold tracking-tight text-primary mb-5">Related Comparisons</h2>
      <div class="grid sm:grid-cols-2 gap-5">
        {[{ name: nameA, slug: a.data.slug, links: linksA, rel: relA }, { name: nameB, slug: b.data.slug, links: linksB, rel: relB }].map(({ name, slug, links, rel }) => (
          <div class="vs-card">
            <h3 class="text-[11px] font-bold text-secondary uppercase tracking-[0.1em] mb-1">{name}</h3>
            <ul class="vs-links">
              <li><a href={`/networks/${slug}/`}>{name} Profile <span aria-hidden="true">&rarr;</span></a></li>
              {links.map(link => (
                <li><a href={link.href}>{link.label} <span aria-hidden="true">&rarr;</span></a></li>
              ))}
              {rel?.alternatives && (
                <li><a href={rel.alternatives}>{name} Alternatives <span aria-hidden="true">&rarr;</span></a></li>
              )}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<!-- Related -->
<section class="py-12 px-4 md:px-6 bg-bg-secondary">
  <div class="max-w-3xl mx-auto text-center">
    <h2 class="text-xl font-bold tracking-tight text-primary mb-2">Keep exploring</h2>
    <p class="text-[14px] text-secondary mb-6">Open both providers in the interactive comparison, or widen the shortlist.</p>
    <div class="flex flex-wrap gap-3 justify-center">
      <a href={`/compare/?networks=${a.data.slug},${b.data.slug}`} class="vs-btn vs-btn-primary">Full Comparison Tool</a>
      <a href="/best-expert-networks/" class="vs-btn vs-btn-secondary">Best Networks Ranked</a>
      <a href="/expert-network-pricing/" class="vs-btn vs-btn-secondary">Pricing Guide</a>
    </div>
  </div>
</section>

<style>
  .vs-faceoff { position: relative; display: grid; gap: 16px; }
  @media (min-width: 768px) { .vs-faceoff { grid-template-columns: 1fr 1fr; gap: 24px; } }
  .vs-side {
    position: relative; display: flex; flex-direction: column; align-items: center; text-align: center;
    padding: 28px 24px 22px; text-decoration: none;
    background: linear-gradient(160deg, color-mix(in srgb, var(--vs-b) 9%, #fff), #fff 70%);
    border: 1px solid rgba(210, 210, 215, 0.7); border-radius: 22px;
    transition: border-color 0.2s ease, box-shadow 0.25s ease, transform 0.25s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .vs-side:hover { border-color: rgba(174, 174, 178, 0.9); box-shadow: 0 12px 36px rgba(0, 0, 0, 0.09); transform: translateY(-2px); }
  .vs-logo { width: 72px; height: 72px; border-radius: 18px; object-fit: contain; background: #fff; box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.06), 0 6px 18px rgba(0, 0, 0, 0.08); }
  .vs-logo-fallback { display: flex; align-items: center; justify-content: center; color: #fff; font-size: 22px; font-weight: 700; }
  .vs-profile-link { display: inline-flex; align-items: center; gap: 2px; margin-top: 16px; font-size: 13.5px; font-weight: 600; color: #0066cc; }
  .vs-medallion {
    position: absolute; left: 50%; top: 50%; z-index: 2; transform: translate(-50%, -50%);
    display: flex; align-items: center; justify-content: center; width: 48px; height: 48px;
    font-size: 13px; font-weight: 800; letter-spacing: 0.04em; color: #fff; background: #1d1d1f;
    border: 4px solid #fbfbfd; border-radius: 999px; box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
  }

  .vs-table-card { background: #fff; border: 1px solid rgba(210, 210, 215, 0.7); border-radius: 18px; overflow: hidden; box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03), 0 8px 24px rgba(0, 0, 0, 0.04); }
  .vs-table { width: 100%; min-width: 520px; border-collapse: separate; border-spacing: 0; font-size: 14.5px; table-layout: fixed; }
  .vs-table th, .vs-table td { padding: 13px 18px; text-align: left; vertical-align: top; border-bottom: 1px solid rgba(210, 210, 215, 0.5); line-height: 1.5; }
  .vs-table tbody tr:last-child > * { border-bottom: 0; }
  .vs-table thead th { background: #f5f5f7; font-size: 14px; font-weight: 700; color: #1d1d1f; border-bottom-color: rgba(210, 210, 215, 0.9); }
  .vs-table thead th:first-child { width: 30%; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: #6e6e73; vertical-align: middle; }
  .vs-table tbody th { position: sticky; left: 0; background: #fff; font-weight: 600; color: #1d1d1f; }
  .vs-table td { color: #424245; }
  .vs-table tr.is-diff td { color: #1d1d1f; font-weight: 500; }
  .vs-table tr.is-diff th { box-shadow: inset 3px 0 0 #0071e3; }
  .vs-table tr.is-same td { color: #6e6e73; }
  .vs-same { display: inline-flex; margin-left: 8px; padding: 1px 7px; font-size: 10px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: #6e6e73; background: #f0f0f3; border-radius: 999px; vertical-align: middle; }
  .vs-diff-key { display: inline-block; width: 3px; height: 12px; margin-left: 6px; border-radius: 2px; background: #0071e3; vertical-align: -1px; }
  @media (max-width: 639px) { .vs-table th, .vs-table td { padding: 12px 14px; font-size: 14px; } }

  .vs-card { padding: 22px; background: #fff; border: 1px solid rgba(210, 210, 215, 0.7); border-radius: 18px; }
  .vs-card-title { display: flex; align-items: center; gap: 10px; margin: 0 0 14px; font-size: 17px; font-weight: 700; letter-spacing: -0.01em; color: #1d1d1f; }
  .vs-list { margin: 0; padding: 0; list-style: none; display: grid; gap: 10px; }
  .vs-list li { display: flex; align-items: flex-start; gap: 10px; font-size: 15px; line-height: 1.5; color: #424245; }
  .vs-tick { width: 18px; height: 18px; padding: 3px; margin-top: 2px; border-radius: 999px; flex-shrink: 0; color: #0b5d33; background: #e8f6ee; }
  .vs-tick-blue { color: #004f9f; background: rgba(0, 113, 227, 0.1); }
  .vs-list-dots li::before, .vs-list-arrows li::before { content: ''; flex-shrink: 0; width: 6px; height: 6px; margin-top: 0.55em; border-radius: 2px; background: #0071e3; }
  .vs-list-arrows li::before { border-radius: 999px; background: #1f9d55; }
  .vs-list-empty { font-style: italic; color: #6e6e73 !important; }
  .vs-list-empty::before { display: none; }

  .vs-prose { max-width: 68ch; font-size: 17px; line-height: 1.7; color: #424245; }
  .vs-prose :global(p + p) { margin-top: 1.1em; }
  .vs-prose :global(strong) { color: #1d1d1f; font-weight: 700; }
  .vs-links { margin: 0; padding: 0; list-style: none; }
  .vs-links a { display: flex; align-items: center; justify-content: space-between; min-height: 44px; font-size: 15px; font-weight: 500; color: #0066cc; text-decoration: none; border-top: 1px solid rgba(210, 210, 215, 0.5); }
  .vs-links li:first-child a { border-top: 0; }
  .vs-links a:hover { text-decoration: underline; text-underline-offset: 3px; }

  .vs-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 22px; font-size: 15px; font-weight: 600; border-radius: 999px; text-decoration: none; transition: background-color 0.15s ease, transform 0.15s ease; }
  .vs-btn-primary { color: #fff; background: #0071e3; }
  .vs-btn-primary:hover { background: #0064cc; }
  .vs-btn-secondary { color: #1d1d1f; background: #fff; border: 1px solid rgba(210, 210, 215, 0.95); }
  .vs-btn-secondary:hover { background: #f5f5f7; }
  .vs-btn:active { transform: scale(0.97); }

  @media (prefers-reduced-motion: reduce) {
    .vs-side, .vs-btn { transition: none; }
    .vs-side:hover, .vs-btn:active { transform: none; }
  }
</style>

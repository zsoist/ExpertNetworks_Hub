---
import siteConfig from '../content/site.json';
const { hero } = siteConfig;
---
<section class="min-h-screen flex items-center justify-center text-center px-6 bg-gradient-to-b from-bg-primary to-bg-secondary pt-[52px]" id="hero">
  <div class="max-w-3xl">
    <div class="inline-block px-4 py-1.5 bg-accent/10 text-accent text-xs font-semibold rounded-full mb-6 fade-in">
      {hero.badge}
    </div>
    <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight leading-[1.05] text-primary mb-6 fade-in">
      {hero.title}
    </h1>
    <p class="text-lg md:text-xl text-secondary leading-relaxed max-w-xl mx-auto mb-10 fade-in">
      {hero.subtitle}
    </p>
    <a href="#networks" class="inline-flex items-center gap-2 bg-accent text-white px-8 py-3.5 rounded-full text-base font-semibold no-underline hover:bg-accent-hover transition-all hover:shadow-lg fade-in">
      {hero.cta}
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </a>
    <div class="mt-20 text-tertiary text-sm animate-bounce" id="scrollHint">
      Discover the networks
      <span class="block text-lg mt-1">&darr;</span>
    </div>
  </div>
</section>

---
import siteConfig from '../content/site.json';
const { footer } = siteConfig;
---
<footer class="bg-bg-dark text-white/50 pt-16 pb-10 px-6">
  <div class="max-w-site mx-auto flex flex-col md:flex-row justify-between items-start gap-8">
    <div>
      <div class="text-base font-bold text-white mb-2">
        Expert<span class="text-accent">Networks</span>
      </div>
      <p class="text-[13px] max-w-[300px] leading-relaxed">{footer.description}</p>
      <a href="https://www.linkedin.com/company/expertnetworks-net/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 mt-3 text-white/50 hover:text-white transition-colors" aria-label="Follow us on LinkedIn">
        <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        <span class="text-[13px]">LinkedIn</span>
      </a>
    </div>
    <div class="flex gap-12 md:gap-12">
      <div>
        <h4 class="text-white text-[13px] font-bold uppercase tracking-wide mb-4">Navigate</h4>
        <a href="/networks" class="block text-white/50 no-underline text-[13px] mb-2 hover:text-white transition-colors">All Networks</a>
        <a href="/#news" class="block text-white/50 no-underline text-[13px] mb-2 hover:text-white transition-colors">Latest News</a>
        <a href="/compare" class="block text-white/50 no-underline text-[13px] mb-2 hover:text-white transition-colors">Compare</a>
        <a href="/about" class="block text-white/50 no-underline text-[13px] mb-2 hover:text-white transition-colors">About</a>
      </div>
      <div>
        <h4 class="text-white text-[13px] font-bold uppercase tracking-wide mb-4">Top Networks</h4>
        <a href="/networks/glg" class="block text-white/50 no-underline text-[13px] mb-2 hover:text-white transition-colors">GLG</a>
        <a href="/networks/alphasights" class="block text-white/50 no-underline text-[13px] mb-2 hover:text-white transition-colors">AlphaSights</a>
        <a href="/networks/third-bridge" class="block text-white/50 no-underline text-[13px] mb-2 hover:text-white transition-colors">Third Bridge</a>
        <a href="/networks/guidepoint" class="block text-white/50 no-underline text-[13px] mb-2 hover:text-white transition-colors">Guidepoint</a>
      </div>
      <div>
        <h4 class="text-white text-[13px] font-bold uppercase tracking-wide mb-4">Legal</h4>
        <a href="/disclaimer" class="block text-white/50 no-underline text-[13px] mb-2 hover:text-white transition-colors">Disclaimer</a>
        <a href="/privacy" class="block text-white/50 no-underline text-[13px] mb-2 hover:text-white transition-colors">Privacy</a>
        <a href="/sources" class="block text-white/50 no-underline text-[13px] mb-2 hover:text-white transition-colors">Sources</a>
      </div>
    </div>
  </div>
  <div class="max-w-site mx-auto mt-10 pt-5 border-t border-white/10 text-xs flex flex-col md:flex-row justify-between gap-2">
    <span>&copy; {footer.copyright}</span>
    <span>{footer.disclaimer}</span>
  </div>
</footer>

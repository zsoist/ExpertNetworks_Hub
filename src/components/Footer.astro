---
import { getCollection } from 'astro:content';

const allNetworks = await getCollection('networks');
const publishedNetworks = allNetworks.filter(n => n.data.published);
const networkCount = publishedNetworks.length;
---

<footer class="relative overflow-hidden bg-[#111113]" id="siteFooter">
  <!-- Particle canvas -->
  <canvas id="footerCanvas" class="absolute inset-0 w-full h-full" style="pointer-events: none;" role="presentation" aria-hidden="true"></canvas>
  <!-- Subtle top gradient edge -->
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/[0.06] to-transparent"></div>

  <!-- ═══ Main footer content ═══ -->
  <div class="relative z-10 pt-16 pb-0 px-6">
    <div class="max-w-site mx-auto">

      <!-- ─── 4-Column Grid ─── -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8">

        <!-- Column 1: Brand + Trust -->
        <div class="lg:col-span-1 md:col-span-2 lg:pr-4">
          <a href="/" class="inline-flex items-center gap-2 mb-4 group">
            <svg class="w-6 h-6 flex-shrink-0 text-white/60" viewBox="0 0 2048 2048" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M 1493 1721.15 L 1290 1721.17 L 1285 1719.35 L 1228 1716.77 L 1166 1707.92 L 1100 1692.5 L 1057.24 1679 L 1000 1654.83 L 933.33 1617 L 871 1570.28 L 825 1526.61 L 789.79 1489 L 745.39 1429 L 716.92 1383 L 687.97 1325 L 672.75 1288 L 657.1 1239 L 640 1159.34 L 615.79 1199 L 566.83 1288 L 502.98 1409 L 474.75 1467 L 485 1469.51 L 575 1472.05 L 580 1473.92 L 707 1474.77 L 739.53 1518 L 766.02 1549 L 816 1598.85 L 878 1647.62 L 933.02 1683 L 965 1699.96 L 965 1703 L 915 1708.2 L 910 1710.22 L 893 1710.42 L 888 1712.42 L 869 1712.57 L 864 1714.6 L 807 1717.17 L 802 1719.06 L 763 1719.34 L 757 1721.2 L 556 1721.19 L 551 1719.37 L 505 1719.05 L 500 1717.15 L 432 1714.6 L 427 1712.65 L 405 1712.34 L 387 1707.81 L 368.51 1692 L 331 1636.83 L 288.93 1566 L 233.5 1455 L 224.57 1430 L 224.63 1423 L 229.28 1409 L 374.98 1133 L 430.12 1036 L 461.5 989 L 510.23 927 L 562 875.27 L 618 830.45 L 671 797.29 L 722 772.91 L 762 757.34 L 833 737.41 L 899 726.41 L 921 726.02 L 927 724.11 L 1002 724.11 L 1045 728.54 L 1116 744.02 L 1172.17 763 L 1159.11 736 L 1123.59 676 L 1081.77 610 L 1022 521.85 L 1017.07 526 L 1001.77 548 L 938.79 648 L 925 666.3 L 902 666.82 L 853 673.46 L 802 684.48 L 756 697.74 L 691 722.31 L 638 748.84 L 602.97 770 L 606.6 758 L 664 645.42 L 758.78 480 L 791.87 427 L 838.68 358 L 857.49 337 L 867 331.98 L 906 326.98 L 941 326.62 L 946 324.82 L 1095 324.8 L 1101 326.63 L 1160 329.25 L 1178 333.73 L 1186 338.92 L 1210 369.71 L 1260.89 445 L 1368.85 619 L 1415.46 708 L 1444.09 785 L 1461.81 856 L 1468.49 896 L 1470.97 935 L 1472.94 941 L 1472.92 1024 L 1470.91 1029 L 1468.51 1066 L 1459.65 1117 L 1446.32 1166 L 1422.08 1230 L 1399.55 1275 L 1379.77 1308 L 1350.9 1348 L 1326.35 1377 L 1294 1409.32 L 1258.66 1438 L 1220 1463.71 L 1218.53 1467 L 1266 1469.89 L 1271 1471.87 L 1299 1472.1 L 1304 1473.98 L 1343 1474.26 L 1472 1473.91 L 1478 1472.03 L 1559 1469.53 L 1571.04 1467 L 1543.04 1409 L 1468.63 1269 L 1490.26 1217 L 1503.52 1177 L 1521.42 1101 L 1530.16 1030 L 1530.3 957 L 1528.18 946 L 1528.32 931 L 1530 929.32 L 1540.83 941 L 1591.07 1011 L 1646.36 1095 L 1673.39 1140 L 1752.43 1285 L 1812.46 1405 L 1821.47 1429 L 1812.13 1458 L 1768.16 1546 L 1748 1581.77 L 1721.46 1626 L 1677.48 1692 L 1671 1698.7 L 1653 1709.78 L 1643 1712.37 L 1595 1714.85 L 1590 1716.76 L 1553 1717.14 L 1548 1719.03 L 1498 1719.36 L 1493 1721.15 Z M 1042.02 1372 L 1087 1363.76 L 1128 1347.73 L 1154.93 1332 L 1173 1318.4 L 1193 1300.52 L 1207.54 1284 L 1232.19 1248 L 1252.23 1203 L 1258.74 1179 L 1263.2 1150 L 1263.36 1109 L 1254.31 1063 L 1238.84 1023 L 1216.42 985 L 1186 950.27 L 1148 921.13 L 1108 900.95 L 1080.69 892 L 1058 887.45 L 1006 885.36 L 965.02 892 L 927 905.36 L 905 916.47 L 878 934.55 L 845.31 965 L 816.2 1005 L 796.01 1048 L 787.23 1079 L 782.81 1106 L 782.73 1149 L 787.08 1178 L 793.76 1203 L 816 1252.33 L 836.59 1282 L 851.35 1299 L 871 1316.51 L 903 1339.3 L 952 1361.49 L 990 1370.42 L 1009 1372.55 L 1042.02 1372 Z M 1041 1260.06 L 1006 1260.14 L 985 1255.58 L 955.44 1242 L 940 1230.97 L 922.85 1214 L 911 1197.51 L 897.42 1168 L 892.96 1148 L 892.91 1108 L 895.35 1098 L 904.08 1072 L 917.74 1049 L 935 1029.47 L 958 1013.42 L 976 1004.47 L 1001 997.67 L 1025 995.49 L 1057 1000.13 L 1075 1006.89 L 1102 1022.72 L 1126 1046.72 L 1134.84 1060 L 1144 1078.29 L 1153.03 1112 L 1153.1 1143 L 1148.53 1166 L 1135 1197.55 L 1124 1213 L 1107 1230.14 L 1090.53 1242 L 1061 1255.57 L 1041 1260.06 Z"/></svg>
            <span class="text-[22px] font-bold text-white tracking-tight">Expert<span class="text-accent">Networks</span></span>
          </a>
          <p class="text-[13px] text-white/40 leading-[1.7] mb-5 max-w-[360px]">
            Compare providers, review industry news, and assess pricing, compliance, expert coverage, and AI capabilities across {networkCount} networks. No paywalls. No affiliations. Built from public-source research.
          </p>
          <!-- LinkedIn -->
          <a href="https://www.linkedin.com/company/expertnetworks-net/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-white/40 hover:text-white/70 transition-colors" aria-label="Follow us on LinkedIn">
            <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            <span class="text-[13px]">LinkedIn</span>
          </a>
        </div>

        <!-- Column 2: Explore -->
        <div>
          <h4 class="footer-heading">Explore</h4>
          <nav class="flex flex-col gap-0.5" aria-label="Explore links">
            <a href="/networks" class="footer-link">All Networks</a>
            <a href="/compare" class="footer-link">Compare Networks</a>
            <a href="/news" class="footer-link">Latest News</a>
            <a href="/about" class="footer-link">About the Project</a>
          </nav>
        </div>

        <!-- Column 3: Research Standards -->
        <div>
          <h4 class="footer-heading">Research Standards</h4>
          <nav class="flex flex-col gap-0.5" aria-label="Research standards links">
            <a href="/sources" class="footer-link">Sources &amp; Methodology</a>
            <a href="/verification" class="footer-link">Verification Framework</a>
            <a href="/disclaimer" class="footer-link">Disclaimer</a>
            <a href="/privacy" class="footer-link">Privacy</a>
          </nav>
          <p class="mt-4 text-[11px] text-white/25 leading-[1.65] max-w-[240px]">
            Every profile and news item is based on publicly available materials and labeled where claims are verified, positioned, or inferred.
          </p>
        </div>

        <!-- Column 4: Popular Profiles -->
        <div>
          <h4 class="footer-heading">Popular Profiles</h4>
          <nav class="flex flex-col gap-0.5" aria-label="Popular network profiles">
            <a href="/networks/glg" class="footer-link">GLG</a>
            <a href="/networks/alphasights" class="footer-link">AlphaSights</a>
            <a href="/networks/third-bridge" class="footer-link">Third Bridge</a>
            <a href="/networks/guidepoint" class="footer-link">Guidepoint</a>
            <a href="/networks/dialectica" class="footer-link">Dialectica</a>
            <a href="/networks/alphasense-tegus" class="footer-link">AlphaSense / Tegus</a>
          </nav>
        </div>
      </div>

      <!-- ─── Bottom Bar ─── -->
      <div class="mt-12 py-5 border-t border-white/[0.06] flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
        <span class="text-[11px] text-white/25">&copy; 2026 ExpertNetworks.net</span>
        <span class="text-[11px] text-white/20">Independent information resource. Not affiliated with any expert network.</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-heading {
    @apply text-[11px] font-semibold uppercase tracking-[0.12em] text-white/50 mb-4;
  }
  .footer-link {
    @apply block text-[13px] text-white/40 no-underline py-1.5 transition-colors duration-150;
  }
  .footer-link:hover {
    @apply text-white/80;
  }
</style>

<script>
(function() {
  // ─── Footer Particle System — matches homepage hero ───
  var PARTICLE_COUNT_DESKTOP = 110;
  var PARTICLE_COUNT_TABLET = 65;
  var PARTICLE_COUNT_MOBILE = 35;
  var MAX_CONNECTION_DIST = 140;
  var MAX_CONNECTION_DIST_SQ = MAX_CONNECTION_DIST * MAX_CONNECTION_DIST;
  var LINE_OPACITY = 0.09;
  var BASE_PARTICLE_OPACITY = 0.4;
  var IDLE_DRIFT_STRENGTH = 0.18;
  var POINTER_INFLUENCE_RADIUS = 180;
  var POINTER_INFLUENCE_RADIUS_SQ = POINTER_INFLUENCE_RADIUS * POINTER_INFLUENCE_RADIUS;
  var POINTER_REPULSION_STRENGTH = 130;
  var REVEAL_RADIUS = 200;
  var REVEAL_RADIUS_SQ = REVEAL_RADIUS * REVEAL_RADIUS;
  var REVEAL_OPACITY_BOOST = 0.5;
  var RECOVERY_SPEED = 0.018;
  var INTERPOLATION_FACTOR = 0.12;
  var CLICK_PULSE_STRENGTH = 200;
  var CLICK_PULSE_DURATION = 500;
  var DPR_CAP = 2;

  var REVEAL_PARTICLE_COUNT_DESKTOP = 140;
  var REVEAL_PARTICLE_COUNT_TABLET = 80;
  var REVEAL_PARTICLE_COUNT_MOBILE = 45;
  var REVEAL_MAX_CONNECTION_DIST = 110;
  var REVEAL_MAX_CONNECTION_DIST_SQ = REVEAL_MAX_CONNECTION_DIST * REVEAL_MAX_CONNECTION_DIST;
  var REVEAL_LINE_OPACITY = 0.22;
  var REVEAL_PARTICLE_OPACITY = 0.6;

  var canvas = document.getElementById('footerCanvas');
  var footer = document.getElementById('siteFooter');
  if (!canvas || !footer) return;
  var ctx = canvas.getContext('2d');
  if (!ctx) return;

  var motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
  var prefersReducedMotion = motionQuery.matches;

  function getTier() {
    var w = window.innerWidth;
    if (w >= 1024) return 'desktop';
    if (w >= 640) return 'tablet';
    return 'mobile';
  }
  function getParticleCount(tier) {
    if (tier === 'desktop') return PARTICLE_COUNT_DESKTOP;
    if (tier === 'tablet') return PARTICLE_COUNT_TABLET;
    return PARTICLE_COUNT_MOBILE;
  }
  function getRevealCount(tier) {
    if (tier === 'desktop') return REVEAL_PARTICLE_COUNT_DESKTOP;
    if (tier === 'tablet') return REVEAL_PARTICLE_COUNT_TABLET;
    return REVEAL_PARTICLE_COUNT_MOBILE;
  }

  var pointer = { x: -9999, y: -9999 };
  var smoothPointer = { x: -9999, y: -9999 };
  var isPointerInside = false;
  var clickPulse = { active: false, x: 0, y: 0, startTime: 0 };
  var particles = [];
  var revealParticles = [];
  var animationId = null;
  var isVisible = false;
  var currentTier = getTier();
  var cachedW = 0, cachedH = 0, lastTime = 0;

  function createParticle(w, h) {
    return {
      x: Math.random() * w, y: Math.random() * h,
      homeX: 0, homeY: 0,
      vx: (Math.random() - 0.5) * IDLE_DRIFT_STRENGTH,
      vy: (Math.random() - 0.5) * IDLE_DRIFT_STRENGTH,
      size: 1 + Math.random() * 1.2,
      opacity: BASE_PARTICLE_OPACITY * (0.4 + Math.random() * 0.6),
    };
  }
  function createRevealParticle(w, h) {
    return {
      x: Math.random() * w, y: Math.random() * h,
      size: 0.8 + Math.random() * 0.8,
      opacity: REVEAL_PARTICLE_OPACITY * (0.5 + Math.random() * 0.5),
    };
  }

  function resize() {
    var rect = footer.getBoundingClientRect();
    var dpr = Math.min(window.devicePixelRatio || 1, DPR_CAP);
    cachedW = rect.width; cachedH = rect.height;
    canvas.width = cachedW * dpr; canvas.height = cachedH * dpr;
    canvas.style.width = cachedW + 'px'; canvas.style.height = cachedH + 'px';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    var newTier = getTier();
    var needsRebuild = (newTier !== currentTier) || particles.length === 0;
    currentTier = newTier;
    if (needsRebuild) {
      var count = getParticleCount(currentTier);
      var revCount = getRevealCount(currentTier);
      particles = []; revealParticles = [];
      for (var i = 0; i < count; i++) {
        var p = createParticle(cachedW, cachedH);
        p.homeX = p.x; p.homeY = p.y;
        particles.push(p);
      }
      for (var i = 0; i < revCount; i++) {
        revealParticles.push(createRevealParticle(cachedW, cachedH));
      }
    }
  }

  function onPointerMove(e) {
    var rect = footer.getBoundingClientRect();
    pointer.x = e.clientX - rect.left; pointer.y = e.clientY - rect.top;
    isPointerInside = true;
  }
  function onPointerLeave() { isPointerInside = false; }
  function onClick(e) {
    var rect = footer.getBoundingClientRect();
    clickPulse.active = true;
    clickPulse.x = e.clientX - rect.left;
    clickPulse.y = e.clientY - rect.top;
    clickPulse.startTime = performance.now();
  }
  function onTouchStart(e) {
    if (e.touches.length > 0) {
      var rect = footer.getBoundingClientRect();
      pointer.x = e.touches[0].clientX - rect.left;
      pointer.y = e.touches[0].clientY - rect.top;
      isPointerInside = true;
    }
  }
  function onTouchMove(e) {
    if (e.touches.length > 0) {
      var rect = footer.getBoundingClientRect();
      pointer.x = e.touches[0].clientX - rect.left;
      pointer.y = e.touches[0].clientY - rect.top;
      isPointerInside = true;
    }
  }
  function onTouchEnd() { isPointerInside = false; }

  footer.addEventListener('mousemove', onPointerMove, { passive: true });
  footer.addEventListener('mouseleave', onPointerLeave, { passive: true });
  footer.addEventListener('click', onClick);
  footer.addEventListener('touchstart', onTouchStart, { passive: true });
  footer.addEventListener('touchmove', onTouchMove, { passive: true });
  footer.addEventListener('touchend', onTouchEnd, { passive: true });
  footer.addEventListener('touchcancel', onTouchEnd, { passive: true });

  var observer = new IntersectionObserver(function(entries) {
    isVisible = entries[0].isIntersecting;
  }, { threshold: 0.05 });
  observer.observe(footer);

  function onVisibilityChange() {
    if (document.hidden) {
      if (animationId) { cancelAnimationFrame(animationId); animationId = null; }
    } else if (!prefersReducedMotion && !animationId) {
      lastTime = 0; animationId = requestAnimationFrame(draw);
    }
  }
  document.addEventListener('visibilitychange', onVisibilityChange);

  function draw(now) {
    animationId = requestAnimationFrame(draw);
    if (!isVisible) return;
    var dt = lastTime ? Math.min((now - lastTime) / 16.667, 3) : 1;
    lastTime = now;
    var w = cachedW, h = cachedH;
    ctx.clearRect(0, 0, w, h);

    if (isPointerInside) {
      smoothPointer.x += (pointer.x - smoothPointer.x) * INTERPOLATION_FACTOR;
      smoothPointer.y += (pointer.y - smoothPointer.y) * INTERPOLATION_FACTOR;
    } else {
      smoothPointer.x += (-9999 - smoothPointer.x) * 0.02;
      smoothPointer.y += (-9999 - smoothPointer.y) * 0.02;
    }

    var pulseStrength = 0, pulseRadius = 0, pulseRadiusSq = 0;
    if (clickPulse.active) {
      var elapsed = now - clickPulse.startTime;
      if (elapsed > CLICK_PULSE_DURATION) { clickPulse.active = false; }
      else {
        var t = elapsed / CLICK_PULSE_DURATION;
        pulseStrength = CLICK_PULSE_STRENGTH * (1 - t);
        pulseRadius = POINTER_INFLUENCE_RADIUS * (1 + t * 1.5);
        pulseRadiusSq = pulseRadius * pulseRadius;
      }
    }

    var spx = smoothPointer.x, spy = smoothPointer.y;
    var revealActive = spx > -1000 && spy > -1000;

    // Reveal layer
    if (revealActive) {
      ctx.strokeStyle = 'rgb(120,140,170)'; ctx.lineWidth = 0.5;
      for (var i = 0; i < revealParticles.length; i++) {
        var a = revealParticles[i];
        var dxA = a.x - spx, dyA = a.y - spy;
        var distSqA = dxA * dxA + dyA * dyA;
        if (distSqA > REVEAL_RADIUS_SQ) continue;
        var distA = Math.sqrt(distSqA);
        var alphaA = 1 - (distA / REVEAL_RADIUS);
        for (var j = i + 1; j < revealParticles.length; j++) {
          var b = revealParticles[j];
          var dxB = b.x - spx, dyB = b.y - spy;
          var distSqB = dxB * dxB + dyB * dyB;
          if (distSqB > REVEAL_RADIUS_SQ) continue;
          var dxAB = a.x - b.x, dyAB = a.y - b.y;
          var distSqAB = dxAB * dxAB + dyAB * dyAB;
          if (distSqAB > REVEAL_MAX_CONNECTION_DIST_SQ) continue;
          var distB = Math.sqrt(distSqB), distAB = Math.sqrt(distSqAB);
          var alphaB = 1 - (distB / REVEAL_RADIUS);
          var lineFade = 1 - (distAB / REVEAL_MAX_CONNECTION_DIST);
          ctx.globalAlpha = REVEAL_LINE_OPACITY * alphaA * alphaB * lineFade;
          ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
        }
      }
      ctx.fillStyle = 'rgb(140,160,190)';
      for (var i = 0; i < revealParticles.length; i++) {
        var p = revealParticles[i];
        var dx = p.x - spx, dy = p.y - spy;
        var distSq = dx * dx + dy * dy;
        if (distSq > REVEAL_RADIUS_SQ) continue;
        var proximity = 1 - (Math.sqrt(distSq) / REVEAL_RADIUS);
        ctx.globalAlpha = p.opacity * proximity * REVEAL_OPACITY_BOOST;
        ctx.beginPath(); ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2); ctx.fill();
      }
    }

    // Primary particles
    ctx.fillStyle = 'rgb(180,180,190)';
    for (var i = 0; i < particles.length; i++) {
      var p = particles[i];
      p.x += p.vx * dt; p.y += p.vy * dt;
      var dx = p.x - spx, dy = p.y - spy;
      var distSq = dx * dx + dy * dy;
      if (distSq < POINTER_INFLUENCE_RADIUS_SQ && distSq > 0) {
        var dist = Math.sqrt(distSq);
        var prox = 1 - dist / POINTER_INFLUENCE_RADIUS;
        var force = prox * prox * POINTER_REPULSION_STRENGTH;
        p.x += (dx / dist) * force * 0.04 * dt;
        p.y += (dy / dist) * force * 0.04 * dt;
      }
      if (clickPulse.active && pulseStrength > 0) {
        var cdx = p.x - clickPulse.x, cdy = p.y - clickPulse.y;
        var cdistSq = cdx * cdx + cdy * cdy;
        if (cdistSq < pulseRadiusSq && cdistSq > 0) {
          var cdist = Math.sqrt(cdistSq);
          var pProx = 1 - cdist / pulseRadius;
          var pForce = pProx * pProx * pulseStrength;
          p.x += (cdx / cdist) * pForce * 0.06 * dt;
          p.y += (cdy / cdist) * pForce * 0.06 * dt;
        }
      }
      var recoveryFactor = 1 - Math.pow(1 - RECOVERY_SPEED, dt);
      p.x += (p.homeX - p.x) * recoveryFactor;
      p.y += (p.homeY - p.y) * recoveryFactor;
      if (p.x < -10) p.x = w + 10; if (p.x > w + 10) p.x = -10;
      if (p.y < -10) p.y = h + 10; if (p.y > h + 10) p.y = -10;
      ctx.globalAlpha = p.opacity;
      ctx.beginPath(); ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2); ctx.fill();
    }

    // Connections
    ctx.strokeStyle = 'rgb(180,180,190)'; ctx.lineWidth = 0.5;
    for (var i = 0; i < particles.length; i++) {
      for (var j = i + 1; j < particles.length; j++) {
        var a = particles[i], b = particles[j];
        var dxAB = a.x - b.x, dyAB = a.y - b.y;
        var distSqAB = dxAB * dxAB + dyAB * dyAB;
        if (distSqAB > MAX_CONNECTION_DIST_SQ) continue;
        var distAB = Math.sqrt(distSqAB);
        var lineFade = 1 - (distAB / MAX_CONNECTION_DIST);
        var stress = 1;
        var midX = (a.x + b.x) * 0.5, midY = (a.y + b.y) * 0.5;
        var midDx = midX - spx, midDy = midY - spy;
        var midDistSq = midDx * midDx + midDy * midDy;
        if (midDistSq < POINTER_INFLUENCE_RADIUS_SQ) {
          stress = Math.sqrt(midDistSq) / POINTER_INFLUENCE_RADIUS;
          stress = stress * stress;
        }
        ctx.globalAlpha = LINE_OPACITY * lineFade * stress;
        ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
      }
    }

    // Click pulse ring
    if (clickPulse.active) {
      var elapsed = now - clickPulse.startTime;
      var t = elapsed / CLICK_PULSE_DURATION;
      var ringRadius = 20 + t * POINTER_INFLUENCE_RADIUS * 1.2;
      ctx.strokeStyle = 'rgb(120,150,200)';
      ctx.globalAlpha = 0.15 * (1 - t);
      ctx.lineWidth = 1.5 * (1 - t);
      ctx.beginPath(); ctx.arc(clickPulse.x, clickPulse.y, ringRadius, 0, Math.PI * 2); ctx.stroke();
    }
    ctx.globalAlpha = 1;
  }

  function drawStatic() {
    resize();
    ctx.clearRect(0, 0, cachedW, cachedH);
    ctx.fillStyle = 'rgb(180,180,190)';
    for (var i = 0; i < particles.length; i++) {
      var p = particles[i];
      ctx.globalAlpha = p.opacity * 0.7;
      ctx.beginPath(); ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2); ctx.fill();
    }
    ctx.strokeStyle = 'rgb(180,180,190)'; ctx.lineWidth = 0.5;
    for (var i = 0; i < particles.length; i++) {
      for (var j = i + 1; j < particles.length; j++) {
        var a = particles[i], b = particles[j];
        var dxAB = a.x - b.x, dyAB = a.y - b.y;
        var distSqAB = dxAB * dxAB + dyAB * dyAB;
        if (distSqAB > MAX_CONNECTION_DIST_SQ) continue;
        var distAB = Math.sqrt(distSqAB);
        var lineFade = 1 - (distAB / MAX_CONNECTION_DIST);
        ctx.globalAlpha = LINE_OPACITY * lineFade * 0.7;
        ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
      }
    }
    ctx.globalAlpha = 1;
  }

  function cleanup() {
    if (animationId) { cancelAnimationFrame(animationId); animationId = null; }
    observer.disconnect();
    footer.removeEventListener('mousemove', onPointerMove);
    footer.removeEventListener('mouseleave', onPointerLeave);
    footer.removeEventListener('click', onClick);
    footer.removeEventListener('touchstart', onTouchStart);
    footer.removeEventListener('touchmove', onTouchMove);
    footer.removeEventListener('touchend', onTouchEnd);
    footer.removeEventListener('touchcancel', onTouchEnd);
    document.removeEventListener('visibilitychange', onVisibilityChange);
    window.removeEventListener('resize', debouncedResize);
    motionQuery.removeEventListener('change', onMotionChange);
  }

  function onMotionChange(e) {
    prefersReducedMotion = e.matches;
    if (prefersReducedMotion) {
      if (animationId) { cancelAnimationFrame(animationId); animationId = null; }
      drawStatic();
    } else {
      if (!animationId) { lastTime = 0; animationId = requestAnimationFrame(draw); }
    }
  }
  motionQuery.addEventListener('change', onMotionChange);

  if (prefersReducedMotion) { drawStatic(); } else {
    resize(); lastTime = 0; animationId = requestAnimationFrame(draw);
  }

  var resizeTimeout;
  function debouncedResize() {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(function() { resize(); if (prefersReducedMotion) drawStatic(); }, 150);
  }
  window.addEventListener('resize', debouncedResize, { passive: true });
  window.addEventListener('beforeunload', cleanup);
})();
</script>

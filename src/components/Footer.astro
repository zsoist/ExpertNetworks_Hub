        <!-- Column 3: Research Standards -->
        <div>
          <h4 class="footer-heading">Research Standards</h4>
          <nav class="flex flex-col gap-0.5" aria-label="Research standards links">
            <a href="/sources" class="footer-link">Sources &amp; Methodology</a>

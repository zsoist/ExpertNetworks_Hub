---
import { getCollection } from 'astro:content';

const { pathname = '/' } = Astro.props;

const allNetworks = await getCollection('networks');
const publishedNetworks = allNetworks.filter(n => n.data.published);
const top10 = [...publishedNetworks]
  .sort((a, b) => a.data.priority - b.data.priority)
  .slice(0, 10);

// Determine page type for contextual sidebar blocks
const pageType = pathname === '/' ? 'home'
  : pathname.startsWith('/compare') ? 'compare'
  : pathname.startsWith('/networks/') && pathname !== '/networks/' ? 'profile'
  : pathname === '/networks/' || pathname === '/networks' ? 'directory'
  : pathname.startsWith('/news') ? 'news'
  : 'default';

// Active path matching
function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}

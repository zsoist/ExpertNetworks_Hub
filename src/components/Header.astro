          <svg class="w-3 h-3 ml-auto flex-shrink-0 opacity-30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
        <a href="/expert-networks-for-private-equity" class="flex items-center gap-2.5 px-3.5 py-2.5 no-underline drawer-provider-item border-t drawer-divider">
          <span class="text-[13px]">Private Equity & Hedge Funds</span>
          <svg class="w-3 h-3 ml-auto flex-shrink-0 opacity-30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
        <a href="/compare?preset=enterprise" class="flex items-center gap-2.5 px-3.5 py-2.5 no-underline drawer-provider-item border-t drawer-divider">
          <span class="text-[13px]">Enterprise Strategy</span>
          <svg class="w-3 h-3 ml-auto flex-shrink-0 opacity-30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
        <a href="/compare?preset=library" class="flex items-center gap-2.5 px-3.5 py-2.5 no-underline drawer-provider-item border-t drawer-divider">
          <span class="text-[13px]">Transcript-Led Research</span>
          <svg class="w-3 h-3 ml-auto flex-shrink-0 opacity-30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
        <a href="/compare?preset=aiResearch" class="flex items-center gap-2.5 px-3.5 py-2.5 no-underline drawer-provider-item border-t drawer-divider">
          <span class="text-[13px]">AI-Forward Research</span>
          <svg class="w-3 h-3 ml-auto flex-shrink-0 opacity-30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
        <a href="/what-is-an-expert-network" class="flex items-center gap-2.5 px-3.5 py-2.5 no-underline drawer-provider-item border-t drawer-divider">
          <span class="text-[13px]">First-Time Buyer</span>
          <svg class="w-3 h-3 ml-auto flex-shrink-0 opacity-30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      </div>
    </div>

    <!-- E. FEATURED PROVIDERS -->
    <div class="mb-5">
      <button id="networksToggle" class="w-full flex items-center justify-between drawer-label px-2 mb-2 cursor-pointer hover:text-white/50 transition-colors">
        <span>Featured Providers</span>
        <svg id="networksChevron" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" class="transition-transform duration-200"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div id="networksList" class="drawer-card overflow-hidden">
        {top10.map((n, i) => (
          <a
            href={`/networks/${n.data.slug}`}
            class:list={[
              'flex items-center gap-2.5 px-3 py-2.5 no-underline drawer-provider-item',
              i > 0 ? 'border-t drawer-divider' : '',
              pathname === `/networks/${n.data.slug}` || pathname === `/networks/${n.data.slug}/` ? 'drawer-nav-active' : '',
            ]}
          >
            {n.data.logo ? (
              <img src={n.data.logo} alt="" width="24" height="24" class="w-6 h-6 rounded-md object-contain flex-shrink-0 bg-white/10" loading="lazy" />
            ) : (
              <div
                class="w-6 h-6 rounded-md flex items-center justify-center text-white font-semibold text-[9px] flex-shrink-0"
                style={`background: linear-gradient(135deg, ${n.data.gradientFrom}, ${n.data.gradientTo})`}
              >
                {n.data.shortName}
              </div>
            )}
            <span class="text-[13px] font-medium truncate">{n.data.name.split(' (')[0]}</span>
            <svg class="w-3 h-3 ml-auto flex-shrink-0 opacity-30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        ))}
      </div>
      <a href="/networks" class="flex items-center gap-1.5 px-2 mt-2 no-underline text-[11px] font-medium drawer-trust-link hover:text-white/60">
        View all {publishedNetworks.length} providers
        <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
    </div>

    <!-- F. CONTEXTUAL BLOCKS -->
    <!-- Homepage context -->
    {pageType === 'home' && (
      <div class="mb-5">
        <div class="drawer-label px-2 mb-2">Quick Actions</div>
        <div class="drawer-card p-3 space-y-2">
          <a href="/compare" class="flex items-center gap-2 px-2.5 py-2 rounded-lg no-underline drawer-nav-item text-[12px] font-medium">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" class="opacity-60"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
            Compare top providers
          </a>
          <a href="/expert-network-pricing" class="flex items-center gap-2 px-2.5 py-2 rounded-lg no-underline drawer-nav-item text-[12px] font-medium">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" class="opacity-60"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
            See pricing benchmarks
          </a>
          <a href="/news" class="flex items-center gap-2 px-2.5 py-2 rounded-lg no-underline drawer-nav-item text-[12px] font-medium">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" class="opacity-60"><path d="M4 22h16a2 2 0 002-2V4a2 2 0 00-2-2H8a2 2 0 00-2 2v16a2 2 0 01-2 2zm0 0a2 2 0 01-2-2v-9c0-1.1.9-2 2-2h2"/></svg>
            Latest intelligence
          </a>
        </div>
      </div>
    )}

    <!-- Compare page context -->
    {pageType === 'compare' && (
      <div class="mb-5">
        <div class="drawer-label px-2 mb-2">Compare Presets</div>
        <div class="drawer-card overflow-hidden">
          <a href="/compare?preset=leaders" class="flex items-center gap-2.5 px-3.5 py-2.5 no-underline drawer-provider-item text-[12px]">Global Leaders</a>
          <a href="/compare?preset=pe" class="flex items-center gap-2.5 px-3.5 py-2.5 no-underline drawer-provider-item border-t drawer-divider text-[12px]">PE / Hedge Funds</a>
          <a href="/compare?preset=consulting" class="flex items-center gap-2.5 px-3.5 py-2.5 no-underline drawer-provider-item border-t drawer-divider text-[12px]">Consulting Fit</a>
          <a href="/compare?preset=library" class="flex items-center gap-2.5 px-3.5 py-2.5 no-underline drawer-provider-item border-t drawer-divider text-[12px]">Transcript Leaders</a>
          <a href="/compare?preset=aiResearch" class="flex items-center gap-2.5 px-3.5 py-2.5 no-underline drawer-provider-item border-t drawer-divider text-[12px]">AI Research</a>
          <a href="/compare?preset=asia" class="flex items-center gap-2.5 px-3.5 py-2.5 no-underline drawer-provider-item border-t drawer-divider text-[12px]">APAC Specialists</a>
        </div>
      </div>
    )}

    <!-- Profile page context -->
    {pageType === 'profile' && (
      <div class="mb-5">
        <div class="drawer-label px-2 mb-2">On This Page</div>
        <div class="drawer-card p-3 space-y-1" id="drawerProfileToc">
          <div class="text-[11px] text-white/40 italic">Loading page sections...</div>
        </div>
      </div>
    )}

    <!-- G. TRUST FOOTER -->
    <div class="pt-3 border-t drawer-divider">
      <div class="flex flex-wrap gap-x-4 gap-y-1.5 px-1">
        <a href="/about" class="no-underline text-[11px] drawer-trust-link">About</a>
        <a href="/sources" class="no-underline text-[11px] drawer-trust-link">Sources</a>
        <a href="/verification" class="no-underline text-[11px] drawer-trust-link">Verification</a>
        <a href="/disclaimer" class="no-underline text-[11px] drawer-trust-link">Disclaimer</a>
        <a href="/privacy" class="no-underline text-[11px] drawer-trust-link">Privacy</a>
      </div>
      <div class="mt-3 px-1 text-[10px] text-white/20">
        Independent research. No paid placements.
      </div>
    </div>
  </div>
</aside>

<!-- Search overlay -->
<div id="searchOverlay" class="fixed inset-0 z-[200] hidden">
  <div id="searchBackdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>
  <div class="relative max-w-xl mx-auto mt-[8vh] sm:mt-[15vh] px-4">
    <div class="bg-white rounded-2xl shadow-2xl overflow-hidden border border-border/40">
      <div class="flex items-center gap-3 px-4 py-3 border-b border-border/40">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" class="text-tertiary flex-shrink-0" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input
          id="headerSearchInput"
          type="text"
          placeholder="Search networks by name..."
          aria-label="Search networks by name"
          class="flex-1 bg-transparent border-none outline-none text-[15px] text-primary placeholder:text-tertiary"
          autocomplete="off"
        />
        <kbd class="bg-bg-secondary px-2 py-0.5 rounded text-xs text-tertiary border border-border">Esc</kbd>
      </div>
      <div id="searchResults" class="max-h-[50vh] overflow-y-auto">
        <div id="searchEmpty" class="px-4 py-8 text-center text-sm text-tertiary">Type to search across {publishedNetworks.length} networks</div>
        <div id="searchList" class="hidden"></div>
        <div id="searchNoMatch" class="hidden px-4 py-8 text-center text-sm text-tertiary">No networks found</div>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ searchNetworks: publishedNetworks.map(n => ({ slug: n.data.slug, name: n.data.name.split(' (')[0], logo: n.data.logo || null, shortName: n.data.shortName, gradientFrom: n.data.gradientFrom, gradientTo: n.data.gradientTo, expertCount: n.data.expertCount, pricingModel: n.data.pricingModel })) }}>
  // Search functionality
  const searchTrigger = document.getElementById('searchTrigger');
  const drawerSearchBtn = document.getElementById('drawerSearchBtn');
  const searchOverlay = document.getElementById('searchOverlay');
  const searchBackdrop = document.getElementById('searchBackdrop');
  const searchInput = document.getElementById('headerSearchInput');
  const searchList = document.getElementById('searchList');
  const searchEmpty = document.getElementById('searchEmpty');
  const searchNoMatch = document.getElementById('searchNoMatch');

  let overlayCount = 0;
  let savedScrollY = 0;
  function lockScroll() {
    if (overlayCount === 0) {
      savedScrollY = window.scrollY;
      document.body.classList.add('overlay-open');
      document.body.style.top = `-${savedScrollY}px`;
    }
    overlayCount++;
  }
  function unlockScroll() {
    overlayCount = Math.max(0, overlayCount - 1);
    if (overlayCount === 0) {
      document.body.classList.remove('overlay-open');
      document.body.style.top = '';
      window.scrollTo(0, savedScrollY);
    }
  }
  function forceUnlockScroll() {
    overlayCount = 0;
    document.body.classList.remove('overlay-open');
    document.body.style.top = '';
    window.scrollTo(0, savedScrollY);
  }

  let searchIsOpen = false;
  let menuIsOpen = false;

  function openSearch() {
    if (searchIsOpen) return;
    if (menuIsOpen) closeMenu();
    searchIsOpen = true;
    searchOverlay?.classList.remove('hidden');
    lockScroll();
    setTimeout(() => searchInput?.focus(), 100);
  }

  function closeSearch() {
    if (!searchIsOpen) return;
    searchIsOpen = false;
    searchOverlay?.classList.add('hidden');
    if (searchInput) searchInput.value = '';
    searchList?.classList.add('hidden');
    searchEmpty?.classList.remove('hidden');
    searchNoMatch?.classList.add('hidden');
    unlockScroll();
  }

  function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  function renderResults(query) {
    if (!query) {
      searchList?.classList.add('hidden');
      searchEmpty?.classList.remove('hidden');
      searchNoMatch?.classList.add('hidden');
      return;
    }
    searchEmpty?.classList.add('hidden');
    const q = query.toLowerCase();
    const matches = searchNetworks.filter(n => n.name.toLowerCase().includes(q));

    if (matches.length === 0) {
      searchList?.classList.add('hidden');
      searchNoMatch?.classList.remove('hidden');
      return;
    }

    searchNoMatch?.classList.add('hidden');
    searchList?.classList.remove('hidden');
    if (searchList) {
      searchList.innerHTML = matches.map(n => {
        const safeName = escapeHtml(n.name);
        const safeShort = escapeHtml(n.shortName);
        const safeSlug = encodeURIComponent(n.slug);
        const safeExperts = escapeHtml(n.expertCount || '');
        const safePricing = escapeHtml(n.pricingModel || '');
        const avatar = n.logo
          ? `<img src="${escapeHtml(n.logo)}" alt="" width="32" height="32" class="w-8 h-8 rounded-lg object-cover flex-shrink-0" loading="lazy" />`
          : `<div class="w-8 h-8 rounded-lg flex items-center justify-center text-white font-semibold text-[10px] flex-shrink-0" style="background:linear-gradient(135deg,${escapeHtml(n.gradientFrom)},${escapeHtml(n.gradientTo)})">${safeShort}</div>`;
        return `<a href="/networks/${safeSlug}" class="flex items-center gap-3 px-4 py-3 hover:bg-bg-secondary transition-colors no-underline text-primary border-b border-bg-secondary last:border-0">
          ${avatar}
          <div class="min-w-0 flex-1">
            <div class="text-[13px] font-semibold">${safeName}</div>
            <div class="text-[11px] text-tertiary">${safeExperts} experts · ${safePricing}</div>
          </div>
          <svg class="w-3.5 h-3.5 flex-shrink-0 text-tertiary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
        </a>`;
      }).join('');
    }
  }

  searchTrigger?.addEventListener('click', openSearch);
  drawerSearchBtn?.addEventListener('click', openSearch);
  searchBackdrop?.addEventListener('click', closeSearch);
  searchInput?.addEventListener('input', (e) => {
    const input = e.target;
    if (input instanceof HTMLInputElement) renderResults(input.value);
  });

  searchList?.addEventListener('click', (e) => {
    const target = e.target;
    if (target instanceof Element && (target instanceof HTMLAnchorElement || target.closest('a'))) {
      closeSearch();
    }
  });

  const menuBtn = document.getElementById('menuBtn');
  const menuBackdrop = document.getElementById('menuBackdrop');
  const menuDrawer = document.getElementById('menuDrawer');
  const menuClose = document.getElementById('menuClose');

  function openMenu() {
    if (menuIsOpen) return;
    menuIsOpen = true;
    menuBackdrop?.classList.remove('hidden');
    requestAnimationFrame(() => {
      menuBackdrop?.classList.add('opacity-100');
      menuBackdrop?.classList.remove('opacity-0');
      menuDrawer?.classList.remove('-translate-x-full');
      menuDrawer?.setAttribute('aria-hidden', 'false');
      menuBtn?.setAttribute('aria-expanded', 'true');
    });
    lockScroll();
    setTimeout(() => {
      const firstLink = menuDrawer?.querySelector('a[href]');
      (firstLink || menuClose)?.focus();
    }, 300);
  }

  function closeMenu() {
    if (!menuIsOpen) return;
    menuIsOpen = false;
    menuBackdrop?.classList.remove('opacity-100');
    menuBackdrop?.classList.add('opacity-0');
    menuDrawer?.classList.add('-translate-x-full');
    menuDrawer?.setAttribute('aria-hidden', 'true');
    menuBtn?.setAttribute('aria-expanded', 'false');
    setTimeout(() => menuBackdrop?.classList.add('hidden'), 300);
    unlockScroll();
  }

  menuBtn?.addEventListener('click', openMenu);
  menuBackdrop?.addEventListener('click', closeMenu);
  menuClose?.addEventListener('click', closeMenu);

  menuDrawer?.addEventListener('click', (e) => {
    const link = e.target instanceof HTMLAnchorElement ? e.target : e.target?.closest?.('a');
    if (link && link.href) {
      closeMenu();
    }
  });

  // Expandable submenu toggles
  function setupToggle(btnId, listId, chevronId, startOpen) {
    const btn = document.getElementById(btnId);
    const list = document.getElementById(listId);
    const chevron = document.getElementById(chevronId);
    if (!btn || !list || !chevron) return;

    let isOpen = startOpen;

    function render() {
      if (isOpen) {
        list.style.maxHeight = list.scrollHeight + 'px';
        list.style.opacity = '1';
        chevron.style.transform = 'rotate(0deg)';
      } else {
        list.style.maxHeight = '0px';
        list.style.opacity = '0';
        chevron.style.transform = 'rotate(-90deg)';
      }
    }

    btn.addEventListener('click', () => {
      isOpen = !isOpen;
      render();
      try { localStorage.setItem('drawer_' + btnId, isOpen ? '1' : '0'); } catch(e) {}
    });

    // Restore from localStorage
    try {
      const saved = localStorage.getItem('drawer_' + btnId);
      if (saved !== null) isOpen = saved === '1';
    } catch(e) {}

    list.style.transition = 'max-height 0.3s ease, opacity 0.2s ease';
    list.style.overflow = 'hidden';
    render();
  }

  setupToggle('networksToggle', 'networksList', 'networksChevron', true);
  setupToggle('pathwaysToggle', 'pathwaysList', 'pathwaysChevron', true);

  // Profile page: populate TOC from page sections
  const drawerToc = document.getElementById('drawerProfileToc');
  if (drawerToc && menuDrawer?.dataset.pageType === 'profile') {
    const tocLinks = document.querySelectorAll('[data-toc-id]');
    if (tocLinks.length > 0) {
      drawerToc.innerHTML = '';
      tocLinks.forEach(el => {
        const id = el.getAttribute('data-toc-id');
        const label = el.getAttribute('data-toc-label') || el.textContent?.trim() || id;
        const a = document.createElement('a');
        a.href = '#' + id;
        a.className = 'flex items-center gap-2 px-2 py-1.5 rounded-md no-underline drawer-nav-item text-[12px]';
        a.textContent = label;
        drawerToc.appendChild(a);
      });
    } else {
      // Fallback: use the page's existing sidebar TOC if present
      const sidebarLinks = document.querySelectorAll('.sidebar-toc a, #profile-toc a[href^="#"], nav[class*="sticky"] a[href^="#"]');
      if (sidebarLinks.length > 0) {
        drawerToc.innerHTML = '';
        sidebarLinks.forEach(el => {
          const a = document.createElement('a');
          a.href = el.getAttribute('href') || '#';
          a.className = 'flex items-center gap-2 px-2 py-1.5 rounded-md no-underline drawer-nav-item text-[12px]';
          a.textContent = el.textContent?.trim() || '';
          drawerToc.appendChild(a);
        });
      }
    }
  }

  // Keyboard shortcuts
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (searchIsOpen) closeSearch();
      else if (menuIsOpen) closeMenu();
    }
    if (e.key === '/' && !searchIsOpen) {
      const tag = document.activeElement?.tagName;
      if (tag !== 'INPUT' && tag !== 'TEXTAREA' && tag !== 'SELECT') {
        e.preventDefault();
        openSearch();
      }
    }
  });
</script>

<style>
  /* ─── Hero animations ─── */
  .about-fade-up {
    transform: translateY(24px);
    transition: opacity 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .about-fade-up.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .about-delay-1 { transition-delay: 0.1s; }
  .about-delay-2 { transition-delay: 0.25s; }
  .about-delay-3 { transition-delay: 0.45s; }
  .about-delay-4 { transition-delay: 0.65s; }

  /* ─── Pulse rings on hero SVG ─── */
  .about-pulse-ring {
    transform-origin: center;
  }
  .about-pulse-1 {
    animation: aboutPulse 4s ease-in-out infinite;
  }
  .about-pulse-2 {
    animation: aboutPulse 4s ease-in-out 2s infinite;
  }
  @keyframes aboutPulse {
    0%, 100% { opacity: 0.15; transform: scale(1); }
    50% { opacity: 0.05; transform: scale(1.3); }
  }

  /* ─── Slow float for hero SVG ─── */
  .about-hero-svg {
    animation: aboutFloat 20s ease-in-out infinite;
  }
  @keyframes aboutFloat {
    0%, 100% { transform: translate(0, 0); }
    25% { transform: translate(-8px, 6px); }
    50% { transform: translate(4px, -8px); }
    75% { transform: translate(-4px, 4px); }
  }

  /* ─── Reduced motion ─── */
  @media (prefers-reduced-motion: reduce) {
    .about-fade-up {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .about-pulse-ring,
    .about-hero-svg {
      animation: none;
    }
  }
</style>

<script>
// ─── Hero fade-up reveal ───
(function() {
  var items = document.querySelectorAll('.about-fade-up');
  if (!items.length) return;

  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    items.forEach(function(el) { el.classList.add('is-visible'); });
    return;
  }

  // Small delay to allow the page to paint first
  setTimeout(function() {
    items.forEach(function(el) { el.classList.add('is-visible'); });
  }, 100);
})();
</script>

<!-- Nav dark mode — same pattern as ParticleHero -->
<script>
(function() {
  var nav = document.querySelector('nav');
  var heroSection = document.getElementById('aboutHero');
  if (!nav || !heroSection) return;

  var brandLink = nav.querySelector('a[href="/"]');
  var menuBtn = nav.querySelector('#menuBtn');
  var navLinks = nav.querySelectorAll('ul a');
  var searchBtn = nav.querySelector('#searchTrigger');
  var linkedinLink = nav.querySelector('a[aria-label="LinkedIn"]');

  var isDark = false;

  function setDarkNav() {
    if (isDark) return;
    isDark = true;
    nav.style.background = 'rgba(10,10,12,0.85)';
    nav.style.borderBottomColor = 'rgba(255,255,255,0.06)';
    if (brandLink) { brandLink.style.color = '#fff'; }
    if (menuBtn) { menuBtn.style.color = '#a1a1a6'; }
    navLinks.forEach(function(l) { l.style.color = '#a1a1a6'; });
    if (searchBtn) { searchBtn.style.background = 'rgba(255,255,255,0.08)'; searchBtn.style.color = '#a1a1a6'; }
    if (linkedinLink) { linkedinLink.style.color = '#a1a1a6'; }
  }

  function setLightNav() {
    if (!isDark) return;
    isDark = false;
    nav.style.background = '';
    nav.style.borderBottomColor = '';
    if (brandLink) { brandLink.style.color = ''; }
    if (menuBtn) { menuBtn.style.color = ''; }
    navLinks.forEach(function(l) { l.style.color = ''; });
    if (searchBtn) { searchBtn.style.background = ''; searchBtn.style.color = ''; }
    if (linkedinLink) { linkedinLink.style.color = ''; }
  }

  // Since the entire about page is dark, keep nav dark always
  setDarkNav();

  // But watch scroll in case we ever add a light section
  function check() {
    var heroBottom = heroSection.getBoundingClientRect().bottom;
    // Keep dark nav for the full dark page
    setDarkNav();
  }

  window.addEventListener('scroll', check, { passive: true });
})();
</script>

  .ev-verified { background: #30D158; }
  .ev-stated { background: #0071E3; }
  .ev-inferred { background: #FF9F0A; }
  .ev-estimated { background: #BF5AF2; }
  .insight-pill { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; background: white; border: 1px solid rgba(210,210,215,0.4); border-radius: 10px; font-size: 12px; color: #1D1D1F; white-space: nowrap; }
  .insight-pill .pill-label { color: #86868B; font-weight: 500; }
  .insight-pill .pill-value { font-weight: 600; }

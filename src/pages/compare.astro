---
import BaseLayout from '../layouts/BaseLayout.astro';
import ParticleHero from '../components/ParticleHero.astro';
import { getCollection } from 'astro:content';
import compareConfig from '../content/compare.json';
import { buildCompareRender, formatDateLabel, projectCompareNetwork } from '../lib/compare-v2';

const allNetworks = await getCollection('networks');
const published = allNetworks.filter((n) => n.data.published).sort((a, b) => a.data.priority - b.data.priority);

const defaultSlugs = compareConfig.networks as string[];
const presets = compareConfig.presets as Record<string, string[]>;
const sections = compareConfig.sections as any[];
const enriched = (compareConfig as any).enriched as Record<string, any>;
const substituteTypes = (compareConfig as any).substituteTypes as Record<string, string>;
const pathwayGroups = (compareConfig as any).buyerPathwayGroups as any[];
const explainableInsights = (compareConfig as any).explainableInsights as any[];
const contextualDisclaimers = (compareConfig as any).contextualDisclaimers as Record<string, string>;
const comparisonNote = (compareConfig as any).comparisonNote as string;

const networkDataMap = Object.fromEntries(published.map((entry) => [entry.data.slug, projectCompareNetwork(entry.data)]));
const allNetworkList = published.map((entry) => ({
  slug: entry.data.slug,
  name: entry.data.name,
  shortName: entry.data.shortName,
  logo: entry.data.logo || '',
  gradientFrom: entry.data.gradientFrom,
  gradientTo: entry.data.gradientTo,
}));

function shortDisplayName(slug: string): string {
  const data = networkDataMap[slug];
  if (!data) return slug;
  return data.name.split(' (')[0].split(' / ')[0];
}

const defaultLatestReviewed = defaultSlugs
  .map((slug) => networkDataMap[slug]?.lastUpdated)
  .filter(Boolean)
  .sort()
  .at(-1);

const compareClientData = {
  networkDataMap,
  defaultSlugs,
  presets,
  sections,
  enriched,
  substituteTypes,
  explainableInsights,
  comparisonNote,
};

const initialRender = buildCompareRender(defaultSlugs, compareClientData);
const defaultDirectoryHref = initialRender.directoryHref;
const compareClientJson = JSON.stringify(compareClientData).replaceAll('<', '\\u003c');
---

<BaseLayout
  title="Compare Expert Networks: buyer guide and evidence matrix | ExpertNetworks.net"
  description="Compare expert networks and adjacent research platforms by workflow fit, AI maturity, compliance posture, commercial model, and geographic strength."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://expertnetworks.net/' },
      { '@type': 'ListItem', position: 2, name: 'Compare Networks', item: 'https://expertnetworks.net/compare/' },
    ],
  }}
>
  <ParticleHero minHeight="230px">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl">
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="compare-hero-badge">Independent research</span>
          <span class="compare-hero-badge">Public-source methodology</span>
          <span class="compare-hero-badge" id="selectionReviewedBadge">Selection reviewed: {formatDateLabel(defaultLatestReviewed)}</span>
        </div>
        <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight text-white">Compare Expert Networks</h1>
        <p class="text-[#b4b4bc] text-sm md:text-base mt-3 max-w-2xl leading-relaxed">
          Compare expert networks and adjacent research platforms by workflow fit, AI maturity, compliance posture, commercial model, and geographic strength.
        </p>
      </div>
      <div class="flex flex-wrap gap-3" style="pointer-events: auto;">
        <a href="/sources" class="compare-hero-link">Methodology</a>
        <a href="/disclaimer" class="compare-hero-link">Disclaimer</a>
        <a id="heroDirectoryBtn" href={defaultDirectoryHref} class="compare-hero-primary">&larr; Directory</a>
      </div>
    </div>
  </ParticleHero>

  <section class="px-4 md:px-6 pt-5">
    <div class="max-w-site mx-auto">
      <div class="rounded-2xl border border-amber-200/70 bg-amber-50 px-4 py-4 md:px-5 md:py-4">
        <div class="flex items-start gap-3">
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-amber-100 text-amber-700">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
          </div>
          <div class="min-w-0">
            <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-amber-800">Comparison note</div>
            <p class="mt-1 text-[13px] text-amber-900 leading-relaxed">{comparisonNote}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div id="controlBar" class="sticky top-[52px] z-40 bg-white/95 backdrop-blur border-b border-border/40 shadow-sm">
    <div class="max-w-site mx-auto px-4 md:px-6 py-3">
      <div class="flex flex-col gap-3">
        <div class="flex items-center gap-2 overflow-x-auto scrollbar-none pb-1">
          <span class="text-[10px] font-bold uppercase tracking-[0.18em] text-tertiary whitespace-nowrap mr-1">Comparing</span>
          <div id="providerChips" class="flex items-center gap-1.5" set:html={initialRender.chipsHtml}></div>
          <button id="addNetworkBtn" class="inline-flex items-center gap-1 px-2.5 py-1 text-[12px] font-medium text-accent bg-accent/[0.07] rounded-xl border border-accent/20 hover:bg-accent/[0.1] transition-colors cursor-pointer whitespace-nowrap">
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Add
          </button>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex flex-wrap items-center gap-2 text-[11px] text-secondary">
            <label class="inline-flex items-center gap-1.5 cursor-pointer rounded-full bg-[#f5f5f7] px-2.5 py-1.5 border border-border/40">
              <input type="checkbox" id="diffToggle" class="rounded border-border/60 text-accent focus:ring-accent/30" />
              Differences only
            </label>
            <label class="inline-flex items-center gap-1.5 cursor-pointer rounded-full bg-[#f5f5f7] px-2.5 py-1.5 border border-border/40">
              <input type="checkbox" id="highConfidenceToggle" class="rounded border-border/60 text-accent focus:ring-accent/30" />
              High-confidence rows
            </label>
            <label class="inline-flex items-center gap-1.5 cursor-pointer rounded-full bg-[#f5f5f7] px-2.5 py-1.5 border border-border/40">
              <input type="checkbox" id="notesToggle" class="rounded border-border/60 text-accent focus:ring-accent/30" />
              Evidence notes
            </label>
          </div>

          <div class="flex items-center gap-2 overflow-x-auto scrollbar-none text-[10px] text-tertiary">
            <span class="inline-flex items-center gap-1"><span class="ev-dot ev-verified"></span>Verified</span>
            <span class="inline-flex items-center gap-1"><span class="ev-dot ev-stated"></span>Company-stated</span>
            <span class="inline-flex items-center gap-1"><span class="ev-dot ev-inferred"></span>Inferred</span>
            <span class="inline-flex items-center gap-1"><span class="ev-dot ev-estimated"></span>Estimated</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div id="addNetworkModal" class="fixed inset-0 z-[200] hidden">
    <div class="absolute inset-0 bg-black/45 backdrop-blur-sm" id="modalBackdrop"></div>
    <div class="absolute top-1/2 left-1/2 w-full max-w-md -translate-x-1/2 -translate-y-1/2 overflow-hidden rounded-3xl bg-white shadow-2xl">
      <div class="border-b border-border/30 px-5 pb-4 pt-5">
        <div class="flex items-center justify-between">
          <h3 class="text-[15px] font-semibold text-primary">Add provider to comparison</h3>
          <button id="closeModal" class="rounded-full p-1 text-tertiary hover:bg-[#f5f5f7] hover:text-primary transition-colors bg-transparent border-none cursor-pointer" aria-label="Close">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
          </button>
        </div>
        <input id="networkSearch" type="text" placeholder="Search providers..." class="mt-3 w-full rounded-xl border border-border/30 bg-[#f5f5f7] px-3 py-2 text-[13px] text-primary focus:outline-none focus:ring-2 focus:ring-accent/25" />
      </div>
      <div id="networkPickerList" class="max-h-80 overflow-y-auto p-2">
        {allNetworkList.map((network) => (
          <button class="network-pick-btn flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-left hover:bg-[#f5f5f7] transition-colors bg-transparent border-none cursor-pointer" data-slug={network.slug} data-name={network.name.toLowerCase()}>
            {network.logo ? (
              <img src={network.logo} alt="" width="24" height="24" class="w-6 h-6 rounded-lg object-contain flex-shrink-0" loading="lazy" />
            ) : (
              <div class="w-6 h-6 rounded-lg flex items-center justify-center text-white text-[8px] font-bold flex-shrink-0" style={`background: linear-gradient(135deg, ${network.gradientFrom}, ${network.gradientTo})`}>{network.shortName}</div>
            )}
            <span class="text-[13px] font-medium text-primary">{network.name}</span>
          </button>
        ))}
      </div>
    </div>
  </div>

  <div id="sectionNav" class="hidden lg:block sticky top-[141px] z-30 bg-white/90 backdrop-blur border-b border-border/20">
    <div class="max-w-site mx-auto px-6 py-1.5 flex items-center gap-1 overflow-x-auto scrollbar-none">
      <a href="#buyerPathways" class="section-anchor-link" data-section="buyerPathways">Pathways</a>
      <a href="#recommendationSummarySection" class="section-anchor-link" data-section="recommendationSummarySection">Summary</a>
      <a href="#providerSnapshot" class="section-anchor-link" data-section="providerSnapshot">Snapshot</a>
      <a href="#criticalDifferences" class="section-anchor-link" data-section="criticalDifferences">Critical Differences</a>
      <a href="#aiIntelligence" class="section-anchor-link" data-section="aiIntelligence">AI Intelligence</a>
      <a href="#commercialCompliance" class="section-anchor-link" data-section="commercialCompliance">Commercial + Compliance</a>
      <a href="#fullMatrix" class="section-anchor-link" data-section="fullMatrix">Full Matrix</a>
      <a href="#methodology" class="section-anchor-link" data-section="methodology">Methodology</a>
    </div>
  </div>

  <section id="buyerPathways" class="py-8 px-4 md:px-6">
    <div class="max-w-site mx-auto">
      <div class="max-w-2xl">
        <div class="section-eyebrow">Buyer Pathway</div>
        <h2 class="section-title">What are you trying to optimize?</h2>
        <p class="section-copy">
          Use a buyer pathway to load a shorter, more relevant compare set. These are editorial shortcuts, not hard rankings.
        </p>
      </div>

      <div class="mt-6 space-y-6">
        {pathwayGroups.map((group) => (
          <div>
            <div class="mb-3 flex items-center justify-between gap-3">
              <h3 class="text-[12px] font-bold uppercase tracking-[0.18em] text-tertiary">{group.label}</h3>
              <span class="text-[11px] text-tertiary">{group.items.length} pathways</span>
            </div>
            <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
              {group.items.map((item: any) => (
                <button
                  class="pathway-card rounded-2xl border border-border/40 bg-white p-4 text-left shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md"
                  data-pathway={item.id}
                  data-preset={item.preset}
                  type="button"
                >
                  <div class="flex items-start justify-between gap-3">
                    <div>
                      <div class="text-[10px] font-bold uppercase tracking-[0.18em] text-tertiary">{group.label}</div>
                      <h4 class="mt-1 text-[15px] font-semibold text-primary">{item.label}</h4>
                    </div>
                    <span class="confidence-chip" data-confidence={item.confidence}>{item.confidence}</span>
                  </div>
                  <p class="mt-3 text-[12px] leading-relaxed text-secondary">{item.reason}</p>
                  <div class="mt-3 flex flex-wrap gap-1.5">
                    {item.providers.map((slug: string) => (
                      <span class="inline-flex items-center rounded-full bg-[#f5f5f7] px-2 py-1 text-[10px] font-medium text-primary">{shortDisplayName(slug)}</span>
                    ))}
                  </div>
                  <p class="mt-3 text-[11px] leading-relaxed text-tertiary">{item.caveat}</p>
                </button>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="recommendationSummarySection" class="border-t border-border/20 bg-[#fafafa] py-8 px-4 md:px-6">
    <div class="max-w-site mx-auto">
      <div class="max-w-2xl">
        <div class="section-eyebrow">Recommendation Summary</div>
        <h2 class="section-title">What should I choose?</h2>
        <p class="section-copy">
          The summary below updates with your current selection. It is designed to surface the most decision-relevant fit signals first.
        </p>
      </div>
      <noscript>
        <p class="mt-4 rounded-2xl border border-border/40 bg-white p-4 text-[13px] text-secondary">JavaScript is required for the interactive recommendation summary and matrix filters on this page.</p>
      </noscript>
      <div id="decisionSummaryCards" class="mt-6 grid gap-3 lg:grid-cols-4" set:html={initialRender.decisionSummaryHtml}></div>
      <div id="decisionSummaryCaution" class="mt-4" set:html={initialRender.decisionSummaryCautionHtml}></div>
    </div>
  </section>

  <section id="explainableInsightsSection" class="border-t border-border/20 py-8 px-4 md:px-6">
    <div class="max-w-site mx-auto">
      <div class="max-w-2xl">
        <div class="section-eyebrow">Explainable Insights</div>
        <h2 class="section-title">Editorial conclusions with criteria, evidence, and caveats</h2>
        <p class="section-copy">
          Each insight calls out what drove the conclusion, how strong the public evidence is, and where comparability is only partial.
        </p>
      </div>
      <div id="explainableInsights" class="mt-6 grid gap-3 lg:grid-cols-2" set:html={initialRender.explainableInsightsHtml}></div>
    </div>
  </section>

  <section id="providerSnapshot" class="border-t border-border/20 bg-[#fafafa] py-8 px-4 md:px-6">
    <div class="max-w-site mx-auto">
      <div class="max-w-2xl">
        <div class="section-eyebrow">Compared Providers Snapshot</div>
        <h2 class="section-title">Sharper positioning, caveats, and substitute context</h2>
        <p class="section-copy">
          These cards are intentionally decisive: best fit, not ideal for, closest alternatives, and confidence all sit above the deeper evidence table.
        </p>
      </div>

      <div id="providerSnapshotCards" class="mt-6 grid gap-4 lg:grid-cols-2 xl:grid-cols-3" set:html={initialRender.providerCardsHtml}></div>

      <div class="mt-6 rounded-3xl border border-border/30 bg-white p-4 shadow-sm">
        <div class="mb-3 flex items-center justify-between gap-3">
          <div>
            <div class="text-[10px] font-bold uppercase tracking-[0.18em] text-tertiary">Layer A</div>
            <h3 class="text-[15px] font-semibold text-primary">Compact decision snapshot</h3>
          </div>
          <span class="text-[11px] text-tertiary">High-signal fields only</span>
        </div>
        <div id="snapshotTable" set:html={initialRender.snapshotTableHtml}></div>
      </div>
    </div>
  </section>

  <section id="criticalDifferences" class="border-t border-border/20 py-8 px-4 md:px-6">
    <div class="max-w-site mx-auto">
      <div class="max-w-2xl">
        <div class="section-eyebrow">Layer B</div>
        <h2 class="section-title">Critical differences for actual buying decisions</h2>
        <p class="section-copy">
          This layer prioritizes the rows most likely to change a shortlist: call strength, reusable content, AI posture, pricing structure, geography, and compliance.
        </p>
      </div>

      <div id="pinnedDifferences" class="mt-6 grid gap-3 lg:grid-cols-5" set:html={initialRender.pinnedDifferencesHtml}></div>

      <div class="mt-6 rounded-3xl border border-border/30 bg-white p-4 shadow-sm">
        <div class="mb-3 flex items-center justify-between gap-3">
          <div>
            <div class="text-[10px] font-bold uppercase tracking-[0.18em] text-tertiary">Decision table</div>
            <h3 class="text-[15px] font-semibold text-primary">Importance-sorted deltas</h3>
          </div>
          <span class="text-[11px] text-tertiary">Major, moderate, and minor differences</span>
        </div>
        <div id="criticalDifferencesTable" set:html={initialRender.criticalDifferencesHtml}></div>
      </div>
    </div>
  </section>

  <section id="aiIntelligence" class="border-t border-border/20 bg-[#fafafa] py-8 px-4 md:px-6">
    <div class="max-w-site mx-auto">
      <div class="max-w-2xl">
        <div class="section-eyebrow">AI & Workflow Intelligence</div>
        <h2 class="section-title">Stricter AI taxonomy, less hype, clearer caveats</h2>
        <p class="section-copy">
          AI comparisons here distinguish sourcing, content interrogation, workflow automation, compliance, and primary-research capture. Public visibility is not treated as proof of production maturity.
        </p>
      </div>

      <div class="mt-5 rounded-2xl border border-blue-200/60 bg-blue-50 px-4 py-4 text-[12px] text-blue-900 leading-relaxed">
        <strong class="font-semibold">AI caveat:</strong> {contextualDisclaimers.ai}
      </div>

      <div id="aiTaxonomyGrid" class="mt-6 grid gap-4 xl:grid-cols-2" set:html={initialRender.aiTaxonomyHtml}></div>
    </div>
  </section>

  <section id="commercialCompliance" class="border-t border-border/20 py-8 px-4 md:px-6">
    <div class="max-w-site mx-auto">
      <div class="max-w-2xl">
        <div class="section-eyebrow">Commercial + Compliance</div>
        <h2 class="section-title">Contract reality, scale caveats, and governance posture</h2>
        <p class="section-copy">
          These sections stay concise by default because many claims in pricing, scale, and compliance are directionally useful rather than perfectly standardized.
        </p>
      </div>

      <div class="mt-6 grid gap-4 xl:grid-cols-2">
        <div class="rounded-3xl border border-border/30 bg-white p-4 shadow-sm">
          <div class="flex items-center justify-between gap-3">
            <div>
              <div class="text-[10px] font-bold uppercase tracking-[0.18em] text-tertiary">Commercial model</div>
              <h3 class="text-[15px] font-semibold text-primary">Pricing, geography, and scale</h3>
            </div>
            <span class="info-chip">Indicative only</span>
          </div>
          <div class="mt-3 space-y-3">
            <p class="rounded-2xl border border-amber-200/60 bg-amber-50 px-3 py-3 text-[11px] leading-relaxed text-amber-900">{contextualDisclaimers.pricing}</p>
            <p class="rounded-2xl border border-slate-200/60 bg-slate-50 px-3 py-3 text-[11px] leading-relaxed text-slate-700">{contextualDisclaimers.scale}</p>
          </div>
          <div id="commercialTable" class="mt-4" set:html={initialRender.commercialTableHtml}></div>
        </div>

        <div class="rounded-3xl border border-border/30 bg-white p-4 shadow-sm">
          <div class="flex items-center justify-between gap-3">
            <div>
              <div class="text-[10px] font-bold uppercase tracking-[0.18em] text-tertiary">Compliance posture</div>
              <h3 class="text-[15px] font-semibold text-primary">Governance and control signals</h3>
            </div>
            <span class="info-chip">Needs diligence</span>
          </div>
          <p class="mt-3 rounded-2xl border border-emerald-200/60 bg-emerald-50 px-3 py-3 text-[11px] leading-relaxed text-emerald-900">{contextualDisclaimers.compliance}</p>
          <div id="complianceTable" class="mt-4" set:html={initialRender.complianceTableHtml}></div>
        </div>
      </div>
    </div>
  </section>

  <section id="fullMatrix" class="border-t border-border/20 bg-[#fafafa] py-8 px-4 md:px-6">
    <div class="max-w-site mx-auto">
      <div class="max-w-2xl">
        <div class="section-eyebrow">Layer C</div>
        <h2 class="section-title">Full evidence matrix</h2>
        <p class="section-copy">
          The full table is still here for power users. It stays collapsed by default so the page behaves like a decision tool first and a raw evidence slab second.
        </p>
      </div>

      <details id="fullMatrixDetails" class="mt-6 rounded-3xl border border-border/30 bg-white shadow-sm" open={false}>
        <summary class="list-none cursor-pointer px-5 py-4 flex items-center justify-between gap-3">
          <div>
            <div class="text-[10px] font-bold uppercase tracking-[0.18em] text-tertiary">Full comparison</div>
            <div class="text-[15px] font-semibold text-primary">Show full matrix</div>
          </div>
          <span class="summary-pill">29 tracked fields</span>
        </summary>
        <div class="border-t border-border/20 px-4 pb-4 pt-4 md:px-5">
          <div id="matrixHiddenSummary" class="mb-4" set:html={initialRender.fullMatrixSummaryHtml}></div>
          <div id="fullMatrixContent" set:html={initialRender.fullMatrixContentHtml}></div>
        </div>
      </details>
    </div>
  </section>

  <section id="methodology" class="border-t border-border/20 py-8 px-4 md:px-6">
    <div class="max-w-site mx-auto">
      <div class="grid gap-4 xl:grid-cols-[1.3fr_1fr]">
        <div class="rounded-3xl border border-border/30 bg-white p-5 shadow-sm">
          <div class="section-eyebrow">Methodology</div>
          <h2 class="text-[20px] font-semibold text-primary">What this page does and does not claim</h2>
          <p class="mt-3 text-[13px] leading-relaxed text-secondary">
            This project compares public-facing evidence, company materials, and editorial synthesis. It does not claim private product access, confidential pricing data, or perfect apples-to-apples comparability where the underlying services are structurally different.
          </p>
          <div class="mt-5 grid gap-3 md:grid-cols-2">
            <div class="rounded-2xl border border-border/30 bg-[#fafafa] p-4">
              <div class="text-[11px] font-semibold text-primary">Evidence provenance</div>
              <div class="mt-3 flex flex-wrap gap-2 text-[11px] text-secondary">
                <span class="inline-flex items-center gap-1 rounded-full bg-white px-2 py-1 border border-border/30"><span class="ev-dot ev-verified"></span>Verified</span>
                <span class="inline-flex items-center gap-1 rounded-full bg-white px-2 py-1 border border-border/30"><span class="ev-dot ev-stated"></span>Company-stated</span>
                <span class="inline-flex items-center gap-1 rounded-full bg-white px-2 py-1 border border-border/30"><span class="ev-dot ev-inferred"></span>Inferred</span>
                <span class="inline-flex items-center gap-1 rounded-full bg-white px-2 py-1 border border-border/30"><span class="ev-dot ev-estimated"></span>Estimated</span>
              </div>
            </div>
            <div class="rounded-2xl border border-border/30 bg-[#fafafa] p-4">
              <div class="text-[11px] font-semibold text-primary">AI maturity language</div>
              <div class="mt-3 flex flex-wrap gap-2 text-[11px] text-secondary">
                <span class="inline-flex items-center rounded-full bg-white px-2 py-1 border border-border/30">Publicly documented</span>
                <span class="inline-flex items-center rounded-full bg-white px-2 py-1 border border-border/30">Publicly indicated</span>
                <span class="inline-flex items-center rounded-full bg-white px-2 py-1 border border-border/30">Limited public evidence</span>
                <span class="inline-flex items-center rounded-full bg-white px-2 py-1 border border-border/30">Not publicly clear</span>
              </div>
            </div>
          </div>
          <div class="mt-5 flex flex-wrap gap-3">

---
import BaseLayout from '../layouts/BaseLayout.astro';
import ParticleHero from '../components/ParticleHero.astro';
import { getCollection } from 'astro:content';
import compareConfig from '../content/compare.json';
import { buildCompareRender, formatDateLabel, projectCompareNetwork, compareGoals } from '../lib/compare-v2';

const allNetworks = await getCollection('networks');
const published = allNetworks.filter((n) => n.data.published).sort((a, b) => a.data.priority - b.data.priority);

const defaultSlugs = compareConfig.networks as string[];
const presets = compareConfig.presets as Record<string, string[]>;
const sections = compareConfig.sections as any[];
const enriched = (compareConfig as any).enriched as Record<string, any>;
const substituteTypes = (compareConfig as any).substituteTypes as Record<string, string>;
const explainableInsights = (compareConfig as any).explainableInsights as any[];
const contextualDisclaimers = (compareConfig as any).contextualDisclaimers as Record<string, string>;
const comparisonNote = (compareConfig as any).comparisonNote as string;

const networkDataMap = Object.fromEntries(published.map((entry) => [entry.data.slug, projectCompareNetwork(entry.data)]));
const allNetworkList = published.map((entry) => ({
  slug: entry.data.slug,
  name: entry.data.name,
  shortName: entry.data.shortName,
  logo: entry.data.logo || '',
  gradientFrom: entry.data.gradientFrom,
  gradientTo: entry.data.gradientTo,
}));

const defaultLatestReviewed = defaultSlugs
  .map((slug) => networkDataMap[slug]?.lastUpdated)
  .filter(Boolean)
  .sort()
  .at(-1);

const compareClientData = {
  networkDataMap,
  defaultSlugs,
  presets,
  sections,
  enriched,
  substituteTypes,
  explainableInsights,
  comparisonNote,
};

const initialRender = buildCompareRender(defaultSlugs, compareClientData);
const defaultDirectoryHref = initialRender.directoryHref;
const compareClientJson = JSON.stringify(compareClientData).replaceAll('<', '\\u003c');
---

<BaseLayout
  title="Compare Expert Networks: buyer guide and evidence matrix | ExpertNetworks.net"
  description="Compare expert networks and adjacent research platforms by workflow fit, AI maturity, compliance posture, commercial model, and geographic strength."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://expertnetworks.net/' },
      { '@type': 'ListItem', position: 2, name: 'Compare Networks', item: 'https://expertnetworks.net/compare/' },
    ],
  }}
>
  <!-- HERO -->
  <ParticleHero minHeight="200px">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl">
        <div class="flex flex-wrap gap-2 mb-3">
          <span class="compare-hero-badge">Independent research</span>
          <span class="compare-hero-badge" id="selectionReviewedBadge">Selection reviewed: {formatDateLabel(defaultLatestReviewed)}</span>
        </div>
        <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight text-white">Compare Expert Networks</h1>
        <p class="text-[#b4b4bc] text-sm mt-2 max-w-xl leading-relaxed">
          Independent comparison by workflow fit, AI maturity, compliance posture, and commercial model.
        </p>
      </div>
      <div class="flex flex-wrap gap-3" style="pointer-events: auto;">
        <a href="/sources" class="compare-hero-link">Methodology</a>
        <a href="/disclaimer" class="compare-hero-link">Disclaimer</a>
        <a id="heroDirectoryBtn" href={defaultDirectoryHref} class="compare-hero-primary">&larr; Directory</a>
      </div>
    </div>
  </ParticleHero>

  <!-- CONTROL BAR -->
  <div id="controlBar" class="sticky top-[52px] z-40 bg-white/95 backdrop-blur border-b border-border/40 shadow-sm">
    <div class="max-w-site mx-auto px-4 md:px-6 py-3">
      <div class="flex flex-col gap-2.5">
        <div class="flex items-center gap-2 overflow-x-auto scrollbar-none pb-1">
          <span class="text-[10px] font-bold uppercase tracking-[0.18em] text-tertiary whitespace-nowrap mr-1">Comparing</span>
          <div id="providerChips" class="flex items-center gap-1.5" set:html={initialRender.chipsHtml}></div>
          <button id="addNetworkBtn" class="inline-flex items-center gap-1 px-2.5 py-1 text-[12px] font-medium text-accent bg-accent/[0.07] rounded-xl border border-accent/20 hover:bg-accent/[0.1] transition-colors cursor-pointer whitespace-nowrap">
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Add
          </button>
        </div>
        <div class="flex flex-wrap items-center gap-2 text-[11px] text-secondary">
          <label class="inline-flex items-center gap-1.5 cursor-pointer rounded-full bg-[#f5f5f7] px-2.5 py-1.5 border border-border/40">
            <input type="checkbox" id="diffToggle" class="rounded border-border/60 text-accent focus:ring-accent/30" />
            Differences only
          </label>
          <label class="inline-flex items-center gap-1.5 cursor-pointer rounded-full bg-[#f5f5f7] px-2.5 py-1.5 border border-border/40">
            <input type="checkbox" id="notesToggle" class="rounded border-border/60 text-accent focus:ring-accent/30" />
            Evidence notes
          </label>
        </div>
      </div>
    </div>
  </div>

  <!-- ADD NETWORK MODAL -->
  <div id="addNetworkModal" class="fixed inset-0 z-[200] hidden">
    <div class="absolute inset-0 bg-black/45 backdrop-blur-sm" id="modalBackdrop"></div>
    <div class="absolute top-1/2 left-1/2 w-full max-w-md -translate-x-1/2 -translate-y-1/2 overflow-hidden rounded-3xl bg-white shadow-2xl">
      <div class="border-b border-border/30 px-5 pb-4 pt-5">
        <div class="flex items-center justify-between">
          <h3 class="text-[15px] font-semibold text-primary">Add provider to comparison</h3>
          <button id="closeModal" class="rounded-full p-1 text-tertiary hover:bg-[#f5f5f7] hover:text-primary transition-colors bg-transparent border-none cursor-pointer" aria-label="Close">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
          </button>
        </div>
        <input id="networkSearch" type="text" placeholder="Search providers..." class="mt-3 w-full rounded-xl border border-border/30 bg-[#f5f5f7] px-3 py-2 text-[13px] text-primary focus:outline-none focus:ring-2 focus:ring-accent/25" />
      </div>
      <div id="networkPickerList" class="max-h-80 overflow-y-auto p-2">
        {allNetworkList.map((network) => (
          <button class="network-pick-btn flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-left hover:bg-[#f5f5f7] transition-colors bg-transparent border-none cursor-pointer" data-slug={network.slug} data-name={network.name.toLowerCase()}>
            {network.logo ? (
              <img src={network.logo} alt="" width="24" height="24" class="w-6 h-6 rounded-lg object-contain flex-shrink-0" loading="lazy" />
            ) : (
              <div class="w-6 h-6 rounded-lg flex items-center justify-center text-white text-[8px] font-bold flex-shrink-0" style={`background: linear-gradient(135deg, ${network.gradientFrom}, ${network.gradientTo})`}>{network.shortName}</div>
            )}
            <span class="text-[13px] font-medium text-primary">{network.name}</span>
          </button>
        ))}
      </div>
    </div>
  </div>

  <!-- SECTION NAV -->
  <div id="sectionNav" class="hidden lg:block sticky top-[128px] z-30 bg-white/90 backdrop-blur border-b border-border/20">
    <div class="max-w-site mx-auto px-6 py-1.5 flex items-center gap-1 overflow-x-auto scrollbar-none">
      <a href="#startHere" class="section-anchor-link" data-section="startHere">Start Here</a>
      <a href="#shortlistDecision" class="section-anchor-link" data-section="shortlistDecision">Shortlist</a>
      <a href="#deepDive" class="section-anchor-link" data-section="deepDive">Deep Dive</a>
      <a href="#methodology" class="section-anchor-link" data-section="methodology">Methodology</a>
    </div>
  </div>

  <!-- ============================================ -->
  <!-- SECTION A: START HERE                        -->
  <!-- ============================================ -->
  <section id="startHere" class="py-8 px-4 md:px-6">
    <div class="max-w-site mx-auto">
      <div class="max-w-2xl">
        <div class="section-eyebrow">Start here</div>
        <h2 class="section-title">What are you trying to find?</h2>
        <p class="section-copy">
          Editorial shortcuts &mdash; not objective rankings. Choosing a goal loads a curated provider set and frames the comparison.
        </p>
      </div>

      <div class="mt-5 flex flex-wrap gap-2" id="goalSelector">
        {compareGoals.map((goal) => (
          <button class="goal-pill" data-goal={goal.id} data-preset={goal.preset} type="button">{goal.label}</button>
        ))}
      </div>

      <div class="mt-5 rounded-xl border border-amber-200/60 bg-amber-50/60 px-4 py-3">
        <p class="text-[12px] leading-relaxed text-amber-900">{comparisonNote}</p>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- SECTION B: SHORTLIST DECISION                -->
  <!-- ============================================ -->
  <section id="shortlistDecision" class="border-t border-border/20 bg-[#fafafa] py-8 px-4 md:px-6">
    <div class="max-w-site mx-auto">
      <!-- Recommendation Summary -->
      <div class="max-w-2xl">
        <div class="section-eyebrow">Shortlist Decision</div>
        <h2 class="section-title">What should I take away?</h2>
        <p class="section-copy">
          If you only spend 30 seconds here, use these recommendations. Each includes evidence rationale and caveats.
        </p>
      </div>
      <noscript>
        <p class="mt-4 rounded-2xl border border-border/40 bg-white p-4 text-[13px] text-secondary">JavaScript is required for the interactive comparison on this page.</p>
      </noscript>
      <div id="recommendationCards" class="mt-6 grid gap-3 md:grid-cols-2 xl:grid-cols-3" set:html={initialRender.recommendationHtml}></div>
      <div id="cautionBanner" class="mt-4" set:html={initialRender.cautionHtml}></div>
    </div>
  </section>

  <!-- Critical Differences -->
  <section class="border-t border-border/20 py-8 px-4 md:px-6">
    <div class="max-w-site mx-auto">
      <div class="max-w-2xl">
        <div class="section-eyebrow">Critical Differences</div>
        <h2 class="section-title">What materially changes the buying decision?</h2>
        <p class="section-copy">
          The six fields most likely to change a shortlist. Toggle "Differences only" above to surface where providers diverge.
        </p>
      </div>

      <div class="mt-6 rounded-3xl border border-border/30 bg-white p-4 shadow-sm">
        <div id="criticalPrimaryTable" set:html={initialRender.criticalPrimaryHtml}></div>
      </div>

      <div id="criticalExpandedWrapper" class="hidden mt-4 rounded-3xl border border-border/30 bg-white p-4 shadow-sm">
        <div class="mb-3 flex items-center justify-between gap-3">
          <h3 class="text-[14px] font-semibold text-primary">Additional buying factors</h3>
          <span class="summary-pill">8 rows</span>
        </div>
        <div id="criticalExpandedTable" set:html={initialRender.criticalExpandedHtml}></div>
      </div>

      <button id="showMoreBtn" type="button" class="mt-4 inline-flex items-center gap-1.5 text-[13px] font-medium text-accent cursor-pointer bg-transparent border-none px-0">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
        Show more buying factors
      </button>
    </div>
  </section>

  <!-- Provider Fit Cards -->
  <section class="border-t border-border/20 bg-[#fafafa] py-8 px-4 md:px-6">
    <div class="max-w-site mx-auto">
      <div class="max-w-2xl">
        <div class="section-eyebrow">Provider Fit</div>
        <h2 class="section-title">When is each provider a strong or weak fit?</h2>
      </div>
      <div id="providerFitCards" class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3" set:html={initialRender.providerCardsHtml}></div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- SECTION C: DEEP DIVE                         -->
  <!-- ============================================ -->
  <section id="deepDive" class="border-t border-border/20 py-8 px-4 md:px-6">
    <div class="max-w-site mx-auto">
      <div class="max-w-2xl mb-6">
        <div class="section-eyebrow">Deep Dive</div>
        <h2 class="section-title">Inspect detail by category</h2>
        <p class="section-copy">For serious buyers who need to inspect AI, commercial, compliance, or the full evidence matrix.</p>
      </div>

      <!-- Tab Bar -->
      <div class="flex gap-1 overflow-x-auto scrollbar-none mb-6 border-b border-border/20 pb-2" id="tabBar">
        <button class="tab-btn is-active" data-tab="ai" type="button">AI & Workflow</button>
        <button class="tab-btn" data-tab="commercial" type="button">Commercial</button>
        <button class="tab-btn" data-tab="compliance" type="button">Compliance</button>
        <button class="tab-btn" data-tab="matrix" type="button">Full Matrix</button>
      </div>

      <!-- AI Tab -->
      <div class="tab-panel" data-tab-panel="ai">
        <div class="rounded-2xl border border-blue-200/60 bg-blue-50 px-4 py-3 text-[12px] text-blue-900 leading-relaxed mb-5">
          <strong class="font-semibold">AI caveat:</strong> {contextualDisclaimers.ai}
        </div>
        <div class="rounded-3xl border border-border/30 bg-white p-4 shadow-sm">
          <div id="aiTabContent" set:html={initialRender.aiTabHtml}></div>
        </div>
      </div>

      <!-- Commercial Tab -->
      <div class="tab-panel hidden" data-tab-panel="commercial">
        <div class="space-y-2 mb-5">
          <div class="rounded-2xl border border-amber-200/60 bg-amber-50 px-4 py-3 text-[12px] leading-relaxed text-amber-900">{contextualDisclaimers.pricing}</div>
          <div class="rounded-2xl border border-slate-200/60 bg-slate-50 px-4 py-3 text-[12px] leading-relaxed text-slate-700">{contextualDisclaimers.scale}</div>
        </div>
        <div class="rounded-3xl border border-border/30 bg-white p-4 shadow-sm">
          <div id="commercialTabContent" set:html={initialRender.commercialTabHtml}></div>
        </div>
      </div>

      <!-- Compliance Tab -->
      <div class="tab-panel hidden" data-tab-panel="compliance">
        <div class="rounded-2xl border border-emerald-200/60 bg-emerald-50 px-4 py-3 text-[12px] leading-relaxed text-emerald-900 mb-5">
          {contextualDisclaimers.compliance}
        </div>
        <div class="rounded-3xl border border-border/30 bg-white p-4 shadow-sm">
          <div id="complianceTabContent" set:html={initialRender.complianceTabHtml}></div>
        </div>
      </div>

      <!-- Full Matrix Tab -->
      <div class="tab-panel hidden" data-tab-panel="matrix">
        <div id="matrixSummary" class="mb-4" set:html={initialRender.fullMatrixSummaryHtml}></div>
        <div id="matrixContent" set:html={initialRender.fullMatrixContentHtml}></div>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- SECTION D: METHODOLOGY                      -->
  <!-- ============================================ -->
  <section id="methodology" class="border-t border-border/20 py-8 px-4 md:px-6">
    <div class="max-w-site mx-auto">
      <details class="rounded-3xl border border-border/30 bg-white shadow-sm">
        <summary class="list-none cursor-pointer px-5 py-4 flex items-center justify-between gap-3">
          <div>
            <div class="section-eyebrow">Methodology</div>
            <div class="text-[17px] font-semibold text-primary mt-1">How are these judgments made?</div>
          </div>
          <svg class="w-5 h-5 text-tertiary meth-chevron transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <div class="border-t border-border/20 px-5 pb-5 pt-4">
          <p class="text-[13px] leading-relaxed text-secondary">
            This project compares public-facing evidence, company materials, and editorial synthesis. It does not claim private product access, confidential pricing data, or perfect apples-to-apples comparability where the underlying services are structurally different.
          </p>
          <div class="mt-5 grid gap-3 md:grid-cols-2">
            <div class="rounded-2xl border border-border/30 bg-[#fafafa] p-4">
              <div class="text-[11px] font-semibold text-primary">Evidence provenance</div>
              <div class="mt-3 flex flex-wrap gap-2 text-[11px] text-secondary">
                <span class="inline-flex items-center gap-1 rounded-full bg-white px-2 py-1 border border-border/30"><span class="ev-dot ev-verified"></span>Verified</span>
                <span class="inline-flex items-center gap-1 rounded-full bg-white px-2 py-1 border border-border/30"><span class="ev-dot ev-stated"></span>Company-stated</span>
                <span class="inline-flex items-center gap-1 rounded-full bg-white px-2 py-1 border border-border/30"><span class="ev-dot ev-inferred"></span>Inferred</span>
                <span class="inline-flex items-center gap-1 rounded-full bg-white px-2 py-1 border border-border/30"><span class="ev-dot ev-estimated"></span>Estimated</span>
              </div>
            </div>
            <div class="rounded-2xl border border-border/30 bg-[#fafafa] p-4">
              <div class="text-[11px] font-semibold text-primary">AI maturity language</div>
              <div class="mt-3 flex flex-wrap gap-2 text-[11px] text-secondary">
                <span class="inline-flex items-center rounded-full bg-white px-2 py-1 border border-border/30">Publicly documented</span>
                <span class="inline-flex items-center rounded-full bg-white px-2 py-1 border border-border/30">Publicly indicated</span>
                <span class="inline-flex items-center rounded-full bg-white px-2 py-1 border border-border/30">Limited public evidence</span>
                <span class="inline-flex items-center rounded-full bg-white px-2 py-1 border border-border/30">Not publicly clear</span>
              </div>
            </div>
          </div>
          <div class="mt-5 grid gap-3 md:grid-cols-2">
            <div class="rounded-2xl border border-amber-200/60 bg-amber-50 px-4 py-3">
              <div class="text-[11px] font-semibold text-amber-900">Pricing</div>
              <p class="mt-1 text-[11px] leading-relaxed text-amber-900">{contextualDisclaimers.pricing}</p>
            </div>
            <div class="rounded-2xl border border-slate-200/60 bg-slate-50 px-4 py-3">
              <div class="text-[11px] font-semibold text-slate-800">Scale</div>
              <p class="mt-1 text-[11px] leading-relaxed text-slate-700">{contextualDisclaimers.scale}</p>
            </div>
            <div class="rounded-2xl border border-blue-200/60 bg-blue-50 px-4 py-3">
              <div class="text-[11px] font-semibold text-blue-900">AI</div>
              <p class="mt-1 text-[11px] leading-relaxed text-blue-900">{contextualDisclaimers.ai}</p>
            </div>
            <div class="rounded-2xl border border-emerald-200/60 bg-emerald-50 px-4 py-3">
              <div class="text-[11px] font-semibold text-emerald-900">Compliance</div>
              <p class="mt-1 text-[11px] leading-relaxed text-emerald-900">{contextualDisclaimers.compliance}</p>
            </div>
          </div>
          <div class="mt-5 flex flex-wrap gap-3">
            <a href="/sources" class="compare-hero-primary">Read methodology</a>
            <a href="/disclaimer" class="compare-hero-link compare-hero-link-light">Read disclaimer</a>
          </div>
        </div>
      </details>
    </div>
  </section>

  <!-- FOOTER CTA -->
  <section class="border-t border-border/20 py-8 px-4 md:px-6">
    <div class="max-w-site mx-auto text-center">
      <h2 class="text-lg font-bold text-primary mb-1.5">Explore further</h2>
      <p class="text-[13px] text-secondary mb-4">Open detailed provider profiles or move back to the broader directory.</p>
      <div class="flex items-center justify-center gap-3 flex-wrap">
        <a id="browseDirectoryBtn" href={defaultDirectoryHref} class="compare-hero-primary">Browse directory</a>
        <a href="/" class="compare-hero-link compare-hero-link-light">&larr; Home</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .scrollbar-none::-webkit-scrollbar { display: none; }
  .scrollbar-none { -ms-overflow-style: none; scrollbar-width: none; }
  .compare-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 10px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.06);
    color: #d6d6dc;
    font-size: 11px;
    font-weight: 600;
  }
  .compare-hero-link,
  .compare-hero-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0 16px;
    border-radius: 14px;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    transition: all 0.2s ease;
  }
  .compare-hero-link {
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.06);
    color: #d6d6dc;
  }
  .compare-hero-link:hover { background: rgba(255, 255, 255, 0.1); }
  .compare-hero-link-light {
    border-color: rgba(210, 210, 215, 0.7);
    background: white;
    color: #1d1d1f;
  }
  .compare-hero-link-light:hover { background: #f5f5f7; }
  .compare-hero-primary {
    background: #0071e3;
    color: white;
  }
  .compare-hero-primary:hover { background: #0064cc; }
  .section-eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #86868b;
  }
  .section-title {
    margin-top: 8px;
    font-size: 28px;
    line-height: 1.15;
    font-weight: 700;
    color: #1d1d1f;
  }
  .section-copy {
    margin-top: 10px;
    font-size: 14px;
    line-height: 1.7;
    color: #4a4a52;
  }

  /* Goal selector */
  .goal-pill {
    display: inline-flex;
    align-items: center;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid rgba(210, 210, 215, 0.55);
    background: white;
    color: #1d1d1f;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .goal-pill:hover {
    border-color: rgba(0, 113, 227, 0.35);
    background: rgba(0, 113, 227, 0.04);
  }
  .goal-pill.is-active {
    border-color: rgba(0, 113, 227, 0.5);
    background: rgba(0, 113, 227, 0.08);
    color: #0071e3;
    font-weight: 600;
  }

  /* Tabs */
  .tab-btn {
    display: inline-flex;
    align-items: center;
    padding: 8px 14px;
    border-radius: 999px;
    border: none;
    background: transparent;
    color: #6e6e73;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }
  .tab-btn:hover {
    color: #1d1d1f;
    background: rgba(245, 245, 247, 0.8);
  }
  .tab-btn.is-active {
    color: #0071e3;
    background: rgba(0, 113, 227, 0.08);
  }

  /* Recommendation details expand */
  .rec-expander summary { list-style: none; }
  .rec-expander summary::-webkit-details-marker { display: none; }
  .rec-expander[open] .rec-chevron { transform: rotate(90deg); }

  /* Methodology expand */

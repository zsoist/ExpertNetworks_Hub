---
import BaseLayout from '../layouts/BaseLayout.astro';
import ParticleHero from '../components/ParticleHero.astro';
import CompareTable from '../components/CompareTable.astro';
---

<BaseLayout
  title="Compare Networks — Expert Networks Hub"
  description="Side-by-side comparison of leading expert networks. Compare expert call capabilities, content libraries, AI matching, survey tools, and compliance features across top providers."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    'itemListElement': [
      { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': 'https://expertnetworks.net/' },
      { '@type': 'ListItem', 'position': 2, 'name': 'Compare Networks' }
    ]
  }}
>
  <!-- Header with particle background -->
  <ParticleHero minHeight="240px">
    <div class="text-center">
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold tracking-tight text-white">Compare Networks</h1>
      <p class="text-[#a1a1a6] mt-3 text-base md:text-lg">Side-by-side comparison of leading expert networks.</p>
    </div>
  </ParticleHero>
  <CompareTable />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompareTable from '../components/CompareTable.astro';
---

<BaseLayout title="Compare Networks — Expert Networks Hub">
  <section class="pt-32 pb-8 px-6">
    <div class="max-w-site mx-auto text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-primary">Compare Networks</h1>
      <p class="text-secondary mt-3 text-lg">Side-by-side comparison of leading expert networks.</p>
    </div>
  </section>
  <CompareTable />
</BaseLayout>

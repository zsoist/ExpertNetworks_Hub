    .compare-section th, .compare-section td { min-width: 120px !important; padding: 6px 8px !important; }
    .compare-section th:first-child, .compare-section td:first-child { min-width: 110px !important; }
  }
</style>

<script define:vars={{ networkDataMap, presets, presetMeta, sections, defaultSlugs, allNetworkList, enriched, providerTypeColors }}>
  function getInitialSlugs() {
    const params = new URLSearchParams(window.location.search);
    const fromUrl = params.get('networks');
    if (fromUrl) { const slugs = fromUrl.split(',').filter(s => networkDataMap[s]); if (slugs.length >= 2) return slugs.slice(0, 6); }
    const presetParam = params.get('preset');
    if (presetParam && presets[presetParam]) return [...presets[presetParam]];
    const addParam = params.get('add');
    if (addParam && networkDataMap[addParam]) { const base = [...defaultSlugs]; if (!base.includes(addParam)) base.push(addParam); return base.slice(0, 6); }
    return [...defaultSlugs];
  }
  let activeSlugs = getInitialSlugs();
  let activePreset = new URLSearchParams(window.location.search).get('preset') || '';
  let diffMode = false;

  function syncUrl() {
    const slugStr = activeSlugs.join(',');
    const url = new URL(window.location.href);
    url.searchParams.set('networks', slugStr);
    window.history.replaceState({}, '', url.toString());
    const dirUrl = '/networks?selected=' + slugStr;
    const h = document.getElementById('heroDirectoryBtn');
    const b = document.getElementById('browseDirectoryBtn');
    if (h) h.setAttribute('href', dirUrl);
    if (b) b.setAttribute('href', dirUrl);
  }

  const providerChips = document.getElementById('providerChips');
  const addNetworkBtn = document.getElementById('addNetworkBtn');
  const addNetworkModal = document.getElementById('addNetworkModal');
  const closeModalEl = document.getElementById('closeModal');
  const modalBackdrop = document.getElementById('modalBackdrop');
  const networkSearch = document.getElementById('networkSearch');
  const networkPickerList = document.getElementById('networkPickerList');
  const diffToggle = document.getElementById('diffToggle');
  const summaryCards = document.getElementById('summaryCards');
  const insightCards = document.getElementById('insightCards');
  const insightPills = document.getElementById('insightPills');

  function resolve(data, key) { return key.split('.').reduce((obj, k) => obj?.[k], data); }
  function getCellValue(slug, row) {
    if (row.source === 'enriched') { const e = enriched[slug]; return e ? resolve(e, row.key) : null; }
    return resolve(networkDataMap[slug], row.key);
  }
  function getEvidence(slug, field) { return enriched[slug]?.[field] || 'Inferred'; }
  function evidenceDotClass(ev) { if (ev === 'Verified') return 'ev-verified'; if (ev === 'Company-Stated') return 'ev-stated'; if (ev === 'Estimated') return 'ev-estimated'; return 'ev-inferred'; }
  function capabilityClass(val) { if (val === 'Strong') return 'text-emerald-600 font-semibold'; if (val === 'Yes') return 'text-emerald-600 font-medium'; if (val === 'Limited') return 'text-amber-600 font-medium'; if (val === 'No') return 'text-tertiary/60'; return 'text-secondary'; }
  function getComparableValue(slug, row) { const val = getCellValue(slug, row); return Array.isArray(val) ? val[0] : val; }

  const complianceColors = { 'Strong Compliance':'bg-emerald-500/10 text-emerald-700', 'Standard Compliance':'bg-slate-100 text-slate-600', 'Compliance Tools':'bg-blue-500/10 text-blue-600', 'Limited Public Detail':'bg-amber-500/10 text-amber-600' };
  const aiColors = { 'AI-Native':'bg-violet-500/10 text-violet-700', 'AI Research':'bg-blue-500/10 text-blue-600', 'AI Matching':'bg-cyan-500/10 text-cyan-600', 'AI Moderation':'bg-teal-500/10 text-teal-600', 'Limited AI Detail':'bg-slate-100 text-slate-500' };
  const badgeColorMap = { 'Global Leader':'bg-amber-500/10 text-amber-700', 'Major Provider':'bg-blue-500/10 text-blue-700', 'Fast-Growing':'bg-emerald-500/10 text-emerald-700', 'Asia Specialist':'bg-rose-500/10 text-rose-700', 'Research Platform':'bg-violet-500/10 text-violet-700', 'Technology-First':'bg-cyan-500/10 text-cyan-700', 'Marketplace':'bg-orange-500/10 text-orange-700', 'Boutique Specialist':'bg-slate-100 text-slate-600' };
  const deliveryColorMap = { 'Concierge':'bg-blue-500/10 text-blue-700', 'Hybrid':'bg-violet-500/10 text-violet-600', 'Self-Serve':'bg-emerald-500/10 text-emerald-700', 'Marketplace':'bg-orange-500/10 text-orange-700', 'Platform-Led':'bg-cyan-500/10 text-cyan-700' };
  const regionColorMap = { 'Global':'bg-blue-500/10 text-blue-700', 'North America':'bg-slate-100 text-slate-700', 'Europe':'bg-indigo-500/10 text-indigo-700', 'Asia-Pacific':'bg-rose-500/10 text-rose-700', 'Greater China':'bg-red-500/10 text-red-700', 'India':'bg-amber-500/10 text-amber-700', 'Emerging Markets':'bg-teal-500/10 text-teal-700' };

  function renderChips() {
    if (!providerChips) return;
    providerChips.innerHTML = '';
    activeSlugs.forEach(slug => {
      const d = networkDataMap[slug]; if (!d) return;
      const chip = document.createElement('div');
      chip.className = 'provider-chip flex items-center gap-1.5 px-2.5 py-1 bg-[#f5f5f7] rounded-lg border border-border/30 whitespace-nowrap';
      chip.dataset.slug = slug;
      const dn = d.name.split(' (')[0].split(' / ')[0];
      chip.innerHTML = (d.logo ? `<img src="${d.logo}" alt="" width="16" height="16" class="w-4 h-4 rounded object-contain" loading="lazy" />` : `<div class="w-4 h-4 rounded flex items-center justify-center text-white text-[7px] font-bold" style="background:linear-gradient(135deg,${d.gradientFrom},${d.gradientTo})">${d.shortName}</div>`) + `<span class="text-[12px] font-medium text-primary">${dn}</span><button class="remove-provider ml-0.5 text-tertiary hover:text-red-500 transition-colors bg-transparent border-none cursor-pointer p-0" data-slug="${slug}"><svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg></button>`;
      providerChips.appendChild(chip);
    });
    providerChips.querySelectorAll('.remove-provider').forEach(btn => {
      btn.addEventListener('click', e => { e.stopPropagation(); if (activeSlugs.length <= 2) return; activeSlugs = activeSlugs.filter(s => s !== btn.dataset.slug); rebuildComparison(); });
    });
  }

  function renderSummaryCards() {
    if (!summaryCards) return;
    summaryCards.innerHTML = '';
    activeSlugs.forEach(slug => {
      const d = networkDataMap[slug]; if (!d) return;
      const provType = enriched[slug]?.providerType || '';
      const provClass = providerTypeColors[provType] || 'bg-slate-100 text-slate-600 border-slate-200/50';
      const card = document.createElement('div');
      card.className = 'summary-card bg-white rounded-xl border border-border/30 p-4 hover:shadow-sm transition-shadow';
      card.dataset.slug = slug;
      const dn = d.name.split(' (')[0];
      const desc = d.description.length > 120 ? d.description.slice(0, 120) + '...' : d.description;
      let bf = '';
      if (d.bestFor?.length > 0) {
        const pills = d.bestFor.slice(0, 3).map(b => `<span class="px-1.5 py-0.5 text-[9px] font-medium rounded bg-accent/[0.06] text-accent">${b}</span>`).join('');
        bf = `<div class="mt-2.5 pt-2.5 border-t border-border/20"><div class="text-[10px] text-tertiary font-medium mb-1">Best for</div><div class="flex flex-wrap gap-1">${pills}${d.bestFor.length > 3 ? `<span class="text-[9px] text-tertiary">+${d.bestFor.length - 3}</span>` : ''}</div></div>`;
      }
      const cl = d.complianceBadge === 'Strong Compliance' ? 'Strong' : d.complianceBadge === 'Standard Compliance' ? 'Standard' : d.complianceBadge || '—';
      const cc = d.complianceBadge === 'Strong Compliance' ? 'text-emerald-600' : 'text-primary';
      const ac = d.aiBadge === 'AI-Native' ? 'text-violet-600' : d.aiBadge === 'AI Research' ? 'text-blue-600' : 'text-primary';
      card.innerHTML = `<div class="flex items-center gap-2.5 mb-2">${d.logo ? `<img src="${d.logo}" alt="" width="28" height="28" class="w-7 h-7 rounded-lg object-contain flex-shrink-0" loading="lazy" />` : `<div class="w-7 h-7 rounded-lg flex items-center justify-center text-white text-[9px] font-bold flex-shrink-0" style="background:linear-gradient(135deg,${d.gradientFrom},${d.gradientTo})">${d.shortName}</div>`}<div class="min-w-0"><a href="/networks/${d.slug}" class="text-[14px] font-semibold text-primary hover:text-accent transition-colors no-underline block truncate">${dn}</a>${provType ? `<span class="inline-block mt-0.5 px-1.5 py-0.5 text-[8px] font-semibold uppercase tracking-wider rounded border ${provClass}">${provType}</span>` : ''}</div></div><p class="text-[11.5px] text-secondary leading-relaxed line-clamp-2 mb-3">${desc}</p><div class="grid grid-cols-2 gap-x-3 gap-y-1.5 text-[11px]"><div><span class="text-tertiary">Model </span><span class="font-semibold text-primary">${d.deliveryModel || '—'}</span></div><div><span class="text-tertiary">Pricing </span><span class="font-semibold text-primary">${d.pricingModel || '—'}</span></div><div><span class="text-tertiary">AI </span><span class="font-semibold ${ac}">${d.aiBadge || '—'}</span></div><div><span class="text-tertiary">Compliance </span><span class="font-semibold ${cc}">${cl}</span></div><div><span class="text-tertiary">Region </span><span class="font-semibold text-primary">${d.regionStrength || '—'}</span></div><div><span class="text-tertiary">Scale </span><span class="font-semibold text-primary">${d.expertCount || '—'}</span></div></div>${bf}`;
      summaryCards.appendChild(card);
    });
  }

  function renderCellValue(slug, row) {
    const val = getCellValue(slug, row);
    const type = row.type;
    const key = row.key;
    if (type === 'capability') {
      if (Array.isArray(val)) {
        const ev = val[1] ? `<span class="ev-dot ${evidenceDotClass(val[1])}" title="${val[1]}"></span>` : '';
        const note = val[2] ? `<span class="text-[9px] text-tertiary" title="${val[2]}">(${val[2].length > 30 ? val[2].slice(0, 28) + '…' : val[2]})</span>` : '';
        return `<div class="flex items-start gap-1.5 flex-wrap"><span class="${capabilityClass(val[0])}">${val[0]}</span>${ev}${note}</div>`;
      }
      return '<span class="text-tertiary/40">—</span>';
    }
    if (type === 'chip-provider') {
      if (val) { const cls = providerTypeColors[val] || 'bg-slate-100 text-slate-600 border-slate-200/50'; return `<span class="inline-block px-1.5 py-0.5 text-[10px] font-semibold rounded border ${cls}">${val}</span>`; }
      return '<span class="text-tertiary/40">—</span>';
    }
    if (type === 'product-names') return val ? `<span class="text-[11px] italic text-secondary">${val}</span>` : '<span class="text-tertiary/40">—</span>';
    if (type === 'text-evidence') {
      if (val != null && val !== '') { const ev = getEvidence(slug, row.evidenceField); return `<div class="flex items-center gap-1.5"><span class="text-primary text-[12px]">${String(val)}</span><span class="ev-dot ${evidenceDotClass(ev)}" title="${ev}"></span></div>`; }
      return '<span class="text-tertiary/40">—</span>';
    }
    if (type === 'text-italic') return val ? `<span class="text-[11px] italic text-secondary leading-snug">${val}</span>` : '<span class="text-tertiary/40">—</span>';
    if (type === 'boolean') return val === true ? '<span class="text-emerald-500 font-bold">&#10003;</span>' : '<span class="text-tertiary/40">—</span>';
    if (type === 'boolean-or-string') { if (val === true) return '<span class="text-emerald-500 font-bold">&#10003;</span>'; if (typeof val === 'string') return `<span class="text-emerald-600 font-medium text-[11px]">${val}</span>`; return '<span class="text-tertiary/40">—</span>'; }
    if (type === 'graded' && val) { const cm = key === 'complianceBadge' ? complianceColors : key === 'aiBadge' ? aiColors : {}; return `<span class="inline-block px-1.5 py-0.5 text-[10px] font-semibold rounded ${cm[val] || 'bg-slate-100 text-slate-600'}">${val}</span>`; }
    if (type === 'chip' && val) { const cm = key === 'deliveryModel' ? deliveryColorMap : key === 'regionStrength' ? regionColorMap : key === 'categoryBadge' ? badgeColorMap : {}; return `<span class="inline-block px-1.5 py-0.5 text-[10px] font-semibold rounded ${cm[val] || 'bg-slate-100 text-slate-600'}">${val}</span>`; }
    if (type === 'list' && Array.isArray(val) && val.length > 0) { const items = val.slice(0, 3).map(i => `<span class="px-1.5 py-0.5 text-[9px] font-medium rounded bg-[#f5f5f7] text-secondary">${i.length > 28 ? i.slice(0, 25) + '...' : i}</span>`).join(''); return `<div class="flex flex-wrap gap-1">${items}${val.length > 3 ? `<span class="text-[9px] text-tertiary">+${val.length - 3}</span>` : ''}</div>`; }
    if (val != null && val !== '') return `<span class="text-primary text-[12px]">${String(val)}</span>`;
    return '<span class="text-tertiary/40">—</span>';
  }

  function renderMatrix() {
    const container = document.getElementById('matrixContainer');
    if (!container) return;
    container.innerHTML = '';
    sections.forEach(section => {
      const sEl = document.createElement('div');
      sEl.className = 'compare-section mb-6'; sEl.id = `section-${section.id}`; sEl.dataset.sectionId = section.id;
      const tBtn = document.createElement('button');
      tBtn.className = 'section-toggle flex items-center gap-2 w-full text-left py-3 px-1 border-b-2 border-primary/10 hover:border-accent/30 transition-colors bg-transparent cursor-pointer group';
      tBtn.innerHTML = `<svg class="w-4 h-4 text-tertiary group-hover:text-accent transition-colors section-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg><h3 class="text-[13px] font-bold uppercase tracking-wide text-primary">${section.name}</h3><span class="text-[11px] text-tertiary ml-auto">${section.rows.length} fields</span>`;
      sEl.appendChild(tBtn);
      const body = document.createElement('div'); body.className = 'section-body overflow-x-auto mt-1';
      const table = document.createElement('table'); table.className = 'w-full border-collapse';
      const thead = document.createElement('thead');
      let hh = '<tr><th class="text-left text-[11px] font-semibold uppercase tracking-wide text-tertiary px-3 py-2.5 w-40 min-w-[140px] bg-white sticky left-0 z-10">Field</th>';
      activeSlugs.forEach(slug => { const d = networkDataMap[slug]; if (!d) return; const dn = d.name.split(' (')[0].split(' / ')[0]; const ic = d.logo ? `<img src="${d.logo}" alt="" width="16" height="16" class="w-4 h-4 rounded object-contain flex-shrink-0" loading="lazy" />` : `<div class="w-4 h-4 rounded flex items-center justify-center text-white text-[6px] font-bold flex-shrink-0" style="background:linear-gradient(135deg,${d.gradientFrom},${d.gradientTo})">${d.shortName}</div>`; hh += `<th class="text-left text-[11px] font-semibold text-secondary px-3 py-2.5 min-w-[140px] provider-col" data-slug="${slug}"><div class="flex items-center gap-1.5">${ic}<span class="truncate">${dn}</span></div></th>`; });
      hh += '</tr>'; thead.innerHTML = hh; table.appendChild(thead);
      const tbody = document.createElement('tbody');
      section.rows.forEach(row => {
        const vals = activeSlugs.map(s => getComparableValue(s, row));
        const same = vals.every(v => JSON.stringify(v) === JSON.stringify(vals[0]));
        const tr = document.createElement('tr');
        tr.className = `compare-row border-b border-border/10 hover:bg-[#fafafa] transition-colors ${same ? 'same-row' : 'diff-row'}`;
        tr.dataset.same = same ? '1' : '0';
        const dsc = row.description ? `<div class="text-[10px] text-tertiary font-normal mt-0.5 leading-tight">${row.description}</div>` : '';
        let rh = `<td class="px-3 py-3 text-[12px] font-medium text-primary bg-white sticky left-0 z-10"><div class="flex items-center gap-1">${row.label}${!same ? '<span class="inline-block w-1.5 h-1.5 rounded-full bg-accent/60" title="Values differ"></span>' : ''}</div>${dsc}</td>`;
        activeSlugs.forEach(slug => { rh += `<td class="px-3 py-3 text-[12px] provider-col" data-slug="${slug}">${renderCellValue(slug, row)}</td>`; });
        tr.innerHTML = rh; tbody.appendChild(tr);
      });
      table.appendChild(tbody); body.appendChild(table); sEl.appendChild(body);
      tBtn.addEventListener('click', () => sEl.classList.toggle('section-collapsed'));
      container.appendChild(sEl);
    });
    applyDiffMode();
  }

  function renderInsightStrip() {
    if (!insightPills) return;
    insightPills.innerHTML = '';
    const pills = [];
    const types = {};
    activeSlugs.forEach(s => { const pt = enriched[s]?.providerType; if (pt) types[pt] = (types[pt] || 0) + 1; });
    const te = Object.entries(types).sort((a, b) => b[1] - a[1]);
    if (te.length > 1) pills.push({ label: 'Provider mix', value: te.map(([t, c]) => `${c} ${t.split(' ')[0]}`).join(', ') });
    ['matchingAI', 'libraryQA', 'synthesis', 'agents'].forEach(field => {
      const strong = [];
      activeSlugs.forEach(s => { const ai = enriched[s]?.ai; if (ai && Array.isArray(ai[field]) && ai[field][0] === 'Strong') strong.push(networkDataMap[s]?.name?.split(' (')[0]?.split(' / ')[0] || s); });
      if (strong.length > 0 && strong.length < activeSlugs.length) {
        const labels = { matchingAI: 'Strongest AI Matching', libraryQA: 'Strongest Library AI', synthesis: 'Best Synthesis', agents: 'Most Advanced Agents' };
        pills.push({ label: labels[field], value: strong.join(', ') });
      }
    });
    const models = {};
    activeSlugs.forEach(s => { const m = networkDataMap[s]?.deliveryModel; if (m) models[m] = 1; });
    if (Object.keys(models).length > 1) pills.push({ label: 'Delivery models', value: Object.keys(models).join(' vs ') });
    const sc = activeSlugs.filter(s => networkDataMap[s]?.complianceBadge === 'Strong Compliance').length;
    if (sc > 0 && sc < activeSlugs.length) pills.push({ label: 'Strong Compliance', value: `${sc} of ${activeSlugs.length}` });
    if (pills.length === 0) pills.push({ label: 'Comparing', value: `${activeSlugs.length} networks` });
    pills.slice(0, 5).forEach(p => { const el = document.createElement('div'); el.className = 'insight-pill'; el.innerHTML = `<span class="pill-label">${p.label}</span><span class="pill-value">${p.value}</span>`; insightPills.appendChild(el); });
  }

  function renderInsights() {
    if (!insightCards) return;
    insightCards.innerHTML = '';
    const diffs = [];
    sections.forEach(section => { section.rows.forEach(row => {
      const vals = activeSlugs.map(s => getComparableValue(s, row));
      const same = vals.every(v => JSON.stringify(v) === JSON.stringify(vals[0]));
      if (!same) diffs.push({ section: section.name, label: row.label, values: activeSlugs.map((s, i) => ({ slug: s, name: networkDataMap[s]?.name?.split(' (')[0] || s, value: vals[i] })) });
    }); });
    if (diffs.length === 0) { insightCards.innerHTML = '<p class="text-[13px] text-tertiary col-span-full">All selected providers are similar across tracked fields.</p>'; return; }
    diffs.slice(0, 6).forEach(diff => {
      const card = document.createElement('div'); card.className = 'bg-white rounded-xl border border-border/30 p-4';
      const items = diff.values.map(v => { let dv = v.value; if (dv === true) dv = '✓'; else if (dv === false || dv == null) dv = '—'; else if (Array.isArray(dv)) dv = dv.slice(0, 2).join(', ') + (dv.length > 2 ? '…' : ''); return `<div class="flex items-center justify-between text-[11px]"><span class="text-secondary">${v.name.split(' / ')[0]}</span><span class="font-medium text-primary">${dv}</span></div>`; }).join('');
      card.innerHTML = `<div class="text-[10px] font-bold uppercase tracking-wider text-tertiary mb-1">${diff.section}</div><div class="text-[13px] font-semibold text-primary mb-2">${diff.label}</div><div class="space-y-1">${items}</div>`;
      insightCards.appendChild(card);
    });
    if (diffs.length > 6) { const m = document.createElement('div'); m.className = 'bg-white rounded-xl border border-border/30 p-4 flex items-center justify-center'; m.innerHTML = `<span class="text-[13px] text-tertiary">+${diffs.length - 6} more differences</span>`; insightCards.appendChild(m); }
  }

  function applyDiffMode() {
    let hc = 0;
    document.querySelectorAll('.compare-row').forEach(r => { if (diffMode && r.dataset.same === '1') { r.classList.add('hidden-diff'); hc++; } else r.classList.remove('hidden-diff'); });
    const ex = document.getElementById('diffCount'); if (ex) ex.remove();
    if (diffMode && hc > 0) { const c = document.createElement('span'); c.id = 'diffCount'; c.className = 'text-[10px] text-tertiary ml-1'; c.textContent = `(${hc} identical rows hidden)`; diffToggle?.parentElement?.appendChild(c); }
  }

  function rebuildComparison() { renderChips(); renderInsightStrip(); renderSummaryCards(); renderMatrix(); renderInsights(); updateScrollNav(); syncUrl(); }

  function openModal() { addNetworkModal?.classList.remove('hidden'); document.body.style.overflow = 'hidden'; if (networkSearch) networkSearch.value = ''; filterPicker(''); networkSearch?.focus(); }
  function closeModalFn() { addNetworkModal?.classList.add('hidden'); document.body.style.overflow = ''; }
  addNetworkBtn?.addEventListener('click', openModal);
  closeModalEl?.addEventListener('click', closeModalFn);
  modalBackdrop?.addEventListener('click', closeModalFn);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModalFn(); });

  function filterPicker(query) { const l = query.toLowerCase(); networkPickerList?.querySelectorAll('.network-pick-btn').forEach(btn => { const n = btn.dataset.name || ''; const s = btn.dataset.slug || ''; btn.style.display = (!query || n.includes(l)) && !activeSlugs.includes(s) ? '' : 'none'; }); }
  networkSearch?.addEventListener('input', e => filterPicker(e.target.value));

  networkPickerList?.querySelectorAll('.network-pick-btn').forEach(btn => {
    btn.addEventListener('click', () => { const s = btn.dataset.slug; if (!s || activeSlugs.includes(s)) return; if (activeSlugs.length >= 6) activeSlugs.shift(); activeSlugs.push(s); closeModalFn(); activePreset = ''; document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active')); rebuildComparison(); });
  });

  document.querySelectorAll('.preset-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const p = btn.dataset.preset || '';
      if (activePreset === p) { activePreset = ''; btn.classList.remove('active'); activeSlugs = [...defaultSlugs]; }
      else { document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active')); activePreset = p; btn.classList.add('active'); if (presets[p]) activeSlugs = [...presets[p]]; }
      rebuildComparison();
    });
  });

  diffToggle?.addEventListener('change', () => { diffMode = diffToggle.checked; applyDiffMode(); });

  document.querySelectorAll('.remove-provider').forEach(btn => { btn.addEventListener('click', e => { e.stopPropagation(); if (activeSlugs.length <= 2) return; activeSlugs = activeSlugs.filter(s => s !== btn.dataset.slug); rebuildComparison(); }); });
  document.querySelectorAll('.section-toggle').forEach(btn => { btn.addEventListener('click', () => btn.closest('.compare-section')?.classList.toggle('section-collapsed')); });

  document.addEventListener('mouseover', e => { const c = e.target.closest('.provider-col'); if (!c?.dataset.slug) return; document.querySelectorAll(`.provider-col[data-slug="${c.dataset.slug}"]`).forEach(el => el.classList.add('highlight')); });
  document.addEventListener('mouseout', e => { const c = e.target.closest('.provider-col'); if (!c?.dataset.slug) return; document.querySelectorAll(`.provider-col[data-slug="${c.dataset.slug}"]`).forEach(el => el.classList.remove('highlight')); });

  renderInsightStrip();
  const initParams = new URLSearchParams(window.location.search);
  if (initParams.has('networks') || initParams.has('preset') || initParams.has('add')) {
    if (activePreset) document.querySelectorAll('.preset-btn').forEach(b => b.classList.toggle('active', b.dataset.preset === activePreset));
    rebuildComparison();
  } else { syncUrl(); }

  function updateScrollNav() {
    const links = document.querySelectorAll('.scroll-nav-link'); if (!links.length) return;
    const obs = new IntersectionObserver(entries => { entries.forEach(entry => { if (entry.isIntersecting) { const id = entry.target.dataset.sectionId; links.forEach(l => l.classList.toggle('active', l.dataset.section === id)); } }); }, { rootMargin: '-200px 0px -60% 0px' });
    document.querySelectorAll('.compare-section').forEach(s => obs.observe(s));
  }
  updateScrollNav();
</script>

---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found — ExpertNetworks.net"
  description="The page you're looking for doesn't exist or has been moved."
>
  <section class="relative overflow-hidden px-4 sm:px-6 pt-[calc(var(--nav-h)+4rem)] pb-section">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true" style="background: radial-gradient(50% 60% at 50% 0%, rgba(0,113,227,0.08), transparent 70%);"></div>
    <div class="relative max-w-[640px] mx-auto text-center">
      <p class="not-found-code" aria-hidden="true">404</p>
      <h1 class="text-step-3 font-bold text-primary -mt-2">Page not found</h1>
      <p class="mt-3 text-step-0 text-secondary max-w-[46ch] mx-auto">
        The page you're looking for doesn't exist or has been moved. Try browsing our network directory or searching for what you need.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <button type="button" data-open-search class="btn btn-primary">
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          Search networks
        </button>
        <a href="/" class="btn btn-secondary">Go home</a>
      </div>

      <nav class="mt-12 grid grid-cols-1 gap-3 text-left sm:grid-cols-3" aria-label="Popular destinations">
        <a href="/networks" class="group card-spot p-5 no-underline">
          <div class="text-[15px] font-semibold text-primary transition-colors group-hover:text-accent-text">Browse networks</div>
          <div class="mt-1 text-[13px] text-secondary">The full provider directory</div>
        </a>
        <a href="/compare" class="group card-spot p-5 no-underline">
          <div class="text-[15px] font-semibold text-primary transition-colors group-hover:text-accent-text">Compare providers</div>
          <div class="mt-1 text-[13px] text-secondary">Side-by-side comparison</div>
        </a>
        <a href="/news" class="group card-spot p-5 no-underline">
          <div class="text-[15px] font-semibold text-primary transition-colors group-hover:text-accent-text">Industry news</div>
          <div class="mt-1 text-[13px] text-secondary">Latest market signals</div>
        </a>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found-code {
    font-size: clamp(6rem, 4rem + 14vw, 11rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.05em;
    background: linear-gradient(180deg, #C7C7CC 0%, rgba(199, 199, 204, 0.15) 90%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    user-select: none;
  }
</style>

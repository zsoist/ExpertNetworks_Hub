---
import BaseLayout from '../layouts/BaseLayout.astro';
import VsComparison from '../components/VsComparison.astro';
import { getCollection } from 'astro:content';

const allNetworks = await getCollection('networks');
const glg = allNetworks.find(n => n.data.slug === 'glg')!;
const alpha = allNetworks.find(n => n.data.slug === 'alphasights')!;

const verdict = [
  `<strong>GLG</strong> is the industry's broadest platform. If you need multi-format research (calls + surveys + events + library + placements), global coverage across nearly every sector, and the most established compliance infrastructure in the space, GLG is the default choice for large institutional buyers. The trade-off: it's typically the most expensive option, and the breadth of the platform can feel heavy for teams that just need fast expert calls.`,
  `<strong>AlphaSights</strong> positions itself as the speed and service leader. If your team operates under time pressure (PE deal diligence, fast-moving hedge fund research), AlphaSights' custom-sourcing model and high-touch project management are a core part of their value proposition. Their AI investment (AlphaGPT, AlphaGraph) is aggressive, and the firm has maintained a 70% CAGR since founding. The trade-off: narrower product suite than GLG, and the per-call pricing model can add up for high-volume users.`,
  `Some research teams use both — GLG for breadth and AlphaSights for speed. They're complementary more than they are substitutes.`,
];
---

<BaseLayout
  title="GLG vs AlphaSights: Complete Comparison (2026) | ExpertNetworks.net"
  description="Head-to-head comparison of GLG and AlphaSights — the two largest expert networks. Compare pricing, expert coverage, AI capabilities, compliance, services, and which is right for your team."
  canonicalPath="/glg-vs-alphasights"
  ogType="article"
  jsonLd={{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://expertnetworks.net/" },
          { "@type": "ListItem", "position": 2, "name": "Compare", "item": "https://expertnetworks.net/compare" },
          { "@type": "ListItem", "position": 3, "name": "GLG vs AlphaSights" }
        ]
      },
      {
        "@type": "Article",
        "headline": "GLG vs AlphaSights: Complete Comparison (2026)",
        "description": "Head-to-head comparison of GLG and AlphaSights expert networks across pricing, AI, compliance, and services.",
        "publisher": {
          "@type": "Organization",
          "name": "ExpertNetworks.net",
          "url": "https://expertnetworks.net"
        },
        "datePublished": "2026-03-08",
        "dateModified": "2026-03-08"
      }
    ]
  }}
>
  <!-- Hero -->
  <section class="pt-32 pb-16 px-6 bg-gradient-to-b from-bg-secondary to-bg-primary">
    <div class="max-w-4xl mx-auto">
      <div class="flex items-center gap-3 mb-6">
        <a href="/what-is-an-expert-network/" class="text-accent text-sm font-medium no-underline hover:underline">&larr; What's an Expert Network?</a>
      </div>
      <span class="inline-block px-3 py-1 bg-accent/10 text-accent text-xs font-semibold rounded-full mb-4 tracking-wide uppercase">Head-to-Head</span>
      <h1 class="text-4xl md:text-5xl font-extrabold text-primary mb-6 leading-tight">
        GLG vs AlphaSights
      </h1>
      <p class="text-lg text-secondary max-w-3xl leading-relaxed">
        The industry pioneer vs. the fastest-growing challenger. Here's how they actually compare on the things that matter — pricing, speed, AI, compliance, and product depth.
      </p>
    </div>
  </section>

  <VsComparison a={glg} b={alpha} verdict={verdict} />
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getCollection } from 'astro:content';

const allNews = await getCollection('news');
const articles = allNews
  .filter(n => n.data.published)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<BaseLayout title="Industry News — Expert Networks Hub">
  <section class="pt-32 pb-24 px-6">
    <div class="max-w-site mx-auto">
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-primary">Industry News</h1>
        <p class="text-secondary mt-3 text-lg">Curated weekly from third-party sources. No self-reported press releases.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {articles.map(article => (
          <NewsCard {...article.data} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

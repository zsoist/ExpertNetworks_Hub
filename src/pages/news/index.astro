---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ParticleHero from '../../components/ParticleHero.astro';
import { getCollection } from 'astro:content';

const allNews = await getCollection('news');
const articles = allNews
  .filter(n => n.data.published)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const allNetworks = await getCollection('networks');
const networkMap = Object.fromEntries(
  allNetworks.filter(n => n.data.published).map(n => [n.data.slug, n.data.name.split(' (')[0]])
);
const networkLogoMap = Object.fromEntries(
  allNetworks.filter(n => n.data.published && n.data.logo).map(n => [n.data.slug, n.data.logo || ''])
);
const networkGradientMap: Record<string, {from: string, to: string}> = Object.fromEntries(
  allNetworks.filter(n => n.data.published).map(n => [n.data.slug, {from: n.data.gradientFrom, to: n.data.gradientTo}])
);
const articleClientData = Object.fromEntries(
  articles.map(({ data }) => [
    data.slug,
    {
      title: data.title,
      summary: data.summary,
      source: data.source,
      sourceUrl: data.sourceUrl || '',
      sourceType: data.sourceType || '',
      whyItMatters: data.whyItMatters || '',
      impactTags: data.impactTags || [],
      categoryColor: data.categoryColor || '#0071E3',
      gradientFrom: data.gradientFrom || '#1a365d',
    },
  ])
);

// Featured articles for "What Matters Now"
const featuredArticles = articles.filter(a => a.data.featured).slice(0, 5);

// Get unique categories, source types, and related networks
const categories = [...new Set(articles.map(a => a.data.category))].sort();
const sourceTypes = [...new Set(articles.map(a => a.data.sourceType).filter(Boolean))].sort();
const relatedSlugs = [...new Set(articles.flatMap(a => a.data.relatedNetworks))].filter(s => networkMap[s]).sort();

// Coverage intelligence counts
const majorCount = articles.filter(a => a.data.significance === 'major').length;
const networksCovered = new Set(articles.flatMap(a => a.data.relatedNetworks).filter(Boolean)).size;
const sourcesCount = new Set(articles.map(a => a.data.source)).size;

// Source type badge classes (styled in the page stylesheet; mirrored client-side for the signals grid)
const sourceTypeClass: Record<string, string> = {
  'Press Release': 'nw-type-press',
  'Industry Report': 'nw-type-report',
  'News Coverage': 'nw-type-news',
  'Regulatory': 'nw-type-reg',
  'Product Update': 'nw-type-product',
};

// Dates are plain YYYY-MM-DD strings; format them in UTC so the day never shifts with the build or viewer time zone.
function fmtDate(iso: string): string {
  return new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
}

// Group the feed by month for scannable date headers
const monthGroups: { key: string; label: string; items: typeof articles }[] = [];
for (const article of articles) {
  const key = article.data.date.slice(0, 7);
  let group = monthGroups.find(g => g.key === key);
  if (!group) {
    const label = new Date(`${key}-01T00:00:00Z`).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
    group = { key, label, items: [] };
    monthGroups.push(group);
  }
  group.items.push(article);
}

// Time range helper
const now = new Date();
const ninetyDaysAgo = new Date(now.getTime() - 90 * 24 * 60 * 60 * 1000);

// Trend pulse: count articles per category in last 90 days
const recentArticles = articles.filter(a => new Date(a.data.date) >= ninetyDaysAgo);
const trendCounts: Record<string, number> = {};
recentArticles.forEach(a => {
  trendCounts[a.data.category] = (trendCounts[a.data.category] || 0) + 1;
});
const topTrends = Object.entries(trendCounts).sort((a, b) => b[1] - a[1]).slice(0, 6);
---

<BaseLayout
  title="Expert Network Industry News: M&A, Funding, AI & Market Intelligence (2026) | ExpertNetworks.net"
  description="Track expert network industry signals: M&A activity, funding rounds, product launches, regulatory developments, and AI adoption across GLG, AlphaSights, Third Bridge, and 30+ providers."
  canonicalPath="/news"
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Expert Network Industry Intelligence",
    "description": "Curated expert network industry intelligence from independent sources.",
    "url": "https://expertnetworks.net/news",
    "isPartOf": { "@type": "WebSite", "name": "ExpertNetworks.net", "url": "https://expertnetworks.net" }
  }}
>
  <!-- Hero -->
  <ParticleHero>
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between lg:gap-10">
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#a1a1a6] mb-2">Signals feed</p>
        <h1 class="text-3xl md:text-[40px] md:leading-[1.1] font-extrabold tracking-tight text-white">Expert Network Industry Intelligence</h1>
        <p class="text-[#c7c7cc] text-[15px] mt-3 max-w-2xl leading-relaxed">Signals, analysis, and developments across the expert network ecosystem.</p>
      </div>
      <dl class="nw-hero-stats" style="pointer-events: auto;">
        <div><dt>Signals</dt><dd>{articles.length}</dd></div>
        <div><dt>Major</dt><dd>{majorCount}</dd></div>
        <div><dt>Networks</dt><dd>{networksCovered}</dd></div>
        <div><dt>Sources</dt><dd>{sourcesCount}</dd></div>
      </dl>
    </div>
  </ParticleHero>

  <!-- What Matters Now — Featured Signals -->
  {featuredArticles.length > 0 && (
    <section class="pt-10 pb-10 px-4 md:px-6 bg-bg-secondary/60 border-b border-border/40" id="featured" aria-labelledby="featuredHeading">
      <div class="max-w-site mx-auto">
        <div class="flex items-center gap-2.5 mb-5">
          <span class="nw-live-dot" aria-hidden="true"></span>
          <h2 id="featuredHeading" class="text-[22px] font-bold tracking-tight text-primary">What matters now</h2>
        </div>
        {(() => {
          const [lead, ...rest] = featuredArticles;
          return (
            <div class="grid gap-4">
              <article class="nw-lead">
                <div class="nw-lead-main">
                  <div class="flex flex-wrap items-center gap-2 mb-4">
                    <span class="nw-lead-flag">Lead signal</span>
                    <span class="nw-lead-meta">{lead.data.category}</span>
                    {lead.data.sourceType && <span class="nw-lead-meta nw-lead-meta-sep">{lead.data.sourceType}</span>}
                    <time class="nw-lead-meta nw-lead-meta-sep" datetime={lead.data.date}>{fmtDate(lead.data.date)}</time>
                  </div>
                  <h3 class="nw-lead-title">
                    {lead.data.sourceUrl ? (
                      <a href={lead.data.sourceUrl} target="_blank" rel="noopener noreferrer">{lead.data.title}<span class="sr-only"> (opens source in a new tab)</span></a>
                    ) : lead.data.title}
                  </h3>
                  <p class="nw-lead-summary">{lead.data.summary}</p>
                  <div class="flex flex-wrap items-center gap-2 mt-5">
                    {lead.data.relatedNetworks.map((s: string) => networkMap[s] ? (
                      <a href={`/networks/${s}`} class="nw-lead-chip">
                        {networkLogoMap[s] && <img src={networkLogoMap[s]} alt="" width="18" height="18" class="w-[18px] h-[18px] rounded object-contain bg-white" loading="lazy" />}
                        {networkMap[s]}
                      </a>
                    ) : null)}
                    <span class="text-[13px] text-[#a1a1a6]">{lead.data.source}</span>
                  </div>
                </div>
                {lead.data.whyItMatters && (
                  <aside class="nw-lead-why">
                    <div class="nw-lead-why-label">Why it matters</div>
                    <p>{lead.data.whyItMatters}</p>
                    {lead.data.sourceUrl && (
                      <a href={lead.data.sourceUrl} target="_blank" rel="noopener noreferrer" class="nw-lead-source">
                        Read the source
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
                        <span class="sr-only">(opens in a new tab)</span>
                      </a>
                    )}
                  </aside>
                )}
              </article>

              {rest.length > 0 && (
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                  {rest.map((article) => {
                    const primarySlug = article.data.relatedNetworks[0];
                    const logoSrc = primarySlug ? networkLogoMap[primarySlug] : null;
                    const stClass = article.data.sourceType ? sourceTypeClass[article.data.sourceType] : '';
                    return (
                      <article class="nw-feat">
                        <div class="flex items-center gap-2 mb-3">
                          {logoSrc ? (
                            <img src={logoSrc} alt="" width="24" height="24" class="w-6 h-6 rounded-md object-contain bg-white ring-1 ring-black/5" loading="lazy" />
                          ) : (
                            <span class="w-6 h-6 rounded-md inline-flex items-center justify-center" style={`background: ${article.data.gradientFrom || '#1a365d'}`} aria-hidden="true"><span class="w-1.5 h-1.5 rounded-full bg-white/70"></span></span>
                          )}
                          {article.data.sourceType && <span class={`nw-type ${stClass}`}>{article.data.sourceType}</span>}
                          <time class="text-[12px] text-secondary ml-auto whitespace-nowrap" datetime={article.data.date}>{fmtDate(article.data.date)}</time>
                        </div>
                        <h3 class="nw-feat-title">
                          {article.data.sourceUrl ? (
                            <a href={article.data.sourceUrl} target="_blank" rel="noopener noreferrer">{article.data.title}<span class="sr-only"> (opens source in a new tab)</span></a>
                          ) : article.data.title}
                        </h3>
                        <p class="nw-feat-summary line-clamp-4">{article.data.summary}</p>
                        <div class="nw-feat-foot">
                          <span class="nw-cat"><span class="nw-cat-dot" style={`background: ${article.data.categoryColor || '#0071E3'}`} aria-hidden="true"></span>{article.data.category}</span>
                          {article.data.sourceUrl && <svg class="w-4 h-4 text-[#aeaeb2] ml-auto nw-feat-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>}
                        </div>
                      </article>
                    );
                  })}
                </div>
              )}
            </div>
          );
        })()}
      </div>
    </section>
  )}

  <!-- Control Bar -->
  <section class="nw-bar sticky top-[52px] z-40 px-4 md:px-6" id="controlBar" aria-label="Filter signals">
    <div class="max-w-site mx-auto flex items-center gap-2 py-2.5">
      <div class="nw-bar-scroll">
        <select id="filterCategory" aria-label="Filter by category" class="nw-select">
          <option value="">All Categories</option>
          {categories.map(cat => (
            <option value={cat}>{cat}</option>
          ))}
        </select>
        <select id="filterNetwork" aria-label="Filter by network" class="nw-select">
          <option value="">All Networks</option>
          {relatedSlugs.map(slug => (
            <option value={slug}>{networkMap[slug]}</option>
          ))}
        </select>
        <select id="filterSourceType" aria-label="Filter by source type" class="nw-select">
          <option value="">All Source Types</option>
          {sourceTypes.map(st => (
            <option value={st}>{st}</option>
          ))}
        </select>
        <select id="filterTimeRange" aria-label="Filter by time range" class="nw-select">
          <option value="">All Time</option>
          <option value="30">Last 30 Days</option>
          <option value="90">Last 90 Days</option>
          <option value="365">Last Year</option>
        </select>
        <select id="filterSignificance" aria-label="Filter by significance" class="nw-select">
          <option value="">All Levels</option>
          <option value="major">Major Only</option>
          <option value="standard">Standard</option>
          <option value="brief">Brief</option>
        </select>
        <select id="filterSort" aria-label="Sort" class="nw-select">
          <option value="newest">Newest First</option>
          <option value="oldest">Oldest First</option>
        </select>
      </div>
      <div class="nw-view-toggle" role="group" aria-label="Layout">
        <button id="viewFeed" type="button" class="view-btn is-active" aria-label="Feed view" title="Feed view" aria-pressed="true">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <button id="viewSignals" type="button" class="view-btn" aria-label="Signals grid view" title="Signals view" aria-pressed="false">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
        </button>
      </div>
    </div>
  </section>

  <!-- Trend Pulse Strip -->
  {topTrends.length > 0 && (
    <section class="pt-5 px-4 md:px-6" aria-label="Trending categories">
      <div class="max-w-site mx-auto nw-trends">
        <span class="nw-eyebrow whitespace-nowrap">Trending (90d)</span>
        {topTrends.map(([cat, count]) => (
          <button type="button" class="trend-btn" data-trend-category={cat} aria-pressed="false">
            {cat}
            <span class="trend-count">{count}</span>
          </button>
        ))}
      </div>
    </section>
  )}

  <!-- Article Feed -->
  <section class="pt-5 pb-12 px-4 md:px-6">
    <div class="max-w-site mx-auto">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mb-2 min-h-[36px]">
        <p id="articleCount" class="text-[15px] text-secondary m-0" role="status" aria-live="polite"><strong class="text-primary font-bold">{articles.length}</strong> signals</p>
        <div id="filterSummary" class="hidden flex-wrap items-center gap-1.5">
          <div id="filterChips" class="flex flex-wrap items-center gap-1.5" aria-label="Active filters"></div>
          <button id="clearFilters" type="button" class="nw-clear-all hidden">Clear all</button>
        </div>
        <div class="nw-legend ml-auto" aria-hidden="true">
          <span><i class="nw-legend-major"></i>Major</span>
          <span><i class="nw-legend-standard"></i>Standard</span>
          <span><i class="nw-legend-brief"></i>Brief</span>
        </div>
      </div>

      <!-- Feed View -->
      <div id="feedView" class="nw-feed">
        {monthGroups.map(group => (
          <section class="nw-group" data-month={group.key}>
            <h2 class="nw-group-head">
              <span>{group.label}</span>
              <span class="nw-group-count" data-total={group.items.length}>{group.items.length} signal{group.items.length === 1 ? '' : 's'}</span>
            </h2>
            <div class="nw-group-items">
              {group.items.map(article => {
                const sig = article.data.significance || 'standard';
                const stClass = article.data.sourceType ? sourceTypeClass[article.data.sourceType] : '';
                const date = new Date(`${article.data.date}T00:00:00Z`);
                return (
                  <article
                    class={`news-item nw-item nw-item-${sig}`}
                    data-category={article.data.category}
                    data-networks={article.data.relatedNetworks.join(',')}
                    data-date={article.data.date}
                    data-significance={sig}
                    data-source-type={article.data.sourceType || ''}
                    data-slug={article.data.slug}
                  >
                    <time class="nw-item-date" datetime={article.data.date}>
                      <span class="nw-item-day">{date.getUTCDate()}</span>
                      <span class="nw-item-mon">{date.toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' })}</span>
                    </time>
                    <div class="min-w-0 flex-1">
                      <div class="nw-item-tags">
                        {sig === 'major' && <span class="nw-sig nw-sig-major">Major</span>}
                        {sig === 'brief' && <span class="nw-sig nw-sig-brief">Brief</span>}
                        <span class="nw-cat"><span class="nw-cat-dot" style={`background: ${article.data.categoryColor || '#0071E3'}`} aria-hidden="true"></span>{article.data.category}</span>
                        {article.data.sourceType && <span class={`nw-type ${stClass}`}>{article.data.sourceType}</span>}
                        <span class="nw-item-date-inline">{fmtDate(article.data.date)}</span>
                      </div>
                      <h3 class="nw-item-title">
                        {article.data.sourceUrl ? (
                          <a href={article.data.sourceUrl} target="_blank" rel="noopener noreferrer">{article.data.title}<span class="sr-only"> (opens source in a new tab)</span></a>
                        ) : article.data.title}
                      </h3>
                      {sig !== 'brief' && (
                        <p class="nw-item-summary">{article.data.summary}</p>
                      )}
                      {article.data.whyItMatters && sig === 'major' && (
                        <div class="nw-why">
                          <span class="nw-why-label">Why it matters</span>
                          <p>{article.data.whyItMatters}</p>
                        </div>
                      )}
                      <div class="nw-item-meta">
                        <span class="nw-item-source">{article.data.source}</span>
                        {article.data.relatedNetworks.map((s: string) => networkMap[s] ? (
                          <a href={`/networks/${s}`} class="nw-net-chip">
                            {networkLogoMap[s] && <img src={networkLogoMap[s]} alt="" width="16" height="16" class="w-4 h-4 rounded object-contain bg-white" loading="lazy" />}
                            {networkMap[s]}
                          </a>
                        ) : null)}
                        {article.data.sourceUrl && (
                          <a href={article.data.sourceUrl} target="_blank" rel="noopener noreferrer" class="nw-source-link" aria-label={`Source for: ${article.data.title} (opens in a new tab)`}>
                            Source
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
                          </a>
                        )}
                      </div>
                    </div>
                  </article>
                );
              })}
            </div>
          </section>
        ))}
      </div>

      <!-- Signals View (grid, rendered client-side) -->
      <div id="signalsView" class="hidden grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mt-4"></div>

      <div id="noResults" class="nw-empty hidden">
        <div class="nw-empty-icon" aria-hidden="true">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 5h16M7 12h10M10 19h4"/></svg>
        </div>
        <h2 class="text-[17px] font-bold text-primary">No signals match your filters</h2>
        <p class="mt-1 text-[14px] text-secondary">Try a wider time range or remove a filter.</p>
        <button id="emptyClear" type="button" class="nw-btn-primary mt-5">Clear all filters</button>
      </div>
    </div>
  </section>

  <!-- Network Profile Integration -->
  <section class="py-10 px-4 md:px-6 bg-bg-secondary/60 border-t border-border/40">
    <div class="max-w-site mx-auto">
      <h2 class="text-[20px] font-bold tracking-tight text-primary">Coverage by network</h2>
      <p class="text-[14px] text-secondary mt-1 mb-4">Select a network to filter the feed above.</p>
      <div class="flex flex-wrap gap-2">
        {relatedSlugs.map(slug => {
          const count = articles.filter(a => a.data.relatedNetworks.includes(slug)).length;
          const logo = networkLogoMap[slug];
          return (
            <a href={`/networks/${slug}`} class="network-coverage-chip" data-network-slug={slug}>
              {logo ? (
                <img src={logo} alt="" width="20" height="20" class="w-5 h-5 rounded-md object-contain bg-white" loading="lazy" />
              ) : (
                <span class="w-5 h-5 rounded-md inline-flex items-center justify-center" style={`background: linear-gradient(135deg, ${networkGradientMap[slug]?.from || '#333'}, ${networkGradientMap[slug]?.to || '#666'})`} aria-hidden="true">
                  <span class="text-[8px] text-white font-bold">{networkMap[slug]?.[0]}</span>
                </span>
              )}
              {networkMap[slug]}
              <span class="trend-count">{count}</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <script is:inline type="application/json" id="newsClientData" set:html={JSON.stringify(articleClientData)}></script>
</BaseLayout>

<script>
  // @ts-nocheck
  const newsClientDataEl = document.getElementById('newsClientData');
  const articleClientData = newsClientDataEl ? JSON.parse(newsClientDataEl.textContent || '{}') : {};
  const filterCategory = document.getElementById('filterCategory');
  const filterNetwork = document.getElementById('filterNetwork');
  const filterSourceType = document.getElementById('filterSourceType');
  const filterTimeRange = document.getElementById('filterTimeRange');
  const filterSignificance = document.getElementById('filterSignificance');
  const filterSort = document.getElementById('filterSort');
  const clearBtn = document.getElementById('clearFilters');
  const emptyClear = document.getElementById('emptyClear');
  const items = Array.from(document.querySelectorAll('.news-item'));
  const groups = Array.from(document.querySelectorAll('.nw-group'));
  const articleCount = document.getElementById('articleCount');
  const noResults = document.getElementById('noResults');
  const feedView = document.getElementById('feedView');
  const signalsView = document.getElementById('signalsView');
  const viewFeedBtn = document.getElementById('viewFeed');
  const viewSignalsBtn = document.getElementById('viewSignals');
  const filterSummary = document.getElementById('filterSummary');
  const filterChips = document.getElementById('filterChips');
  const trendBtns = Array.from(document.querySelectorAll('.trend-btn'));
  const coverageChips = Array.from(document.querySelectorAll('.network-coverage-chip'));
  const controlBar = document.getElementById('controlBar');

  const totalCount = items.length;
  let currentView = 'feed';
  let lastVisible = items.slice();

  /* Each filter owns its URL key so state survives reload and sharing. */
  const filters = [
    { el: filterCategory, key: 'category', label: v => v },
    { el: filterNetwork, key: 'network', label: () => filterNetwork?.options[filterNetwork.selectedIndex]?.text || '' },
    { el: filterSourceType, key: 'sourceType', label: v => v },
    { el: filterTimeRange, key: 'time', label: v => ({ '30': 'Last 30 days', '90': 'Last 90 days', '365': 'Last year' }[v] || v) },
    { el: filterSignificance, key: 'significance', label: v => `${v.charAt(0).toUpperCase()}${v.slice(1)}` },
  ];

  // Source type badge classes (client-side mirror)
  const stClassMap = {
    'Press Release': 'nw-type-press',
    'Industry Report': 'nw-type-report',
    'News Coverage': 'nw-type-news',
    'Regulatory': 'nw-type-reg',
    'Product Update': 'nw-type-product',
  };

  const esc = (value) => String(value ?? '').replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
  const dateOf = (item) => new Date(`${item.getAttribute('data-date') || ''}T00:00:00Z`).getTime();
  const fmt = (iso) => new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
  const arrow = '<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>';

  function syncUrl() {
    const params = new URLSearchParams();
    filters.forEach(f => { if (f.el?.value) params.set(f.key, f.el.value); });
    if (filterSort?.value === 'oldest') params.set('sort', 'oldest');
    if (currentView === 'signals') params.set('view', 'signals');
    const qs = params.toString();
    window.history.replaceState({}, '', qs ? `${window.location.pathname}?${qs}` : window.location.pathname);
  }

  function applyFilters() {
    const cat = filterCategory?.value || '';
    const net = filterNetwork?.value || '';
    const st = filterSourceType?.value || '';
    const timeRange = filterTimeRange?.value || '';
    const sig = filterSignificance?.value || '';
    const newestFirst = (filterSort?.value || 'newest') !== 'oldest';
    const timeThreshold = timeRange ? Date.now() - parseInt(timeRange, 10) * 24 * 60 * 60 * 1000 : 0;

    items.forEach(item => {
      const match =
        (!cat || item.getAttribute('data-category') === cat) &&
        (!net || (item.getAttribute('data-networks') || '').split(',').includes(net)) &&
        (!st || item.getAttribute('data-source-type') === st) &&
        (!sig || item.getAttribute('data-significance') === sig) &&
        (!timeRange || dateOf(item) >= timeThreshold);
      item.style.display = match ? '' : 'none';
    });

    /* Re-order inside each month, hide empty months, then order the months themselves. */
    const visible = [];
    const orderedGroups = groups.slice().sort((a, b) => {
      const cmp = (a.getAttribute('data-month') || '').localeCompare(b.getAttribute('data-month') || '');
      return newestFirst ? -cmp : cmp;
    });
    orderedGroups.forEach(group => {
      const container = group.querySelector('.nw-group-items');
      const groupItems = Array.from(group.querySelectorAll('.news-item')).sort((a, b) => newestFirst ? dateOf(b) - dateOf(a) : dateOf(a) - dateOf(b));
      groupItems.forEach(item => container?.appendChild(item));
      const shown = groupItems.filter(item => item.style.display !== 'none');
      group.hidden = shown.length === 0;
      const countEl = group.querySelector('.nw-group-count');
      if (countEl) {
        const total = Number(countEl.getAttribute('data-total') || groupItems.length);
        countEl.textContent = shown.length === total ? `${total} signal${total === 1 ? '' : 's'}` : `${shown.length} of ${total}`;
      }
      visible.push(...shown);
      feedView?.appendChild(group);
    });
    lastVisible = visible;

    const count = visible.length;
    if (articleCount) {
      articleCount.innerHTML = `<strong class="text-primary font-bold">${count}</strong> ${count === totalCount ? '' : `of ${totalCount} `}signal${count !== 1 ? 's' : ''}`;
    }
    const empty = count === 0;
    noResults?.classList.toggle('hidden', !empty);
    feedView?.classList.toggle('hidden', empty || currentView !== 'feed');
    signalsView?.classList.toggle('hidden', empty || currentView !== 'signals');

    updateFilterSummary();
    filters.forEach(f => f.el?.classList.toggle('is-set', Boolean(f.el.value)));
    filterSort?.classList.toggle('is-set', !newestFirst);
    trendBtns.forEach(btn => {
      const on = btn.getAttribute('data-trend-category') === cat && cat !== '';
      btn.classList.toggle('is-active', on);
      btn.setAttribute('aria-pressed', String(on));
    });
    coverageChips.forEach(chip => chip.classList.toggle('is-active', chip.getAttribute('data-network-slug') === net && net !== ''));

    syncUrl();
    if (currentView === 'signals') renderSignalsView(visible);
  }

  function updateFilterSummary() {
    const active = filters.filter(f => f.el?.value);
    if (filterChips) {
      filterChips.innerHTML = active.map(f =>
        `<button type="button" class="nw-active-chip" data-clear="${esc(f.key)}" aria-label="Remove filter: ${esc(f.label(f.el.value))}"><span>${esc(f.label(f.el.value))}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></button>`
      ).join('');
    }
    filterSummary?.classList.toggle('hidden', active.length === 0);
    filterSummary?.classList.toggle('flex', active.length > 0);
    clearBtn?.classList.toggle('hidden', active.length < 2);
  }

  function renderSignalsView(visibleItems) {
    if (!signalsView) return;
    signalsView.innerHTML = visibleItems.map(item => {
      const slug = item.getAttribute('data-slug') || '';
      const data = articleClientData[slug];
      if (!data) return '';
      const sig = item.getAttribute('data-significance') || 'standard';
      const cat = item.getAttribute('data-category') || '';
      const sourceType = item.getAttribute('data-source-type') || '';
      const date = item.getAttribute('data-date') || '';
      const title = data.sourceUrl
        ? `<a href="${esc(data.sourceUrl)}" target="_blank" rel="noopener noreferrer">${esc(data.title)}<span class="sr-only"> (opens source in a new tab)</span></a>`
        : esc(data.title);
      const tags = (data.impactTags || []).slice(0, 3).map(tag => `<span class="nw-tag">${esc(tag)}</span>`).join('');

      return `<article class="nw-card nw-card-${esc(sig)}">
        <div class="flex items-center gap-2 mb-2.5">
          ${sig === 'major' ? '<span class="nw-sig nw-sig-major">Major</span>' : sig === 'brief' ? '<span class="nw-sig nw-sig-brief">Brief</span>' : ''}
          ${sourceType ? `<span class="nw-type ${stClassMap[sourceType] || ''}">${esc(sourceType)}</span>` : ''}
          <time class="text-[12px] text-secondary ml-auto whitespace-nowrap" datetime="${esc(date)}">${fmt(date)}</time>
        </div>
        <h3 class="nw-card-title">${title}</h3>
        ${sig !== 'brief' ? `<p class="nw-card-summary line-clamp-3">${esc(data.summary)}</p>` : ''}
        ${data.whyItMatters && sig === 'major' ? `<div class="nw-why"><span class="nw-why-label">Why it matters</span><p>${esc(data.whyItMatters)}</p></div>` : ''}
        ${tags ? `<div class="flex flex-wrap gap-1.5 mt-3">${tags}</div>` : ''}
        <div class="nw-card-foot">
          <span class="nw-cat"><span class="nw-cat-dot" style="background: ${esc(data.categoryColor)}" aria-hidden="true"></span>${esc(cat)}</span>
          <span class="nw-item-source truncate">${esc(data.source)}</span>
          ${data.sourceUrl ? `<a href="${esc(data.sourceUrl)}" target="_blank" rel="noopener noreferrer" class="nw-source-link" aria-label="Source for: ${esc(data.title)} (opens in a new tab)">Source ${arrow}</a>` : ''}
        </div>
      </article>`;
    }).join('');
  }

  // View toggle
  function setView(view, sync = true) {
    currentView = view === 'signals' ? 'signals' : 'feed';
    const isFeed = currentView === 'feed';
    const empty = lastVisible.length === 0;
    feedView?.classList.toggle('hidden', !isFeed || empty);
    signalsView?.classList.toggle('hidden', isFeed || empty);
    viewFeedBtn?.classList.toggle('is-active', isFeed);
    viewSignalsBtn?.classList.toggle('is-active', !isFeed);
    viewFeedBtn?.setAttribute('aria-pressed', String(isFeed));
    viewSignalsBtn?.setAttribute('aria-pressed', String(!isFeed));
    if (!isFeed) renderSignalsView(lastVisible);
    if (sync) syncUrl();
  }

  viewFeedBtn?.addEventListener('click', () => setView('feed'));
  viewSignalsBtn?.addEventListener('click', () => setView('signals'));

  // Filter listeners
  [...filters.map(f => f.el), filterSort].forEach(el => el?.addEventListener('change', applyFilters));

  function clearAll() {
    filters.forEach(f => { if (f.el) f.el.value = ''; });
    if (filterSort) filterSort.value = 'newest';
    applyFilters();
  }
  clearBtn?.addEventListener('click', clearAll);
  emptyClear?.addEventListener('click', clearAll);

  filterChips?.addEventListener('click', (event) => {
    const button = event.target instanceof Element ? event.target.closest('[data-clear]') : null;
    if (!button) return;
    const filter = filters.find(f => f.key === button.getAttribute('data-clear'));
    if (filter?.el) filter.el.value = '';
    applyFilters();
  });

  function scrollToBar() {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    controlBar?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
  }

  // Trend buttons → toggle category filter
  trendBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const trendCat = btn.getAttribute('data-trend-category') || '';
      if (!filterCategory) return;
      filterCategory.value = filterCategory.value === trendCat ? '' : trendCat;
      applyFilters();
    });
  });

  // Network coverage chips → set network filter
  coverageChips.forEach(chip => {
    chip.addEventListener('click', (e) => {
      const slug = chip.getAttribute('data-network-slug') || '';
      if (!filterNetwork || !slug) return;
      /* Let modified clicks (new tab etc.) follow the profile link as normal. */
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
      e.preventDefault();
      filterNetwork.value = slug;
      applyFilters();
      scrollToBar();
    });
  });

  // URL parameter support
  function restoreFromUrl() {
    const params = new URLSearchParams(window.location.search);
    filters.forEach(f => {
      const value = params.get(f.key);
      if (value && f.el && Array.from(f.el.options).some(option => option.value === value)) f.el.value = value;
    });
    if (params.get('sort') === 'oldest' && filterSort) filterSort.value = 'oldest';
    if (params.get('view') === 'signals') currentView = 'signals';
  }

  restoreFromUrl();
  applyFilters();
  setView(currentView, false);
</script>


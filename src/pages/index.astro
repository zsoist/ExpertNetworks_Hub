---
import BaseLayout from '../layouts/BaseLayout.astro';
import NetworkCard from '../components/NetworkCard.astro';
import CompareTable from '../components/CompareTable.astro';
import TrackedNetworksMarquee from '../components/TrackedNetworksMarquee.astro';
import { getCollection } from 'astro:content';

const allNetworks = await getCollection('networks');
const allNews = await getCollection('news');

const publishedNetworks = allNetworks
  .filter(n => n.data.published)
  .sort((a, b) => a.data.priority - b.data.priority);

const top7 = publishedNetworks.slice(0, 7);
const featuredNetworks = publishedNetworks.filter(n => n.data.featured);

const publishedNews = allNews
  .filter(n => n.data.published)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const networkLogoMap: Record<string, string> = Object.fromEntries(
  allNetworks.filter(n => n.data.published && n.data.logo).map(n => [n.data.slug, n.data.logo])
);
---

<BaseLayout
  description={`Independent expert network intelligence hub tracking ${publishedNetworks.length} providers — compare pricing, compliance, expert pools, and AI capabilities across GLG, AlphaSights, Third Bridge, and more.`}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "ExpertNetworks.net",
    "url": "https://expertnetworks.net",
    "description": `Independent expert network intelligence hub tracking ${publishedNetworks.length} providers.`,
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://expertnetworks.net/networks?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  }}
>
  <!-- Hero — dark interactive intelligence surface -->
  <section class="relative overflow-hidden bg-[#0d0d0f]" id="top" style="min-height: 260px;">
    <!-- Layer 1–3: Canvas (particles + reveal) -->
    <canvas id="heroCanvas" class="absolute inset-0 w-full h-full" style="pointer-events: none;" role="presentation" aria-hidden="true"></canvas>
    <!-- Layer 4: Readability vignette -->
    <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse at 50% 40%, transparent 30%, rgba(13,13,15,0.55) 100%);"></div>
    <!-- Layer 5: Content -->
    <div class="relative z-10 pt-[88px] pb-12 md:pt-[100px] md:pb-14 px-6" id="heroContent">
      <div class="max-w-site mx-auto text-center">
        <h1 id="heroTitle" class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-white" aria-label="The Expert Network Hub"><span id="heroTitleText"></span><span id="heroTitleCursor" class="inline-block w-[3px] h-[0.85em] bg-white/70 align-middle ml-0.5 animate-[heroBlink_0.53s_steps(2)_infinite]"></span></h1>
        <p id="heroSubtext" class="text-[#a1a1a6] text-sm md:text-base mt-4 leading-relaxed max-w-2xl mx-auto opacity-0 transition-opacity duration-700">Your open guide to the expert network industry. Compare {publishedNetworks.length} providers — pricing, compliance, expert pools, and AI tools — all in one place. No sign-ups, no bias. Explore freely.</p>
        <div id="heroCtas" class="flex gap-3 justify-center mt-6 opacity-0 transition-opacity duration-700">
          <a href="/networks" class="inline-flex items-center gap-1.5 px-5 py-2.5 bg-accent text-white text-sm font-semibold rounded-lg no-underline hover:bg-accent-hover transition-colors">
            Browse All
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
          <a href="/compare" class="inline-flex items-center gap-1.5 px-5 py-2.5 bg-[rgba(255,255,255,0.08)] text-[#e5e5ea] text-sm font-semibold rounded-lg no-underline hover:bg-[rgba(255,255,255,0.14)] transition-colors border border-[rgba(255,255,255,0.08)]">Compare</a>
        </div>
      </div>
    </div>
  </section>

  <style>
    @keyframes heroBlink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0; }
    }
  </style>

  <script>
  // ─── Typewriter effect for hero title ───
  (function() {
    const TITLE_TEXT = 'The Expert Network Hub';
    const TYPE_DELAY = 32;       // ms per character — fast, like real typing
    const START_DELAY = 300;     // ms before typing starts
    const CURSOR_LINGER = 500;   // ms cursor stays after typing finishes

    const textEl = document.getElementById('heroTitleText');
    const cursorEl = document.getElementById('heroTitleCursor');
    const subtext = document.getElementById('heroSubtext');
    const ctas = document.getElementById('heroCtas');
    if (!textEl || !cursorEl) return;

    // Respect reduced motion — show instantly
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      textEl.textContent = TITLE_TEXT;
      cursorEl.style.display = 'none';
      if (subtext) subtext.style.opacity = '1';
      if (ctas) ctas.style.opacity = '1';
      return;
    }

    let i = 0;
    function typeNext() {
      if (i < TITLE_TEXT.length) {
        textEl.textContent += TITLE_TEXT[i];
        i++;
        setTimeout(typeNext, TYPE_DELAY);
      } else {
        // Typing done — fade in subtext and CTAs, then hide cursor
        if (subtext) subtext.style.opacity = '1';
        if (ctas) ctas.style.opacity = '1';
        setTimeout(function() {
          cursorEl.style.transition = 'opacity 0.4s';
          cursorEl.style.opacity = '0';
        }, CURSOR_LINGER);
      }
    }

    setTimeout(typeNext, START_DELAY);
  })();
  </script>

  <script>
  (function() {
    // ─── Tuning constants ───
    const PARTICLE_COUNT_DESKTOP = 110;
    const PARTICLE_COUNT_TABLET = 65;
    const PARTICLE_COUNT_MOBILE = 35;
    const MAX_CONNECTION_DIST = 140;
    const MAX_CONNECTION_DIST_SQ = MAX_CONNECTION_DIST * MAX_CONNECTION_DIST;
    const LINE_OPACITY = 0.09;
    const BASE_PARTICLE_OPACITY = 0.4;
    const IDLE_DRIFT_STRENGTH = 0.18;
    const POINTER_INFLUENCE_RADIUS = 180;
    const POINTER_INFLUENCE_RADIUS_SQ = POINTER_INFLUENCE_RADIUS * POINTER_INFLUENCE_RADIUS;
    const POINTER_REPULSION_STRENGTH = 130;
    const REVEAL_RADIUS = 200;
    const REVEAL_RADIUS_SQ = REVEAL_RADIUS * REVEAL_RADIUS;
    const REVEAL_OPACITY_BOOST = 0.5;
    const RECOVERY_SPEED = 0.018;
    const INTERPOLATION_FACTOR = 0.12;
    const CLICK_PULSE_STRENGTH = 200;
    const CLICK_PULSE_DURATION = 500;
    const DPR_CAP = 2;

    // ─── Reveal layer constants ───
    const REVEAL_PARTICLE_COUNT_DESKTOP = 140;
    const REVEAL_PARTICLE_COUNT_TABLET = 80;
    const REVEAL_PARTICLE_COUNT_MOBILE = 45;
    const REVEAL_MAX_CONNECTION_DIST = 110;
    const REVEAL_MAX_CONNECTION_DIST_SQ = REVEAL_MAX_CONNECTION_DIST * REVEAL_MAX_CONNECTION_DIST;
    const REVEAL_LINE_OPACITY = 0.22;
    const REVEAL_PARTICLE_OPACITY = 0.6;

    const canvas = document.getElementById('heroCanvas');
    const hero = document.getElementById('top');
    if (!canvas || !hero) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    // ─── Reduced motion — live query (responds to mid-session changes) ───
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    let prefersReducedMotion = motionQuery.matches;

    // ─── Responsive tier ───
    function getTier() {
      const w = window.innerWidth;
      if (w >= 1024) return 'desktop';
      if (w >= 640) return 'tablet';
      return 'mobile';
    }

    function getParticleCount(tier) {
      if (tier === 'desktop') return PARTICLE_COUNT_DESKTOP;
      if (tier === 'tablet') return PARTICLE_COUNT_TABLET;
      return PARTICLE_COUNT_MOBILE;
    }

    function getRevealCount(tier) {
      if (tier === 'desktop') return REVEAL_PARTICLE_COUNT_DESKTOP;
      if (tier === 'tablet') return REVEAL_PARTICLE_COUNT_TABLET;
      return REVEAL_PARTICLE_COUNT_MOBILE;
    }

    // ─── State ───
    let pointer = { x: -9999, y: -9999 };
    let smoothPointer = { x: -9999, y: -9999 };
    let isPointerInside = false;
    let clickPulse = { active: false, x: 0, y: 0, startTime: 0 };
    let particles = [];
    let revealParticles = [];
    let animationId = null;
    let isVisible = true;
    let currentTier = getTier();
    let cachedW = 0;
    let cachedH = 0;
    let lastTime = 0;

    // ─── Particle factory ───
    function createParticle(w, h) {
      return {
        x: Math.random() * w,
        y: Math.random() * h,
        homeX: 0, homeY: 0,
        vx: (Math.random() - 0.5) * IDLE_DRIFT_STRENGTH,
        vy: (Math.random() - 0.5) * IDLE_DRIFT_STRENGTH,
        size: 1 + Math.random() * 1.2,
        opacity: BASE_PARTICLE_OPACITY * (0.4 + Math.random() * 0.6),
      };
    }

    function createRevealParticle(w, h) {
      return {
        x: Math.random() * w,
        y: Math.random() * h,
        size: 0.8 + Math.random() * 0.8,
        opacity: REVEAL_PARTICLE_OPACITY * (0.5 + Math.random() * 0.5),
      };
    }

    // ─── Resize (caches dimensions to avoid per-frame layout thrashing) ───
    function resize() {
      const rect = hero.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, DPR_CAP);
      cachedW = rect.width;
      cachedH = rect.height;
      canvas.width = cachedW * dpr;
      canvas.height = cachedH * dpr;
      canvas.style.width = cachedW + 'px';
      canvas.style.height = cachedH + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const newTier = getTier();
      const needsRebuild = (newTier !== currentTier) || particles.length === 0;
      currentTier = newTier;

      if (needsRebuild) {
        const count = getParticleCount(currentTier);
        const revCount = getRevealCount(currentTier);
        particles = [];
        revealParticles = [];
        for (let i = 0; i < count; i++) {
          const p = createParticle(cachedW, cachedH);
          p.homeX = p.x;
          p.homeY = p.y;
          particles.push(p);
        }
        for (let i = 0; i < revCount; i++) {
          revealParticles.push(createRevealParticle(cachedW, cachedH));
        }
      } else {
        for (const p of particles) {
          p.homeX = Math.min(p.homeX, cachedW);
          p.homeY = Math.min(p.homeY, cachedH);
          p.x = Math.min(p.x, cachedW);
          p.y = Math.min(p.y, cachedH);
        }
      }
    }

    // ─── Pointer events ───
    function onPointerMove(e) {
      const rect = hero.getBoundingClientRect();
      pointer.x = e.clientX - rect.left;
      pointer.y = e.clientY - rect.top;
      isPointerInside = true;
    }
    function onPointerLeave() {
      isPointerInside = false;
    }
    function onClick(e) {
      const rect = hero.getBoundingClientRect();
      clickPulse.active = true;
      clickPulse.x = e.clientX - rect.left;
      clickPulse.y = e.clientY - rect.top;
      clickPulse.startTime = performance.now();
    }
    function onTouchStart(e) {
      if (e.touches.length > 0) {
        const rect = hero.getBoundingClientRect();
        pointer.x = e.touches[0].clientX - rect.left;
        pointer.y = e.touches[0].clientY - rect.top;
        isPointerInside = true;
      }
    }
    function onTouchMove(e) {
      if (e.touches.length > 0) {
        const rect = hero.getBoundingClientRect();
        pointer.x = e.touches[0].clientX - rect.left;
        pointer.y = e.touches[0].clientY - rect.top;
        isPointerInside = true;
      }
    }
    function onTouchEnd() {
      isPointerInside = false;
    }

    hero.addEventListener('mousemove', onPointerMove, { passive: true });
    hero.addEventListener('mouseleave', onPointerLeave, { passive: true });
    hero.addEventListener('click', onClick);
    hero.addEventListener('touchstart', onTouchStart, { passive: true });
    hero.addEventListener('touchmove', onTouchMove, { passive: true });
    hero.addEventListener('touchend', onTouchEnd, { passive: true });
    hero.addEventListener('touchcancel', onTouchEnd, { passive: true });

    // ─── Intersection Observer ───
    const observer = new IntersectionObserver(function(entries) {
      isVisible = entries[0].isIntersecting;
    }, { threshold: 0.05 });
    observer.observe(hero);

    // ─── Visibility change — pause when tab hidden to save CPU/battery ───
    function onVisibilityChange() {
      if (document.hidden) {
        if (animationId) {
          cancelAnimationFrame(animationId);
          animationId = null;
        }
      } else if (!prefersReducedMotion && !animationId) {
        lastTime = 0; // reset delta to avoid huge jump
        animationId = requestAnimationFrame(draw);
      }
    }
    document.addEventListener('visibilitychange', onVisibilityChange);

    // ─── Draw (frame-rate independent via delta time) ───
    function draw(now) {
      animationId = requestAnimationFrame(draw);
      if (!isVisible) return;

      // Delta time normalized to 60fps; capped at 3 frames to prevent jumps
      var dt = lastTime ? Math.min((now - lastTime) / 16.667, 3) : 1;
      lastTime = now;

      var w = cachedW;
      var h = cachedH;
      ctx.clearRect(0, 0, w, h);

      // Smooth pointer interpolation
      if (isPointerInside) {
        smoothPointer.x += (pointer.x - smoothPointer.x) * INTERPOLATION_FACTOR;
        smoothPointer.y += (pointer.y - smoothPointer.y) * INTERPOLATION_FACTOR;
      } else {
        smoothPointer.x += (-9999 - smoothPointer.x) * 0.02;
        smoothPointer.y += (-9999 - smoothPointer.y) * 0.02;
      }

      // Click pulse calculation
      var pulseStrength = 0;
      var pulseRadius = 0;
      var pulseRadiusSq = 0;
      if (clickPulse.active) {
        var elapsed = now - clickPulse.startTime;
        if (elapsed > CLICK_PULSE_DURATION) {
          clickPulse.active = false;
        } else {
          var t = elapsed / CLICK_PULSE_DURATION;
          pulseStrength = CLICK_PULSE_STRENGTH * (1 - t);
          pulseRadius = POINTER_INFLUENCE_RADIUS * (1 + t * 1.5);
          pulseRadiusSq = pulseRadius * pulseRadius;
        }
      }

      var spx = smoothPointer.x;
      var spy = smoothPointer.y;
      var revealActive = spx > -1000 && spy > -1000;

      // ─── Layer 3: Reveal particles (hidden intelligence mesh) ───
      if (revealActive) {
        // Draw reveal connections (use globalAlpha to avoid string alloc)
        ctx.strokeStyle = 'rgb(120,140,170)';
        ctx.lineWidth = 0.5;
        for (var i = 0; i < revealParticles.length; i++) {
          var a = revealParticles[i];
          var dxA = a.x - spx;
          var dyA = a.y - spy;
          var distSqA = dxA * dxA + dyA * dyA;
          if (distSqA > REVEAL_RADIUS_SQ) continue;
          var distA = Math.sqrt(distSqA);
          var alphaA = 1 - (distA / REVEAL_RADIUS);

          for (var j = i + 1; j < revealParticles.length; j++) {
            var b = revealParticles[j];
            var dxB = b.x - spx;
            var dyB = b.y - spy;
            var distSqB = dxB * dxB + dyB * dyB;
            if (distSqB > REVEAL_RADIUS_SQ) continue;

            var dxAB = a.x - b.x;
            var dyAB = a.y - b.y;
            var distSqAB = dxAB * dxAB + dyAB * dyAB;
            if (distSqAB > REVEAL_MAX_CONNECTION_DIST_SQ) continue;

            var distB = Math.sqrt(distSqB);
            var distAB = Math.sqrt(distSqAB);
            var alphaB = 1 - (distB / REVEAL_RADIUS);
            var lineFade = 1 - (distAB / REVEAL_MAX_CONNECTION_DIST);
            ctx.globalAlpha = REVEAL_LINE_OPACITY * alphaA * alphaB * lineFade;
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.stroke();
          }
        }

        // Draw reveal particles
        ctx.fillStyle = 'rgb(140,160,190)';
        for (var i = 0; i < revealParticles.length; i++) {
          var p = revealParticles[i];
          var dx = p.x - spx;
          var dy = p.y - spy;
          var distSq = dx * dx + dy * dy;
          if (distSq > REVEAL_RADIUS_SQ) continue;
          var proximity = 1 - (Math.sqrt(distSq) / REVEAL_RADIUS);
          ctx.globalAlpha = p.opacity * proximity * REVEAL_OPACITY_BOOST;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      // ─── Layer 2: Primary particles ───
      ctx.fillStyle = 'rgb(180,180,190)';
      for (var i = 0; i < particles.length; i++) {
        var p = particles[i];
        // Ambient drift (frame-rate independent)
        p.x += p.vx * dt;
        p.y += p.vy * dt;

        // Pointer repulsion (squared distance for early rejection)
        var dx = p.x - spx;
        var dy = p.y - spy;
        var distSq = dx * dx + dy * dy;
        if (distSq < POINTER_INFLUENCE_RADIUS_SQ && distSq > 0) {
          var dist = Math.sqrt(distSq);
          var proximity = 1 - dist / POINTER_INFLUENCE_RADIUS;
          var force = proximity * proximity * POINTER_REPULSION_STRENGTH;
          p.x += (dx / dist) * force * 0.04 * dt;
          p.y += (dy / dist) * force * 0.04 * dt;
        }

        // Click pulse repulsion
        if (clickPulse.active && pulseStrength > 0) {
          var cdx = p.x - clickPulse.x;
          var cdy = p.y - clickPulse.y;
          var cdistSq = cdx * cdx + cdy * cdy;
          if (cdistSq < pulseRadiusSq && cdistSq > 0) {
            var cdist = Math.sqrt(cdistSq);
            var pProx = 1 - cdist / pulseRadius;
            var pForce = pProx * pProx * pulseStrength;
            p.x += (cdx / cdist) * pForce * 0.06 * dt;
            p.y += (cdy / cdist) * pForce * 0.06 * dt;
          }
        }

        // Recovery toward home (frame-rate independent exponential decay)
        var recoveryFactor = 1 - Math.pow(1 - RECOVERY_SPEED, dt);
        p.x += (p.homeX - p.x) * recoveryFactor;
        p.y += (p.homeY - p.y) * recoveryFactor;

        // Bounds wrap
        if (p.x < -10) p.x = w + 10;
        if (p.x > w + 10) p.x = -10;
        if (p.y < -10) p.y = h + 10;
        if (p.y > h + 10) p.y = -10;

        // Draw particle (globalAlpha avoids per-particle string allocation)
        ctx.globalAlpha = p.opacity;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fill();
      }

      // ─── Connections between primary particles ───
      ctx.strokeStyle = 'rgb(180,180,190)';
      ctx.lineWidth = 0.5;
      for (var i = 0; i < particles.length; i++) {
        for (var j = i + 1; j < particles.length; j++) {
          var a = particles[i];
          var b = particles[j];
          var dxAB = a.x - b.x;
          var dyAB = a.y - b.y;
          var distSqAB = dxAB * dxAB + dyAB * dyAB;
          if (distSqAB > MAX_CONNECTION_DIST_SQ) continue;
          var distAB = Math.sqrt(distSqAB);
          var lineFade = 1 - (distAB / MAX_CONNECTION_DIST);

          // Lines near cursor become stressed (fade/break)
          var stress = 1;
          var midX = (a.x + b.x) * 0.5;
          var midY = (a.y + b.y) * 0.5;
          var midDx = midX - spx;
          var midDy = midY - spy;
          var midDistSq = midDx * midDx + midDy * midDy;
          if (midDistSq < POINTER_INFLUENCE_RADIUS_SQ) {
            stress = Math.sqrt(midDistSq) / POINTER_INFLUENCE_RADIUS;
            stress = stress * stress;
          }

          ctx.globalAlpha = LINE_OPACITY * lineFade * stress;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.stroke();
        }
      }

      // ─── Click pulse ring ───
      if (clickPulse.active) {
        var elapsed = now - clickPulse.startTime;
        var t = elapsed / CLICK_PULSE_DURATION;
        var ringRadius = 20 + t * POINTER_INFLUENCE_RADIUS * 1.2;
        ctx.strokeStyle = 'rgb(120,150,200)';
        ctx.globalAlpha = 0.15 * (1 - t);
        ctx.lineWidth = 1.5 * (1 - t);
        ctx.beginPath();
        ctx.arc(clickPulse.x, clickPulse.y, ringRadius, 0, Math.PI * 2);
        ctx.stroke();
      }

      // Reset globalAlpha to avoid bleeding into other canvas operations
      ctx.globalAlpha = 1;
    }

    // ─── Static fallback for reduced motion ───
    function drawStatic() {
      resize();
      ctx.clearRect(0, 0, cachedW, cachedH);
      ctx.fillStyle = 'rgb(180,180,190)';
      for (var i = 0; i < particles.length; i++) {
        var p = particles[i];
        ctx.globalAlpha = p.opacity * 0.7;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.strokeStyle = 'rgb(180,180,190)';
      ctx.lineWidth = 0.5;
      for (var i = 0; i < particles.length; i++) {
        for (var j = i + 1; j < particles.length; j++) {
          var a = particles[i];
          var b = particles[j];
          var dxAB = a.x - b.x;
          var dyAB = a.y - b.y;
          var distSqAB = dxAB * dxAB + dyAB * dyAB;
          if (distSqAB > MAX_CONNECTION_DIST_SQ) continue;
          var distAB = Math.sqrt(distSqAB);
          var lineFade = 1 - (distAB / MAX_CONNECTION_DIST);
          ctx.globalAlpha = LINE_OPACITY * lineFade * 0.7;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.stroke();
        }
      }
      ctx.globalAlpha = 1;
    }

    // ─── Cleanup — removes all listeners, stops animation ───
    function cleanup() {
      if (animationId) {
        cancelAnimationFrame(animationId);
        animationId = null;
      }
      observer.disconnect();
      hero.removeEventListener('mousemove', onPointerMove);
      hero.removeEventListener('mouseleave', onPointerLeave);
      hero.removeEventListener('click', onClick);
      hero.removeEventListener('touchstart', onTouchStart);
      hero.removeEventListener('touchmove', onTouchMove);
      hero.removeEventListener('touchend', onTouchEnd);
      hero.removeEventListener('touchcancel', onTouchEnd);
      document.removeEventListener('visibilitychange', onVisibilityChange);
      window.removeEventListener('resize', debouncedResize);
      motionQuery.removeEventListener('change', onMotionChange);
    }

    // ─── Respond to reduced motion preference changes mid-session ───
    function onMotionChange(e) {
      prefersReducedMotion = e.matches;
      if (prefersReducedMotion) {
        if (animationId) {
          cancelAnimationFrame(animationId);
          animationId = null;
        }
        drawStatic();
      } else {
        if (!animationId) {
          lastTime = 0;
          animationId = requestAnimationFrame(draw);
        }
      }
    }
    motionQuery.addEventListener('change', onMotionChange);

    // ─── Init ───
    if (prefersReducedMotion) {
      drawStatic();
    } else {
      resize();
      lastTime = 0;
      animationId = requestAnimationFrame(draw);
    }

    var resizeTimeout;
    function debouncedResize() {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(function() {
        resize();
        if (prefersReducedMotion) drawStatic();
      }, 150);
    }
    window.addEventListener('resize', debouncedResize, { passive: true });

    // Clean up if page is torn down (e.g. Astro view transitions)
    window.addEventListener('beforeunload', cleanup);
  })();
  </script>

  <script>
  // ─── Homepage nav dark mode ───
  // Make the nav white-on-dark while over the hero, revert when scrolled past
  (function() {
    const nav = document.querySelector('nav');
    const heroSection = document.getElementById('top');
    if (!nav || !heroSection) return;

    const brandLink = nav.querySelector('a[href="/"]');
    const menuBtn = nav.querySelector('#menuBtn');
    const navLinks = nav.querySelectorAll('ul a');
    const searchBtn = nav.querySelector('#searchTrigger');
    const linkedinLink = nav.querySelector('a[aria-label="LinkedIn"]');

    let isDark = false;

    function setDarkNav() {
      if (isDark) return;
      isDark = true;
      nav.style.background = 'rgba(13,13,15,0.82)';
      nav.style.borderBottomColor = 'rgba(255,255,255,0.06)';
      if (brandLink) { brandLink.style.color = '#fff'; }
      if (menuBtn) { menuBtn.style.color = '#a1a1a6'; }
      navLinks.forEach(function(l) { l.style.color = '#a1a1a6'; });
      if (searchBtn) { searchBtn.style.background = 'rgba(255,255,255,0.08)'; searchBtn.style.color = '#a1a1a6'; }
      if (linkedinLink) { linkedinLink.style.color = '#a1a1a6'; }
    }

    function setLightNav() {
      if (!isDark) return;
      isDark = false;
      nav.style.background = '';
      nav.style.borderBottomColor = '';
      if (brandLink) { brandLink.style.color = ''; }
      if (menuBtn) { menuBtn.style.color = ''; }
      navLinks.forEach(function(l) { l.style.color = ''; });
      if (searchBtn) { searchBtn.style.background = ''; searchBtn.style.color = ''; }
      if (linkedinLink) { linkedinLink.style.color = ''; }
    }

    function check() {
      const heroBottom = heroSection.getBoundingClientRect().bottom;
      if (heroBottom > 52) {
        setDarkNav();
      } else {
        setLightNav();
      }
    }

    check();
    window.addEventListener('scroll', check, { passive: true });
    window.addEventListener('resize', check, { passive: true });
  })();
  </script>


  <!-- Top Networks particle system (mirrors ParticleHero exactly) -->
  <script>
  (function() {
    var PARTICLE_COUNT_DESKTOP = 80;
    var PARTICLE_COUNT_TABLET = 50;
    var PARTICLE_COUNT_MOBILE = 25;
    var MAX_CONNECTION_DIST = 140;
    var MAX_CONNECTION_DIST_SQ = MAX_CONNECTION_DIST * MAX_CONNECTION_DIST;
    var LINE_OPACITY = 0.09;
    var BASE_PARTICLE_OPACITY = 0.4;
    var IDLE_DRIFT_STRENGTH = 0.18;
    var POINTER_INFLUENCE_RADIUS = 180;
    var POINTER_INFLUENCE_RADIUS_SQ = POINTER_INFLUENCE_RADIUS * POINTER_INFLUENCE_RADIUS;
    var POINTER_REPULSION_STRENGTH = 130;
    var REVEAL_RADIUS = 200;
    var REVEAL_RADIUS_SQ = REVEAL_RADIUS * REVEAL_RADIUS;
    var REVEAL_OPACITY_BOOST = 0.5;
    var RECOVERY_SPEED = 0.018;
    var INTERPOLATION_FACTOR = 0.12;
    var CLICK_PULSE_STRENGTH = 200;
    var CLICK_PULSE_DURATION = 500;
    var DPR_CAP = 2;

    var REVEAL_PARTICLE_COUNT_DESKTOP = 100;
    var REVEAL_PARTICLE_COUNT_TABLET = 60;
    var REVEAL_PARTICLE_COUNT_MOBILE = 35;
    var REVEAL_MAX_CONNECTION_DIST = 110;
    var REVEAL_MAX_CONNECTION_DIST_SQ = REVEAL_MAX_CONNECTION_DIST * REVEAL_MAX_CONNECTION_DIST;
    var REVEAL_LINE_OPACITY = 0.22;
    var REVEAL_PARTICLE_OPACITY = 0.6;

    var canvas = document.getElementById('topNetworksCanvas');
    var box = document.getElementById('topNetworksBox');
    if (!canvas || !box) return;
    var ctx = canvas.getContext('2d');
    if (!ctx) return;

    var motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    var prefersReducedMotion = motionQuery.matches;

    function getTier() {
      var w = window.innerWidth;
      if (w >= 1024) return 'desktop';
      if (w >= 640) return 'tablet';
      return 'mobile';
    }
    function getParticleCount(tier) {
      if (tier === 'desktop') return PARTICLE_COUNT_DESKTOP;
      if (tier === 'tablet') return PARTICLE_COUNT_TABLET;
      return PARTICLE_COUNT_MOBILE;
    }
    function getRevealCount(tier) {
      if (tier === 'desktop') return REVEAL_PARTICLE_COUNT_DESKTOP;
      if (tier === 'tablet') return REVEAL_PARTICLE_COUNT_TABLET;
      return REVEAL_PARTICLE_COUNT_MOBILE;
    }

    var pointer = { x: -9999, y: -9999 };
    var smoothPointer = { x: -9999, y: -9999 };
    var isPointerInside = false;
    var clickPulse = { active: false, x: 0, y: 0, startTime: 0 };
    var particles = [];
    var revealParticles = [];
    var animationId = null;
    var isVisible = false;
    var currentTier = getTier();
    var cachedW = 0, cachedH = 0, lastTime = 0;

    function createParticle(w, h) {
      return {
        x: Math.random() * w, y: Math.random() * h,
        homeX: 0, homeY: 0,
        vx: (Math.random() - 0.5) * IDLE_DRIFT_STRENGTH,
        vy: (Math.random() - 0.5) * IDLE_DRIFT_STRENGTH,
        size: 1 + Math.random() * 1.2,
        opacity: BASE_PARTICLE_OPACITY * (0.4 + Math.random() * 0.6),
      };
    }
    function createRevealParticle(w, h) {
      return {
        x: Math.random() * w, y: Math.random() * h,
        size: 0.8 + Math.random() * 0.8,
        opacity: REVEAL_PARTICLE_OPACITY * (0.5 + Math.random() * 0.5),
      };
    }

    function resize() {
      var rect = box.getBoundingClientRect();
      var dpr = Math.min(window.devicePixelRatio || 1, DPR_CAP);
      cachedW = rect.width; cachedH = rect.height;
      canvas.width = cachedW * dpr; canvas.height = cachedH * dpr;
      canvas.style.width = cachedW + 'px'; canvas.style.height = cachedH + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      var newTier = getTier();
      var needsRebuild = (newTier !== currentTier) || particles.length === 0;
      currentTier = newTier;
      if (needsRebuild) {
        var count = getParticleCount(currentTier);
        var revCount = getRevealCount(currentTier);
        particles = []; revealParticles = [];
        for (var i = 0; i < count; i++) {
          var p = createParticle(cachedW, cachedH);
          p.homeX = p.x; p.homeY = p.y;
          particles.push(p);
        }
        for (var i = 0; i < revCount; i++) {
          revealParticles.push(createRevealParticle(cachedW, cachedH));
        }
      }
    }

    function onPointerMove(e) {
      var rect = box.getBoundingClientRect();
      pointer.x = e.clientX - rect.left; pointer.y = e.clientY - rect.top;
      isPointerInside = true;
    }
    function onPointerLeave() { isPointerInside = false; }
    function onClick(e) {
      var rect = box.getBoundingClientRect();
      clickPulse.active = true;
      clickPulse.x = e.clientX - rect.left;
      clickPulse.y = e.clientY - rect.top;
      clickPulse.startTime = performance.now();
    }
    box.addEventListener('mousemove', onPointerMove, { passive: true });
    box.addEventListener('mouseleave', onPointerLeave, { passive: true });
    box.addEventListener('click', onClick);

    var observer = new IntersectionObserver(function(entries) {
      isVisible = entries[0].isIntersecting;
    }, { threshold: 0.05 });
    observer.observe(box);

    function onVisibilityChange() {
      if (document.hidden) {
        if (animationId) { cancelAnimationFrame(animationId); animationId = null; }
      } else if (!prefersReducedMotion && !animationId) {
        lastTime = 0; animationId = requestAnimationFrame(draw);
      }
    }
    document.addEventListener('visibilitychange', onVisibilityChange);

    function draw(now) {
      animationId = requestAnimationFrame(draw);
      if (!isVisible) return;
      var dt = lastTime ? Math.min((now - lastTime) / 16.667, 3) : 1;
      lastTime = now;
      var w = cachedW, h = cachedH;
      ctx.clearRect(0, 0, w, h);

      if (isPointerInside) {
        smoothPointer.x += (pointer.x - smoothPointer.x) * INTERPOLATION_FACTOR;
        smoothPointer.y += (pointer.y - smoothPointer.y) * INTERPOLATION_FACTOR;
      } else {
        smoothPointer.x += (-9999 - smoothPointer.x) * 0.02;
        smoothPointer.y += (-9999 - smoothPointer.y) * 0.02;
      }

      var pulseStrength = 0, pulseRadius = 0, pulseRadiusSq = 0;
      if (clickPulse.active) {
        var elapsed = now - clickPulse.startTime;
        if (elapsed > CLICK_PULSE_DURATION) { clickPulse.active = false; }
        else {
          var t = elapsed / CLICK_PULSE_DURATION;
          pulseStrength = CLICK_PULSE_STRENGTH * (1 - t);
          pulseRadius = POINTER_INFLUENCE_RADIUS * (1 + t * 1.5);
          pulseRadiusSq = pulseRadius * pulseRadius;
        }
      }

      var spx = smoothPointer.x, spy = smoothPointer.y;
      var revealActive = spx > -1000 && spy > -1000;

      // Reveal layer
      if (revealActive) {
        ctx.strokeStyle = 'rgb(120,140,170)'; ctx.lineWidth = 0.5;
        for (var i = 0; i < revealParticles.length; i++) {
          var a = revealParticles[i];
          var dxA = a.x - spx, dyA = a.y - spy;
          var distSqA = dxA * dxA + dyA * dyA;
          if (distSqA > REVEAL_RADIUS_SQ) continue;
          var distA = Math.sqrt(distSqA);
          var alphaA = 1 - (distA / REVEAL_RADIUS);
          for (var j = i + 1; j < revealParticles.length; j++) {
            var b = revealParticles[j];
            var dxB = b.x - spx, dyB = b.y - spy;
            var distSqB = dxB * dxB + dyB * dyB;
            if (distSqB > REVEAL_RADIUS_SQ) continue;
            var dxAB = a.x - b.x, dyAB = a.y - b.y;
            var distSqAB = dxAB * dxAB + dyAB * dyAB;
            if (distSqAB > REVEAL_MAX_CONNECTION_DIST_SQ) continue;
            var distB = Math.sqrt(distSqB), distAB = Math.sqrt(distSqAB);
            var alphaB = 1 - (distB / REVEAL_RADIUS);
            var lineFade = 1 - (distAB / REVEAL_MAX_CONNECTION_DIST);
            ctx.globalAlpha = REVEAL_LINE_OPACITY * alphaA * alphaB * lineFade;
            ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
          }
        }
        ctx.fillStyle = 'rgb(140,160,190)';
        for (var i = 0; i < revealParticles.length; i++) {
          var p = revealParticles[i];
          var dx = p.x - spx, dy = p.y - spy;
          var distSq = dx * dx + dy * dy;
          if (distSq > REVEAL_RADIUS_SQ) continue;
          var proximity = 1 - (Math.sqrt(distSq) / REVEAL_RADIUS);
          ctx.globalAlpha = p.opacity * proximity * REVEAL_OPACITY_BOOST;
          ctx.beginPath(); ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2); ctx.fill();
        }
      }

      // Primary particles
      ctx.fillStyle = 'rgb(180,180,190)';
      for (var i = 0; i < particles.length; i++) {
        var p = particles[i];
        p.x += p.vx * dt; p.y += p.vy * dt;
        var dx = p.x - spx, dy = p.y - spy;
        var distSq = dx * dx + dy * dy;
        if (distSq < POINTER_INFLUENCE_RADIUS_SQ && distSq > 0) {
          var dist = Math.sqrt(distSq);
          var prox = 1 - dist / POINTER_INFLUENCE_RADIUS;
          var force = prox * prox * POINTER_REPULSION_STRENGTH;
          p.x += (dx / dist) * force * 0.04 * dt;
          p.y += (dy / dist) * force * 0.04 * dt;
        }
        if (clickPulse.active && pulseStrength > 0) {
          var cdx = p.x - clickPulse.x, cdy = p.y - clickPulse.y;
          var cdistSq = cdx * cdx + cdy * cdy;
          if (cdistSq < pulseRadiusSq && cdistSq > 0) {
            var cdist = Math.sqrt(cdistSq);
            var pProx = 1 - cdist / pulseRadius;
            var pForce = pProx * pProx * pulseStrength;
            p.x += (cdx / cdist) * pForce * 0.06 * dt;
            p.y += (cdy / cdist) * pForce * 0.06 * dt;
          }
        }
        var recoveryFactor = 1 - Math.pow(1 - RECOVERY_SPEED, dt);
        p.x += (p.homeX - p.x) * recoveryFactor;
        p.y += (p.homeY - p.y) * recoveryFactor;
        if (p.x < -10) p.x = w + 10; if (p.x > w + 10) p.x = -10;
        if (p.y < -10) p.y = h + 10; if (p.y > h + 10) p.y = -10;
        ctx.globalAlpha = p.opacity;
        ctx.beginPath(); ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2); ctx.fill();
      }

      // Connections
      ctx.strokeStyle = 'rgb(180,180,190)'; ctx.lineWidth = 0.5;
      for (var i = 0; i < particles.length; i++) {
        for (var j = i + 1; j < particles.length; j++) {
          var a = particles[i], b = particles[j];
          var dxAB = a.x - b.x, dyAB = a.y - b.y;
          var distSqAB = dxAB * dxAB + dyAB * dyAB;
          if (distSqAB > MAX_CONNECTION_DIST_SQ) continue;
          var distAB = Math.sqrt(distSqAB);
          var lineFade = 1 - (distAB / MAX_CONNECTION_DIST);
          var stress = 1;
          var midX = (a.x + b.x) * 0.5, midY = (a.y + b.y) * 0.5;
          var midDx = midX - spx, midDy = midY - spy;
          var midDistSq = midDx * midDx + midDy * midDy;
          if (midDistSq < POINTER_INFLUENCE_RADIUS_SQ) {
            stress = Math.sqrt(midDistSq) / POINTER_INFLUENCE_RADIUS;
            stress = stress * stress;
          }
          ctx.globalAlpha = LINE_OPACITY * lineFade * stress;
          ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
        }
      }

      // Click pulse ring
      if (clickPulse.active) {
        var elapsed = now - clickPulse.startTime;
        var t = elapsed / CLICK_PULSE_DURATION;
        var ringRadius = 20 + t * POINTER_INFLUENCE_RADIUS * 1.2;
        ctx.strokeStyle = 'rgb(120,150,200)';
        ctx.globalAlpha = 0.15 * (1 - t);
        ctx.lineWidth = 1.5 * (1 - t);
        ctx.beginPath(); ctx.arc(clickPulse.x, clickPulse.y, ringRadius, 0, Math.PI * 2); ctx.stroke();
      }

      ctx.globalAlpha = 1;
    }

    function drawStatic() {
      resize();
      ctx.clearRect(0, 0, cachedW, cachedH);
      ctx.fillStyle = 'rgb(180,180,190)';
      for (var i = 0; i < particles.length; i++) {
        var p = particles[i];
        ctx.globalAlpha = p.opacity * 0.7;
        ctx.beginPath(); ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2); ctx.fill();
      }
      ctx.strokeStyle = 'rgb(180,180,190)'; ctx.lineWidth = 0.5;
      for (var i = 0; i < particles.length; i++) {
        for (var j = i + 1; j < particles.length; j++) {
          var a = particles[i], b = particles[j];
          var dxAB = a.x - b.x, dyAB = a.y - b.y;
          var distSqAB = dxAB * dxAB + dyAB * dyAB;
          if (distSqAB > MAX_CONNECTION_DIST_SQ) continue;
          var distAB = Math.sqrt(distSqAB);
          var lineFade = 1 - (distAB / MAX_CONNECTION_DIST);
          ctx.globalAlpha = LINE_OPACITY * lineFade * 0.7;
          ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
        }
      }
      ctx.globalAlpha = 1;
    }

    function onMotionChange(e) {
      prefersReducedMotion = e.matches;
      if (prefersReducedMotion) {
        if (animationId) { cancelAnimationFrame(animationId); animationId = null; }
        drawStatic();
      } else {
        if (!animationId) { lastTime = 0; animationId = requestAnimationFrame(draw); }
      }
    }
    motionQuery.addEventListener('change', onMotionChange);

    if (prefersReducedMotion) { drawStatic(); } else {
      resize(); lastTime = 0; animationId = requestAnimationFrame(draw);
    }

    var resizeTimeout;
    function debouncedResize() {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(function() { resize(); if (prefersReducedMotion) drawStatic(); }, 150);
    }
    window.addEventListener('resize', debouncedResize, { passive: true });
  })();
  </script>

  <!-- News scroll parallax — items slide up gently as they scroll into view -->
  <script>
  (function() {
    var scrollContainer = document.getElementById('newsScroll');
    if (!scrollContainer) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var items = scrollContainer.querySelectorAll('a');
    if (!items.length) return;

    function updateParallax() {
      var containerRect = scrollContainer.getBoundingClientRect();
      var containerTop = containerRect.top;
      var containerBottom = containerRect.bottom;
      var containerHeight = containerRect.height;

      for (var i = 0; i < items.length; i++) {
        var item = items[i];
        var rect = item.getBoundingClientRect();
        var itemCenter = rect.top + rect.height / 2;

        // How far from center of the container (0 = center, 1 = edge)
        var distFromCenter = (itemCenter - containerTop) / containerHeight;

        // Items near the bottom edge: fade + slight upward shift
        if (distFromCenter > 0.8) {
          var t = (distFromCenter - 0.8) / 0.2; // 0 to 1
          item.style.opacity = String(1 - t * 0.7);
          item.style.transform = 'translateY(' + (t * 6) + 'px)';
        }
        // Items near the top edge: fade
        else if (distFromCenter < 0.1) {
          var t = (0.1 - distFromCenter) / 0.1;
          item.style.opacity = String(1 - t * 0.7);
          item.style.transform = 'translateY(' + (-t * 4) + 'px)';
        }
        else {
          item.style.opacity = '1';
          item.style.transform = 'translateY(0)';
        }
      }
    }

    scrollContainer.addEventListener('scroll', updateParallax, { passive: true });
    // Initial pass
    requestAnimationFrame(updateParallax);
  })();
  </script>

  <!-- Featured Profiles -->
  <section class="py-10 px-6 bg-bg-secondary">
    <div class="max-w-site mx-auto">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-lg font-bold text-primary">Featured Profiles</h2>
        <a href="/networks" class="text-accent text-sm font-medium no-underline hover:underline">View all &rarr;</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {featuredNetworks.map(network => (
          <NetworkCard {...network.data} variant="profile" />
        ))}
      </div>
    </div>
  </section>

  <CompareTable />
</BaseLayout>

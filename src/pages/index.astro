  <!-- ================================================= -->
  <!-- Utility Rail JS: section tracking + mobile sheet   -->
  <!-- ================================================= -->
  <script is:inline>
  (function() {
    var sections = ['overview', 'news', 'top-networks', 'featured', 'compare'];
    var activeSection = '';

    function setActive(id) {
      if (activeSection === id) return;
      activeSection = id;

      // Desktop rail
      document.querySelectorAll('.rail-link').forEach(function(link) {
        var s = link.getAttribute('data-section');
        var dot = link.querySelector('.rail-dot');
        if (s === id) {
          link.classList.add('text-primary');
          link.classList.remove('text-tertiary');
          if (dot) { dot.classList.add('bg-accent'); dot.classList.remove('bg-border'); }
        } else {
          link.classList.remove('text-primary');
          link.classList.add('text-tertiary');
          if (dot) { dot.classList.remove('bg-accent'); dot.classList.add('bg-border'); }
        }
      });

      // Mobile dots
      document.querySelectorAll('.mobile-dot').forEach(function(d) {
        if (d.getAttribute('data-section') === id) {
          d.classList.add('bg-accent'); d.classList.remove('bg-border');
        } else {
          d.classList.remove('bg-accent'); d.classList.add('bg-border');
        }
      });
    }

    // IntersectionObserver for active section
    var obs = new IntersectionObserver(function(entries) {
      var best = null;
      entries.forEach(function(e) {
        if (e.isIntersecting && (!best || Math.abs(e.boundingClientRect.top) < Math.abs(best.boundingClientRect.top))) {
          best = e;
        }
      });
      if (best) setActive(best.target.id);
    }, { threshold: [0, 0.15, 0.4], rootMargin: '-64px 0px -35% 0px' });

    sections.forEach(function(id) {
      var el = document.getElementById(id);
      if (el) obs.observe(el);
    });

    setActive('overview');

    // Mobile bar: show after scroll
    var mobileBar = document.getElementById('mobileUtilBar');
    var barVisible = false;
    window.addEventListener('scroll', function() {
      if (!mobileBar) return;
      if (window.scrollY > 250 && !barVisible) {
        mobileBar.classList.remove('translate-y-full');
        barVisible = true;
      } else if (window.scrollY <= 250 && barVisible) {
        mobileBar.classList.add('translate-y-full');
        barVisible = false;
      }
    }, { passive: true });

    // Mobile sheet open/close
    var toggle = document.getElementById('mobileRailToggle');
    var backdrop = document.getElementById('mobileRailBackdrop');
    var sheet = document.getElementById('mobileRailSheet');

    function openSheet() {
      if (!backdrop || !sheet) return;
      backdrop.classList.remove('hidden');
      requestAnimationFrame(function() {
        backdrop.classList.add('opacity-100');
        backdrop.classList.remove('opacity-0');
        sheet.classList.remove('translate-y-full');
      });
      document.body.style.overflow = 'hidden';
    }
    function closeSheet() {
      if (!backdrop || !sheet) return;
      backdrop.classList.remove('opacity-100');
      backdrop.classList.add('opacity-0');
      sheet.classList.add('translate-y-full');
      setTimeout(function() { backdrop.classList.add('hidden'); }, 300);
      document.body.style.overflow = '';
    }

    if (toggle) toggle.addEventListener('click', openSheet);
    if (backdrop) backdrop.addEventListener('click', closeSheet);
    if (sheet) sheet.addEventListener('click', function(e) {
      if (e.target instanceof HTMLAnchorElement || (e.target instanceof Element && e.target.closest('a'))) closeSheet();
    });
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeSheet(); });

    // Rail search button triggers header search
    var railSearch = document.getElementById('railSearchBtn');
    if (railSearch) railSearch.addEventListener('click', function() {
      var s = document.getElementById('searchTrigger');
      if (s) s.click();
    });
  })();
  </script>
</BaseLayout>

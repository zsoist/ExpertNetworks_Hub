---
import BaseLayout from '../layouts/BaseLayout.astro';
import ParticleHero from '../components/ParticleHero.astro';
import TrackedNetworksMarquee from '../components/TrackedNetworksMarquee.astro';
import compareConfig from '../content/compare.json';
import { getCollection } from 'astro:content';

const allNetworks = await getCollection('networks');
const allNews = await getCollection('news');

const publishedNetworks = allNetworks
  .filter(n => n.data.published)
  .sort((a, b) => a.data.priority - b.data.priority);

const top6 = publishedNetworks.slice(0, 6);
const networkBySlug = new Map(publishedNetworks.map(n => [n.data.slug, n]));
const shortName = (name: string) => name.split(' (')[0];

const publishedNews = allNews
  .filter(n => n.data.published)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

// Curated news: pick top featured/major signals, then fill with recent
const majorNews = publishedNews.filter(n => n.data.significance === 'major' || n.data.featured);
const curatedNews = [...majorNews.slice(0, 3)];
if (curatedNews.length < 4) {
  const slugsUsed = new Set(curatedNews.map(n => n.data.slug));
  for (const n of publishedNews) {
    if (curatedNews.length >= 4) break;
    if (!slugsUsed.has(n.data.slug)) curatedNews.push(n);
  }
}
const [leadNews, ...restNews] = curatedNews;

// ─── Hero stats: every figure is derived from the content collections ───
const compareDimensionCount = compareConfig.sections.reduce((sum, section) => sum + section.rows.length, 0);
const comparePresetCount = Object.keys(compareConfig.presets).length;
const latestTimestamp = Math.max(
  ...publishedNetworks.map(n => new Date(n.data.lastUpdated).getTime()),
  ...publishedNews.map(n => new Date(n.data.date).getTime()),
);
const latestUpdate = new Date(latestTimestamp);
const latestUpdateLabel = latestUpdate.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const latestUpdateIso = latestUpdate.toISOString().slice(0, 10);

const heroStats = [
  { value: String(publishedNetworks.length), label: 'Providers profiled' },
  { value: String(compareDimensionCount), label: 'Comparison dimensions' },
  { value: String(publishedNews.length), label: 'Market signals logged' },
];

const formatDate = (value: string) =>
  new Date(value).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

// ─── Compare presets shown on the homepage: read straight from compare.json ───
const presets = compareConfig.presets as Record<string, string[]>;
const presetMeta = compareConfig.presetMeta as Record<string, { label: string; description: string }>;
const featuredPresets = [
  { key: 'leaders', tone: 'text-accent-text' },
  { key: 'aiResearch', tone: 'text-[#8944AB]' },
  { key: 'library', tone: 'text-[#1F7A3D]' },
]
  .filter(p => presets[p.key] && presetMeta[p.key])
  .map(p => ({
    ...p,
    label: presetMeta[p.key].label,
    description: presetMeta[p.key].description,
    networks: presets[p.key].map(slug => networkBySlug.get(slug)).filter(n => n !== undefined),
  }));

// Provider descriptor map for top 6
const descriptors: Record<string, string> = {
  'glg': 'Broad enterprise coverage and scale',
  'alphasights': 'Fast sourcing and managed service',
  'third-bridge': 'Library-rich research workflows',
  'guidepoint': 'Large advisor network and flexible access',
  'dialectica': 'Hard-to-find experts and research-heavy sourcing',
  'alphasense-tegus': 'AI-led search plus expert content access',
  'capvision': 'Asia-Pacific depth and global reach',
  'atheneum': 'Global coverage with consulting-oriented service',
};
---

<BaseLayout
  title="Best Expert Networks (2026): Compare 33 Providers — Pricing, Compliance, AI"
  description="Compare 33 expert network companies side-by-side. Independent profiles of GLG, AlphaSights, Third Bridge, Guidepoint, Dialectica, and 28 more — with pricing models, compliance ratings, AI capabilities, and expert coverage. Free, no sign-up."
  canonicalPath="/"
  themeColor="#0d0d0f"
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "ExpertNetworks.net",
    "alternateName": ["Expert Networks", "Expert Networks Directory"],
    "url": "https://expertnetworks.net",
    "description": `Independent expert network directory with ${publishedNetworks.length} provider profiles, comparisons, pricing, compliance, and industry news.`,
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://expertnetworks.net/networks?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  }}
>

  <!-- ═══ 1. Hero — dark interactive particle surface ═══
       Everything here is server-rendered and visible on first paint. -->
  <ParticleHero minHeight="clamp(520px, 78svh, 720px)" contentClass="pt-[92px] pb-12 md:pt-[124px] md:pb-16 px-4 sm:px-6">
    <div class="home-hero max-w-[880px] mx-auto text-center" id="top">
      <p class="hero-rise inline-flex items-center gap-2 rounded-full border border-white/[0.12] bg-white/[0.06] px-3.5 py-1.5 text-[12px] font-medium text-white/80">
        <span class="relative flex h-1.5 w-1.5" aria-hidden="true"><span class="absolute inline-flex h-full w-full rounded-full bg-accent-green"></span></span>
        Independent research &middot; No paid placements
      </p>

      <h1 id="heroTitle" class="hero-rise mt-6 text-step-5 font-bold tracking-[-0.035em] text-white">
        Compare expert networks the way serious buyers <span class="hero-accent">actually evaluate them</span>
      </h1>

      <p id="heroSubtext" class="hero-rise hero-rise-2 mx-auto mt-5 max-w-[60ch] text-step-1 text-[#B4B4BA]">
        Independent research on expert networks across pricing model, compliance posture, AI capabilities, transcript access, geography, and service model.
      </p>

      <!-- Search entry point: a real GET form to the directory (works without JS). -->
      <form action="/networks" method="get" role="search" class="hero-rise hero-rise-3 hero-search mx-auto mt-8 flex max-w-[600px] items-center gap-2 rounded-full p-1.5 pl-4 sm:pl-5" aria-label="Search the provider directory">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24" class="flex-shrink-0 text-white/60" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <label for="heroSearchInput" class="sr-only">Search {publishedNetworks.length} expert networks</label>
        <input
          id="heroSearchInput"
          type="search"
          name="q"
          autocomplete="off"
          enterkeyhint="search"
          placeholder={`Search ${publishedNetworks.length} providers`}
          class="min-w-0 flex-1 bg-transparent h-11 text-base text-white placeholder:text-white/55 outline-none border-none [&::-webkit-search-cancel-button]:hidden"
        />
        <button type="submit" class="btn btn-primary !px-5">
          Search
        </button>
      </form>

      <div id="heroCtas" class="hero-rise hero-rise-3 mt-4 flex flex-wrap items-center justify-center gap-x-1 gap-y-0 text-sm sm:gap-x-3">
        <a href="/compare" class="hero-link">
          Compare providers
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
        <a href="/networks" class="hero-link">
          Browse all networks
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
        <a href="/what-is-an-expert-network" class="hero-link">
          What is an expert network?
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      </div>

      <!-- Stats: derived at build time from src/content -->
      <dl class="hero-rise hero-rise-4 mx-auto mt-10 grid max-w-[720px] grid-cols-2 gap-px overflow-hidden rounded-2xl border border-white/[0.1] bg-white/[0.1] text-left sm:grid-cols-4 md:mt-12">
        {heroStats.map(stat => (
          <div class="flex flex-col-reverse bg-[#0d0d0f]/80 px-4 py-4 sm:px-5">
            <dt class="mt-1 text-[12px] leading-snug text-[#A1A1A6]">{stat.label}</dt>
            <dd class="text-[26px] font-semibold leading-none tracking-tight text-white tabular-nums sm:text-[28px]">{stat.value}</dd>
          </div>
        ))}
        <div class="flex flex-col-reverse bg-[#0d0d0f]/80 px-4 py-4 sm:px-5">
          <dt class="mt-1 text-[12px] leading-snug text-[#A1A1A6]">Latest data update</dt>
          <dd class="text-[26px] font-semibold leading-none tracking-tight text-white sm:text-[28px]"><time datetime={latestUpdateIso}>{latestUpdateLabel}</time></dd>
        </div>
      </dl>

      <p id="heroMicro" class="hero-rise hero-rise-4 mt-5 text-[12px] text-[#A1A1A6]">No paywalls. No sign-up required. No affiliations. Public-source research.</p>
    </div>
  </ParticleHero>

  <!-- ═══ 2. Networks Covered — interactive logo carousel ═══ -->
  <TrackedNetworksMarquee />

  <!-- ═══ 3. Decision pathways (bento) ═══ -->
  <section class="py-section px-4 sm:px-6" aria-labelledby="pathwaysHeading">
    <div class="max-w-site mx-auto">
      <div class="fade-in mb-8 md:mb-10 max-w-2xl">
        <p class="eyebrow mb-3">Where to start</p>
        <h2 id="pathwaysHeading" class="text-step-3 font-bold text-primary">Start with your use case</h2>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-6">
        <!-- Feature tile: compare -->
        <a href="/compare" class="fade-in group card-spot card-spot-dark dark-surface flex flex-col justify-between overflow-hidden p-6 no-underline sm:col-span-2 md:p-8 lg:col-span-3 lg:row-span-2">
          <div>
            <div class="mb-5 flex h-10 w-10 items-center justify-center rounded-xl bg-white/[0.08] text-[#6CB4FF]">
              <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
            </div>
            <h3 class="text-step-2 font-semibold text-white">I need to compare providers</h3>
            <p class="mt-2 max-w-[44ch] text-[15px] leading-relaxed text-[#B4B4BA]">Side-by-side comparison across pricing, compliance, AI, and service model.</p>
          </div>
          <div class="mt-8">
            <div class="flex flex-wrap items-center gap-2">
              {top6.map((n) => (
                n.data.logo ? (
                  <img src={n.data.logo} alt="" width="36" height="36" loading="lazy" decoding="async" class:list={['h-9 w-9 rounded-[10px] bg-white object-cover ring-1 ring-white/10']} />
                ) : (
                  <span class:list={['flex h-9 w-9 items-center justify-center rounded-[10px] text-[10px] font-bold text-white ring-1 ring-white/10']} style={`background: linear-gradient(135deg, ${n.data.gradientFrom}, ${n.data.gradientTo})`} aria-hidden="true">{n.data.shortName}</span>
                )
              ))}
              <span class="ml-1 text-[13px] text-[#A1A1A6]">{compareDimensionCount} dimensions &middot; {comparePresetCount} presets</span>
            </div>
            <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-[#6CB4FF]">
              Open the comparison tool
              <svg class="w-3.5 h-3.5 transition-transform duration-200 ease-out-expo group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
            </span>
          </div>
        </a>

        <a href="/networks" class="fade-in group card-spot flex items-center gap-4 p-6 no-underline lg:col-span-3">
          <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-accent-purple/10 text-[#8944AB]">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
          </div>
          <div class="min-w-0">
            <h3 class="text-[17px] font-semibold text-primary transition-colors group-hover:text-accent-text">I need to browse the market</h3>
            <p class="mt-1 text-sm text-secondary">Explore all {publishedNetworks.length} tracked expert networks with search and filters.</p>
          </div>
        </a>

        <a href="/expert-network-pricing" class="fade-in group card-spot flex items-center gap-4 p-6 no-underline lg:col-span-3">
          <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-accent-green/10 text-[#1F7A3D]">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
          </div>
          <div class="min-w-0">
            <h3 class="text-[17px] font-semibold text-primary transition-colors group-hover:text-accent-text">I need to understand pricing</h3>
            <p class="mt-1 text-sm text-secondary">How pricing models differ across calls, subscriptions, and content access.</p>
          </div>
        </a>

        <a href="/what-is-an-expert-network" class="fade-in group card-spot p-6 no-underline lg:col-span-2">
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-accent-orange/10 text-[#A05A00]">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          </div>
          <h3 class="text-[17px] font-semibold text-primary transition-colors group-hover:text-accent-text">I'm new to this category</h3>
          <p class="mt-1 text-sm text-secondary">Learn how expert networks work, what they cost, and how to choose a provider.</p>
        </a>

        <a href="/news" class="fade-in group card-spot p-6 no-underline lg:col-span-2">
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-accent/10 text-accent-text">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z"/><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"/></svg>
          </div>
          <h3 class="text-[17px] font-semibold text-primary transition-colors group-hover:text-accent-text">I want the latest market news</h3>
          <p class="mt-1 text-sm text-secondary">Track launches, M&amp;A, AI products, and market developments.</p>
        </a>

        <a href="/best-expert-networks" class="fade-in group card-spot p-6 no-underline sm:col-span-2 lg:col-span-2">
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-rose-50 text-rose-600">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2L15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2z"/></svg>
          </div>
          <h3 class="text-[17px] font-semibold text-primary transition-colors group-hover:text-accent-text">I want to explore leading providers</h3>
          <p class="mt-1 text-sm text-secondary">Curated overview of top expert networks by category and strength.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ 4. Featured compare module ═══ -->
  <section class="py-section px-4 sm:px-6 bg-bg-secondary" aria-labelledby="compareHeading">
    <div class="max-w-site mx-auto">
      <div class="fade-in mb-8 flex flex-col gap-4 md:mb-10 md:flex-row md:items-end md:justify-between">
        <div class="max-w-2xl">
          <p class="eyebrow mb-3">Comparison tool</p>
          <h2 id="compareHeading" class="text-step-3 font-bold text-primary">Compare leading expert networks</h2>
          <p class="mt-3 text-step-0 text-secondary">Choose a preset to see how providers stack up, or build your own comparison.</p>
        </div>
        <a href="/compare" class="btn btn-primary self-start md:self-auto">
          Open full comparison tool
          <svg class="btn-arrow w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {featuredPresets.map(preset => (
          <a href={`/compare?preset=${preset.key}`} class="fade-in group card-spot flex flex-col p-6 no-underline">
            <div class:list={['text-[11px] font-bold uppercase tracking-[0.08em]', preset.tone]}>{preset.label}</div>
            <p class="mt-2 text-sm text-secondary">{preset.description}</p>
            <div class="mt-5 flex flex-wrap items-center gap-1.5">
              {preset.networks.map((n) => (
                n.data.logo ? (
                  <img src={n.data.logo} alt="" width="32" height="32" loading="lazy" decoding="async" class:list={['h-8 w-8 rounded-lg bg-white object-cover ring-1 ring-black/5']} />
                ) : (
                  <span class:list={['flex h-8 w-8 items-center justify-center rounded-lg text-[9px] font-bold text-white ring-1 ring-black/5']} style={`background: linear-gradient(135deg, ${n.data.gradientFrom}, ${n.data.gradientTo})`} aria-hidden="true">{n.data.shortName}</span>
                )
              ))}
            </div>
            <p class="mt-3 text-[13px] leading-relaxed text-tertiary">{preset.networks.map(n => shortName(n.data.name).split(' / ')[0]).join(', ')}</p>
            <span class="mt-auto inline-flex items-center gap-1.5 pt-5 text-sm font-semibold text-accent-text">
              Open comparison
              <svg class="w-3.5 h-3.5 transition-transform duration-200 ease-out-expo group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ 5. Featured profiles ═══ -->
  <section class="py-section px-4 sm:px-6" aria-labelledby="profilesHeading">
    <div class="max-w-site mx-auto">
      <div class="fade-in mb-8 flex items-end justify-between gap-4 md:mb-10">
        <div>
          <p class="eyebrow mb-3">Provider profiles</p>
          <h2 id="profilesHeading" class="text-step-3 font-bold text-primary">Featured profiles</h2>
        </div>
        <a href="/networks" class="inline-flex min-h-[44px] items-center gap-1 whitespace-nowrap text-sm font-semibold text-accent-text no-underline hover:underline">View all {publishedNetworks.length} <span aria-hidden="true">&rarr;</span></a>
      </div>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-6">
        {top6.map(n => {
          const desc = descriptors[n.data.slug] || (n.data.description ? n.data.description.slice(0, 60) + '…' : n.data.type || '');
          return (
            <a href={`/networks/${n.data.slug}`} class="fade-in group card-spot flex flex-col items-center p-5 text-center no-underline">
              {n.data.logo ? (
                <img src={n.data.logo} alt="" width="48" height="48" class="mb-3 h-12 w-12 rounded-xl object-cover shadow-xs" loading="lazy" decoding="async" style={`view-transition-name: net-${n.data.slug}`} />
              ) : (
                <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-xl text-xs font-bold text-white" style={`background: linear-gradient(135deg, ${n.data.gradientFrom}, ${n.data.gradientTo}); view-transition-name: net-${n.data.slug}`} aria-hidden="true">
                  {n.data.shortName}
                </div>
              )}
              <div class="text-sm font-semibold text-primary transition-colors group-hover:text-accent-text">{shortName(n.data.name)}</div>
              <div class="mt-1 text-[12px] leading-snug text-tertiary">{desc}</div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ═══ 6. What matters now — curated news ═══ -->
  <section class="py-section px-4 sm:px-6 bg-bg-secondary" aria-labelledby="newsHeading">
    <div class="max-w-site mx-auto">
      <div class="fade-in mb-8 flex items-end justify-between gap-4 md:mb-10">
        <div>
          <p class="eyebrow mb-3">Market intelligence</p>
          <h2 id="newsHeading" class="text-step-3 font-bold text-primary">What matters now</h2>
        </div>
        <a href="/news" class="inline-flex min-h-[44px] items-center gap-1 whitespace-nowrap text-sm font-semibold text-accent-text no-underline hover:underline">All signals <span aria-hidden="true">&rarr;</span></a>
      </div>

      <div class="grid gap-4 lg:grid-cols-12">
        {leadNews && (
          <a href={leadNews.data.sourceUrl || '/news'} target={leadNews.data.sourceUrl ? '_blank' : undefined} rel={leadNews.data.sourceUrl ? 'noopener noreferrer' : undefined} class="fade-in group card-spot flex flex-col p-6 no-underline md:p-8 lg:col-span-5 lg:row-span-3">
            <div class="mb-4 flex flex-wrap items-center gap-2">
              <span class="news-chip" style={`--chip: ${leadNews.data.categoryColor || '#0071E3'}`}>{leadNews.data.category}</span>
              {leadNews.data.significance === 'major' && (
                <span class="rounded-full bg-rose-50 px-2.5 py-1 text-[11px] font-bold uppercase tracking-[0.06em] text-rose-700">Major</span>
              )}
            </div>
            <h3 class="text-step-2 font-semibold text-primary transition-colors group-hover:text-accent-text">{leadNews.data.title}</h3>
            <p class="mt-3 text-[15px] leading-relaxed text-secondary">{leadNews.data.summary}</p>
            {leadNews.data.whyItMatters && (
              <div class="mt-5 rounded-xl bg-bg-secondary p-4">
                <div class="eyebrow mb-1.5">Why it matters</div>
                <p class="text-sm leading-relaxed text-secondary">{leadNews.data.whyItMatters}</p>
              </div>
            )}
            <div class="mt-auto flex items-center gap-2 pt-6 text-[13px] text-tertiary">
              <time datetime={leadNews.data.date}>{formatDate(leadNews.data.date)}</time>
              <span aria-hidden="true">&middot;</span>
              <span>{leadNews.data.sourceType || leadNews.data.source}</span>
              {leadNews.data.sourceUrl && (
                <span class="ml-auto inline-flex items-center gap-1 font-medium text-accent-text">
                  Source
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  <span class="sr-only">(opens in a new tab)</span>
                </span>
              )}
            </div>
          </a>
        )}

        {restNews.map(article => (
          <a href={article.data.sourceUrl || '/news'} target={article.data.sourceUrl ? '_blank' : undefined} rel={article.data.sourceUrl ? 'noopener noreferrer' : undefined} class="fade-in group card-spot flex flex-col p-5 no-underline md:p-6 lg:col-span-7">
            <div class="mb-2.5 flex flex-wrap items-center gap-2">
              <span class="news-chip" style={`--chip: ${article.data.categoryColor || '#0071E3'}`}>{article.data.category}</span>
              {article.data.significance === 'major' && (
                <span class="rounded-full bg-rose-50 px-2.5 py-1 text-[11px] font-bold uppercase tracking-[0.06em] text-rose-700">Major</span>
              )}
              <span class="ml-auto flex items-center gap-2 text-[13px] text-tertiary">
                <time datetime={article.data.date}>{formatDate(article.data.date)}</time>
                {article.data.sourceUrl && (
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                )}
              </span>
            </div>
            <h3 class="text-[17px] font-semibold leading-snug text-primary transition-colors group-hover:text-accent-text">{article.data.title}</h3>
            {article.data.whyItMatters && (
              <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-secondary">{article.data.whyItMatters}</p>
            )}
            <div class="mt-auto pt-3 text-[13px] text-tertiary">
              {article.data.sourceType || article.data.source}
              {article.data.sourceUrl && <span class="sr-only"> (opens in a new tab)</span>}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ 7. How this site works — methodology / trust ═══ -->
  <section class="py-section px-4 sm:px-6" aria-labelledby="methodHeading">
    <div class="max-w-site mx-auto grid gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="fade-in lg:col-span-5">
        <p class="eyebrow mb-3">Methodology</p>
        <h2 id="methodHeading" class="text-step-3 font-bold text-primary">How this site works</h2>
        <p class="mt-4 max-w-measure text-step-0 text-secondary">This site is an independent public-source research resource covering expert networks, related research platforms, and industry developments. Provider data may reflect a mix of verified company statements, public reporting, and clearly labeled editorial inferences.</p>
        <div class="mt-6 flex flex-wrap gap-x-6 gap-y-1">
          <a href="/sources" class="inline-flex min-h-[44px] items-center gap-1 text-sm font-semibold text-accent-text no-underline hover:underline">Sources &amp; methodology <span aria-hidden="true">&rarr;</span></a>
          <a href="/verification" class="inline-flex min-h-[44px] items-center gap-1 text-sm font-semibold text-accent-text no-underline hover:underline">Verification framework <span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>
      <ul class="grid list-none grid-cols-1 gap-3 sm:grid-cols-2 lg:col-span-7">
        {[
          'Public-source research only',
          'No paywalls or gated access',
          'No paid placement',
          'Corrections welcomed',
        ].map(principle => (
          <li class="fade-in flex items-center gap-3 rounded-2xl bg-white p-5 shadow-card">
            <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-accent-green/15 text-[#1F7A3D]">
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
            <span class="text-[15px] font-medium text-primary">{principle}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═══ 8. Final CTA ═══ -->
  <section class="px-4 pb-section sm:px-6" aria-labelledby="ctaHeading">
    <div class="fade-in dark-surface relative mx-auto max-w-site overflow-hidden rounded-panel bg-[#0d0d0f] px-6 py-14 text-center md:py-20">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true" style="background: radial-gradient(55% 80% at 50% 0%, rgba(0,113,227,0.28), transparent 70%);"></div>
      <div class="relative">
        <h2 id="ctaHeading" class="text-step-3 font-bold text-white">Ready to narrow your shortlist?</h2>
        <p class="mx-auto mt-3 max-w-[52ch] text-step-0 text-[#B4B4BA]">Compare providers side by side across pricing model, service format, compliance, AI capabilities, and content access.</p>
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          <a href="/compare" class="btn btn-primary">
            Compare providers
            <svg class="btn-arrow w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
          <a href="/networks" class="btn btn-ghost-dark">
            Browse all networks
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>


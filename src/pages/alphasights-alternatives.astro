---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allNetworks = await getCollection('networks');
const published = allNetworks
  .filter(n => n.data.published)
  .sort((a, b) => a.data.priority - b.data.priority);

const alternatives = published.filter(n => n.data.slug !== 'alphasights').slice(0, 10);
---

<BaseLayout
  progress
  title="AlphaSights Alternatives (2026): 10 Expert Networks to Consider | ExpertNetworks.net"
  description="Looking for alternatives to AlphaSights? Compare 10 expert network providers including GLG, Third Bridge, Guidepoint, and Dialectica — with pricing, speed, compliance, and AI capabilities."
  canonicalPath="/alphasights-alternatives"
  ogType="article"
  jsonLd={{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://expertnetworks.net/" },
          { "@type": "ListItem", "position": 2, "name": "Networks", "item": "https://expertnetworks.net/networks" },
          { "@type": "ListItem", "position": 3, "name": "AlphaSights Alternatives" }
        ]
      },
      {
        "@type": "Article",
        "headline": "AlphaSights Alternatives: 10 Expert Networks to Consider (2026)",
        "description": "Comprehensive guide to expert network alternatives to AlphaSights, including pricing, capabilities, and best-fit use cases.",
        "publisher": { "@type": "Organization", "name": "ExpertNetworks.net", "url": "https://expertnetworks.net" },
        "datePublished": "2026-03-09",
        "dateModified": "2026-03-09"
      }
    ]
  }}
>
  <section class="guide-hero pt-[calc(var(--nav-h)+3.5rem)] pb-section-sm px-4 sm:px-6">
    <div class="max-w-4xl mx-auto">
      <div class="flex items-center gap-3 mb-4">
        <a href="/networks/alphasights" class="inline-flex items-center min-h-[44px] text-accent-text text-sm font-medium no-underline hover:underline">&larr; AlphaSights Profile</a>
        <span class="text-tertiary text-sm">|</span>
        <a href="/networks" class="inline-flex items-center min-h-[44px] text-accent-text text-sm font-medium no-underline hover:underline">All Networks</a>
      </div>
      <span class="inline-block px-3 py-1 bg-accent/10 text-accent-text text-xs font-semibold rounded-full mb-4 tracking-wide uppercase">Alternatives Guide</span>
      <h1 class="text-step-4 font-bold tracking-[-0.03em] text-primary mb-5">AlphaSights Alternatives</h1>
      <p class="text-step-1 text-secondary max-w-measure">
        AlphaSights is known for speed and high-touch service. But depending on your priorities — cost, content access, self-service, or regional coverage — one of these {alternatives.length} alternatives may be a better fit.
      </p>
    </div>
  </section>

  <section class="py-section-sm px-4 sm:px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-step-3 font-bold text-primary mb-6">Why consider AlphaSights alternatives?</h2>
      <div class="space-y-4 text-step-0 leading-[1.7] text-secondary max-w-measure">
        <p>
          AlphaSights has built its reputation on fast turnaround and dedicated project management — ideal for PE deal teams and time-pressured research. But some teams look elsewhere because:
        </p>
        <ul class="space-y-2 ml-4">
          <li><strong>Breadth</strong> — GLG offers a wider product suite (surveys, events, library, placements) beyond expert calls.</li>
          <li><strong>Content libraries</strong> — Third Bridge and AlphaSense/Tegus provide pre-built transcript libraries for asynchronous research.</li>
          <li><strong>Cost</strong> — Guidepoint and others offer competitive per-call pricing with more flexible commercial terms.</li>
          <li><strong>Depth</strong> — Dialectica has grown to 1,400+ employees and $100M+ revenue with strong European and emerging market coverage, plus an AI-powered Origin deal-sourcing platform for PE.</li>
          <li><strong>Self-service</strong> — Technology-first platforms like Prosapient and NewtonX offer more automated, self-serve workflows.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="py-section-sm px-4 sm:px-6 bg-bg-secondary">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-step-3 font-bold text-primary mb-8">Top AlphaSights alternatives</h2>
      <div class="space-y-4">
        {alternatives.map((network, i) => (
          <div class="bg-white rounded-card shadow-card p-5 flex flex-col sm:flex-row gap-4 items-start">
            <div class="flex items-center gap-3 flex-shrink-0">
              <span class="text-[11px] font-bold text-tertiary w-5">{i + 1}.</span>
              {network.data.logo ? (
                <img src={network.data.logo} alt={`${network.data.name.split(' (')[0]} logo`} width="40" height="40" class="w-10 h-10 rounded-xl object-contain" loading="lazy" />
              ) : (
                <div class="w-10 h-10 rounded-xl flex items-center justify-center text-white font-bold text-xs" style={`background: linear-gradient(135deg, ${network.data.gradientFrom}, ${network.data.gradientTo})`}>{network.data.shortName}</div>
              )}
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <a href={`/networks/${network.data.slug}`} class="inline-flex items-center max-lg:min-h-[44px] text-[15px] font-bold text-primary no-underline hover:text-accent-text transition-colors">{network.data.name.split(' (')[0]}</a>
                {network.data.categoryBadge && (
                  <span class="px-2 py-0.5 text-[11px] font-semibold rounded-full bg-accent/10 text-accent-text">{network.data.categoryBadge}</span>
                )}
              </div>
              <p class="text-[13px] text-secondary mt-1 line-clamp-2">{network.data.description?.slice(0, 200)}...</p>
              <div class="flex flex-wrap gap-x-4 gap-y-1 mt-2 text-[12px] text-tertiary">
                {network.data.expertCount && <span>Experts: {network.data.expertCount}</span>}
                {network.data.pricingModel && <span>Pricing: {network.data.pricingModel}</span>}
                {network.data.headquarters && <span>HQ: {network.data.headquarters}</span>}
              </div>
              <div class="flex gap-4 mt-1">
                <a href={`/networks/${network.data.slug}`} class="inline-flex items-center min-h-[44px] text-[13px] font-semibold text-accent-text no-underline hover:underline">Full profile &rarr;</a>
                <a href={`/compare?networks=alphasights,${network.data.slug}`} class="inline-flex items-center min-h-[44px] text-[13px] font-medium text-secondary no-underline hover:text-accent-text hover:underline">Compare with AlphaSights</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-section-sm px-4 sm:px-6">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-step-2 font-bold text-primary mb-6">Keep exploring</h2>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="/compare" class="btn btn-primary">Full Comparison Tool</a>
        <a href="/glg-alternatives" class="btn btn-secondary">GLG Alternatives</a>
        <a href="/expert-network-pricing" class="btn btn-secondary">Pricing Guide</a>
      </div>
    </div>
  </section>
</BaseLayout>

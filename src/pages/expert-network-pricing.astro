                    <th class="text-left px-4 py-3 text-[11px] font-semibold text-tertiary uppercase tracking-wider hidden sm:table-cell">Pricing Notes</th>
                    <th class="text-center px-4 py-3 text-[11px] font-semibold text-tertiary uppercase tracking-wider">Confidence</th>
                  </tr>
                </thead>
                <tbody>
                  {published.map((n, i) => (
                      <tr class={`${i % 2 === 0 ? '' : 'bg-bg-secondary/30'} border-b border-border/20 hover:bg-accent/[0.03] transition-colors group`}>
                        <td class="px-4 py-3">
                          <a href={`/networks/${n.data.slug}`} class="flex items-center gap-2 no-underline text-primary hover:text-accent transition-colors">
                            <div class="w-5 h-5 rounded flex items-center justify-center text-white font-bold text-[6px] flex-shrink-0" style={`background: linear-gradient(135deg, ${n.data.gradientFrom}, ${n.data.gradientTo})`}>
                              {n.data.shortName}
                            </div>
                            <span class="text-xs font-medium">{n.data.name.split(' (')[0]}</span>
                          </a>
                        </td>
                        <td class="px-4 py-3">
                          <span class="text-[11px] px-2 py-0.5 rounded-full bg-bg-secondary font-medium text-secondary whitespace-nowrap">{modelMeta[n.data.pricingModel || '']?.label || n.data.pricingModel}</span>
                        </td>
                        <td class="px-4 py-3 text-xs text-secondary max-w-xs hidden sm:table-cell leading-relaxed">{n.data.pricingDetail || 'Contact provider for pricing details'}</td>
                        <td class="px-4 py-3 text-center">
                          <span class={`inline-block text-[10px] px-2 py-0.5 rounded font-semibold whitespace-nowrap ${providerConfidence[i].color}`}>{providerConfidence[i].label}</span>

  <!-- ════════════════════════════════════════════════════════════════
       CLIENT SCRIPTS
       ════════════════════════════════════════════════════════════════ -->
  <script>
    // @ts-nocheck
    (function() {
      /* ── Active TOC tracking ── */
      var tocLinks = document.querySelectorAll('.pricing-toc-link');
      if (!tocLinks.length) return;

      var sectionIds = Array.from(tocLinks).map(function(l) {
        return l.getAttribute('href').replace('#', '');
      });

      function updateToc() {
        var scrollY = window.scrollY + 120;
        var activeId = sectionIds[0];

        for (var i = sectionIds.length - 1; i >= 0; i--) {
          var el = document.getElementById(sectionIds[i]);
          if (el && el.offsetTop <= scrollY) {
            activeId = sectionIds[i];
            break;
          }
        }

        tocLinks.forEach(function(link) {
          var href = link.getAttribute('href').replace('#', '');
          if (href === activeId) {
            link.classList.add('text-accent', 'font-medium', 'border-accent');
            link.classList.remove('text-tertiary', 'border-transparent');
          } else {
            link.classList.remove('text-accent', 'font-medium', 'border-accent');
            link.classList.add('text-tertiary', 'border-transparent');
          }
        });
      }

      var ticking = false;
      window.addEventListener('scroll', function() {
        if (!ticking) {
          requestAnimationFrame(function() { updateToc(); ticking = false; });
          ticking = true;
        }
      }, { passive: true });
      updateToc();
    })();
  </script>

---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getCollection } from 'astro:content';

const allNews = await getCollection('news');
const articles = allNews.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const allNetworks = await getCollection('networks');

const action = Astro.url.searchParams.get('action');
const editSlug = Astro.url.searchParams.get('edit');
const editArticle = editSlug ? articles.find(n => n.data.slug === editSlug) : null;
const showForm = action === 'new' || editArticle;
---

<AdminLayout title="News Manager" activePage="news">
  {!showForm ? (
    <div class="admin-card">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-lg font-bold text-primary">All News ({articles.length})</h2>
        <a href="/admin/news?action=new" class="admin-btn admin-btn-primary">+ Add Article</a>
      </div>
      <table class="admin-table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Category</th>
            <th>Date</th>
            <th>Source</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {articles.map(n => (
            <tr>
              <td class="font-medium max-w-[300px] truncate">{n.data.title}</td>
              <td><span class="admin-badge admin-badge-blue">{n.data.category}</span></td>
              <td class="whitespace-nowrap">{n.data.date}</td>
              <td>{n.data.source}</td>
              <td>
                {n.data.published ? (
                  <span class="admin-badge admin-badge-green">Published</span>
                ) : (
                  <span class="admin-badge admin-badge-yellow">Draft</span>
                )}
              </td>
              <td>
                <div class="flex gap-2">
                  <a href={`/admin/news?edit=${n.data.slug}`} class="text-accent text-sm no-underline hover:underline">Edit</a>
                  <button onclick={`deleteNews('${n.data.slug}')`} class="text-red-500 text-sm bg-transparent border-none cursor-pointer hover:underline">Delete</button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : (
    <div class="admin-card max-w-3xl">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-lg font-bold text-primary">{editArticle ? 'Edit Article' : 'Add New Article'}</h2>
        <a href="/admin/news" class="text-sm text-accent no-underline hover:underline">&larr; Back to list</a>
      </div>
      <form id="newsForm" class="space-y-5">
        <input type="hidden" name="originalSlug" value={editArticle?.data.slug || ''} />

        <div>
          <label class="admin-label">Title *</label>
          <input type="text" name="title" required class="admin-input" value={editArticle?.data.title || ''} placeholder="Article headline..." />
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="admin-label">Slug *</label>
            <input type="text" name="slug" required class="admin-input" value={editArticle?.data.slug || ''} placeholder="auto-from-title" />
          </div>
          <div>
            <label class="admin-label">Category *</label>
            <select name="category" required class="admin-select">
              <option value="M&A" selected={editArticle?.data.category === 'M&A'}>M&A</option>
              <option value="AI" selected={editArticle?.data.category === 'AI'}>AI</option>
              <option value="Industry" selected={editArticle?.data.category === 'Industry'}>Industry</option>
              <option value="Funding" selected={editArticle?.data.category === 'Funding'}>Funding</option>
              <option value="Product" selected={editArticle?.data.category === 'Product'}>Product</option>
              <option value="Regulation" selected={editArticle?.data.category === 'Regulation'}>Regulation</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="admin-label">Date *</label>
            <input type="date" name="date" required class="admin-input" value={editArticle?.data.date || new Date().toISOString().split('T')[0]} />
          </div>
          <div>
            <label class="admin-label">Category Color</label>
            <div class="flex gap-2 items-center">
              <input type="color" name="categoryColorPicker" value={editArticle?.data.categoryColor || '#0071E3'} class="w-10 h-10 rounded border border-border" />
              <input type="text" name="categoryColor" class="admin-input flex-1" value={editArticle?.data.categoryColor || '#0071E3'} />
            </div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="admin-label">Source Name *</label>
            <input type="text" name="source" required class="admin-input" value={editArticle?.data.source || ''} placeholder="e.g. INEX ONE, Business Wire" />
          </div>
          <div>
            <label class="admin-label">Source URL</label>
            <input type="url" name="sourceUrl" class="admin-input" value={editArticle?.data.sourceUrl || ''} placeholder="https://..." />
          </div>
        </div>

        <div>
          <label class="admin-label">Summary *</label>
          <textarea name="summary" required class="admin-textarea" rows="4" placeholder="Article summary...">{editArticle?.data.summary || ''}</textarea>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="admin-label">Card Gradient From</label>
            <div class="flex gap-2 items-center">
              <input type="color" name="gradientFrom" value={editArticle?.data.gradientFrom || '#1a365d'} class="w-10 h-10 rounded border border-border" />
              <input type="text" name="gradientFromText" class="admin-input flex-1" value={editArticle?.data.gradientFrom || '#1a365d'} />
            </div>
          </div>
          <div>
            <label class="admin-label">Card Gradient To</label>
            <div class="flex gap-2 items-center">
              <input type="color" name="gradientTo" value={editArticle?.data.gradientTo || '#2563eb'} class="w-10 h-10 rounded border border-border" />
              <input type="text" name="gradientToText" class="admin-input flex-1" value={editArticle?.data.gradientTo || '#2563eb'} />
            </div>
          </div>
        </div>

        <div>
          <label class="admin-label">Related Networks (comma-separated slugs)</label>
          <input type="text" name="relatedNetworks" class="admin-input" value={editArticle?.data.relatedNetworks?.join(', ') || ''} placeholder="glg, alphasights" />
          <div class="text-xs text-tertiary mt-1">Available: {allNetworks.map(n => n.data.slug).join(', ')}</div>
        </div>

        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" name="published" checked={editArticle?.data.published !== false} class="w-4 h-4 accent-accent" />
          <span class="text-sm font-medium text-primary">Published (visible on public site)</span>
        </label>

        <div class="flex gap-3 pt-4">
          <button type="submit" class="admin-btn admin-btn-primary">
            {editArticle ? 'Save Changes' : 'Create Article'}
          </button>
          <a href="/admin/news" class="admin-btn admin-btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  )}

  <script>
    // Auto-generate slug from title
    const titleInput = document.querySelector('input[name="title"]') as HTMLInputElement;
    const slugInput = document.querySelector('input[name="slug"]') as HTMLInputElement;
    if (titleInput && slugInput && !slugInput.value) {
      titleInput.addEventListener('input', () => {
        slugInput.value = titleInput.value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
      });
    }

    // Sync color pickers
    document.querySelectorAll('input[type="color"]').forEach(picker => {
      const textInput = picker.nextElementSibling as HTMLInputElement;
      if (textInput) {
        picker.addEventListener('input', () => { textInput.value = (picker as HTMLInputElement).value; });
        textInput.addEventListener('input', () => { (picker as HTMLInputElement).value = textInput.value; });
      }
    });

    // Form submission
    document.getElementById('newsForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const fd = new FormData(form);

      const data = {
        title: fd.get('title'),
        slug: fd.get('slug'),
        date: fd.get('date'),
        source: fd.get('source'),
        sourceUrl: fd.get('sourceUrl') || undefined,
        category: fd.get('category'),
        categoryColor: fd.get('categoryColor'),
        gradientFrom: fd.get('gradientFromText') || fd.get('gradientFrom'),
        gradientTo: fd.get('gradientToText') || fd.get('gradientTo'),
        summary: fd.get('summary'),
        relatedNetworks: (fd.get('relatedNetworks') as string)?.split(',').map(s => s.trim()).filter(Boolean) || [],
        published: fd.has('published'),
        originalSlug: fd.get('originalSlug') || undefined,
      };

      const res = await fetch('/api/news', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        window.location.href = '/admin/news';
      } else {
        alert('Error saving: ' + (await res.text()));
      }
    });

    async function deleteNews(slug: string) {
      if (!confirm(`Delete "${slug}"? This cannot be undone.`)) return;
      const res = await fetch(`/api/news?slug=${slug}`, { method: 'DELETE' });
      if (res.ok) window.location.reload();
      else alert('Error deleting: ' + (await res.text()));
    }
    (window as any).deleteNews = deleteNews;
  </script>
</AdminLayout>

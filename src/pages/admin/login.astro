---
import '../../styles/global.css';

const error = Astro.url.searchParams.get('error');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login — ExpertHub Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body class="min-h-screen bg-bg-secondary flex items-center justify-center font-sans">
  <div class="w-full max-w-sm mx-4">
    <div class="text-center mb-8">
      <div class="text-2xl font-bold text-primary">Expert<span class="text-accent">Hub</span></div>
      <div class="text-sm text-tertiary mt-1">Admin Dashboard</div>
    </div>
    <div class="bg-white rounded-card shadow-card p-8">
      <h1 class="text-xl font-bold text-primary mb-6 text-center">Sign In</h1>
      {error && (
        <div class="bg-red-50 text-red-600 text-sm px-4 py-3 rounded-lg mb-4">
          Incorrect password. Please try again.
        </div>
      )}
      <form method="POST" action="/api/auth">
        <label class="block text-sm font-semibold text-primary mb-1.5" for="password">Password</label>
        <input
          type="password"
          id="password"
          name="password"
          required
          autofocus
          class="w-full px-3 py-2.5 border border-border rounded-lg text-sm text-primary bg-white focus:outline-none focus:ring-2 focus:ring-accent/30 focus:border-accent transition-all mb-6"
          placeholder="Enter admin password"
        />
        <button type="submit" class="w-full bg-accent text-white py-2.5 rounded-lg text-sm font-semibold hover:bg-accent-hover transition-colors">
          Sign In
        </button>
      </form>
    </div>
    <div class="text-center mt-4">
      <a href="/" class="text-sm text-accent no-underline hover:underline">&larr; Back to public site</a>
    </div>
  </div>
</body>
</html>

---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getCollection } from 'astro:content';

const allNetworks = await getCollection('networks');
const allNews = await getCollection('news');
const publishedNetworks = allNetworks.filter(n => n.data.published);
const publishedNews = allNews.filter(n => n.data.published);
const draftNews = allNews.filter(n => !n.data.published);
const featuredNetworks = allNetworks.filter(n => n.data.featured);
---

<AdminLayout title="Dashboard" activePage="dashboard">
  <!-- Stats Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="admin-stat-card">
      <div class="admin-stat-value">{publishedNetworks.length}</div>
      <div class="admin-stat-label">Published Networks</div>
    </div>
    <div class="admin-stat-card">
      <div class="admin-stat-value">{featuredNetworks.length}</div>
      <div class="admin-stat-label">Featured (Deep Dives)</div>
    </div>
    <div class="admin-stat-card">
      <div class="admin-stat-value">{publishedNews.length}</div>
      <div class="admin-stat-label">Published News</div>
    </div>
    <div class="admin-stat-card">
      <div class="admin-stat-value">{draftNews.length}</div>
      <div class="admin-stat-label">Draft Articles</div>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="admin-card mb-8">
    <h2 class="text-lg font-bold text-primary mb-4">Quick Actions</h2>
    <div class="flex flex-wrap gap-3">
      <a href="/admin/networks?action=new" class="admin-btn admin-btn-primary">+ Add Network</a>
      <a href="/admin/news?action=new" class="admin-btn admin-btn-primary">+ Add News Article</a>
      <a href="/admin/settings" class="admin-btn admin-btn-secondary">Edit Site Settings</a>
      <a href="/admin/preview" class="admin-btn admin-btn-secondary">Preview Site</a>
      <a href="/" target="_blank" class="admin-btn admin-btn-secondary">Open Public Site &rarr;</a>
    </div>
  </div>

  <!-- Recent Networks -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="admin-card">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-bold text-primary">Networks</h2>
        <a href="/admin/networks" class="text-sm text-accent no-underline hover:underline">View all &rarr;</a>
      </div>
      <table class="admin-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          {allNetworks.sort((a, b) => a.data.priority - b.data.priority).slice(0, 5).map(n => (
            <tr>
              <td class="font-medium">{n.data.name.split(' (')[0]}</td>
              <td>{n.data.type}</td>
              <td>
                {n.data.featured ? (
                  <span class="admin-badge admin-badge-blue">Featured</span>
                ) : n.data.published ? (
                  <span class="admin-badge admin-badge-green">Published</span>
                ) : (
                  <span class="admin-badge admin-badge-yellow">Draft</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="admin-card">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-bold text-primary">Recent News</h2>
        <a href="/admin/news" class="text-sm text-accent no-underline hover:underline">View all &rarr;</a>
      </div>
      <table class="admin-table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Date</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          {allNews.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()).slice(0, 5).map(n => (
            <tr>
              <td class="font-medium max-w-[200px] truncate">{n.data.title}</td>
              <td class="whitespace-nowrap">{n.data.date}</td>
              <td>
                {n.data.published ? (
                  <span class="admin-badge admin-badge-green">Published</span>
                ) : (
                  <span class="admin-badge admin-badge-yellow">Draft</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>

<script>
  // @ts-nocheck
// ─── Hero fade-up reveal ───
(function() {
  var items = document.querySelectorAll('.src-fade-up');
  if (!items.length) return;

  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    items.forEach(function(el) { el.classList.add('is-visible'); });
    return;
  }

  setTimeout(function() {
    items.forEach(function(el) { el.classList.add('is-visible'); });
  }, 100);
})();
</script>

<!-- Nav dark mode — matches About page pattern -->
<script>
  // @ts-nocheck
(function() {
  var nav = document.querySelector('nav');
  var heroSection = document.getElementById('sourcesHero');
  if (!nav || !heroSection) return;

  var brandLink = nav.querySelector('a[href="/"]');
  var menuBtn = nav.querySelector('#menuBtn');
  var navLinks = nav.querySelectorAll('ul a');
  var searchBtn = nav.querySelector('#searchTrigger');
  var linkedinLink = nav.querySelector('a[aria-label="LinkedIn"]');

  var isDark = false;

  function setDarkNav() {
    if (isDark) return;
    isDark = true;
    nav.style.background = 'rgba(10,10,12,0.85)';
    nav.style.borderBottomColor = 'rgba(255,255,255,0.06)';
    if (brandLink) { brandLink.style.color = '#fff'; }
    if (menuBtn) { menuBtn.style.color = '#a1a1a6'; }
    navLinks.forEach(function(l) { l.style.color = '#a1a1a6'; });
    if (searchBtn) { searchBtn.style.background = 'rgba(255,255,255,0.08)'; searchBtn.style.color = '#a1a1a6'; }
    if (linkedinLink) { linkedinLink.style.color = '#a1a1a6'; }
  }

  function setLightNav() {
    if (!isDark) return;
    isDark = false;
    nav.style.background = '';
    nav.style.borderBottomColor = '';
    if (brandLink) { brandLink.style.color = ''; }
    if (menuBtn) { menuBtn.style.color = ''; }
    navLinks.forEach(function(l) { l.style.color = ''; });
    if (searchBtn) { searchBtn.style.background = ''; searchBtn.style.color = ''; }
    if (linkedinLink) { linkedinLink.style.color = ''; }
  }

  // Entire page is dark — keep nav dark always
  setDarkNav();

  window.addEventListener('scroll', function() {
    setDarkNav();
  }, { passive: true });
})();
</script>

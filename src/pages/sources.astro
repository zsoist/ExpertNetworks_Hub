---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Sources & Methodology — ExpertNetworks.net"
  description="How ExpertNetworks.net gathers, weighs, labels, and updates information across provider profiles, pricing pages, and industry news. Public-source research with clear labeling."
  canonicalPath="/sources"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    'itemListElement': [
      { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': 'https://expertnetworks.net/' },
      { '@type': 'ListItem', 'position': 2, 'name': 'Sources & Methodology' }
    ]
  }}
>

  <!-- ═══ 1. HERO ═══ -->
  <section class="relative overflow-hidden bg-[#0a0a0c]" id="sourcesHero">
    <!-- Grid texture -->
    <div class="absolute inset-0 opacity-[0.025]" style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 60px 60px;"></div>
    <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse at 50% 60%, rgba(0,113,227,0.05) 0%, transparent 60%);"></div>

    <div class="relative z-10 pt-[100px] pb-14 md:pt-[120px] md:pb-18 lg:pt-[136px] lg:pb-20 px-6">
      <div class="max-w-site mx-auto">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 mb-5 opacity-0 src-fade-up src-delay-1">
            <span class="w-8 h-px bg-[rgba(0,113,227,0.5)]"></span>
            <span class="text-[11px] font-semibold tracking-[0.15em] uppercase text-[#6e8aaf]">Research standards</span>
          </div>
          <h1 class="text-[2rem] md:text-[2.75rem] lg:text-[3rem] font-extrabold text-white leading-[1.12] tracking-tight mb-4 opacity-0 src-fade-up src-delay-2">
            Sources & Methodology
          </h1>
          <p class="text-[#9a9aa0] text-base md:text-lg leading-relaxed mb-6 max-w-xl opacity-0 src-fade-up src-delay-3">
            How ExpertNetworks.net gathers, weighs, labels, and updates information across provider profiles, pricing pages, and industry news.
          </p>
          <p class="text-[#6e6e73] text-sm mb-7 opacity-0 src-fade-up src-delay-3">
            Public-source research. Clear labeling. Corrections over ego.
          </p>

          <!-- Trust pills -->
          <div class="flex flex-wrap gap-2 opacity-0 src-fade-up src-delay-4">
            <span class="inline-flex items-center px-3 py-1.5 rounded-full text-[11px] font-semibold text-[#6e8aaf] bg-[rgba(0,113,227,0.08)] border border-[rgba(0,113,227,0.12)]">Public-source only</span>
            <span class="inline-flex items-center px-3 py-1.5 rounded-full text-[11px] font-semibold text-[#6e8aaf] bg-[rgba(0,113,227,0.08)] border border-[rgba(0,113,227,0.12)]">No paid placement</span>
            <span class="inline-flex items-center px-3 py-1.5 rounded-full text-[11px] font-semibold text-[#6e8aaf] bg-[rgba(0,113,227,0.08)] border border-[rgba(0,113,227,0.12)]">Claims labeled</span>
            <span class="inline-flex items-center px-3 py-1.5 rounded-full text-[11px] font-semibold text-[#6e8aaf] bg-[rgba(0,113,227,0.08)] border border-[rgba(0,113,227,0.12)]">Corrections welcome</span>
          </div>
        </div>
      </div>
    </div>

    <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[rgba(255,255,255,0.06)] to-transparent"></div>
  </section>


  <!-- ═══ 2. WHAT THIS PAGE COVERS ═══ -->
  <section class="relative bg-[#0d0d10] py-16 md:py-20 px-6">
    <div class="max-w-site mx-auto">
      <div class="max-w-3xl mx-auto fade-in">
        <div class="rounded-2xl p-7 md:p-8 border border-[rgba(255,255,255,0.06)] bg-[rgba(255,255,255,0.02)]" style="backdrop-filter: blur(8px);">
          <h2 class="text-lg font-bold text-white mb-3">What this page covers</h2>
          <p class="text-[#9a9aa0] text-[14px] leading-[1.75]">
            This page explains how information is collected, how different source types are weighed, how claims are labeled, and how corrections are handled. The goal is not to imply perfect certainty. The goal is to make public information more usable, more comparable, and more honest about its limits.
          </p>
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[rgba(255,255,255,0.04)] to-transparent"></div>
  </section>


  <!-- ═══ 3. HOW WE GATHER AND WEIGH INFORMATION ═══ -->
  <section class="relative bg-[#0b0b0e] py-20 md:py-24 px-6">
    <div class="max-w-site mx-auto">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-4 fade-in">How we gather and weigh information</h2>
        <p class="text-[#9a9aa0] text-[15px] leading-[1.75] mb-10 fade-in">
          ExpertNetworks.net compiles information from publicly available materials, including company websites, product pages, regulatory filings, press releases, industry reports, and independent news coverage. Not all public sources carry the same evidentiary weight.
        </p>

        <!-- Source hierarchy cards -->
        <div class="grid sm:grid-cols-2 gap-4">
          <div class="fade-in stagger-1 rounded-2xl p-6 border border-[rgba(0,113,227,0.12)] bg-[rgba(0,113,227,0.03)]">
            <div class="flex items-center gap-2.5 mb-3">
              <div class="w-7 h-7 rounded-lg bg-[rgba(0,113,227,0.15)] flex items-center justify-center">
                <span class="text-[11px] font-bold text-[#5ba4e6]">1</span>
              </div>
              <h3 class="text-[14px] font-bold text-white">Primary sources</h3>
            </div>
            <p class="text-[#6e6e73] text-[13px] leading-relaxed">
              Company websites, official product pages, regulatory filings, public records.
            </p>
          </div>

          <div class="fade-in stagger-2 rounded-2xl p-6 border border-[rgba(255,255,255,0.06)] bg-[rgba(255,255,255,0.02)]">
            <div class="flex items-center gap-2.5 mb-3">
              <div class="w-7 h-7 rounded-lg bg-[rgba(255,255,255,0.06)] flex items-center justify-center">
                <span class="text-[11px] font-bold text-[#9a9aa0]">2</span>
              </div>
              <h3 class="text-[14px] font-bold text-white">Independent reporting</h3>
            </div>
            <p class="text-[#6e6e73] text-[13px] leading-relaxed">
              Reputable journalism, trade reporting, public interviews, analyst coverage.
            </p>
          </div>

          <div class="fade-in stagger-3 rounded-2xl p-6 border border-[rgba(255,255,255,0.06)] bg-[rgba(255,255,255,0.02)]">
            <div class="flex items-center gap-2.5 mb-3">
              <div class="w-7 h-7 rounded-lg bg-[rgba(255,255,255,0.06)] flex items-center justify-center">
                <span class="text-[11px] font-bold text-[#9a9aa0]">3</span>
              </div>
              <h3 class="text-[14px] font-bold text-white">Company-originated</h3>
            </div>
            <p class="text-[#6e6e73] text-[13px] leading-relaxed">
              Press releases, investor updates, marketing materials, sponsored content.
            </p>
          </div>

          <div class="fade-in stagger-4 rounded-2xl p-6 border border-[rgba(255,255,255,0.06)] bg-[rgba(255,255,255,0.02)]">
            <div class="flex items-center gap-2.5 mb-3">
              <div class="w-7 h-7 rounded-lg bg-[rgba(255,255,255,0.06)] flex items-center justify-center">
                <span class="text-[11px] font-bold text-[#9a9aa0]">4</span>
              </div>
              <h3 class="text-[14px] font-bold text-white">Editorial synthesis</h3>
            </div>
            <p class="text-[#6e6e73] text-[13px] leading-relaxed">
              Comparative analysis and clearly labeled inferences drawn from public evidence.
            </p>
          </div>
        </div>

        <p class="text-[#6e6e73] text-[13px] leading-relaxed mt-6 fade-in">
          In general, official disclosures, current product materials, and independently reported facts are weighted more heavily than promotional content or unattributed summaries.
        </p>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[rgba(255,255,255,0.04)] to-transparent"></div>
  </section>


  <!-- ═══ 4. WHAT WE TRACK ═══ -->
  <section class="relative bg-[#0d0d10] py-20 md:py-24 px-6">
    <div class="max-w-site mx-auto">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-3 fade-in">What we track</h2>
        <p class="text-[#9a9aa0] text-[14px] leading-relaxed mb-8 fade-in">
          Profiles aim to capture the fields buyers actually compare: structure, pricing, compliance, service model, content access, and operating focus.
        </p>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
          <div class="fade-in stagger-1 rounded-xl p-4 border border-[rgba(255,255,255,0.05)] bg-[rgba(255,255,255,0.015)] text-center">
            <div class="w-8 h-8 rounded-lg bg-[rgba(0,113,227,0.08)] flex items-center justify-center mx-auto mb-2.5">
              <svg class="w-4 h-4 text-[#5ba4e6]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>
            </div>
            <div class="text-[12px] font-semibold text-white">Company basics</div>
          </div>
          <div class="fade-in stagger-2 rounded-xl p-4 border border-[rgba(255,255,255,0.05)] bg-[rgba(255,255,255,0.015)] text-center">
            <div class="w-8 h-8 rounded-lg bg-[rgba(0,113,227,0.08)] flex items-center justify-center mx-auto mb-2.5">
              <svg class="w-4 h-4 text-[#5ba4e6]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div class="text-[12px] font-semibold text-white">Scale indicators</div>
          </div>
          <div class="fade-in stagger-3 rounded-xl p-4 border border-[rgba(255,255,255,0.05)] bg-[rgba(255,255,255,0.015)] text-center">
            <div class="w-8 h-8 rounded-lg bg-[rgba(0,113,227,0.08)] flex items-center justify-center mx-auto mb-2.5">
              <svg class="w-4 h-4 text-[#5ba4e6]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
            </div>
            <div class="text-[12px] font-semibold text-white">Services</div>
          </div>
          <div class="fade-in stagger-4 rounded-xl p-4 border border-[rgba(255,255,255,0.05)] bg-[rgba(255,255,255,0.015)] text-center">
            <div class="w-8 h-8 rounded-lg bg-[rgba(0,113,227,0.08)] flex items-center justify-center mx-auto mb-2.5">
              <svg class="w-4 h-4 text-[#5ba4e6]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2a4 4 0 0 1 4 4c0 2-2 3-2 5h-4c0-2-2-3-2-5a4 4 0 0 1 4-4z"/><path d="M10 17h4"/><path d="M10 20h4"/></svg>
            </div>
            <div class="text-[12px] font-semibold text-white">AI capabilities</div>
          </div>
          <div class="fade-in stagger-5 rounded-xl p-4 border border-[rgba(255,255,255,0.05)] bg-[rgba(255,255,255,0.015)] text-center">
            <div class="w-8 h-8 rounded-lg bg-[rgba(0,113,227,0.08)] flex items-center justify-center mx-auto mb-2.5">
              <svg class="w-4 h-4 text-[#5ba4e6]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <div class="text-[12px] font-semibold text-white">Pricing model</div>
          </div>
          <div class="fade-in stagger-6 rounded-xl p-4 border border-[rgba(255,255,255,0.05)] bg-[rgba(255,255,255,0.015)] text-center">
            <div class="w-8 h-8 rounded-lg bg-[rgba(0,113,227,0.08)] flex items-center justify-center mx-auto mb-2.5">
              <svg class="w-4 h-4 text-[#5ba4e6]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div class="text-[12px] font-semibold text-white">Compliance</div>
          </div>
          <div class="fade-in stagger-7 rounded-xl p-4 border border-[rgba(255,255,255,0.05)] bg-[rgba(255,255,255,0.015)] text-center">
            <div class="w-8 h-8 rounded-lg bg-[rgba(0,113,227,0.08)] flex items-center justify-center mx-auto mb-2.5">
              <svg class="w-4 h-4 text-[#5ba4e6]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15 15 0 0 1 4 10 15 15 0 0 1-4 10 15 15 0 0 1-4-10 15 15 0 0 1 4-10z"/></svg>
            </div>
            <div class="text-[12px] font-semibold text-white">Geography</div>
          </div>
          <div class="fade-in stagger-8 rounded-xl p-4 border border-[rgba(255,255,255,0.05)] bg-[rgba(255,255,255,0.015)] text-center">
            <div class="w-8 h-8 rounded-lg bg-[rgba(0,113,227,0.08)] flex items-center justify-center mx-auto mb-2.5">
              <svg class="w-4 h-4 text-[#5ba4e6]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
            <div class="text-[12px] font-semibold text-white">Buyer fit</div>
          </div>
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[rgba(255,255,255,0.04)] to-transparent"></div>
  </section>


  <!-- ═══ 5. CLAIM LABELS ═══ -->
  <section class="relative bg-[#0a0a0c] py-20 md:py-24 px-6 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.02]" style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 40px 40px;"></div>

    <div class="max-w-site mx-auto relative">
      <div class="max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 mb-4 fade-in">
          <span class="w-8 h-px bg-[rgba(0,113,227,0.4)]"></span>
          <span class="text-[10px] font-semibold tracking-[0.18em] uppercase text-[#5a7a9e]">Evidence standards</span>
          <span class="w-8 h-px bg-[rgba(0,113,227,0.4)]"></span>
        </div>
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-3 fade-in">How claims are labeled</h2>
        <p class="text-[#9a9aa0] text-[14px] leading-relaxed mb-10 fade-in">
          Every factual claim in a network profile is assigned one of four labels. This system matches the site's <a href="/verification" class="text-[#5ba4e6] hover:underline">verification framework</a>.
        </p>

        <div class="grid sm:grid-cols-2 gap-4">
          <!-- Verified -->
          <div class="fade-in stagger-1 rounded-2xl p-6 border border-[rgba(48,209,88,0.15)] bg-[rgba(48,209,88,0.03)]">
            <div class="flex items-center gap-2.5 mb-3">
              <span class="w-2.5 h-2.5 rounded-full bg-accent-green"></span>
              <h3 class="text-[14px] font-bold text-white">Verified</h3>
            </div>
            <p class="text-[#9a9aa0] text-[13px] leading-relaxed mb-2">
              Directly supported by primary public sources or multiple credible sources.
            </p>
            <p class="text-[#4a4a52] text-[11px] leading-relaxed">
              E.g., founding year from incorporation records, headquarters from regulatory filings.
            </p>
          </div>

          <!-- Positioned -->
          <div class="fade-in stagger-2 rounded-2xl p-6 border border-[rgba(0,113,227,0.15)] bg-[rgba(0,113,227,0.03)]">
            <div class="flex items-center gap-2.5 mb-3">
              <span class="w-2.5 h-2.5 rounded-full bg-accent"></span>
              <h3 class="text-[14px] font-bold text-white">Positioned</h3>
            </div>
            <p class="text-[#9a9aa0] text-[13px] leading-relaxed mb-2">
              Company-originated claim or marketing framing, presented as such.
            </p>
            <p class="text-[#4a4a52] text-[11px] leading-relaxed">
              E.g., expert count from company website, service descriptions from product pages.
            </p>
          </div>

          <!-- Inferred -->
          <div class="fade-in stagger-3 rounded-2xl p-6 border border-[rgba(255,159,10,0.15)] bg-[rgba(255,159,10,0.03)]">
            <div class="flex items-center gap-2.5 mb-3">
              <span class="w-2.5 h-2.5 rounded-full bg-accent-orange"></span>
              <h3 class="text-[14px] font-bold text-white">Inferred</h3>
            </div>
            <p class="text-[#9a9aa0] text-[13px] leading-relaxed mb-2">
              Editorial conclusion drawn from available public evidence.
            </p>
            <p class="text-[#4a4a52] text-[11px] leading-relaxed">
              E.g., pricing model estimated from job postings, geographic scope from office locations.
            </p>
          </div>

          <!-- Estimated -->
          <div class="fade-in stagger-4 rounded-2xl p-6 border border-[rgba(191,90,242,0.15)] bg-[rgba(191,90,242,0.03)]">
            <div class="flex items-center gap-2.5 mb-3">
              <span class="w-2.5 h-2.5 rounded-full bg-accent-purple"></span>
              <h3 class="text-[14px] font-bold text-white">Estimated</h3>
            </div>
            <p class="text-[#9a9aa0] text-[13px] leading-relaxed mb-2">
              Approximate figure used when definitions vary or precise disclosure is unavailable.
            </p>
            <p class="text-[#4a4a52] text-[11px] leading-relaxed">
              E.g., employee count from LinkedIn, expert network market size from analyst reports.
            </p>
          </div>
        </div>

        <p class="text-[#6e6e73] text-[13px] leading-relaxed mt-6 fade-in">
          Labels are assigned per field, not per profile. A single network may have its founding year marked as verified, its expert count as positioned, and its pricing model as inferred — because each data point has a different evidence basis.
        </p>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[rgba(255,255,255,0.04)] to-transparent"></div>
  </section>


  <!-- ═══ 6. NUMBERS NEED CONTEXT ═══ -->
  <section class="relative bg-[#0d0d10] py-20 md:py-24 px-6">
    <div class="max-w-site mx-auto">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-xl md:text-2xl font-bold text-white mb-4 fade-in">Expert counts, employee counts, and other approximate figures</h2>
        <p class="text-[#9a9aa0] text-[14px] leading-[1.75] mb-8 fade-in">
          Scale metrics are often the least standardized fields in the category. Expert counts are frequently self-reported and may refer to registered, available, active, or vetted experts. Employee counts may vary across company disclosures, LinkedIn-derived estimates, and third-party databases.
        </p>

        <div class="grid md:grid-cols-2 gap-5 fade-in">
          <!-- Common issues -->
          <div class="rounded-2xl p-6 border border-[rgba(255,255,255,0.06)] bg-[rgba(255,255,255,0.02)]">
            <h3 class="text-[13px] font-bold text-[#9a9aa0] uppercase tracking-wide mb-4">Common issues</h3>
            <ul class="space-y-2.5">
              <li class="flex items-start gap-2.5 text-[#6e6e73] text-[13px] leading-relaxed">
                <span class="w-1 h-1 rounded-full bg-[rgba(255,159,10,0.5)] mt-2 shrink-0"></span>
                Different definitions of "expert" across providers
              </li>
              <li class="flex items-start gap-2.5 text-[#6e6e73] text-[13px] leading-relaxed">
                <span class="w-1 h-1 rounded-full bg-[rgba(255,159,10,0.5)] mt-2 shrink-0"></span>
                Self-reporting without standardized methodology
              </li>
              <li class="flex items-start gap-2.5 text-[#6e6e73] text-[13px] leading-relaxed">
                <span class="w-1 h-1 rounded-full bg-[rgba(255,159,10,0.5)] mt-2 shrink-0"></span>
                Stale or infrequently updated figures
              </li>
              <li class="flex items-start gap-2.5 text-[#6e6e73] text-[13px] leading-relaxed">
                <span class="w-1 h-1 rounded-full bg-[rgba(255,159,10,0.5)] mt-2 shrink-0"></span>
                Conflicting estimates across third-party databases
              </li>
            </ul>
          </div>

          <!-- How we handle them -->
          <div class="rounded-2xl p-6 border border-[rgba(0,113,227,0.1)] bg-[rgba(0,113,227,0.02)]">
            <h3 class="text-[13px] font-bold text-[#5ba4e6] uppercase tracking-wide mb-4">How we handle them</h3>
            <ul class="space-y-2.5">
              <li class="flex items-start gap-2.5 text-[#9a9aa0] text-[13px] leading-relaxed">
                <span class="w-1 h-1 rounded-full bg-[rgba(0,113,227,0.5)] mt-2 shrink-0"></span>
                Use the most commonly cited current figure
              </li>
              <li class="flex items-start gap-2.5 text-[#9a9aa0] text-[13px] leading-relaxed">
                <span class="w-1 h-1 rounded-full bg-[rgba(0,113,227,0.5)] mt-2 shrink-0"></span>
                Note approximation and source where possible
              </li>
              <li class="flex items-start gap-2.5 text-[#9a9aa0] text-[13px] leading-relaxed">
                <span class="w-1 h-1 rounded-full bg-[rgba(0,113,227,0.5)] mt-2 shrink-0"></span>
                Prefer primary sources over aggregated estimates
              </li>
              <li class="flex items-start gap-2.5 text-[#9a9aa0] text-[13px] leading-relaxed">
                <span class="w-1 h-1 rounded-full bg-[rgba(0,113,227,0.5)] mt-2 shrink-0"></span>
                Avoid false precision — directional is better than wrong
              </li>
            </ul>
          </div>
        </div>

        <p class="text-[#6e6e73] text-[13px] leading-relaxed mt-6 fade-in">
          Where exact comparability is not possible, figures are treated as directional unless otherwise noted.
        </p>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[rgba(255,255,255,0.04)] to-transparent"></div>
  </section>



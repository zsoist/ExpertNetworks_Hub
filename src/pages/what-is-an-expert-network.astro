      <div class="grid gap-3">
        {topNetworks.map(n => (
          <a href={`/networks/${n.data.slug}`} class="flex items-center gap-4 p-4 bg-bg-secondary rounded-card hover:shadow-card transition-shadow no-underline group">
            {n.data.logo ? (
              <img src={n.data.logo} alt="" width="40" height="40" class="w-10 h-10 rounded-lg object-cover flex-shrink-0" loading="lazy" />

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allNetworks = await getCollection('networks');
const published = allNetworks.filter(n => n.data.published).sort((a, b) => a.data.priority - b.data.priority);

// Filter networks strong for hedge funds
const hfNetworks = published.filter(n => {
  const industries = (n.data.industries || []).map((i: string) => i.toLowerCase());
  const bestFor = (n.data.bestFor || []).map((b: string) => b.toLowerCase());
  const all = [...industries, ...bestFor, (n.data.description || '').toLowerCase()].join(' ');
  return all.includes('hedge fund') || all.includes('investment research') || all.includes('buy-side') || all.includes('asset manage') || all.includes('investor');
});

// Ensure top providers are included
const topSlugs = ['glg', 'alphasights', 'third-bridge', 'guidepoint', 'dialectica', 'alphasense-tegus'];
const topProviders = topSlugs.map(s => published.find(n => n.data.slug === s)).filter(Boolean);
const combined = [...new Map([...topProviders, ...hfNetworks].map(n => [n!.data.slug, n])).values()];
---

<BaseLayout
  progress
  title="Best Expert Networks for Hedge Funds (2026 Guide) | ExpertNetworks.net"
  description="Guide to expert networks for hedge funds: which providers are best for investment research, sector deep-dives, and alpha generation. Compare GLG, AlphaSights, Third Bridge, and more for buy-side use cases."
  canonicalPath="/expert-networks-for-hedge-funds"
  ogType="article"
  jsonLd={{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://expertnetworks.net/" },
          { "@type": "ListItem", "position": 2, "name": "Networks", "item": "https://expertnetworks.net/networks" },
          { "@type": "ListItem", "position": 3, "name": "Expert Networks for Hedge Funds" }
        ]
      },
      {
        "@type": "Article",
        "headline": "Best Expert Networks for Hedge Funds (2026)",
        "description": "Guide to choosing expert networks for hedge fund research, sector analysis, and investment due diligence.",
        "publisher": { "@type": "Organization", "name": "ExpertNetworks.net", "url": "https://expertnetworks.net" },
        "datePublished": "2026-03-09",
        "dateModified": "2026-03-09"
      }
    ]
  }}
>
  <!-- Hero -->
  <section class="guide-hero pt-[calc(var(--nav-h)+3.5rem)] pb-section-sm px-4 sm:px-6">
    <div class="max-w-4xl mx-auto">
      <div class="flex items-center gap-3 mb-4">
        <a href="/networks/" class="inline-flex items-center min-h-[44px] text-accent-text text-sm font-medium no-underline hover:underline">&larr; All Networks</a>
        <span class="text-tertiary text-sm">|</span>
        <a href="/expert-networks-for-private-equity/" class="inline-flex items-center min-h-[44px] text-accent-text text-sm font-medium no-underline hover:underline">Expert Networks for PE</a>
      </div>
      <span class="inline-block px-3 py-1 bg-accent/10 text-accent-text text-xs font-semibold rounded-full mb-4 tracking-wide uppercase">Industry Guide</span>
      <h1 class="text-step-4 font-bold tracking-[-0.03em] text-primary mb-5">Expert Networks for Hedge Funds</h1>
      <p class="text-step-1 text-secondary max-w-measure">
        Which expert networks are best for buy-side investment research? A practical guide to choosing providers based on speed, content access, compliance infrastructure, and research workflow fit.
      </p>
    </div>
  </section>

  <!-- Editorial Content -->
  <section class="py-section-sm px-4 sm:px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-step-3 font-bold text-primary mb-6">How hedge funds use expert networks</h2>
      <div class="space-y-4 text-step-0 leading-[1.7] text-secondary max-w-measure">
        <p>
          Expert networks are a core part of the buy-side research toolkit. Hedge funds use them for sector deep-dives, management reference calls, supply chain checks, competitive intelligence, and pre-investment due diligence. The typical engagement is a 30–60 minute phone consultation with an industry practitioner — a former executive, domain specialist, or channel expert.
        </p>
        <p>
          For hedge funds specifically, the key evaluation criteria are:
        </p>
        <ul class="space-y-2 ml-4">
          <li><strong>Speed</strong> — Investment timelines are short. The best providers can source qualified experts within 24–48 hours.</li>
          <li><strong>Compliance</strong> — SEC scrutiny of expert networks means compliance infrastructure (information barriers, personal trading restrictions, call monitoring) is non-negotiable for institutional funds.</li>
          <li><strong>Content libraries</strong> — Pre-recorded transcripts and interview summaries let analysts scan sectors without scheduling live calls.</li>
          <li><strong>AI and search</strong> — Newer platforms offer AI-powered expert matching, transcript search, and research synthesis tools.</li>
          <li><strong>Expert quality</strong> — Sourcing matters. The best networks consistently deliver experts who are genuinely knowledgeable, not just willing to talk.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Provider Grid -->
  <section class="py-section-sm px-4 sm:px-6 bg-bg-secondary">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-step-3 font-bold text-primary mb-8">Top providers for hedge fund research</h2>
      <div class="space-y-4">
        {combined.map((network) => (
          <div class="bg-white rounded-card shadow-card p-5 flex flex-col sm:flex-row gap-4 items-start">
            <div class="flex-shrink-0">
              {network!.data.logo ? (
                <img src={network!.data.logo} alt="" width="40" height="40" class="w-10 h-10 rounded-xl object-contain" loading="lazy" />
              ) : (
                <div class="w-10 h-10 rounded-xl flex items-center justify-center text-white font-bold text-xs" style={`background: linear-gradient(135deg, ${network!.data.gradientFrom}, ${network!.data.gradientTo})`}>{network!.data.shortName}</div>
              )}
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <a href={`/networks/${network!.data.slug}/`} class="inline-flex items-center max-lg:min-h-[44px] text-[15px] font-bold text-primary no-underline hover:text-accent-text transition-colors">{network!.data.name.split(' (')[0]}</a>
                {network!.data.categoryBadge && (
                  <span class="px-2 py-0.5 text-[11px] font-semibold rounded-full bg-accent/10 text-accent-text">{network!.data.categoryBadge}</span>
                )}
              </div>
              <p class="text-[13px] text-secondary mt-1 line-clamp-2">{network!.data.description?.slice(0, 200)}...</p>
              <div class="flex flex-wrap gap-x-4 gap-y-1 mt-2 text-[12px] text-tertiary">
                {network!.data.expertCount && <span>Experts: {network!.data.expertCount}</span>}
                {network!.data.pricingModel && <span>Pricing: {network!.data.pricingModel}</span>}
                {network!.data.complianceBadge && <span>Compliance: {network!.data.complianceBadge}</span>}
              </div>
              <div class="flex gap-4 mt-1">
                <a href={`/networks/${network!.data.slug}/`} class="inline-flex items-center min-h-[44px] text-[13px] font-semibold text-accent-text no-underline hover:underline">Full profile &rarr;</a>
                <a href={`/compare/?add=${network!.data.slug}`} class="inline-flex items-center min-h-[44px] text-[13px] font-medium text-secondary no-underline hover:text-accent-text hover:underline">Add to comparison</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Compliance note -->
  <section class="py-section-sm px-4 sm:px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-step-3 font-bold text-primary mb-6">Compliance considerations for hedge funds</h2>
      <div class="space-y-4 text-step-0 leading-[1.7] text-secondary max-w-measure">
        <p>
          Regulatory scrutiny of expert network usage by hedge funds has intensified since the insider trading cases of 2010–2014. Today's institutional buyers expect providers to maintain robust compliance infrastructure including:
        </p>
        <ul class="space-y-2 ml-4">
          <li>Personal trading restrictions and blackout periods for experts</li>
          <li>Information barrier policies and MNPI screening</li>
          <li>Call monitoring and recording capabilities</li>
          <li>Expert vetting and conflict-of-interest checks</li>
          <li>Audit trails and compliance reporting</li>
        </ul>
        <p>
          All major providers (GLG, AlphaSights, Third Bridge, Guidepoint) now offer strong compliance tooling, but the depth and rigor varies. See our <a href="/compare/" class="text-accent-text hover:underline">comparison tool</a> to evaluate compliance posture across providers.
        </p>
      </div>
    </div>
  </section>

  <!-- Related -->
  <section class="py-section-sm px-4 sm:px-6 bg-bg-secondary">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-step-2 font-bold text-primary mb-6">Related guides</h2>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="/expert-networks-for-private-equity/" class="btn btn-primary">Expert Networks for PE</a>
        <a href="/expert-networks-for-consulting/" class="btn btn-secondary">Expert Networks for Consulting</a>
        <a href="/compare/" class="btn btn-secondary">Compare Providers</a>
      </div>
    </div>
  </section>
</BaseLayout>

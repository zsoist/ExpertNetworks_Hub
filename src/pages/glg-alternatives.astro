---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allNetworks = await getCollection('networks');
const published = allNetworks
  .filter(n => n.data.published)
  .sort((a, b) => a.data.priority - b.data.priority);

const alternatives = published.filter(n => n.data.slug !== 'glg').slice(0, 10);
---

<BaseLayout
  title="GLG Alternatives (2026): 10 Expert Networks to Consider | ExpertNetworks.net"
  description="Looking for alternatives to GLG? Compare 10 expert network providers including AlphaSights, Third Bridge, Guidepoint, and Dialectica — with pricing, compliance, AI capabilities, and expert coverage."
  canonicalPath="/glg-alternatives"
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "GLG Alternatives: 10 Expert Networks to Consider (2026)",
    "description": "Comprehensive guide to expert network alternatives to GLG, including pricing, capabilities, and best-fit use cases.",
    "publisher": { "@type": "Organization", "name": "ExpertNetworks.net", "url": "https://expertnetworks.net" },
    "datePublished": "2026-03-09",
    "dateModified": "2026-03-09"
  }}
>
  <!-- Hero -->
  <section class="pt-32 pb-16 px-6 bg-gradient-to-b from-bg-secondary to-bg-primary">
    <div class="max-w-4xl mx-auto">
      <div class="flex items-center gap-3 mb-6">
        <a href="/networks/glg" class="text-accent text-sm font-medium no-underline hover:underline">&larr; GLG Profile</a>
        <span class="text-tertiary text-sm">|</span>
        <a href="/networks" class="text-accent text-sm font-medium no-underline hover:underline">All Networks</a>
      </div>
      <span class="inline-block px-3 py-1 bg-accent/10 text-accent text-xs font-semibold rounded-full mb-4 tracking-wide uppercase">Alternatives Guide</span>
      <h1 class="text-4xl md:text-5xl font-extrabold text-primary mb-6 leading-tight">GLG Alternatives</h1>
      <p class="text-lg text-secondary max-w-3xl leading-relaxed">
        GLG is the largest expert network, but it's not the only option. Here are {alternatives.length} alternatives worth evaluating — whether you need faster sourcing, lower costs, better content libraries, or specialized regional coverage.
      </p>
    </div>
  </section>

  <!-- Why Consider Alternatives -->
  <section class="py-12 px-6">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-bold text-primary mb-6">Why consider GLG alternatives?</h2>
      <div class="space-y-4 text-[14px] leading-relaxed text-secondary">
        <p>
          GLG is the industry pioneer with the broadest platform — ~1.2 million experts, multi-format research, and institutional-grade compliance. But its premium pricing, annual commitment structure, and platform complexity aren't the right fit for every team. Common reasons buyers look at alternatives:
        </p>
        <ul class="space-y-2 ml-4">
          <li><strong>Cost</strong> — GLG is typically the most expensive option. Teams with smaller budgets often find better value elsewhere.</li>
          <li><strong>Speed</strong> — Some competitors (especially AlphaSights) specialize in faster expert sourcing and turnaround.</li>
          <li><strong>Content</strong> — Third Bridge and AlphaSense/Tegus offer pre-built transcript libraries that GLG's model doesn't prioritize.</li>
          <li><strong>Flexibility</strong> — Guidepoint and others offer per-call pricing without large annual commitments.</li>
          <li><strong>Specialization</strong> — Regional specialists like Capvision (Asia) or boutique firms may have deeper coverage in specific verticals.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Alternatives Grid -->
  <section class="py-12 px-6 bg-bg-secondary">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-bold text-primary mb-8">Top GLG alternatives</h2>
      <div class="space-y-4">
        {alternatives.map((network, i) => (
          <div class="bg-white rounded-card shadow-card p-5 flex flex-col sm:flex-row gap-4 items-start">
            <div class="flex items-center gap-3 flex-shrink-0">
              <span class="text-[11px] font-bold text-tertiary w-5">{i + 1}.</span>
              {network.data.logo ? (
                <img src={network.data.logo} alt="" width="40" height="40" class="w-10 h-10 rounded-xl object-contain" loading="lazy" />
              ) : (
                <div class="w-10 h-10 rounded-xl flex items-center justify-center text-white font-bold text-xs" style={`background: linear-gradient(135deg, ${network.data.gradientFrom}, ${network.data.gradientTo})`}>{network.data.shortName}</div>
              )}
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <a href={`/networks/${network.data.slug}`} class="text-[15px] font-bold text-primary no-underline hover:text-accent transition-colors">{network.data.name.split(' (')[0]}</a>
                {network.data.categoryBadge && (
                  <span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-accent/10 text-accent">{network.data.categoryBadge}</span>
                )}
              </div>
              <p class="text-[13px] text-secondary mt-1 line-clamp-2">{network.data.description?.slice(0, 200)}...</p>
              <div class="flex flex-wrap gap-x-4 gap-y-1 mt-2 text-[11px] text-tertiary">
                {network.data.expertCount && <span>Experts: {network.data.expertCount}</span>}
                {network.data.pricingModel && <span>Pricing: {network.data.pricingModel}</span>}
                {network.data.headquarters && <span>HQ: {network.data.headquarters}</span>}
              </div>
              <div class="flex gap-2 mt-3">
                <a href={`/networks/${network.data.slug}`} class="text-[12px] font-medium text-accent no-underline hover:underline">Full profile &rarr;</a>
                <a href={`/compare?networks=glg,${network.data.slug}`} class="text-[12px] font-medium text-secondary no-underline hover:text-accent hover:underline">Compare with GLG</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Related -->
  <section class="py-12 px-6">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-xl font-bold text-primary mb-6">Keep exploring</h2>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/compare" class="inline-flex items-center gap-2 px-6 py-3 bg-accent text-white rounded-full font-semibold text-sm no-underline hover:bg-accent-hover transition-colors">Full Comparison Tool</a>
        <a href="/best-expert-networks" class="inline-flex items-center gap-2 px-6 py-3 bg-white text-primary border border-border rounded-full font-semibold text-sm no-underline hover:bg-bg-secondary transition-colors">Best Networks Ranked</a>
        <a href="/expert-network-pricing" class="inline-flex items-center gap-2 px-6 py-3 bg-white text-primary border border-border rounded-full font-semibold text-sm no-underline hover:bg-bg-secondary transition-colors">Pricing Guide</a>
      </div>
    </div>
  </section>
</BaseLayout>

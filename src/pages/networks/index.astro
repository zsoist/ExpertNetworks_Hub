---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ParticleHero from '../../components/ParticleHero.astro';
import { getCollection } from 'astro:content';

const allNetworks = await getCollection('networks');
const networks = allNetworks
  .filter(n => n.data.published)
  .sort((a, b) => a.data.priority - b.data.priority);

// Normalize headquarters to country/region
function getRegion(hq: string): string {
  if (!hq) return '';
  if (hq.includes('UK') || hq.includes('London')) return 'United Kingdom';
  if (hq.includes('Germany') || hq.includes('Munich') || hq.includes('Berlin') || hq.includes('Frankfurt')) return 'Germany';
  if (hq.includes('France') || hq.includes('Paris')) return 'France';
  if (hq.includes('Singapore')) return 'Singapore';
  if (hq.includes('India') || hq.includes('Mumbai') || hq.includes('Bangalore') || hq.includes('Delhi')) return 'India';
  if (hq.includes('Japan') || hq.includes('Tokyo')) return 'Japan';
  if (hq.includes('Hong Kong')) return 'Hong Kong';
  if (hq.includes('China') || hq.includes('Shanghai') || hq.includes('Beijing') || hq.includes('Shenzhen')) return 'China';
  if (hq.includes('Switzerland') || hq.includes('Zurich')) return 'Switzerland';
  if (hq.includes('Sweden') || hq.includes('Stockholm')) return 'Sweden';
  return 'United States';
}

// Derive filter options
const allTypes = [...new Set(networks.map(n => n.data.type))].sort();
const allPricing = [...new Set(networks.map(n => n.data.pricingModel).filter(Boolean))].sort();
const allHqs = [...new Set(networks.map(n => getRegion(n.data.headquarters || '')).filter(Boolean))].sort();
const allDeliveryModels = [...new Set(networks.map(n => n.data.deliveryModel).filter(Boolean))].sort();
const allRegionStrengths = [...new Set(networks.map(n => n.data.regionStrength).filter(Boolean))].sort();

// Stats
const aiCount = networks.filter(n => n.data.comparison?.aiMatching).length;
const complianceCount = networks.filter(n => n.data.comparison?.complianceTools).length;

// Badge color map
const badgeColors: Record<string, string> = {
  'Global Leader': 'bg-amber-500/10 text-amber-700 border-amber-500/20',
  'Major Provider': 'bg-blue-500/10 text-blue-700 border-blue-500/20',
  'Fast-Growing': 'bg-emerald-500/10 text-emerald-700 border-emerald-500/20',
  'Asia Specialist': 'bg-rose-500/10 text-rose-700 border-rose-500/20',
  'Research Platform': 'bg-violet-500/10 text-violet-700 border-violet-500/20',
  'Technology-First': 'bg-cyan-500/10 text-cyan-700 border-cyan-500/20',
  'Marketplace': 'bg-orange-500/10 text-orange-700 border-orange-500/20',
  'Boutique Specialist': 'bg-slate-500/10 text-slate-600 border-slate-500/20',
};

const directoryEntries = networks.map((network, index) => {
  const data = network.data;
  const services = data.services || [];
  return {
    slug: data.slug,
    name: data.name,
    displayName: data.name.split(' (')[0],
    shortName: data.shortName,
    logo: data.logo || '',
    type: data.type,
    pricingModel: data.pricingModel || '',
    region: getRegion(data.headquarters || ''),
    regionStrength: data.regionStrength || '',
    deliveryModel: data.deliveryModel || '',
    founded: data.founded || 0,
    rank: index,
    badge: data.categoryBadge || '',
    description: data.description,
    complianceBadge: data.complianceBadge || '',
    aiBadge: data.aiBadge || '',
    expertCount: data.expertCount || '',
    services,
    bestFor: data.bestFor || [],
    comparison: {
      aiMatching: Boolean(data.comparison?.aiMatching),
      complianceTools: Boolean(data.comparison?.complianceTools),
      surveys: Boolean(data.comparison?.surveys),
      contentLibrary: Boolean(data.comparison?.contentLibrary),
    },
    gradientFrom: data.gradientFrom,
    gradientTo: data.gradientTo,
  };
});
---

<BaseLayout
  title={`Expert Network Companies: ${networks.length} Providers Compared (2026) | ExpertNetworks.net`}
  description={`Browse and compare ${networks.length} expert network companies including GLG, AlphaSights, Third Bridge, and Guidepoint. Independent profiles with pricing models, compliance ratings, expert coverage, and AI capabilities.`}
  canonicalPath="/networks"
  jsonLd={{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://expertnetworks.net/" },
          { "@type": "ListItem", "position": 2, "name": "Expert Networks" }
        ]
      },
      {
        "@type": "CollectionPage",
        "name": "Expert Network Companies Directory",
        "description": `Independent directory of ${networks.length} expert network providers with pricing, compliance, and capability data.`,
        "url": "https://expertnetworks.net/networks",
        "mainEntity": {
          "@type": "ItemList",
          "numberOfItems": networks.length,
          "itemListElement": networks.slice(0, 10).map((n, i) => ({
            "@type": "ListItem",
            "position": i + 1,
            "name": n.data.name,
            "url": `https://expertnetworks.net/networks/${n.data.slug}`
    }))
        }
      }
    ]
  }}
>
  <!-- Hero -->
  <ParticleHero>
    <div class="flex flex-col gap-3">
      <div>
        <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight text-white">Expert Networks Directory</h1>
        <p class="text-[#a1a1a6] text-sm mt-1.5 max-w-2xl">{networks.length} providers with independent profiles, pricing, compliance, and capability data.</p>
        <p class="text-[#86868b] text-xs mt-1 max-w-2xl">Compare networks by use case, pricing model, geography, compliance, and AI capabilities.</p>
      </div>
      <!-- Action row -->
      <div class="flex flex-wrap gap-2 mt-1" style="pointer-events: auto;">
        <div class="relative">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-[#86868b] pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input id="heroSearch" type="text" placeholder="Search networks..." class="text-[13px] text-white bg-white/[0.08] border border-white/[0.12] rounded-lg pl-8 pr-3 py-2 w-52 focus:outline-none focus:ring-2 focus:ring-accent/40 focus:border-accent/40 placeholder:text-[#86868b]" />
        </div>
        <a id="heroCompareBtn" href="/compare" class="inline-flex items-center gap-1.5 px-4 py-2 bg-accent text-white text-sm font-semibold rounded-lg no-underline hover:bg-accent/90 transition-colors">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/></svg>
          <span id="heroCompareBtnText">Compare</span>
        </a>
        <button id="resetAll" class="hidden items-center gap-1 px-3 py-2 bg-white/[0.06] text-[#a1a1a6] text-sm font-medium rounded-lg hover:bg-white/[0.1] transition-colors border border-white/[0.08]">
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
          Reset
        </button>
        <a href="/" class="inline-flex items-center gap-1.5 px-3 py-2 bg-white/[0.06] text-[#a1a1a6] text-sm font-medium rounded-lg no-underline hover:bg-white/[0.1] transition-colors border border-white/[0.08]">&larr; Home</a>
      </div>
    </div>
  </ParticleHero>

  <!-- Quick Presets -->
  <section class="py-3 px-4 md:px-6 border-b border-border/30 bg-white">
    <div class="max-w-site mx-auto">
      <div class="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none">
        <span class="text-[10px] font-bold uppercase tracking-widest text-tertiary whitespace-nowrap mr-1">Quick filters</span>
        <button class="preset-btn px-3.5 py-2 text-[12px] font-medium rounded-full border border-border/60 text-secondary hover:border-accent hover:text-accent hover:bg-accent/[0.04] active:scale-95 active:opacity-70 transition-all whitespace-nowrap cursor-pointer bg-transparent min-h-[36px]" data-preset="consulting">Best for Consulting</button>
        <button class="preset-btn px-3.5 py-2 text-[12px] font-medium rounded-full border border-border/60 text-secondary hover:border-accent hover:text-accent hover:bg-accent/[0.04] active:scale-95 active:opacity-70 transition-all whitespace-nowrap cursor-pointer bg-transparent min-h-[36px]" data-preset="pe">Best for Private Equity</button>
        <button class="preset-btn px-3.5 py-2 text-[12px] font-medium rounded-full border border-border/60 text-secondary hover:border-accent hover:text-accent hover:bg-accent/[0.04] active:scale-95 active:opacity-70 transition-all whitespace-nowrap cursor-pointer bg-transparent min-h-[36px]" data-preset="enterprise">Best for Enterprise</button>
        <button class="preset-btn px-3.5 py-2 text-[12px] font-medium rounded-full border border-border/60 text-secondary hover:border-accent hover:text-accent hover:bg-accent/[0.04] active:scale-95 active:opacity-70 transition-all whitespace-nowrap cursor-pointer bg-transparent min-h-[36px]" data-preset="asia">Asia Specialists</button>
        <button class="preset-btn px-3.5 py-2 text-[12px] font-medium rounded-full border border-border/60 text-secondary hover:border-accent hover:text-accent hover:bg-accent/[0.04] active:scale-95 active:opacity-70 transition-all whitespace-nowrap cursor-pointer bg-transparent min-h-[36px]" data-preset="ai">AI-Forward Platforms</button>
        <button class="preset-btn px-3.5 py-2 text-[12px] font-medium rounded-full border border-border/60 text-secondary hover:border-accent hover:text-accent hover:bg-accent/[0.04] active:scale-95 active:opacity-70 transition-all whitespace-nowrap cursor-pointer bg-transparent min-h-[36px]" data-preset="library">Transcript / Library</button>
        <button class="preset-btn px-3.5 py-2 text-[12px] font-medium rounded-full border border-border/60 text-secondary hover:border-accent hover:text-accent hover:bg-accent/[0.04] active:scale-95 active:opacity-70 transition-all whitespace-nowrap cursor-pointer bg-transparent min-h-[36px]" data-preset="boutique">Boutique Specialists</button>
      </div>
    </div>
  </section>

  <!-- Metrics Strip -->
  <section class="py-3.5 px-4 md:px-6 border-b border-border/20 bg-[#fafafa]">
    <div class="max-w-site mx-auto flex items-center justify-between gap-4 overflow-x-auto">
      <div class="flex items-center gap-2 whitespace-nowrap">
        <span class="text-lg font-extrabold text-primary">{networks.length}</span>
        <span class="text-[11px] text-tertiary uppercase tracking-wide font-medium">Networks Tracked</span>
      </div>
      <div class="w-px h-5 bg-border/40"></div>
      <div class="flex items-center gap-2 whitespace-nowrap">
        <span class="text-lg font-extrabold text-primary">{allHqs.length}+</span>
        <span class="text-[11px] text-tertiary uppercase tracking-wide font-medium">Countries</span>
      </div>
      <div class="w-px h-5 bg-border/40"></div>
      <div class="flex items-center gap-2 whitespace-nowrap">
        <span class="text-lg font-extrabold text-primary">{aiCount}</span>
        <span class="text-[11px] text-tertiary uppercase tracking-wide font-medium">AI Matching</span>
      </div>
      <div class="w-px h-5 bg-border/40"></div>
      <div class="flex items-center gap-2 whitespace-nowrap">
        <span class="text-lg font-extrabold text-primary">{complianceCount}</span>
        <span class="text-[11px] text-tertiary uppercase tracking-wide font-medium">Compliance Tools</span>
      </div>
    </div>
  </section>

  <!-- Filters + Cards -->
  <section class="py-5 px-4 md:px-6">
    <div class="max-w-site mx-auto flex flex-col lg:flex-row gap-5">

      <!-- Filter Sidebar -->
      <aside class="w-full lg:w-56 flex-shrink-0">
        <!-- Mobile filter toggle -->
        <button id="mobileFilterToggle" class="lg:hidden flex items-center justify-between w-full px-4 py-3 bg-white rounded-xl border border-border/60 text-sm font-medium text-primary mb-3 cursor-pointer active:bg-[#f5f5f7] transition-colors min-h-[48px]" aria-expanded="false" aria-controls="filterPanel">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-tertiary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"/></svg>
            Filters
          </span>
          <svg class="w-4 h-4 text-tertiary filter-chevron transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div id="filterPanel" class="hidden lg:block space-y-5">
          <!-- Group A: Fit -->
          <div>
            <h3 class="text-[10px] font-bold uppercase tracking-widest text-tertiary mb-2">Fit</h3>
            <div class="space-y-2">
              <select id="filterRegionStrength" class="filter-select w-full text-[13px] font-medium text-primary bg-white border border-border/60 rounded-lg px-3 py-2 cursor-pointer focus:outline-none focus:ring-2 focus:ring-accent/30">
                <option value="">All Regions</option>
                {allRegionStrengths.map(r => <option value={r}>{r}</option>)}
              </select>
              <select id="filterType" class="filter-select w-full text-[13px] font-medium text-primary bg-white border border-border/60 rounded-lg px-3 py-2 cursor-pointer focus:outline-none focus:ring-2 focus:ring-accent/30">
                <option value="">All Types</option>
                {allTypes.map(t => <option value={t}>{t}</option>)}
              </select>
            </div>
          </div>
          <!-- Group B: Commercial Model -->
          <div>
            <h3 class="text-[10px] font-bold uppercase tracking-widest text-tertiary mb-2">Commercial Model</h3>
            <div class="space-y-2">
              <select id="filterPricing" class="filter-select w-full text-[13px] font-medium text-primary bg-white border border-border/60 rounded-lg px-3 py-2 cursor-pointer focus:outline-none focus:ring-2 focus:ring-accent/30">
                <option value="">All Pricing</option>
                {allPricing.map(p => <option value={p}>{p}</option>)}
              </select>
              <select id="filterDelivery" class="filter-select w-full text-[13px] font-medium text-primary bg-white border border-border/60 rounded-lg px-3 py-2 cursor-pointer focus:outline-none focus:ring-2 focus:ring-accent/30">
                <option value="">All Delivery Models</option>
                {allDeliveryModels.map(d => <option value={d}>{d}</option>)}
              </select>
              <select id="filterHq" class="filter-select w-full text-[13px] font-medium text-primary bg-white border border-border/60 rounded-lg px-3 py-2 cursor-pointer focus:outline-none focus:ring-2 focus:ring-accent/30">
                <option value="">All HQ Locations</option>
                {allHqs.map(h => <option value={h}>{h}</option>)}
              </select>
            </div>
          </div>
          <!-- Group C: Capabilities -->
          <div>
            <h3 class="text-[10px] font-bold uppercase tracking-widest text-tertiary mb-2">Capabilities</h3>
            <div class="space-y-2">
              <label class="flex items-center gap-2.5 text-[13px] text-secondary cursor-pointer hover:text-primary active:text-primary transition-colors min-h-[36px]">
                <input type="checkbox" id="capAI" class="cap-filter w-[18px] h-[18px] rounded border-border/60 text-accent focus:ring-accent/30" /> AI Matching
              </label>
              <label class="flex items-center gap-2.5 text-[13px] text-secondary cursor-pointer hover:text-primary active:text-primary transition-colors min-h-[36px]">
                <input type="checkbox" id="capCompliance" class="cap-filter w-[18px] h-[18px] rounded border-border/60 text-accent focus:ring-accent/30" /> Compliance Tools
              </label>
              <label class="flex items-center gap-2.5 text-[13px] text-secondary cursor-pointer hover:text-primary active:text-primary transition-colors min-h-[36px]">
                <input type="checkbox" id="capSurveys" class="cap-filter w-[18px] h-[18px] rounded border-border/60 text-accent focus:ring-accent/30" /> Surveys
              </label>
              <label class="flex items-center gap-2.5 text-[13px] text-secondary cursor-pointer hover:text-primary active:text-primary transition-colors min-h-[36px]">
                <input type="checkbox" id="capLibrary" class="cap-filter w-[18px] h-[18px] rounded border-border/60 text-accent focus:ring-accent/30" /> Content Library
              </label>
            </div>
          </div>
          <!-- Group D: Sort -->
          <div>
            <h3 class="text-[10px] font-bold uppercase tracking-widest text-tertiary mb-2">Sort</h3>
            <select id="sortBy" class="filter-select w-full text-[13px] font-medium text-primary bg-white border border-border/60 rounded-lg px-3 py-2 cursor-pointer focus:outline-none focus:ring-2 focus:ring-accent/30">
              <option value="rank">Default Order</option>
              <option value="name">A–Z</option>
              <option value="founded">Newest First</option>
              <option value="founded-oldest">Oldest First</option>
            </select>
          </div>
        </div>
      </aside>

      <!-- Cards area -->
      <div class="flex-1 min-w-0">
        <!-- View toggle + result count -->
        <div class="flex items-center justify-between mb-3">
          <span id="resultCount" class="text-[13px] text-tertiary font-medium">{networks.length} networks</span>
          <div class="flex items-center gap-1 bg-[#f5f5f7] rounded-lg p-0.5">
            <button id="viewGrid" class="view-toggle px-3 py-2 text-[12px] font-medium rounded-md bg-white shadow-sm text-primary cursor-pointer border-none active:scale-95 transition-all min-w-[36px] min-h-[36px]" aria-label="Grid view">
              <svg class="w-3.5 h-3.5 inline-block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
            </button>
            <button id="viewList" class="view-toggle px-3 py-2 text-[12px] font-medium rounded-md text-tertiary cursor-pointer border-none bg-transparent active:scale-95 transition-all min-w-[36px] min-h-[36px]" aria-label="List view">
              <svg class="w-3.5 h-3.5 inline-block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
            </button>
          </div>
        </div>

        <div id="noResults" class="hidden text-center py-16 text-sm text-tertiary">
          <svg class="w-10 h-10 mx-auto mb-3 text-tertiary/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          No networks match your filters.
        </div>

        <!-- Grid view (default) -->
        <div id="networkGrid" class="grid grid-cols-1 md:grid-cols-2 gap-3">
          {networks.map((network, i) => {
            const n = network.data;
            const region = getRegion(n.headquarters || '');
            const badge = n.categoryBadge || '';
            const badgeClass = badgeColors[badge] || 'bg-slate-500/10 text-slate-600 border-slate-500/20';
            const servicesArr = n.services || [];
            const maxChips = 3;
            return (
              <div
                class="network-card bg-white rounded-xl border border-border/40 hover:border-border/80 hover:shadow-card-hover hover:-translate-y-[1px] transition-all overflow-hidden"
                data-name={n.name.toLowerCase()}
                data-slug={n.slug}
                data-type={n.type}
                data-pricing={n.pricingModel || ''}
                data-region={region}
                data-region-strength={n.regionStrength || ''}
                data-delivery={n.deliveryModel || ''}
                data-founded={n.founded || 0}
                data-rank={i}
                data-badge={badge}
                data-ai={n.comparison?.aiMatching ? '1' : '0'}
                data-compliance={n.comparison?.complianceTools ? '1' : '0'}
                data-surveys={n.comparison?.surveys ? '1' : '0'}
                data-library={n.comparison?.contentLibrary ? '1' : '0'}
                data-best-for={(n.bestFor || []).join(',').toLowerCase()}
                data-services={servicesArr.join(',').toLowerCase()}
              >
                <!-- Row 1: Identity -->
                <div class="px-4 pt-4 pb-2">
                  <div class="flex items-start gap-3">
                    <div class="text-[11px] text-tertiary/60 font-bold w-4 text-right flex-shrink-0 mt-1.5">{i + 1}</div>
                    {n.logo ? (
                      <img src={n.logo} alt={n.name} width="36" height="36" class="w-9 h-9 rounded-lg object-contain flex-shrink-0" loading="lazy" />
                    ) : (
                      <div
                        class="w-9 h-9 rounded-lg flex items-center justify-center text-white font-bold text-xs flex-shrink-0"
                        style={`background: linear-gradient(135deg, ${n.gradientFrom}, ${n.gradientTo})`}
                      >
                        {n.shortName}
                      </div>
                    )}
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-2 flex-wrap">
                        <a href={`/networks/${n.slug}`} class="text-[14px] font-semibold text-primary hover:text-accent transition-colors no-underline truncate">{n.name.split(' (')[0]}</a>
                        {badge && <span class={`px-1.5 py-0.5 text-[9px] font-semibold uppercase tracking-wider rounded border ${badgeClass}`}>{badge}</span>}
                      </div>
                    </div>
                    <label class="compare-label flex items-center gap-1.5 flex-shrink-0 cursor-pointer min-w-[44px] min-h-[44px] justify-center" title="Add to comparison">
                      <input type="checkbox" class="compare-check w-[18px] h-[18px] rounded border-border/60 text-accent focus:ring-accent/30 cursor-pointer" data-slug={n.slug} data-name={n.name} />
                      <span class="text-[10px] text-tertiary font-medium hidden sm:inline">Compare</span>
                    </label>
                  </div>
                </div>

                <!-- Row 2: Brief text -->
                <div class="px-4 pb-2.5">
                  <p class="text-[12.5px] text-secondary leading-relaxed line-clamp-2 m-0">{n.description}</p>
                </div>

                <!-- Row 3: Decision strip -->
                <div class="px-4 pb-2.5">
                  <div class="flex flex-wrap gap-x-4 gap-y-1 text-[11px]">
                    {n.pricingModel && (
                      <div>
                        <span class="text-tertiary">Pricing </span>
                        <span class="font-semibold text-primary">{n.pricingModel}</span>
                      </div>
                    )}
                    {n.expertCount && (
                      <div>
                        <span class="text-tertiary">Scale </span>
                        <span class="font-semibold text-primary">{n.expertCount}</span>
                      </div>
                    )}
                    {n.founded && (
                      <div>
                        <span class="text-tertiary">Est. </span>
                        <span class="font-semibold text-primary">{n.founded}</span>
                      </div>
                    )}
                    {n.deliveryModel && (
                      <div>
                        <span class="text-tertiary">Model </span>
                        <span class="font-semibold text-primary">{n.deliveryModel}</span>
                      </div>
                    )}
                  </div>
                </div>

                <!-- Row 4: Service chips -->
                <div class="px-4 pb-2.5">
                  <div class="flex flex-wrap gap-1">
                    {servicesArr.slice(0, maxChips).map((s: string) => (
                      <span class="px-2 py-0.5 text-[10px] font-medium rounded-full bg-[#f5f5f7] text-secondary">{s.length > 25 ? s.slice(0, 22) + '...' : s}</span>
                    ))}
                    {servicesArr.length > maxChips && <span class="px-2 py-0.5 text-[10px] font-medium rounded-full bg-[#f5f5f7] text-tertiary">+{servicesArr.length - maxChips}</span>}
                  </div>
                </div>

                <!-- Row 5: Bottom bar -->
                <div class="flex items-center justify-between px-4 py-2 border-t border-border/20 bg-[#fafafa]">
                  <div class="flex items-center gap-2">
                    {n.complianceBadge && (
                      <span class={`inline-flex items-center gap-1 text-[10px] font-medium ${n.complianceBadge === 'Strong Compliance' ? 'text-emerald-600' : n.complianceBadge === 'Compliance Tools' ? 'text-blue-600' : 'text-tertiary'}`}>
                        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        {n.complianceBadge === 'Strong Compliance' ? 'Strong' : n.complianceBadge === 'Compliance Tools' ? 'Tools' : n.complianceBadge === 'Standard Compliance' ? 'Standard' : 'Limited'}
                      </span>
                    )}
                    {n.aiBadge && (
                      <span class={`inline-flex items-center gap-1 text-[10px] font-medium ${n.aiBadge === 'AI-Native' ? 'text-violet-600' : n.aiBadge === 'AI Research' ? 'text-blue-600' : 'text-tertiary'}`}>
                        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2a4 4 0 0 1 4 4v2a4 4 0 0 1-8 0V6a4 4 0 0 1 4-4z"/><path d="M16 14a4 4 0 0 1 4 4v2H4v-2a4 4 0 0 1 4-4h8z"/></svg>
                        {n.aiBadge}
                      </span>
                    )}
                    {n.regionStrength && (
                      <span class="text-[10px] text-tertiary font-medium">{n.regionStrength}</span>
                    )}
                  </div>
                  <a href={`/networks/${n.slug}`} class="inline-flex items-center gap-1 text-[11px] font-semibold text-accent hover:text-accent/80 active:text-accent/60 active:scale-95 no-underline transition-all py-1.5 px-2 -mr-2 rounded-lg">
                    View Profile
                    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                  </a>
                </div>
              </div>
            );
          })}
        </div>

        <!-- List view (rendered client-side on demand) -->
        <div id="networkList" class="hidden space-y-1.5"></div>
      </div>
    </div>
  </section>

  <!-- EDITORIAL CONTENT -->
  <section class="py-10 px-4 md:px-6 border-t border-border/20 bg-white">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-xl font-bold text-primary mb-4">About expert network companies</h2>
      <div class="space-y-4 text-[14px] leading-relaxed text-secondary">
        <p>
          Expert networks connect investors, consultants, and corporate teams with subject-matter experts for paid consultations. The industry has grown from a handful of providers in the early 2000s to more than {networks.length} tracked companies in 2026, spanning global leaders, regional specialists, technology-first platforms, and boutique research firms.
        </p>
        <p>
          The market is led by four major providers: <a href="/networks/glg" class="text-accent hover:underline">GLG</a> (the largest by expert count and revenue), <a href="/networks/alphasights" class="text-accent hover:underline">AlphaSights</a> (known for fast turnaround and project management), <a href="/networks/third-bridge" class="text-accent hover:underline">Third Bridge</a> (differentiated by its Forum and Interviews content library), and <a href="/networks/guidepoint" class="text-accent hover:underline">Guidepoint</a> (offering flexible, high-volume expert access). Together they serve the majority of institutional investors and management consulting firms globally.
        </p>
        <p>
          Key trends shaping the industry in 2026 include AI-powered expert matching and transcript search, increased regulatory scrutiny around compliance and information barriers, consolidation through M&A (including the AlphaSense–Tegus merger), and the rise of self-service marketplace models that challenge traditional managed-service approaches. Use the filters above to explore providers by pricing model, geography, compliance posture, and AI capabilities, or <a href="/compare" class="text-accent hover:underline">compare providers side-by-side</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- Sticky Compare Tray -->
  <div id="compareTray" class="fixed bottom-0 left-0 right-0 z-50 translate-y-full transition-transform duration-200 ease-out" style="padding-bottom: env(safe-area-inset-bottom);">
    <div class="max-w-site mx-auto px-4 md:px-6 pb-3">
      <div class="bg-primary text-white rounded-xl shadow-2xl px-5 py-3.5 flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <span class="text-sm font-semibold"><span id="compareCount">0/6</span> selected</span>
          <div id="compareNames" class="hidden sm:flex items-center gap-1 text-[12px] text-[#a1a1a6] truncate max-w-xs"></div>
        </div>
        <div class="flex items-center gap-2">
          <button id="clearCompare" class="px-3 py-2 text-[12px] font-medium text-[#a1a1a6] hover:text-white active:text-white transition-colors bg-transparent border-none cursor-pointer min-h-[40px]">Clear</button>
          <a id="compareLink" href="/compare" class="px-4 py-2 bg-accent text-white text-[13px] font-semibold rounded-lg no-underline hover:bg-accent/90 active:bg-accent/80 active:scale-95 transition-all min-h-[40px] flex items-center">Compare Now</a>
        </div>
      </div>
    </div>
  </div>

  <script is:inline type="application/json" id="directoryData" set:html={JSON.stringify(directoryEntries)}></script>
</BaseLayout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .scrollbar-none::-webkit-scrollbar { display: none; }
  .scrollbar-none { -ms-overflow-style: none; scrollbar-width: none; }
  .preset-btn.active {
    border-color: #0071E3;
    color: #0071E3;
    background: rgba(0, 113, 227, 0.04);
  }
</style>

<script>
  // @ts-nocheck
  const directoryDataEl = document.getElementById('directoryData');
  const directoryEntries = directoryDataEl ? JSON.parse(directoryDataEl.textContent || '[]') : [];
  const directoryBySlug = new Map(directoryEntries.map(entry => [entry.slug, entry]));

  const heroSearch = document.getElementById('heroSearch') as HTMLInputElement | null;
  const filterType = document.getElementById('filterType') as HTMLSelectElement | null;
  const filterPricing = document.getElementById('filterPricing') as HTMLSelectElement | null;
  const filterHq = document.getElementById('filterHq') as HTMLSelectElement | null;
  const filterDelivery = document.getElementById('filterDelivery') as HTMLSelectElement | null;
  const filterRegionStrength = document.getElementById('filterRegionStrength') as HTMLSelectElement | null;
  const sortBy = document.getElementById('sortBy') as HTMLSelectElement | null;
  const capAI = document.getElementById('capAI') as HTMLInputElement | null;
  const capCompliance = document.getElementById('capCompliance') as HTMLInputElement | null;
  const capSurveys = document.getElementById('capSurveys') as HTMLInputElement | null;
  const capLibrary = document.getElementById('capLibrary') as HTMLInputElement | null;
  const resetAll = document.getElementById('resetAll') as HTMLElement | null;
  const resultCount = document.getElementById('resultCount') as HTMLElement | null;
  const noResults = document.getElementById('noResults') as HTMLElement | null;
  const networkGrid = document.getElementById('networkGrid') as HTMLElement | null;
  const networkList = document.getElementById('networkList') as HTMLElement | null;
  const viewGrid = document.getElementById('viewGrid') as HTMLElement | null;
  const viewList = document.getElementById('viewList') as HTMLElement | null;
  const compareTray = document.getElementById('compareTray') as HTMLElement | null;
  const compareCount = document.getElementById('compareCount') as HTMLElement | null;
  const compareNames = document.getElementById('compareNames') as HTMLElement | null;
  const compareLink = document.getElementById('compareLink') as HTMLAnchorElement | null;
  const clearCompare = document.getElementById('clearCompare') as HTMLElement | null;
  const mobileFilterToggle = document.getElementById('mobileFilterToggle') as HTMLElement | null;
  const filterPanel = document.getElementById('filterPanel') as HTMLElement | null;
  const heroCompareBtn = document.getElementById('heroCompareBtn') as HTMLAnchorElement | null;

  const cards = Array.from(document.querySelectorAll('.network-card')) as HTMLElement[];
  const badgeClassMap: Record<string, string> = {
    'Global Leader': 'bg-amber-500/10 text-amber-700 border-amber-500/20',
    'Major Provider': 'bg-blue-500/10 text-blue-700 border-blue-500/20',
    'Fast-Growing': 'bg-emerald-500/10 text-emerald-700 border-emerald-500/20',
    'Asia Specialist': 'bg-rose-500/10 text-rose-700 border-rose-500/20',
    'Research Platform': 'bg-violet-500/10 text-violet-700 border-violet-500/20',
    'Technology-First': 'bg-cyan-500/10 text-cyan-700 border-cyan-500/20',
    'Marketplace': 'bg-orange-500/10 text-orange-700 border-orange-500/20',
    'Boutique Specialist': 'bg-slate-500/10 text-slate-600 border-slate-500/20',
  };
  const selected = new Map<string, string>();
  const presets: Record<string, (el: HTMLElement) => boolean> = {
    consulting: el => el.dataset.bestFor?.includes('consult') || false,
    pe: el => el.dataset.bestFor?.includes('private equity') || el.dataset.bestFor?.includes('pe') || false,
    enterprise: el => el.dataset.bestFor?.includes('enterprise') || el.dataset.bestFor?.includes('corporate') || false,
    asia: el => el.dataset.regionStrength === 'Asia-Pacific' || el.dataset.regionStrength === 'Greater China' || el.dataset.badge === 'Asia Specialist',
    ai: el => el.dataset.badge === 'Technology-First' || el.dataset.badge === 'Research Platform' || el.getAttribute('data-ai') === '1',
    library: el => el.getAttribute('data-library') === '1' || el.dataset.services?.includes('library') || el.dataset.services?.includes('transcript') || false,
    boutique: el => el.dataset.badge === 'Boutique Specialist',
  };

  let activePreset = '';
  let currentView = 'grid';

  function getVisibleCards(): HTMLElement[] {
    return cards.filter(card => card.style.display !== 'none');
  }

  function renderListView() {
    if (!networkList) return;
    const rowsHtml = getVisibleCards().map(card => {
      const slug = card.dataset.slug || '';
      const entry = directoryBySlug.get(slug);
      if (!entry) return '';
      const badgeClass = badgeClassMap[entry.badge] || 'bg-slate-500/10 text-slate-600 border-slate-500/20';
      const shortDescription = entry.description.length > 90 ? `${entry.description.slice(0, 90)}...` : entry.description;
      const compareChecked = selected.has(slug) ? 'checked' : '';
      const logoHtml = entry.logo
        ? `<img src="${entry.logo}" alt="${entry.name}" width="32" height="32" class="w-8 h-8 rounded-lg object-contain flex-shrink-0" loading="lazy" />`
        : `<div class="w-8 h-8 rounded-lg flex items-center justify-center text-white font-bold text-[10px] flex-shrink-0" style="background: linear-gradient(135deg, ${entry.gradientFrom}, ${entry.gradientTo})">${entry.shortName}</div>`;
      const badgeHtml = entry.badge
        ? `<span class="inline-block mt-0.5 px-1.5 py-0.5 text-[8px] font-semibold uppercase tracking-wider rounded border ${badgeClass}">${entry.badge}</span>`
        : '';
      const pricingHtml = entry.pricingModel
        ? `<span class="text-[11px] text-primary font-medium w-16 text-center">${entry.pricingModel}</span>`
        : '';
      const deliveryHtml = entry.deliveryModel
        ? `<span class="text-[11px] text-tertiary w-20 text-center">${entry.deliveryModel}</span>`
        : '';

      return `
        <div class="network-row flex items-center gap-3 px-4 py-3 bg-white rounded-xl border border-border/30 hover:border-border/60 hover:shadow-sm hover:-translate-y-[0.5px] transition-all">
          <div class="text-[11px] text-tertiary/50 font-bold w-4 text-right flex-shrink-0">${entry.rank + 1}</div>
          ${logoHtml}
          <div class="min-w-0 w-40 flex-shrink-0">
            <a href="/networks/${entry.slug}" class="text-[13px] font-semibold text-primary hover:text-accent transition-colors no-underline truncate block">${entry.displayName}</a>
            ${badgeHtml}
          </div>
          <div class="hidden md:block min-w-0 flex-1">
            <p class="text-[12px] text-secondary truncate m-0">${shortDescription}</p>
          </div>
          <div class="hidden lg:flex items-center gap-4 flex-shrink-0">
            ${pricingHtml}
            ${deliveryHtml}
          </div>
          <div class="flex items-center gap-2 flex-shrink-0">
            <input type="checkbox" class="compare-check rounded border-border/60 text-accent focus:ring-accent/30 cursor-pointer" data-slug="${entry.slug}" data-name="${entry.name}" title="Compare" ${compareChecked} />
            <a href="/networks/${entry.slug}" class="text-tertiary hover:text-accent transition-colors no-underline">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
            </a>
          </div>
        </div>`;
    }).join('');

    networkList.innerHTML = rowsHtml;
  }

  function setView(view: 'grid' | 'list') {
    currentView = view;
    if (view === 'grid') {
      networkGrid?.classList.remove('hidden');
      networkList?.classList.add('hidden');
      viewGrid?.classList.add('bg-white', 'shadow-sm', 'text-primary');
      viewGrid?.classList.remove('text-tertiary', 'bg-transparent');
      viewList?.classList.remove('bg-white', 'shadow-sm', 'text-primary');
      viewList?.classList.add('text-tertiary', 'bg-transparent');
      return;
    }

    renderListView();
    networkGrid?.classList.add('hidden');
    networkList?.classList.remove('hidden');
    viewList?.classList.add('bg-white', 'shadow-sm', 'text-primary');
    viewList?.classList.remove('text-tertiary', 'bg-transparent');
    viewGrid?.classList.remove('bg-white', 'shadow-sm', 'text-primary');
    viewGrid?.classList.add('text-tertiary', 'bg-transparent');
  }

  function hasActiveFilter(): boolean {
    return Boolean(
      heroSearch?.value ||
      filterType?.value ||
      filterPricing?.value ||
      filterHq?.value ||
      filterDelivery?.value ||
      filterRegionStrength?.value ||
      capAI?.checked ||
      capCompliance?.checked ||
      capSurveys?.checked ||
      capLibrary?.checked ||
      activePreset
    );
  }

  function applyFilters() {
    const search = heroSearch?.value.toLowerCase().trim() || '';
    const type = filterType?.value || '';
    const pricing = filterPricing?.value || '';
    const hq = filterHq?.value || '';
    const delivery = filterDelivery?.value || '';
    const regionStr = filterRegionStrength?.value || '';
    const sort = sortBy?.value || 'rank';
    const wantAI = capAI?.checked || false;
    const wantCompliance = capCompliance?.checked || false;
    const wantSurveys = capSurveys?.checked || false;
    const wantLibrary = capLibrary?.checked || false;

    let visibleCount = 0;
    cards.forEach(card => {
      let match = true;
      if (search && !(card.dataset.name || '').includes(search)) match = false;
      if (type && card.dataset.type !== type) match = false;
      if (pricing && card.dataset.pricing !== pricing) match = false;
      if (hq && card.dataset.region !== hq) match = false;
      if (delivery && card.dataset.delivery !== delivery) match = false;
      if (regionStr && card.dataset.regionStrength !== regionStr) match = false;
      if (wantAI && card.getAttribute('data-ai') !== '1') match = false;
      if (wantCompliance && card.getAttribute('data-compliance') !== '1') match = false;
      if (wantSurveys && card.getAttribute('data-surveys') !== '1') match = false;
      if (wantLibrary && card.getAttribute('data-library') !== '1') match = false;
      if (activePreset && presets[activePreset] && !presets[activePreset](card)) match = false;

      card.style.display = match ? '' : 'none';
      if (match) visibleCount++;
    });

    const visibleCards = getVisibleCards().sort((a, b) => {
      if (sort === 'name') return (a.dataset.name || '').localeCompare(b.dataset.name || '');
      if (sort === 'founded') return parseInt(b.dataset.founded || '0', 10) - parseInt(a.dataset.founded || '0', 10);
      if (sort === 'founded-oldest') return parseInt(a.dataset.founded || '0', 10) - parseInt(b.dataset.founded || '0', 10);
      return parseInt(a.dataset.rank || '0', 10) - parseInt(b.dataset.rank || '0', 10);
    });

    visibleCards.forEach(card => networkGrid?.appendChild(card));
    cards.filter(card => card.style.display === 'none').forEach(card => networkGrid?.appendChild(card));

    if (resultCount) {
      resultCount.textContent = `${visibleCount} network${visibleCount !== 1 ? 's' : ''}`;
    }
    noResults?.classList.toggle('hidden', visibleCount > 0);
    resetAll?.classList.toggle('hidden', !hasActiveFilter());
    if (hasActiveFilter() && resetAll) {
      resetAll.style.display = 'inline-flex';
    }
    if (currentView === 'list') {
      renderListView();
    }
  }

  function clearFilters(clearPreset = true) {
    if (heroSearch) heroSearch.value = '';
    if (filterType) filterType.value = '';
    if (filterPricing) filterPricing.value = '';
    if (filterHq) filterHq.value = '';
    if (filterDelivery) filterDelivery.value = '';
    if (filterRegionStrength) filterRegionStrength.value = '';
    if (capAI) capAI.checked = false;
    if (capCompliance) capCompliance.checked = false;
    if (capSurveys) capSurveys.checked = false;
    if (capLibrary) capLibrary.checked = false;
    if (sortBy) sortBy.value = 'rank';
    if (clearPreset) {
      activePreset = '';
      document.querySelectorAll('.preset-btn').forEach(btn => btn.classList.remove('active'));
    }
  }

  const MAX_COMPARE = 6;
  const directoryToComparePreset: Record<string, string> = {
    consulting: 'consulting',
    pe: 'pe',
    enterprise: 'enterprise',
    asia: 'asia',
    library: 'library',
    ai: 'aiMatching',
  };

  function buildCompareUrl(): string {
    const slugs = Array.from(selected.keys());
    if (slugs.length === 1) {
      return `/compare?add=${encodeURIComponent(slugs[0])}`;
    }
    if (slugs.length >= 2) {
      const base = `/compare?networks=${slugs.slice(0, MAX_COMPARE).join(',')}`;
      const comparePreset = directoryToComparePreset[activePreset];
      return comparePreset ? `${base}&preset=${comparePreset}` : base;
    }
    if (activePreset && directoryToComparePreset[activePreset]) {
      return `/compare?preset=${directoryToComparePreset[activePreset]}`;
    }
    return '/compare';
  }

  const heroCompareBtnText = document.getElementById('heroCompareBtnText') as HTMLElement | null;

  function updateCompareTray() {
    const count = selected.size;
    if (compareCount) compareCount.textContent = `${count}/${MAX_COMPARE}`;
    if (compareNames) {
      compareNames.innerHTML = '';
      const names = Array.from(selected.values());
      names.slice(0, 3).forEach(name => {
        const chip = document.createElement('span');
        chip.className = 'px-1.5 py-0.5 bg-white/10 rounded text-[11px]';
        chip.textContent = name.split(' (')[0];
        compareNames.appendChild(chip);
      });
      if (names.length > 3) {
        const extra = document.createElement('span');
        extra.className = 'text-[11px]';
        extra.textContent = `+${names.length - 3}`;
        compareNames.appendChild(extra);
      }
    }

    const url = buildCompareUrl();
    if (compareLink) compareLink.href = url;
    if (heroCompareBtn) heroCompareBtn.href = url;
    if (heroCompareBtnText) {
      heroCompareBtnText.textContent = count > 0 ? `Compare (${count})` : 'Compare';
    }
    compareTray?.classList.toggle('translate-y-full', count === 0);
    compareTray?.classList.toggle('translate-y-0', count > 0);
  }

  function syncCompareCheckboxes(slug: string, checked: boolean) {
    document.querySelectorAll(`.compare-check[data-slug="${slug}"]`).forEach(input => {
      (input as HTMLInputElement).checked = checked;
    });
  }

  function handleCompareToggle(input: HTMLInputElement) {
    const slug = input.dataset.slug || '';
    const name = input.dataset.name || '';
    if (!slug) return;
    if (input.checked) {
      if (selected.size >= MAX_COMPARE) {
        input.checked = false;
        syncCompareCheckboxes(slug, false);
        /* Flash the tray to indicate the limit */
        if (compareTray) {
          compareTray.classList.add('ring-2', 'ring-red-400');
          setTimeout(() => compareTray.classList.remove('ring-2', 'ring-red-400'), 800);
        }
        return;
      }
      selected.set(slug, name);
    } else {
      selected.delete(slug);
    }
    syncCompareCheckboxes(slug, input.checked);
    updateCompareTray();
  }

  function restoreFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const slugs = params.get('selected');
    if (!slugs) return;

    slugs.split(',').slice(0, MAX_COMPARE).forEach(slug => {
      const checkbox = document.querySelector(`.compare-check[data-slug="${slug}"]`) as HTMLInputElement | null;
      if (!checkbox) return;
      checkbox.checked = true;
      selected.set(slug, checkbox.dataset.name || slug);
      syncCompareCheckboxes(slug, true);
    });

    updateCompareTray();
    window.history.replaceState({}, '', window.location.pathname);
  }

  mobileFilterToggle?.addEventListener('click', () => {
    const isHidden = filterPanel?.classList.contains('hidden');
    filterPanel?.classList.toggle('hidden', !isHidden);
    mobileFilterToggle.setAttribute('aria-expanded', String(isHidden));
    const chevron = mobileFilterToggle.querySelector('.filter-chevron');
    if (chevron) {
      (chevron as HTMLElement).style.transform = isHidden ? 'rotate(180deg)' : '';
    }
  });

  document.querySelectorAll('.preset-btn').forEach(button => {
    button.addEventListener('click', () => {
      const preset = (button as HTMLElement).dataset.preset || '';
      if (activePreset === preset) {
        activePreset = '';
        button.classList.remove('active');
      } else {
        document.querySelectorAll('.preset-btn').forEach(item => item.classList.remove('active'));
        activePreset = preset;
        button.classList.add('active');
      }
      clearFilters(false);
      applyFilters();
    });
  });

  viewGrid?.addEventListener('click', () => setView('grid'));
  viewList?.addEventListener('click', () => setView('list'));

  heroSearch?.addEventListener('input', () => {
    activePreset = '';
    document.querySelectorAll('.preset-btn').forEach(button => button.classList.remove('active'));
    applyFilters();
    const url = new URL(window.location.href);
    if (heroSearch.value) { url.searchParams.set('q', heroSearch.value); } else { url.searchParams.delete('q'); }
    window.history.replaceState({}, '', url.toString());
  });
  [filterType, filterPricing, filterHq, filterDelivery, filterRegionStrength, sortBy].forEach(input => input?.addEventListener('change', applyFilters));
  [capAI, capCompliance, capSurveys, capLibrary].forEach(input => input?.addEventListener('change', applyFilters));
  resetAll?.addEventListener('click', () => {
    clearFilters();
    applyFilters();
  });

  document.querySelectorAll('.compare-check').forEach(input => {
    input.addEventListener('change', () => handleCompareToggle(input as HTMLInputElement));
  });
  networkList?.addEventListener('change', event => {
    const target = event.target;
    if (target instanceof HTMLInputElement && target.classList.contains('compare-check')) {
      handleCompareToggle(target);
    }
  });

  clearCompare?.addEventListener('click', () => {
    selected.clear();
    document.querySelectorAll('.compare-check').forEach(input => {
      (input as HTMLInputElement).checked = false;
    });
    updateCompareTray();
  });

  /* Populate search from URL ?q= parameter */
  const urlQ = new URLSearchParams(window.location.search).get('q');
  if (urlQ && heroSearch) { heroSearch.value = urlQ; }

  restoreFromUrl();
  setView('grid');
  applyFilters();
</script>

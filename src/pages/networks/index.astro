---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ParticleHero from '../../components/ParticleHero.astro';
import { getCollection } from 'astro:content';

const allNetworks = await getCollection('networks');
const networks = allNetworks
  .filter(n => n.data.published)
  .sort((a, b) => a.data.priority - b.data.priority);

// Normalize headquarters to country/region
function getRegion(hq: string): string {
  if (!hq) return '';
  if (hq.includes('UK') || hq.includes('London')) return 'United Kingdom';
  if (hq.includes('Germany') || hq.includes('Munich') || hq.includes('Berlin') || hq.includes('Frankfurt')) return 'Germany';
  if (hq.includes('France') || hq.includes('Paris')) return 'France';
  if (hq.includes('Singapore')) return 'Singapore';
  if (hq.includes('India') || hq.includes('Mumbai') || hq.includes('Bangalore') || hq.includes('Delhi')) return 'India';
  if (hq.includes('Japan') || hq.includes('Tokyo')) return 'Japan';
  if (hq.includes('Hong Kong')) return 'Hong Kong';
  if (hq.includes('China') || hq.includes('Shanghai') || hq.includes('Beijing') || hq.includes('Shenzhen')) return 'China';
  if (hq.includes('Switzerland') || hq.includes('Zurich')) return 'Switzerland';
  if (hq.includes('Sweden') || hq.includes('Stockholm')) return 'Sweden';
  return 'United States';
}

// Derive filter options
const allTypes = [...new Set(networks.map(n => n.data.type))].sort();
const allPricing = [...new Set(networks.map(n => n.data.pricingModel).filter(Boolean))].sort();
const allHqs = [...new Set(networks.map(n => getRegion(n.data.headquarters || '')).filter(Boolean))].sort();
const allDeliveryModels = [...new Set(networks.map(n => n.data.deliveryModel).filter(Boolean))].sort();
const allRegionStrengths = [...new Set(networks.map(n => n.data.regionStrength).filter(Boolean))].sort();

// Stats
const aiCount = networks.filter(n => n.data.comparison?.aiMatching).length;
const complianceCount = networks.filter(n => n.data.comparison?.complianceTools).length;
const surveysCount = networks.filter(n => n.data.comparison?.surveys).length;
const libraryCount = networks.filter(n => n.data.comparison?.contentLibrary).length;

// Badge color map
const badgeColors: Record<string, string> = {
  'Global Leader': 'bg-amber-500/10 text-amber-700 border-amber-500/20',
  'Major Provider': 'bg-blue-500/10 text-blue-700 border-blue-500/20',
  'Fast-Growing': 'bg-emerald-500/10 text-emerald-700 border-emerald-500/20',
  'Asia Specialist': 'bg-rose-500/10 text-rose-700 border-rose-500/20',
  'Research Platform': 'bg-violet-500/10 text-violet-700 border-violet-500/20',
  'Technology-First': 'bg-cyan-500/10 text-cyan-700 border-cyan-500/20',
  'Marketplace': 'bg-orange-500/10 text-orange-700 border-orange-500/20',
  'Boutique Specialist': 'bg-slate-500/10 text-slate-700 border-slate-500/20',
};

const directoryEntries = networks.map((network, index) => {
  const data = network.data;
  const services = data.services || [];
  return {
    slug: data.slug,
    name: data.name,
    displayName: data.name.split(' (')[0],
    shortName: data.shortName,
    logo: data.logo || '',
    type: data.type,
    pricingModel: data.pricingModel || '',
    region: getRegion(data.headquarters || ''),
    regionStrength: data.regionStrength || '',
    deliveryModel: data.deliveryModel || '',
    founded: data.founded || 0,
    rank: index,
    badge: data.categoryBadge || '',
    description: data.description,
    complianceBadge: data.complianceBadge || '',
    aiBadge: data.aiBadge || '',
    expertCount: data.expertCount || '',
    services,
    bestFor: data.bestFor || [],
    comparison: {
      aiMatching: Boolean(data.comparison?.aiMatching),
      complianceTools: Boolean(data.comparison?.complianceTools),
      surveys: Boolean(data.comparison?.surveys),
      contentLibrary: Boolean(data.comparison?.contentLibrary),
    },
    gradientFrom: data.gradientFrom,
    gradientTo: data.gradientTo,
  };
});
---

<BaseLayout
  title={`Expert Network Companies: ${networks.length} Providers Compared (2026) | ExpertNetworks.net`}
  description={`Browse and compare ${networks.length} expert network companies including GLG, AlphaSights, Third Bridge, and Guidepoint. Independent profiles with pricing models, compliance ratings, expert coverage, and AI capabilities.`}
  canonicalPath="/networks"
  themeColor="#0d0d0f"
  jsonLd={{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://expertnetworks.net/" },
          { "@type": "ListItem", "position": 2, "name": "Expert Networks" }
        ]
      },
      {
        "@type": "CollectionPage",
        "name": "Expert Network Companies Directory",
        "description": `Independent directory of ${networks.length} expert network providers with pricing, compliance, and capability data.`,
        "url": "https://expertnetworks.net/networks",
        "mainEntity": {
          "@type": "ItemList",
          "numberOfItems": networks.length,
          "itemListElement": networks.slice(0, 10).map((n, i) => ({
            "@type": "ListItem",
            "position": i + 1,
            "name": n.data.name,
            "url": `https://expertnetworks.net/networks/${n.data.slug}`
    }))
        }
      }
    ]
  }}
>
  <!-- Hero -->
  <ParticleHero>
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between lg:gap-10">
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#a1a1a6] mb-2">Independent directory</p>
        <h1 class="text-3xl md:text-[40px] md:leading-[1.1] font-extrabold tracking-tight text-white">Expert Networks Directory</h1>
        <p class="text-[#c7c7cc] text-[15px] mt-3 max-w-2xl leading-relaxed">{networks.length} providers with independent profiles, pricing, compliance, and capability data.</p>
        <p class="text-[#a1a1a6] text-[13px] mt-1 max-w-2xl">Compare networks by use case, pricing model, geography, compliance, and AI capabilities.</p>
      </div>
      <dl class="dir-hero-stats" style="pointer-events: auto;">
        <div><dt>Networks tracked</dt><dd>{networks.length}</dd></div>
        <div><dt>Countries</dt><dd>{allHqs.length}+</dd></div>
        <div><dt>AI matching</dt><dd>{aiCount}</dd></div>
        <div><dt>Compliance tools</dt><dd>{complianceCount}</dd></div>
      </dl>
    </div>
  </ParticleHero>

  <!-- Sticky toolbar: search, filters, count, view -->
  <div id="dirToolbar" class="dir-toolbar sticky top-[52px] z-30 px-4 md:px-6">
    <div class="max-w-site mx-auto py-2.5 flex items-center gap-2 sm:gap-3">
      <div class="relative flex-1 min-w-0 sm:max-w-sm">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-tertiary pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input id="heroSearch" type="search" autocomplete="off" placeholder="Search networks" aria-label="Search networks by name, type, or service" class="dir-search" />
      </div>
      <button id="mobileFilterToggle" type="button" class="dir-filter-btn lg:hidden" aria-label="Filters" aria-expanded="false" aria-controls="filterPanel">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="4" y1="6" x2="20" y2="6"/><line x1="7" y1="12" x2="17" y2="12"/><line x1="10" y1="18" x2="14" y2="18"/></svg>
        <span class="dir-filter-btn-label">Filters</span>
        <span id="filterBadge" class="dir-filter-badge hidden" aria-hidden="true">0</span>
      </button>
      <p class="hidden sm:block text-[13px] text-secondary whitespace-nowrap ml-auto" aria-hidden="true"><strong id="resultCountBar" class="text-primary font-semibold tabular-nums">{networks.length}</strong> of {networks.length}</p>
      <div class="dir-view-toggle" role="group" aria-label="Layout">
        <button id="viewGrid" type="button" class="view-toggle is-active" aria-label="Grid view" aria-pressed="true">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
        </button>
        <button id="viewList" type="button" class="view-toggle" aria-label="List view" aria-pressed="false">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Quick presets -->
  <section class="pt-4 px-4 md:px-6" aria-label="Quick filters">
    <div class="max-w-site mx-auto">
      <div class="dir-presets dir-scroll-none">
        <button type="button" class="preset-btn" data-preset="consulting" aria-pressed="false">Best for Consulting</button>
        <button type="button" class="preset-btn" data-preset="pe" aria-pressed="false">Best for Private Equity</button>
        <button type="button" class="preset-btn" data-preset="enterprise" aria-pressed="false">Best for Enterprise</button>
        <button type="button" class="preset-btn" data-preset="asia" aria-pressed="false">Asia Specialists</button>
        <button type="button" class="preset-btn" data-preset="ai" aria-pressed="false">AI-Forward Platforms</button>
        <button type="button" class="preset-btn" data-preset="library" aria-pressed="false">Transcript / Library</button>
        <button type="button" class="preset-btn" data-preset="boutique" aria-pressed="false">Boutique Specialists</button>
      </div>
    </div>
  </section>

  <!-- Filters + Cards -->
  <section class="pt-5 pb-10 px-4 md:px-6">
    <div class="max-w-site mx-auto flex flex-col lg:flex-row gap-6">

      <!-- Filter panel: sidebar on desktop, bottom sheet on mobile -->
      <div id="filterBackdrop" class="dir-sheet-backdrop" hidden></div>
      <aside id="filterPanel" class="dir-filters" aria-label="Filters">
        <div class="dir-sheet-head">
          <h2 class="text-[17px] font-bold text-primary">Filters</h2>
          <button id="filterClose" type="button" class="dir-icon-btn" aria-label="Close filters">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
        </div>
        <div class="dir-filters-body">
          <fieldset>
            <legend class="dir-eyebrow">Fit</legend>
            <label class="sr-only" for="filterRegionStrength">Region strength</label>
            <select id="filterRegionStrength" class="filter-select" data-label="Region">
              <option value="">All Regions</option>
              {allRegionStrengths.map(r => <option value={r}>{r}</option>)}
            </select>
            <label class="sr-only" for="filterType">Provider type</label>
            <select id="filterType" class="filter-select" data-label="Type">
              <option value="">All Types</option>
              {allTypes.map(t => <option value={t}>{t}</option>)}
            </select>
          </fieldset>
          <fieldset>
            <legend class="dir-eyebrow">Commercial model</legend>
            <label class="sr-only" for="filterPricing">Pricing model</label>
            <select id="filterPricing" class="filter-select" data-label="Pricing">
              <option value="">All Pricing</option>
              {allPricing.map(p => <option value={p}>{p}</option>)}
            </select>
            <label class="sr-only" for="filterDelivery">Delivery model</label>
            <select id="filterDelivery" class="filter-select" data-label="Delivery">
              <option value="">All Delivery Models</option>
              {allDeliveryModels.map(d => <option value={d}>{d}</option>)}
            </select>
            <label class="sr-only" for="filterHq">Headquarters</label>
            <select id="filterHq" class="filter-select" data-label="HQ">
              <option value="">All HQ Locations</option>
              {allHqs.map(h => <option value={h}>{h}</option>)}
            </select>
          </fieldset>
          <fieldset>
            <legend class="dir-eyebrow">Capabilities</legend>
            <label class="dir-check"><input type="checkbox" id="capAI" class="cap-filter" data-label="AI Matching" /><span>AI Matching</span><span class="dir-check-count">{aiCount}</span></label>
            <label class="dir-check"><input type="checkbox" id="capCompliance" class="cap-filter" data-label="Compliance Tools" /><span>Compliance Tools</span><span class="dir-check-count">{complianceCount}</span></label>
            <label class="dir-check"><input type="checkbox" id="capSurveys" class="cap-filter" data-label="Surveys" /><span>Surveys</span><span class="dir-check-count">{surveysCount}</span></label>
            <label class="dir-check"><input type="checkbox" id="capLibrary" class="cap-filter" data-label="Content Library" /><span>Content Library</span><span class="dir-check-count">{libraryCount}</span></label>
          </fieldset>
          <fieldset>
            <legend class="dir-eyebrow">Sort</legend>
            <label class="sr-only" for="sortBy">Sort order</label>
            <select id="sortBy" class="filter-select">
              <option value="rank">Default Order</option>
              <option value="name">A–Z</option>
              <option value="founded">Newest First</option>
              <option value="founded-oldest">Oldest First</option>
            </select>
          </fieldset>
          <button id="resetAll" type="button" class="dir-reset hidden">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
            Reset all filters
          </button>
        </div>
        <div class="dir-sheet-foot">
          <button id="filterApply" type="button" class="dir-btn-primary w-full">{`Show ${networks.length} networks`}</button>
        </div>
      </aside>

      <!-- Results -->
      <div class="flex-1 min-w-0">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mb-4 min-h-[36px]">
          <p id="resultCount" class="text-[15px] text-secondary" role="status" aria-live="polite"><strong class="text-primary font-bold">{networks.length}</strong> networks</p>
          <div id="activeChips" class="flex flex-wrap items-center gap-1.5" aria-label="Active filters"></div>
          <a id="heroCompareBtn" href="/compare" class="ml-auto hidden md:inline-flex items-center gap-1.5 text-[13px] font-semibold text-[#0066cc] no-underline hover:underline underline-offset-4">
            <span id="heroCompareBtnText">Open compare tool</span>
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>

        <div id="noResults" class="dir-empty hidden">
          <div class="dir-empty-icon" aria-hidden="true">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><line x1="20" y1="20" x2="16.2" y2="16.2"/><line x1="8.5" y1="11" x2="13.5" y2="11"/></svg>
          </div>
          <h2 class="text-[17px] font-bold text-primary">No networks match these filters</h2>
          <p id="noResultsDetail" class="mt-1 text-[14px] text-secondary max-w-sm mx-auto">Try removing a filter or broadening your search.</p>
          <div class="mt-5 flex flex-wrap items-center justify-center gap-2">
            <button id="emptyClear" type="button" class="dir-btn-primary">Clear all filters</button>
            <button id="emptyClearSearch" type="button" class="dir-btn-secondary hidden">Clear search only</button>
          </div>
        </div>

        <!-- Grid view (default) -->
        <div id="networkGrid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {networks.map((network, i) => {
            const n = network.data;
            const region = getRegion(n.headquarters || '');
            const badge = n.categoryBadge || '';
            const badgeClass = badgeColors[badge] || 'bg-slate-500/10 text-slate-700 border-slate-500/20';
            const servicesArr = n.services || [];
            const maxChips = 3;
            const displayName = n.name.split(' (')[0];
            return (
              <article
                class="network-card dir-card"
                data-name={n.name.toLowerCase()}
                data-search={[n.name, n.shortName, n.type, badge, ...servicesArr].join(' ').toLowerCase()}
                data-slug={n.slug}
                data-type={n.type}
                data-pricing={n.pricingModel || ''}
                data-region={region}
                data-region-strength={n.regionStrength || ''}
                data-delivery={n.deliveryModel || ''}
                data-founded={n.founded || 0}
                data-rank={i}
                data-badge={badge}
                data-ai={n.comparison?.aiMatching ? '1' : '0'}
                data-compliance={n.comparison?.complianceTools ? '1' : '0'}
                data-surveys={n.comparison?.surveys ? '1' : '0'}
                data-library={n.comparison?.contentLibrary ? '1' : '0'}
                data-best-for={(n.bestFor || []).join(',').toLowerCase()}
                data-services={servicesArr.join(',').toLowerCase()}
              >
                <div class="flex items-start gap-3.5">
                  {n.logo ? (
                    <img src={n.logo} alt="" width="48" height="48" class="dir-logo" loading={i < 6 ? 'eager' : 'lazy'} decoding="async" style={`view-transition-name: net-${n.slug}`} />
                  ) : (
                    <div class="dir-logo dir-logo-fallback" aria-hidden="true" style={`background: linear-gradient(135deg, ${n.gradientFrom}, ${n.gradientTo}); view-transition-name: net-${n.slug}`}>{n.shortName}</div>
                  )}
                  <div class="min-w-0 flex-1">
                    <h2 class="dir-card-name"><a href={`/networks/${n.slug}`} class="dir-card-link">{displayName}</a></h2>
                    <p class="dir-card-type">{n.type}</p>
                  </div>
                  <label class="compare-label dir-compare" title="Add to comparison">
                    <input type="checkbox" class="compare-check" data-slug={n.slug} data-name={n.name} aria-label={`Compare ${displayName}`} />
                    <span class="dir-compare-pill" aria-hidden="true">
                      <svg class="dir-compare-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                      <svg class="dir-compare-tick" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg>
                      <span class="dir-compare-off">Compare</span><span class="dir-compare-on">Added</span>
                    </span>
                  </label>
                </div>

                {badge && <div class="mt-3"><span class={`dir-badge border ${badgeClass}`}>{badge}</span></div>}

                <p class="dir-card-desc line-clamp-2">{n.description}</p>

                <dl class="dir-facts">
                  {n.pricingModel && <div><dt>Pricing</dt><dd>{n.pricingModel}</dd></div>}
                  {n.expertCount && <div><dt>Scale</dt><dd>{n.expertCount}</dd></div>}
                  {n.founded && <div><dt>Founded</dt><dd>{n.founded}</dd></div>}
                  {n.deliveryModel && <div><dt>Model</dt><dd>{n.deliveryModel}</dd></div>}
                </dl>

                {servicesArr.length > 0 && (
                  <div class="flex flex-wrap gap-1.5 mt-3.5">
                    {servicesArr.slice(0, maxChips).map((s: string) => (
                      <span class="dir-chip">{s.length > 25 ? s.slice(0, 22) + '...' : s}</span>
                    ))}
                    {servicesArr.length > maxChips && <span class="dir-chip dir-chip-more">+{servicesArr.length - maxChips}</span>}
                  </div>
                )}

                <div class="dir-card-foot">
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 min-w-0">
                    {n.complianceBadge && (
                      <span class={`dir-signal ${n.complianceBadge === 'Strong Compliance' ? 'text-emerald-700' : n.complianceBadge === 'Compliance Tools' ? 'text-blue-700' : 'text-secondary'}`} title={n.complianceBadge}>
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        <span class="sr-only">Compliance: </span>{n.complianceBadge === 'Strong Compliance' ? 'Strong' : n.complianceBadge === 'Compliance Tools' ? 'Tools' : n.complianceBadge === 'Standard Compliance' ? 'Standard' : 'Limited'}
                      </span>
                    )}
                    {n.aiBadge && (
                      <span class={`dir-signal ${n.aiBadge === 'AI-Native' ? 'text-violet-700' : n.aiBadge === 'AI Research' ? 'text-blue-700' : 'text-secondary'}`}>
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15z"/></svg>
                        {n.aiBadge}
                      </span>
                    )}
                    {n.regionStrength && (
                      <span class="dir-signal text-secondary">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>
                        {n.regionStrength}
                      </span>
                    )}
                  </div>
                  <span class="dir-card-cta" aria-hidden="true">
                    View profile
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
                  </span>
                </div>
              </article>
            );
          })}
        </div>

        <!-- List view (rendered client-side on demand) -->
        <div id="networkList" class="hidden dir-list" role="list"></div>
      </div>
    </div>
  </section>

  <!-- EDITORIAL CONTENT -->
  <section class="py-12 px-4 md:px-6 border-t border-border/40 bg-white">
    <div class="max-w-[68ch] mx-auto">
      <h2 class="text-2xl font-bold tracking-tight text-primary mb-4">About expert network companies</h2>
      <div class="space-y-4 text-[15px] leading-[1.7] text-[#424245]">
        <p>
          Expert networks connect investors, consultants, and corporate teams with subject-matter experts for paid consultations. The industry has grown from a handful of providers in the early 2000s to more than {networks.length} tracked companies in 2026, spanning global leaders, regional specialists, technology-first platforms, and boutique research firms.
        </p>
        <p>

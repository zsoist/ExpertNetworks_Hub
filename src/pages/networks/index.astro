  .dir-tray-inner {
    pointer-events: auto; display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 10px 10px 10px 18px; color: #fff;
    background: rgba(29, 29, 31, 0.92);
    -webkit-backdrop-filter: saturate(180%) blur(24px); backdrop-filter: saturate(180%) blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 18px;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.32);
  }
  .dir-tray.is-full .dir-tray-inner { animation: dir-nudge 0.4s ease; box-shadow: 0 16px 48px rgba(0, 0, 0, 0.32), 0 0 0 2px #ff9f0a; }
  @keyframes dir-nudge { 20% { transform: translateX(-5px); } 50% { transform: translateX(4px); } 80% { transform: translateX(-2px); } }
  .dir-tray-chips { display: none; align-items: center; gap: 6px; min-width: 0; overflow-x: auto; }
  @media (min-width: 640px) { .dir-tray-chips { display: flex; } }
  .dir-tray-chip { display: inline-flex; align-items: center; gap: 6px; height: 32px; padding: 0 4px 0 5px; font-size: 12.5px; font-weight: 500; color: #f5f5f7; background: rgba(255, 255, 255, 0.1); border: none; border-radius: 999px; white-space: nowrap; flex-shrink: 0; }
  .dir-tray-chip img, .dir-tray-chip .dir-tray-dot { width: 22px; height: 22px; border-radius: 999px; object-fit: contain; background: #fff; flex-shrink: 0; }
  .dir-tray-chip .dir-tray-dot { display: inline-flex; align-items: center; justify-content: center; font-size: 8px; font-weight: 700; color: #fff; }
  .dir-tray-chip button { display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; padding: 0; color: #c7c7cc; background: transparent; border: none; border-radius: 999px; cursor: pointer; position: relative; }
  .dir-tray-chip button::after { content: ''; position: absolute; inset: -10px -4px; }
  .dir-tray-chip button:hover { background: rgba(255, 255, 255, 0.16); color: #fff; }
  .dir-tray-chip button svg { width: 12px; height: 12px; }
  .dir-tray-clear { min-height: 44px; padding: 0 12px; font-size: 13px; font-weight: 500; color: #c7c7cc; background: transparent; border: none; border-radius: 12px; cursor: pointer; }
  .dir-tray-clear:hover { color: #fff; background: rgba(255, 255, 255, 0.08); }
  .dir-tray-cta { display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px; font-size: 14px; font-weight: 600; color: #fff; background: #0071e3; border-radius: 12px; text-decoration: none; white-space: nowrap; transition: background-color 0.15s ease, transform 0.15s ease; }
  .dir-tray-cta:hover { background: #0a84ff; }
  .dir-tray-cta:active { transform: scale(0.97); }
  body.dir-tray-open footer { padding-bottom: 88px; }

  @media (prefers-reduced-motion: reduce) {
    .dir-card, .dir-card-cta svg, .dir-compare-pill, .preset-btn, .view-toggle, .dir-filters, .dir-sheet-backdrop, .dir-tray,
    .dir-tray-cta, .dir-btn-primary, .dir-btn-secondary, .dir-filter-btn, .network-row, .filter-select, .dir-search, .dir-active-chip {
      transition: none !important;
    }
    .dir-card:hover, .dir-card:active { transform: none; }
    .dir-card:hover .dir-card-cta svg { transform: none; }
    .dir-tray.is-full .dir-tray-inner { animation: none; }
  }
</style>

<script>
  // @ts-nocheck
  const directoryDataEl = document.getElementById('directoryData');
  const directoryEntries = directoryDataEl ? JSON.parse(directoryDataEl.textContent || '[]') : [];
  const directoryBySlug = new Map(directoryEntries.map(entry => [entry.slug, entry]));

  const $ = (id) => document.getElementById(id);
  const heroSearch = $('heroSearch');
  const filterType = $('filterType');
  const filterPricing = $('filterPricing');
  const filterHq = $('filterHq');
  const filterDelivery = $('filterDelivery');
  const filterRegionStrength = $('filterRegionStrength');
  const sortBy = $('sortBy');
  const capAI = $('capAI');
  const capCompliance = $('capCompliance');
  const capSurveys = $('capSurveys');
  const capLibrary = $('capLibrary');
  const resetAll = $('resetAll');
  const resultCount = $('resultCount');
  const resultCountBar = $('resultCountBar');
  const noResults = $('noResults');
  const noResultsDetail = $('noResultsDetail');
  const emptyClear = $('emptyClear');
  const emptyClearSearch = $('emptyClearSearch');
  const networkGrid = $('networkGrid');
  const networkList = $('networkList');
  const viewGrid = $('viewGrid');
  const viewList = $('viewList');
  const activeChips = $('activeChips');
  const compareTray = $('compareTray');
  const compareCount = $('compareCount');
  const compareNames = $('compareNames');
  const compareLink = $('compareLink');
  const compareLimitMsg = $('compareLimitMsg');
  const clearCompare = $('clearCompare');
  const mobileFilterToggle = $('mobileFilterToggle');
  const filterPanel = $('filterPanel');
  const filterBackdrop = $('filterBackdrop');
  const filterClose = $('filterClose');
  const filterApply = $('filterApply');
  const filterBadge = $('filterBadge');
  const heroCompareBtn = $('heroCompareBtn');
  const heroCompareBtnText = $('heroCompareBtnText');

  const cards = Array.from(document.querySelectorAll('.network-card'));
  const presetButtons = Array.from(document.querySelectorAll('.preset-btn'));
  const badgeClassMap = {
    'Global Leader': 'bg-amber-500/10 text-amber-700 border-amber-500/20',
    'Major Provider': 'bg-blue-500/10 text-blue-700 border-blue-500/20',
    'Fast-Growing': 'bg-emerald-500/10 text-emerald-700 border-emerald-500/20',
    'Asia Specialist': 'bg-rose-500/10 text-rose-700 border-rose-500/20',
    'Research Platform': 'bg-violet-500/10 text-violet-700 border-violet-500/20',
    'Technology-First': 'bg-cyan-500/10 text-cyan-700 border-cyan-500/20',
    'Marketplace': 'bg-orange-500/10 text-orange-700 border-orange-500/20',
    'Boutique Specialist': 'bg-slate-500/10 text-slate-700 border-slate-500/20',
  };
  const selected = new Map();
  const presets = {
    consulting: el => el.dataset.bestFor?.includes('consult') || false,
    pe: el => el.dataset.bestFor?.includes('private equity') || el.dataset.bestFor?.includes('pe') || false,
    enterprise: el => el.dataset.bestFor?.includes('enterprise') || el.dataset.bestFor?.includes('corporate') || false,
    asia: el => el.dataset.regionStrength === 'Asia-Pacific' || el.dataset.regionStrength === 'Greater China' || el.dataset.badge === 'Asia Specialist',
    ai: el => el.dataset.badge === 'Technology-First' || el.dataset.badge === 'Research Platform' || el.getAttribute('data-ai') === '1',
    library: el => el.getAttribute('data-library') === '1' || el.dataset.services?.includes('library') || el.dataset.services?.includes('transcript') || false,
    boutique: el => el.dataset.badge === 'Boutique Specialist',
  };

  /* Each filter knows its URL key, so state round-trips through the address bar. */
  const selectFilters = [
    { el: filterRegionStrength, key: 'region', label: 'Region' },
    { el: filterType, key: 'type', label: 'Type' },
    { el: filterPricing, key: 'pricing', label: 'Pricing' },
    { el: filterDelivery, key: 'delivery', label: 'Delivery' },
    { el: filterHq, key: 'hq', label: 'HQ' },
  ];
  const capFilters = [
    { el: capAI, key: 'ai', attr: 'data-ai', label: 'AI Matching' },
    { el: capCompliance, key: 'compliance', attr: 'data-compliance', label: 'Compliance Tools' },
    { el: capSurveys, key: 'surveys', attr: 'data-surveys', label: 'Surveys' },
    { el: capLibrary, key: 'library', attr: 'data-library', label: 'Content Library' },
  ];
  const sortLabels = { name: 'A–Z', founded: 'Newest first', 'founded-oldest': 'Oldest first' };

  let activePreset = '';
  let currentView = 'grid';
  const MAX_COMPARE = 5; /* matches the compare page's 5-provider limit */

  const esc = (value) => String(value ?? '').replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
  const xIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>';

  function getVisibleCards() {
    return cards.filter(card => card.style.display !== 'none');
  }

  function logoHtml(entry) {
    const vt = `view-transition-name: net-${esc(entry.slug)}`;
    return entry.logo
      ? `<img src="${esc(entry.logo)}" alt="" width="40" height="40" class="dir-logo" loading="lazy" decoding="async" style="${vt}" />`
      : `<div class="dir-logo dir-logo-fallback" aria-hidden="true" style="background: linear-gradient(135deg, ${esc(entry.gradientFrom)}, ${esc(entry.gradientTo)}); ${vt}">${esc(entry.shortName)}</div>`;
  }

  function renderListView() {
    if (!networkList) return;
    networkList.innerHTML = getVisibleCards().map(card => {
      const slug = card.dataset.slug || '';
      const entry = directoryBySlug.get(slug);
      if (!entry) return '';
      const col = (cls, label, value) => `<div class="dir-row-col ${cls}"><small>${label}</small><span title="${esc(value || '')}">${value ? esc(value) : '&ndash;'}</span></div>`;
      return `
        <div class="network-row" role="listitem">
          ${logoHtml(entry)}
          <div class="dir-row-main">
            <a href="/networks/${esc(entry.slug)}" class="dir-row-name">${esc(entry.displayName)}</a>
            <div class="dir-row-sub">${esc(entry.badge || entry.type)}</div>
          </div>
          ${col('c1', 'Pricing', entry.pricingModel)}
          ${col('c2', 'Model', entry.deliveryModel)}
          ${col('c3', 'Scale', entry.expertCount)}
          <label class="compare-label dir-compare" title="Add to comparison">
            <input type="checkbox" class="compare-check" data-slug="${esc(entry.slug)}" data-name="${esc(entry.name)}" aria-label="Compare ${esc(entry.displayName)}" ${selected.has(slug) ? 'checked' : ''} />
            <span class="dir-compare-pill" aria-hidden="true">
              <svg class="dir-compare-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              <svg class="dir-compare-tick" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg>
              <span class="dir-compare-off">Compare</span><span class="dir-compare-on">Added</span>
            </span>
          </label>
          <svg class="dir-row-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </div>`;
    }).join('');
  }

  function setView(view, sync = true) {
    currentView = view === 'list' ? 'list' : 'grid';
    const isList = currentView === 'list';
    if (isList) renderListView();
    /* Only one of the two containers is ever rendered, so each view-transition-name stays unique. */
    networkGrid?.classList.toggle('hidden', isList);
    networkList?.classList.toggle('hidden', !isList);
    viewGrid?.classList.toggle('is-active', !isList);
    viewList?.classList.toggle('is-active', isList);
    viewGrid?.setAttribute('aria-pressed', String(!isList));
    viewList?.setAttribute('aria-pressed', String(isList));
    if (sync) syncUrl();
  }

  function activeFilterList() {
    const list = [];
    const q = heroSearch?.value.trim();
    if (q) list.push({ id: 'q', key: 'Search', label: `“${q}”`, clear: () => { heroSearch.value = ''; } });
    if (activePreset) {
      const btn = presetButtons.find(b => b.dataset.preset === activePreset);
      list.push({ id: 'preset', key: '', label: btn?.textContent?.trim() || activePreset, clear: () => { setPreset(''); } });
    }
    selectFilters.forEach(f => {
      if (f.el?.value) list.push({ id: f.key, key: f.label, label: f.el.value, clear: () => { f.el.value = ''; } });
    });
    capFilters.forEach(f => {
      if (f.el?.checked) list.push({ id: f.key, key: '', label: f.label, clear: () => { f.el.checked = false; } });
    });
    return list;
  }

  function renderChips(list) {
    if (!activeChips) return;
    activeChips.innerHTML = list.map(item =>
      `<button type="button" class="dir-active-chip" data-clear="${esc(item.id)}" aria-label="Remove filter: ${esc(item.key ? item.key + ' ' : '')}${esc(item.label)}">${item.key ? `<span class="dir-chip-key">${esc(item.key)}:</span>` : ''}<span>${esc(item.label)}</span>${xIcon}</button>`
    ).join('') + (list.length > 1 ? '<button type="button" class="dir-clear-all" data-clear="*">Clear all</button>' : '');
  }

  function setPreset(preset) {
    activePreset = presets[preset] ? preset : '';
    presetButtons.forEach(btn => {
      const on = btn.dataset.preset === activePreset;
      btn.classList.toggle('active', on);
      btn.setAttribute('aria-pressed', String(on));
    });
  }

  function syncUrl() {
    const params = new URLSearchParams();
    const q = heroSearch?.value.trim();
    if (q) params.set('q', q);
    if (activePreset) params.set('preset', activePreset);
    selectFilters.forEach(f => { if (f.el?.value) params.set(f.key, f.el.value); });
    const caps = capFilters.filter(f => f.el?.checked).map(f => f.key);
    if (caps.length) params.set('caps', caps.join(','));
    if (sortBy?.value && sortBy.value !== 'rank') params.set('sort', sortBy.value);
    if (currentView === 'list') params.set('view', 'list');
    if (selected.size) params.set('selected', Array.from(selected.keys()).join(','));
    const qs = params.toString().replace(/%2C/g, ',');
    window.history.replaceState({}, '', qs ? `${window.location.pathname}?${qs}` : window.location.pathname);
  }

  function applyFilters() {
    const search = heroSearch?.value.toLowerCase().trim() || '';
    const sort = sortBy?.value || 'rank';
    const terms = search.split(/\s+/).filter(Boolean);

    let visibleCount = 0;
    cards.forEach(card => {
      let match = true;
      const haystack = card.dataset.search || card.dataset.name || '';
      if (terms.length && !terms.every(term => haystack.includes(term))) match = false;
      if (filterType?.value && card.dataset.type !== filterType.value) match = false;
      if (filterPricing?.value && card.dataset.pricing !== filterPricing.value) match = false;
      if (filterHq?.value && card.dataset.region !== filterHq.value) match = false;
      if (filterDelivery?.value && card.dataset.delivery !== filterDelivery.value) match = false;
      if (filterRegionStrength?.value && card.dataset.regionStrength !== filterRegionStrength.value) match = false;
      capFilters.forEach(f => { if (f.el?.checked && card.getAttribute(f.attr) !== '1') match = false; });
      if (activePreset && presets[activePreset] && !presets[activePreset](card)) match = false;

      card.style.display = match ? '' : 'none';
      if (match) visibleCount++;
    });

    const visibleCards = getVisibleCards().sort((a, b) => {
      if (sort === 'name') return (a.dataset.name || '').localeCompare(b.dataset.name || '');
      if (sort === 'founded') return parseInt(b.dataset.founded || '0', 10) - parseInt(a.dataset.founded || '0', 10);
      if (sort === 'founded-oldest') return parseInt(a.dataset.founded || '0', 10) - parseInt(b.dataset.founded || '0', 10);
      return parseInt(a.dataset.rank || '0', 10) - parseInt(b.dataset.rank || '0', 10);
    });
    const fragment = document.createDocumentFragment();
    visibleCards.forEach(card => fragment.appendChild(card));
    cards.filter(card => card.style.display === 'none').forEach(card => fragment.appendChild(card));
    networkGrid?.appendChild(fragment);

    const noun = `network${visibleCount !== 1 ? 's' : ''}`;
    if (resultCount) resultCount.innerHTML = `<strong class="text-primary font-bold">${visibleCount}</strong> ${noun}${sortLabels[sort] ? ` <span class="text-[13px]">· sorted ${sortLabels[sort]}</span>` : ''}`;
    if (resultCountBar) resultCountBar.textContent = String(visibleCount);
    if (filterApply) filterApply.textContent = `Show ${visibleCount} ${noun}`;

    const active = activeFilterList();
    renderChips(active);
    selectFilters.forEach(f => f.el?.classList.toggle('is-set', Boolean(f.el.value)));
    sortBy?.classList.toggle('is-set', sort !== 'rank');
    resetAll?.classList.toggle('hidden', active.length === 0 && sort === 'rank');
    if (filterBadge) {
      /* Search has its own visible field, so the badge counts panel filters only. */
      const panelCount = active.filter(item => item.id !== 'q' && item.id !== 'preset').length;
      filterBadge.textContent = String(panelCount);
      filterBadge.classList.toggle('hidden', panelCount === 0);
    }

    const empty = visibleCount === 0;
    noResults?.classList.toggle('hidden', !empty);
    if (empty) {
      const q = heroSearch?.value.trim();
      const others = active.filter(item => item.id !== 'q');
      if (noResultsDetail) {
        noResultsDetail.textContent = q && others.length
          ? `Nothing matches “${q}” with ${others.length} other filter${others.length > 1 ? 's' : ''} applied. Try removing one.`
          : q
            ? `Nothing matches “${q}”. Check the spelling or search by provider type or service.`
            : 'No provider has this combination. Try removing a filter.';
      }
      emptyClearSearch?.classList.toggle('hidden', !(q && others.length));
    }
    networkGrid?.classList.toggle('hidden', empty || currentView === 'list');
    networkList?.classList.toggle('hidden', empty || currentView !== 'list');
    if (currentView === 'list') renderListView();

    updateCompareTray(false);
    syncUrl();
  }

  function clearFilters(clearPreset = true) {
    if (heroSearch) heroSearch.value = '';
    selectFilters.forEach(f => { if (f.el) f.el.value = ''; });
    capFilters.forEach(f => { if (f.el) f.el.checked = false; });
    if (sortBy) sortBy.value = 'rank';
    if (clearPreset) setPreset('');
  }

  const directoryToComparePreset = {
    consulting: 'consulting',
    pe: 'pe',
    enterprise: 'enterprise',
    asia: 'asia',
    library: 'library',
    ai: 'aiMatching',
  };

  function buildCompareUrl() {
    const slugs = Array.from(selected.keys());
    if (slugs.length === 1) {
      return `/compare?add=${encodeURIComponent(slugs[0])}`;
    }
    if (slugs.length >= 2) {
      const base = `/compare?networks=${slugs.slice(0, MAX_COMPARE).join(',')}`;
      const comparePreset = directoryToComparePreset[activePreset];
      return comparePreset ? `${base}&preset=${comparePreset}` : base;
    }
    if (activePreset && directoryToComparePreset[activePreset]) {
      return `/compare?preset=${directoryToComparePreset[activePreset]}`;
    }
    return '/compare';
  }

  function updateCompareTray(sync = true) {
    const count = selected.size;
    if (compareCount) compareCount.textContent = `${count}/${MAX_COMPARE}`;
    if (compareNames) {
      compareNames.innerHTML = Array.from(selected.entries()).map(([slug, name]) => {
        const entry = directoryBySlug.get(slug);
        const icon = entry?.logo
          ? `<img src="${esc(entry.logo)}" alt="" width="22" height="22" />`
          : `<span class="dir-tray-dot" style="background: linear-gradient(135deg, ${esc(entry?.gradientFrom || '#333')}, ${esc(entry?.gradientTo || '#666')})">${esc(entry?.shortName || '')}</span>`;
        const short = name.split(' (')[0];
        return `<span class="dir-tray-chip">${icon}<span>${esc(short)}</span><button type="button" data-remove-slug="${esc(slug)}" aria-label="Remove ${esc(short)} from comparison">${xIcon}</button></span>`;
      }).join('');
    }

    const url = buildCompareUrl();
    if (compareLink) {
      compareLink.href = url;
      compareLink.textContent = count >= 2 ? `Compare ${count} providers` : 'Compare with the leaders';
    }
    if (heroCompareBtn) heroCompareBtn.href = url;
    if (heroCompareBtnText) heroCompareBtnText.textContent = count > 0 ? `Compare selected (${count})` : 'Open compare tool';
    const open = count > 0;
    compareTray?.classList.toggle('is-open', open);
    document.body.classList.toggle('dir-tray-open', open);
    if (sync) syncUrl();
  }

  function syncCompareCheckboxes(slug, checked) {
    document.querySelectorAll(`.compare-check[data-slug="${CSS.escape(slug)}"]`).forEach(input => { input.checked = checked; });
  }

  function handleCompareToggle(input) {
    const slug = input.dataset.slug || '';
    const name = input.dataset.name || '';
    if (!slug) return;
    if (input.checked) {
      if (selected.size >= MAX_COMPARE) {
        input.checked = false;
        syncCompareCheckboxes(slug, false);
        /* Nudge the tray to show the limit */
        if (compareTray) {
          compareTray.classList.add('is-full');
          setTimeout(() => compareTray.classList.remove('is-full'), 900);
        }
        if (compareLimitMsg) compareLimitMsg.textContent = `You can compare up to ${MAX_COMPARE} providers. Remove one to add another.`;
        return;
      }
      selected.set(slug, name);
    } else {
      selected.delete(slug);
    }
    if (compareLimitMsg) compareLimitMsg.textContent = '';
    syncCompareCheckboxes(slug, input.checked);
    updateCompareTray();
  }

  function restoreFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const q = params.get('q');
    if (q && heroSearch) heroSearch.value = q;
    selectFilters.forEach(f => {
      const value = params.get(f.key);
      if (value && f.el && Array.from(f.el.options).some(option => option.value === value)) f.el.value = value;
    });
    (params.get('caps') || '').split(',').forEach(key => {
      const cap = capFilters.find(f => f.key === key);
      if (cap?.el) cap.el.checked = true;
    });
    const sort = params.get('sort');
    if (sort && sortBy && Array.from(sortBy.options).some(option => option.value === sort)) sortBy.value = sort;
    setPreset(params.get('preset') || '');
    if (params.get('view') === 'list') currentView = 'list';

    (params.get('selected') || '').split(',').filter(Boolean).slice(0, MAX_COMPARE).forEach(slug => {
      const checkbox = document.querySelector(`.compare-check[data-slug="${CSS.escape(slug)}"]`);
      if (!checkbox) return;
      checkbox.checked = true;
      selected.set(slug, checkbox.dataset.name || slug);
    });
  }

  /* ----- Mobile filter sheet ----- */
  let sheetScrollY = 0;
  const sheetMq = window.matchMedia('(max-width: 1023px)');
  function setSheet(open) {
    if (!filterPanel) return;
    if (open && !sheetMq.matches) return;
    const wasOpen = filterPanel.classList.contains('is-open');
    filterPanel.classList.toggle('is-open', open);
    mobileFilterToggle?.setAttribute('aria-expanded', String(open));
    if (open) {
      sheetScrollY = window.scrollY;
      if (filterBackdrop) { filterBackdrop.hidden = false; requestAnimationFrame(() => filterBackdrop.classList.add('is-open')); }
      document.body.classList.add('overlay-open');
      document.body.style.top = `-${sheetScrollY}px`;
      filterPanel.setAttribute('role', 'dialog');
      filterPanel.setAttribute('aria-modal', 'true');
      setTimeout(() => filterClose?.focus(), 50);
    } else if (wasOpen) {
      filterBackdrop?.classList.remove('is-open');
      setTimeout(() => { if (filterBackdrop && !filterPanel.classList.contains('is-open')) filterBackdrop.hidden = true; }, 260);
      document.body.classList.remove('overlay-open');
      document.body.style.top = '';
      window.scrollTo(0, sheetScrollY);
      filterPanel.removeAttribute('role');
      filterPanel.removeAttribute('aria-modal');
      mobileFilterToggle?.focus({ preventScroll: true });
    }
  }
  mobileFilterToggle?.addEventListener('click', () => setSheet(!filterPanel?.classList.contains('is-open')));
  filterClose?.addEventListener('click', () => setSheet(false));
  filterApply?.addEventListener('click', () => setSheet(false));
  filterBackdrop?.addEventListener('click', () => setSheet(false));
  sheetMq.addEventListener('change', () => setSheet(false));
  document.addEventListener('keydown', event => {
    if (!filterPanel?.classList.contains('is-open')) return;
    if (event.key === 'Escape') { setSheet(false); return; }
    if (event.key !== 'Tab') return;
    const focusable = Array.from(filterPanel.querySelectorAll('button, select, input')).filter(el => el.offsetParent !== null);
    if (!focusable.length) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
    else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
  });

  /* ----- Events ----- */
  presetButtons.forEach(button => {
    button.addEventListener('click', () => {
      const preset = button.dataset.preset || '';
      const next = activePreset === preset ? '' : preset;
      clearFilters(true);
      setPreset(next);
      applyFilters();
    });
  });

  viewGrid?.addEventListener('click', () => setView('grid'));
  viewList?.addEventListener('click', () => setView('list'));

  heroSearch?.addEventListener('input', () => {
    setPreset('');
    applyFilters();
  });
  heroSearch?.addEventListener('keydown', event => {
    if (event.key === 'Escape' && heroSearch.value) { heroSearch.value = ''; applyFilters(); }
  });
  [...selectFilters.map(f => f.el), sortBy, ...capFilters.map(f => f.el)].forEach(input => input?.addEventListener('change', applyFilters));

  function clearEverything() {
    clearFilters();
    applyFilters();
  }
  resetAll?.addEventListener('click', clearEverything);
  emptyClear?.addEventListener('click', clearEverything);
  emptyClearSearch?.addEventListener('click', () => { if (heroSearch) heroSearch.value = ''; applyFilters(); heroSearch?.focus(); });

  activeChips?.addEventListener('click', event => {
    const button = event.target instanceof Element ? event.target.closest('[data-clear]') : null;
    if (!button) return;
    const id = button.getAttribute('data-clear');
    if (id === '*') { clearEverything(); return; }
    activeFilterList().find(item => item.id === id)?.clear();
    applyFilters();
  });

  document.addEventListener('change', event => {
    const target = event.target;
    if (target instanceof HTMLInputElement && target.classList.contains('compare-check')) handleCompareToggle(target);
  });

  compareNames?.addEventListener('click', event => {
    const button = event.target instanceof Element ? event.target.closest('[data-remove-slug]') : null;
    if (!button) return;
    const slug = button.getAttribute('data-remove-slug') || '';
    selected.delete(slug);
    syncCompareCheckboxes(slug, false);
    updateCompareTray();
  });

  clearCompare?.addEventListener('click', () => {
    selected.clear();
    document.querySelectorAll('.compare-check').forEach(input => { input.checked = false; });
    updateCompareTray();
  });

  restoreFromUrl();
  setView(currentView, false);
  applyFilters();
</script>

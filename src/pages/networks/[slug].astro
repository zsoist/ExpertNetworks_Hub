  <script>
    // Sidebar search filtering
    function setupSearch(inputId: string, listIds: string[]) {
      const input = document.getElementById(inputId) as HTMLInputElement;
      if (!input) return;
      input.addEventListener('input', () => {
        const q = input.value.toLowerCase().trim();
        listIds.forEach(listId => {
          const list = document.getElementById(listId);
          if (!list) return;
          const items = list.querySelectorAll('.sidebar-item') as NodeListOf<HTMLElement>;
          items.forEach(item => {
            const name = item.getAttribute('data-name') || '';
            item.style.display = (!q || name.includes(q)) ? '' : 'none';
          });
        });
      });
    }

    setupSearch('sidebarSearch', ['featuredList', 'allList']);
    setupSearch('mobileSearch', ['mobileFeaturedList', 'mobileAllList']);

    // Mobile sidebar toggle
    const toggle = document.getElementById('sidebarToggle');
    const backdrop = document.getElementById('sidebarBackdrop');
    const mobileSidebar = document.getElementById('mobileSidebar');
    const closeBtn = document.getElementById('closeSidebar');

    function openMobile() {
      backdrop?.classList.remove('hidden');
      requestAnimationFrame(() => {
        backdrop?.classList.add('opacity-100');
        backdrop?.classList.remove('opacity-0');
        mobileSidebar?.classList.remove('-translate-x-full');
      });
      document.body.style.overflow = 'hidden';
    }

    function closeMobile() {
      backdrop?.classList.remove('opacity-100');
      backdrop?.classList.add('opacity-0');
      mobileSidebar?.classList.add('-translate-x-full');
      setTimeout(() => backdrop?.classList.add('hidden'), 300);
      document.body.style.overflow = '';
    }

    toggle?.addEventListener('click', openMobile);
    backdrop?.addEventListener('click', closeMobile);
    closeBtn?.addEventListener('click', closeMobile);

    // Close mobile sidebar when clicking a network link inside it
    mobileSidebar?.addEventListener('click', (e) => {
      const target = e.target;
      if (target instanceof Element) {
        const link = target.closest('a');
        if (link?.href) closeMobile();
      }
    });

    // Close mobile sidebar on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileSidebar && !mobileSidebar.classList.contains('-translate-x-full')) {
        closeMobile();
      }
    });

    // Scroll active sidebar item into view on desktop
    const activeSidebarItem = document.querySelector('#sidebar .bg-accent');
    if (activeSidebarItem) {
      activeSidebarItem.scrollIntoView({ block: 'center', behavior: 'auto' });
    }

    // Right TOC — active section tracking via IntersectionObserver
    const tocLinks = document.querySelectorAll('.toc-link') as NodeListOf<HTMLAnchorElement>;
    if (tocLinks.length > 0) {
      const sectionIds = Array.from(tocLinks).map(l => l.getAttribute('data-section')!);
      const sections = sectionIds
        .map(id => document.getElementById(id))
        .filter((el): el is HTMLElement => el !== null);

      function setActive(id: string) {
        tocLinks.forEach(link => {
          const isActive = link.getAttribute('data-section') === id;
          link.classList.toggle('text-accent', isActive);
          link.classList.toggle('border-accent', isActive);
          link.classList.toggle('font-medium', isActive);
          link.classList.toggle('text-tertiary', !isActive);
          link.classList.toggle('border-transparent', !isActive);
        });
      }

      const tocObserver = new IntersectionObserver((entries) => {
        // Find the first section that is intersecting (top-most visible)
        for (const entry of entries) {
          if (entry.isIntersecting) {
            setActive(entry.target.id);
            break;
          }
        }
      }, {
        rootMargin: '-80px 0px -60% 0px',
        threshold: 0
      });

      sections.forEach(section => tocObserver.observe(section));

      // Set initial active state
      if (sections.length > 0) setActive(sections[0].id);
    }
  </script>
</BaseLayout>

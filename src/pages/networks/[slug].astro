  .pf-secnav-browse { display: inline-flex; align-items: center; gap: 6px; height: 36px; padding: 0 12px; margin-right: 10px; font-size: 13px; font-weight: 600; color: #fff; background: #1d1d1f; border: none; border-radius: 999px; cursor: pointer; flex-shrink: 0; position: relative; }
  .pf-secnav-browse::after { content: ''; position: absolute; inset: -6px -2px; }
  .pf-secnav-browse:active { transform: scale(0.96); }

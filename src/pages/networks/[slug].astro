  <script>
    // Sidebar search filtering
    function setupSearch(inputId: string, listIds: string[]) {
      const input = document.getElementById(inputId) as HTMLInputElement;
      if (!input) return;
      input.addEventListener('input', () => {
        const q = input.value.toLowerCase().trim();
        listIds.forEach(listId => {
          const list = document.getElementById(listId);
          if (!list) return;
          const items = list.querySelectorAll('.sidebar-item') as NodeListOf<HTMLElement>;
          items.forEach(item => {
            const name = item.getAttribute('data-name') || '';
            item.style.display = (!q || name.includes(q)) ? '' : 'none';
          });
        });
      });
    }

    setupSearch('sidebarSearch', ['featuredList', 'allList']);
    setupSearch('mobileSearch', ['mobileFeaturedList', 'mobileAllList']);

    // Mobile sidebar drawer
    const toggle = document.getElementById('sidebarToggle');
    const backdrop = document.getElementById('sidebarBackdrop');
    const mobileSidebar = document.getElementById('mobileSidebar');
    const closeBtn = document.getElementById('closeSidebar');

    let savedScrollY = 0;
    function isDrawerOpen() {
      return Boolean(mobileSidebar && !mobileSidebar.classList.contains('-translate-x-full'));
    }
    function setDrawerHidden(hidden: boolean) {
      if (!mobileSidebar) return;
      mobileSidebar.setAttribute('aria-hidden', String(hidden));
      if (hidden) mobileSidebar.setAttribute('inert', ''); else mobileSidebar.removeAttribute('inert');
    }
    function openMobile() {
      savedScrollY = window.scrollY;
      backdrop?.classList.remove('hidden');
      setDrawerHidden(false);
      requestAnimationFrame(() => {
        backdrop?.classList.add('opacity-100');
        backdrop?.classList.remove('opacity-0');
        mobileSidebar?.classList.remove('-translate-x-full');
      });
      document.body.classList.add('overlay-open');
      document.body.style.top = `-${savedScrollY}px`;
      toggle?.setAttribute('aria-expanded', 'true');
      setTimeout(() => closeBtn?.focus(), 60);
    }

    function closeMobile(restoreFocus = true) {
      if (!isDrawerOpen()) return;
      backdrop?.classList.remove('opacity-100');
      backdrop?.classList.add('opacity-0');
      mobileSidebar?.classList.add('-translate-x-full');
      setTimeout(() => { if (!isDrawerOpen()) backdrop?.classList.add('hidden'); }, 300);
      document.body.classList.remove('overlay-open');
      document.body.style.top = '';
      window.scrollTo(0, savedScrollY);
      toggle?.setAttribute('aria-expanded', 'false');
      setDrawerHidden(true);
      if (restoreFocus) toggle?.focus({ preventScroll: true });
    }

    setDrawerHidden(true);
    toggle?.addEventListener('click', openMobile);
    backdrop?.addEventListener('click', () => closeMobile());
    closeBtn?.addEventListener('click', () => closeMobile());

    // Close mobile sidebar when clicking a network link inside it
    mobileSidebar?.addEventListener('click', (e) => {
      const target = e.target;
      if (target instanceof Element) {
        const link = target.closest('a');
        if (link?.href) closeMobile(false);
      }
    });

    // Escape closes; Tab stays inside the open drawer
    document.addEventListener('keydown', (e) => {
      if (!isDrawerOpen() || !mobileSidebar) return;
      if (e.key === 'Escape') { closeMobile(); return; }
      if (e.key !== 'Tab') return;
      const focusable = Array.from(mobileSidebar.querySelectorAll<HTMLElement>('a[href], button, input')).filter(el => el.offsetParent !== null);
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => { if (e.matches) closeMobile(false); });

    // Keep the active item visible in the desktop sidebar without scrolling the page
    const sidebarEl = document.getElementById('sidebar');
    const activeSidebarItem = sidebarEl?.querySelector<HTMLElement>('[aria-current="page"]');
    if (sidebarEl && activeSidebarItem) {
      sidebarEl.scrollTop = activeSidebarItem.offsetTop - sidebarEl.clientHeight / 2 + activeSidebarItem.offsetHeight / 2;
    }

    // Section navigation: one scroll-spy drives both the sticky pill bar and the right-hand TOC
    const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc-link, .pf-secnav-link'));
    const secnav = document.querySelector<HTMLElement>('.pf-secnav');
    const secnavScroll = document.getElementById('pfSecnavScroll');
    if (navLinks.length > 0) {
      const ids = Array.from(new Set(navLinks.map(l => l.dataset.section || '')));
      const sections = ids
        .map(id => document.getElementById(id))
        .filter((el): el is HTMLElement => el !== null);
      let activeId = '';

      function spyOffset() {
        const navHeight = secnav && secnav.offsetParent !== null ? secnav.offsetHeight : 0;
        return 52 + navHeight + 28;
      }

      function setActive(id: string) {
        if (id === activeId) return;
        activeId = id;
        navLinks.forEach(link => {
          const isActive = link.dataset.section === id;
          link.classList.toggle('is-active', isActive);
          if (isActive) link.setAttribute('aria-current', 'location'); else link.removeAttribute('aria-current');
          if (isActive && secnavScroll && link.classList.contains('pf-secnav-link')) {
            const target = link.offsetLeft - (secnavScroll.clientWidth - link.offsetWidth) / 2;
            secnavScroll.scrollTo({ left: Math.max(0, target), behavior: 'auto' });
          }
        });
      }

      function updateActive() {
        const line = spyOffset();
        /* The active section is the last one whose top has crossed the line under the sticky bars. */
        let current = sections[0];
        let bestTop = -Infinity;
        for (const section of sections) {
          const top = section.getBoundingClientRect().top;
          if (top <= line && top > bestTop) { bestTop = top; current = section; }
        }
        /* At the very bottom the last sections can never reach the line; pick the last one on screen. */
        if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
          const onScreen = sections.filter(s => s.getBoundingClientRect().top < window.innerHeight);
          if (onScreen.length) current = onScreen.reduce((a, b) => (b.getBoundingClientRect().top > a.getBoundingClientRect().top ? b : a));
        }
        if (current) setActive(current.id);
      }

      let ticking = false;
      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => { ticking = false; updateActive(); });
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      document.querySelectorAll('details.pf-acc').forEach(el => el.addEventListener('toggle', onScroll));

      /* Jumping to a collapsed accordion section opens it first */
      navLinks.forEach(link => {
        link.addEventListener('click', () => {
          const target = document.getElementById(link.dataset.section || '');
          if (target instanceof HTMLDetailsElement && !target.open) target.open = true;
        });
      });
      const hashTarget = window.location.hash ? document.getElementById(decodeURIComponent(window.location.hash.slice(1))) : null;
      if (hashTarget instanceof HTMLDetailsElement) { hashTarget.open = true; hashTarget.scrollIntoView(); }

      updateActive();
    }

    // Expand / collapse all deep-dive sections
    const expandAll = document.getElementById('pfExpandAll');
    const accordions = Array.from(document.querySelectorAll<HTMLDetailsElement>('details.pf-acc'));
    function syncExpandLabel() {
      if (!expandAll) return;
      const allOpen = accordions.length > 0 && accordions.every(a => a.open);
      expandAll.textContent = allOpen ? 'Collapse all' : 'Expand all';
      expandAll.setAttribute('aria-pressed', String(allOpen));
    }
    expandAll?.addEventListener('click', () => {
      const allOpen = accordions.every(a => a.open);
      accordions.forEach(a => { a.open = !allOpen; });
      syncExpandLabel();
    });
    accordions.forEach(a => a.addEventListener('toggle', syncExpandLabel));
  </script>
</BaseLayout>

<style is:global>
  /*

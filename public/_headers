# Cloudflare Pages headers
# Static Astro site — https://expertnetworks.net
# Security headers + long-lived caching for fingerprinted assets.
#
# CSP notes:
# - 'unsafe-inline' for script/style is required: Astro inlines small page
#   scripts and JSON data blocks, Tailwind injects styles, and a few elements
#   use inline style attributes. There is no server and no user input, so the
#   XSS surface is minimal; this locks down everything else (objects, frames,
#   base-uri, form targets) while permitting the resources the site actually uses.
# - Google Fonts: stylesheet from fonts.googleapis.com, font files from fonts.gstatic.com.
# - img-src allows https: and data: to cover favicons, OG images, and any remote logos.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# Fingerprinted build assets are immutable — cache aggressively.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Static media and icons — long cache, allow revalidation.
/images/*
  Cache-Control: public, max-age=2592000

/favicon.svg
  Cache-Control: public, max-age=2592000
/favicon.ico
  Cache-Control: public, max-age=2592000
